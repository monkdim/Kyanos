-- App scaffolder — `clarity app new` (Phase 64 task 4).
--
-- Generates a minimal KyanOS app project on disk:
--
--     clarity-app.toml     manifest with sensible defaults
--     main.clarity         entry point matching template
--     .gitignore           clarity_modules/, *.bmp.bak, etc.
--     icon.bmp             8x8 placeholder bitmap (only if BMP writer available)
--
-- Two templates ship today:
--
--   "basic"   pure-CLI app: `show "Hello from <name>!"`. Useful for
--             scripts that don't need a UI.
--   "gui"     mounts a WidgetRoot with a Label centred on a coloured
--             Wallpaper. Wires up the InputBus + Compositor render
--             loop in skeleton form (the runtime hooks land in a
--             later phase; for now main() exits after one paint).
--
-- The scaffolder does not run any commands or touch the network. It
-- writes files only.
--
--     scaffold_app("/tmp/myapp", {"name": "myapp", "template": "gui"})
--     -> {"created": [...paths...], "manifest_path": ..., "manifest": <AppManifest>}

from "app_manifest.clarity" import manifest, MANIFEST_FILENAME, generate_manifest

let DEFAULT_TEMPLATE = "basic"
let TEMPLATES = ["basic", "gui"]

-- ── File helpers ─────────────────────────────────────

fn _quote(s) {
    let escaped = replace(str(s), "'", "'\\''")
    return "'" + escaped + "'"
}

fn _exists(path) {
    let result = exec_full("test -e " + _quote(path) + " && echo yes || echo no")
    return trim(result.stdout) == "yes"
}

fn _mkdir_p(path) { exec_full("mkdir -p " + _quote(path)) }

fn _write_file(path, content) {
    write(path, content)
    return path
}

fn _basename(path) {
    let parts = split(path, "/")
    if len(parts) == 0 { return path }
    let last = parts[len(parts) - 1]
    if len(last) == 0 and len(parts) >= 2 {
        return parts[len(parts) - 2]
    }
    return last
}

-- ── Manifest defaults ────────────────────────────────

fn _default_manifest_map(name, template, author, description) {
    mut perms = {}
    if template == "gui" {
        perms["notifications"] = true
    }
    let win = if template == "gui" {
        {"title": name, "width": 480, "height": 320, "resizable": true}
    } else {
        {"title": name, "width": 320, "height": 240, "resizable": false}
    }
    mut app_section = {
        "name": name,
        "version": "0.1.0",
        "entry": "main.clarity",
        "icon": "icon.bmp"
    }
    if author != null and len(author) > 0 { app_section["author"] = author }
    if description != null and len(description) > 0 { app_section["description"] = description }
    return {
        "app": app_section,
        "window": win,
        "permissions": perms
    }
}

-- ── Templates ────────────────────────────────────────

fn _basic_main(name) {
    return "-- " + name + " — generated by `clarity app new`.\n" +
           "\n" +
           "fn main() {\n" +
           "    show \"Hello from " + name + "!\"\n" +
           "}\n" +
           "\n" +
           "main()\n"
}

fn _gui_main(name) {
    return "-- " + name + " — generated by `clarity app new` (gui template).\n" +
           "\n" +
           "from \"ui.clarity\" import WidgetRoot\n" +
           "from \"widgets.clarity\" import Label\n" +
           "from \"theme.clarity\" import dark\n" +
           "\n" +
           "fn build() {\n" +
           "    let root = WidgetRoot(480, 320)\n" +
           "    root.theme = dark()\n" +
           "    let title = Label(\"" + name + "\")\n" +
           "    title.set_bounds(20, 20, 440, 40)\n" +
           "    root.add(title)\n" +
           "    return root\n" +
           "}\n" +
           "\n" +
           "fn main() {\n" +
           "    let root = build()\n" +
           "    root.render()\n" +
           "    show \"" + name + " ready (one frame painted).\"\n" +
           "}\n" +
           "\n" +
           "main()\n"
}

fn _gitignore() {
    return "# Clarity\nclarity_modules/\nclarity.lock\n*.tar.gz\n\n# Editors\n.vscode/\n.idea/\n*.swp\n\n# OS\n.DS_Store\nThumbs.db\n"
}

fn _readme(name, description) {
    let desc = if len(description) > 0 { description + "\n\n" } else { "" }
    return "# " + name + "\n\n" + desc +
           "Generated by `clarity app new`. Run with:\n\n" +
           "```\nclarity run main.clarity\n```\n"
}

-- 8x8 BGRA placeholder icon (a single solid colour). 32-bit BMP
-- header + 256 bytes of pixel data. Returned as a string so we can
-- write it; readers should reopen as binary for byte-accurate use.
fn _placeholder_icon_bytes() {
    -- We return null and let the caller skip the icon if it can't
    -- produce a real BMP. Phase 57's image module owns BMP writing,
    -- and we don't want a hard dep on it from the scaffolder. The
    -- manifest still references icon.bmp; users drop their own in.
    return null
}

-- ── Main entry ───────────────────────────────────────

fn scaffold_app(dest_dir, opts) {
    let o = opts ?? {}
    let inferred_name = _basename(dest_dir)
    let name = if has(o, "name") and len(o["name"]) > 0 { o["name"] } else { inferred_name }
    let template = if has(o, "template") { o["template"] } else { DEFAULT_TEMPLATE }
    let author = if has(o, "author") { o["author"] } else { "" }
    let description = if has(o, "description") { o["description"] } else { "" }
    let force = if has(o, "force") { o["force"] } else { false }

    if not contains(TEMPLATES, template) {
        throw "ScaffoldError: unknown template '" + template + "' (known: " + join(TEMPLATES, ", ") + ")"
    }

    if _exists(dest_dir) and not force {
        let manifest_check = dest_dir + "/" + MANIFEST_FILENAME
        if _exists(manifest_check) {
            throw "ScaffoldError: '" + dest_dir + "' already contains " + MANIFEST_FILENAME
        }
    }
    _mkdir_p(dest_dir)

    mut created = []

    let manifest_map = _default_manifest_map(name, template, author, description)
    let manifest_path = dest_dir + "/" + MANIFEST_FILENAME
    _write_file(manifest_path, generate_manifest(manifest_map))
    push(created, manifest_path)

    let main_path = dest_dir + "/main.clarity"
    let main_src = if template == "gui" { _gui_main(name) } else { _basic_main(name) }
    _write_file(main_path, main_src)
    push(created, main_path)

    let gitignore_path = dest_dir + "/.gitignore"
    if not _exists(gitignore_path) {
        _write_file(gitignore_path, _gitignore())
        push(created, gitignore_path)
    }

    let readme_path = dest_dir + "/README.md"
    if not _exists(readme_path) {
        _write_file(readme_path, _readme(name, description))
        push(created, readme_path)
    }

    return {
        "name": name,
        "template": template,
        "manifest_path": manifest_path,
        "manifest": manifest(manifest_map),
        "created": created
    }
}
