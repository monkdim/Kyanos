    show "  clarity info some-package"
}

-- ── Path helpers ───────────────────────────────────────

fn _dirname(path) {
    let result = exec_full("dirname " + _quote(path))
    return trim(result.stdout)
}

fn _abspath(path) {
    let result = exec_full("realpath " + _quote(path) + " 2>/dev/null || readlink -f " + _quote(path) + " 2>/dev/null || echo " + _quote(path))
    return trim(result.stdout)
}

-- Locate the stdlib sources for `transpile --bundle`.
--
-- This used to be `_dirname(_abspath("lexer.clarity"))`, which only resolves
-- correctly when the process was started from inside stdlib/. Run from the
-- repo root it resolved to the root, matched no source files, and wrote an
-- *empty* bundle while still reporting success — so a rebuild appeared to
-- work and silently produced nothing.
fn _find_stdlib_dir() {
    let here = _dirname(_abspath("lexer.clarity"))
    for cand in [here, _abspath("stdlib"), _abspath("../stdlib")] {
        if exists(cand + "/lexer.clarity") { return cand }
    }
    return null
}

fn _resolve_stdlib_dir() {
    let found = _find_stdlib_dir()
    if found != null { return found }
    throw "transpile --bundle: cannot find the stdlib sources (no lexer.clarity next to the working directory, ./stdlib or ../stdlib)"
}

fn _quote(s) {
    let escaped = replace(str(s), "'", "'\\''")
    return "'" + escaped + "'"
}

fn _is_dir(path) {
    let result = exec_full("test -d " + _quote(path) + " && echo dir || echo file")
    return trim(result.stdout) == "dir"
}

fn _collect_clarity_files(paths) {
    mut files = []
    for p in paths {
        if exists(p) {
            if _is_dir(p) {
                let find_result = exec_full("find " + _quote(p) + " -name '*.clarity' -type f | sort")
                let found = split(trim(find_result.stdout), "\n")
                for f in found {
                    if len(trim(f)) > 0 {
                        push(files, trim(f))
                    }
                }
            } else {
                push(files, p)
            }
        } else {
            show red("  >> Not found: {p}")
            exit(1)
        }
    }
    return files
}

-- ── File runner ─────────────────────────────────────────

-- `program_args` is what the program's args() answers: the arguments
-- after the file, without the flag that picks the engine. An installed
-- binary already saw exactly that; a program under `clarity run` shared
-- the CLI's argv and got "run", the file and the flag in front of its own,
-- so args()[0] differed between the two. The override lives in each
-- engine's globals rather than in the runtime: the CI test jobs are built
-- by the previous release's transpiler, whose runtime import header knows
-- nothing added since, so a new runtime export is a ReferenceError there.
fn run_file(path, program_args) {
    if not exists(path) {
        show red("  >> File not found: {path}")
        exit(1)
    }

    let source = read(path)

    try {
        let tokens = tokenize(source, path)
        let tree = parse(tokens, source)
        let source_dir = _dirname(_abspath(path))
        let interp = Interpreter(null, source_dir)
        interp.global_env.set("args", fn() { return program_args ?? [] }, true)
        interp.run(tree)
    } catch e {
        show red("\n" + format_error(e, source, path))
        exit(1)
    }
}

fn run_file_fast(path, program_args) {
    -- Run through bytecode VM instead of tree-walking interpreter
    if not exists(path) {
        show red("  >> File not found: {path}")
        exit(1)
    }

    let source = read(path)

    try {
        let tokens = tokenize(source, path)
        let tree = parse(tokens, source)
        let code = compile_to_bytecode(tree)
        optimize(code)
        let vm = VM()
        vm.source_dir = _dirname(_abspath(path))
        vm.globals["args"] = fn() { return program_args ?? [] }
        vm.run(code)
    } catch e {
        show red("\n" + format_error(e, source, path))
        exit(1)
    }
}

-- ── Syntax checker ──────────────────────────────────────

-- Pick a C compiler that's actually installed.
fn _find_cc() {
    for candidate in ["cc", "gcc", "clang"] {
        let r = exec_full(candidate + " --version")
        if len(trim(r.stdout)) > 0 { return candidate }
    }
    return null
}

-- `clarity cc <file.clarity> [-o out] [--freestanding]` — compile a Clarity program straight
-- to a native binary through C. No Bun, no bytecode VM: real machine code.
-- (Stage 1: the scalar core — numbers, strings, booleans, variables,
-- if/while, and functions. Richer features are still landing.)
fn cc_file(cli_args) {
    if len(cli_args) < 2 {
        show red("  Usage: clarity cc <file.clarity> [-o <output>] [--freestanding]")
        exit(1)
    }
    let path = cli_args[1]
    if not exists(path) {
        show red("  >> File not found: {path}")
        exit(1)
    }
    -- output name: -o <name>, else the source stem
    mut out = stem(path)
    mut freestanding = false
    mut i = 2
    while i < len(cli_args) {
        if cli_args[i] == "-o" and i + 1 < len(cli_args) { out = cli_args[i + 1]; i += 2 }
        elif cli_args[i] == "--freestanding" { freestanding = true; i += 1 }
        else { i += 1 }
    }

    let cc = _find_cc()
    if cc == null {
        show red("  >> No C compiler found (need cc, gcc, or clang on PATH)")
        exit(1)
    }

    let source = read(path)
    mut c_src = ""
    try {
        -- A native build is a single C translation unit, so imports are
        -- resolved by inlining the modules rather than by linking. Imports
        -- resolve next to the file being compiled first, then in the stdlib,
        -- the same order the interpreter uses.
        let tree = parse(tokenize(source, path), source)
        let abs = _abspath(path)
        -- The stdlib is a *fallback* search path here, not a requirement:
        -- `clarity cc` has to work on a program outside the repo, whose
        -- imports all sit next to it.
        let flat = resolve_native_imports(tree, _dirname(abs), _find_stdlib_dir(), abs)
        c_src = if freestanding { compile_to_c_freestanding(flat) } else { compile_to_c(flat) }
    } catch e {
        show red("\n" + format_error(e, source, path))
        exit(1)
    }

    let cfile = out + ".c"
    write(cfile, c_src)

    -- A freestanding build cannot be linked here: the C library it needs is
    -- the one the target has to supply, and this machine's is the wrong one.
    -- So it stops at an object file, and prints the symbols that object needs
    -- — which is the actual specification of the libc the target must have,
    -- measured rather than guessed.
    if freestanding {
        _cc_freestanding(cc, cfile, out, path)
        return
    }
    -- FFI (dlsym) needs libdl on Linux; on modern glibc it's a harmless stub,
    -- on macOS dlsym lives in libSystem so no extra flag is needed. Unused FFI
    -- helpers are stripped at -O2, so non-FFI programs don't actually pull it.
    let ldl = if contains(exec("uname"), "Linux") { " -ldl" } else { "" }
    let comp = exec_full(cc + " -O2 -w " + _quote(cfile) + " -o " + _quote(out) + " -lm" + ldl)
    if len(trim(comp.stderr)) > 0 and not exists(out) {
        show red("  >> C compilation failed:")
        show comp.stderr
        exit(1)
    }
    show green("  compiled") + " {path} → {out}  " + dim("(via {cc}; C at {cfile})")
}

-- Compile one translation unit for a target with no operating system, and
-- report what it still needs from a C library.
fn _cc_freestanding(cc, cfile, out, path) {
    let obj = out + ".o"
    -- -U_FORTIFY_SOURCE matters for the symbol list, not the code: a glibc
    -- host with fortification on rewrites printf into __printf_chk, and the
    -- target's C library would have no such symbol. Turning it off keeps the
    -- list below the set of functions the target actually has to provide.
    let comp = exec_full(cc + " -O2 -w -ffreestanding -U_FORTIFY_SOURCE -c " + _quote(cfile) + " -o " + _quote(obj))
    if not exists(obj) {
        show red("  >> C compilation failed:")
        show comp.stderr
        exit(1)
    }
    show green("  compiled") + " {path} → {obj}  " + dim("(freestanding; C at {cfile})")

    -- `nm -u` lists exactly the undefined symbols. It is not on every machine,
    -- so its absence is a missing note, not a failed build.
    mut nm = null
    for candidate in ["nm", "llvm-nm"] {
        if len(trim(exec(candidate + " --version 2>/dev/null | head -1"))) > 0 { nm = candidate; break }
    }
    if nm == null {
        show dim("  (install nm to see which C library symbols this object still needs)")
        return
    }
    let listing = exec(nm + " -u " + _quote(obj) + " 2>/dev/null")
    mut syms = []
    for line in split(listing, "\n") {
        mut t = trim(line)
        -- Mach-O nm prints a leading underscore on every C symbol; ELF does not.
        if starts(t, "U ") { t = trim(substring(t, 2, len(t))) }
        if starts(t, "_") and contains(exec("uname"), "Darwin") { t = substring(t, 1, len(t)) }
        if len(t) > 0 and not contains(syms, t) { push(syms, t) }
    }
    if len(syms) == 0 { return }
    show ""
    show "  needs " + str(len(syms)) + " symbol(s) from the target's C library:"
    show "    " + join(sort(syms), " ")
}

fn check_file(path, type_check) {
    if not exists(path) {
        show red("  >> File not found: {path}")
        exit(1)
    }

    let source = read(path)

    try {
        let tokens = tokenize(source, path)
        let tree = parse(tokens, source)
        let stmt_count = len(tree.body)
        show green("  OK") + " — {path} ({stmt_count} statements)"

        if type_check {
            let checker = TypeChecker()
            let diagnostics = checker.check(tree)
            if len(diagnostics) > 0 {
                mut errors = 0
                mut warnings = 0
                for d in diagnostics {
                    let color = if d["severity"] == "error" { red(upper(d["severity"])) } else { yellow(upper(d["severity"])) }
                    mut loc = ""
                    if d["line"] != null { loc = ":" + str(d["line"]) }
                    show "  " + color + " " + path + loc + ": " + d["message"]
                    if d["severity"] == "error" { errors += 1 } else { warnings += 1 }
                }
                show ""
                show "  " + str(errors) + " error(s), " + str(warnings) + " warning(s)"
                if errors > 0 { exit(1) }
            } else {
                show green("  OK") + " — No type errors"
            }
        }
    } catch e {
        show red("  ERROR") + "\n" + red(format_error(e, source, path))
        exit(1)
    }
}

-- ── Token display ───────────────────────────────────────

fn show_tokens(path) {
    if not exists(path) {
        show red("  >> File not found: {path}")
        exit(1)
    }

    let source = read(path)

    try {
        let tokens = tokenize(source, path)
        show bold(cyan("  Tokens for {path}:"))
        show ""
        mut i = 0
        while i < len(tokens) {
            let tok = tokens[i]
            show "  " + dim(str(i)) + "  " + cyan(tok.type) + "  " + str(tok.value) + "  " + dim("L{tok.line}:{tok.column}")
            i += 1
        }
        show ""
        show dim("  {len(tokens)} tokens total")
    } catch e {
        show red("  Lexer error: {e}")
        exit(1)
    }
}

-- ── AST display ─────────────────────────────────────────

fn show_ast(path) {
    if not exists(path) {
        show red("  >> File not found: {path}")
        exit(1)
    }

    let source = read(path)

    try {
        let tokens = tokenize(source, path)
        let tree = parse(tokens, source)
        show bold(cyan("  AST for {path}:"))
        show ""
        print_node(tree, 0)
        show ""
        show dim("  {len(tree.body)} top-level statement(s)")
    } catch e {
        show red("  Parse error: {e}")
        exit(1)
    }
}

fn print_node(node, indent) {
    let prefix = repeat("  ", indent + 1)

    if type(node) == "list" {
        mut i = 0
        while i < len(node) {
            print_node(node[i], indent)
            i += 1
        }
        return null
    }

    if node == null { return null }
    if type(node) != "map" and type(node) != "ClarityInstance" { return null }

    mut nt = null
    try { nt = node.node_type } catch e { return null }
    if nt == null { return null }

    mut fields_str = ""
    if nt == "Identifier" {
        try { fields_str = "name=" + repr_val(node.name) } catch e {}
    } elif nt == "NumberLiteral" {
        try { fields_str = "value=" + str(node.value) } catch e {}
    } elif nt == "StringLiteral" {
        try { fields_str = "value=" + repr_val(node.value) } catch e {}
    } elif nt == "BoolLiteral" {
        try { fields_str = "value=" + str(node.value) } catch e {}
    } elif nt == "NullLiteral" {
        fields_str = ""
    } elif nt == "LetStatement" {
        try { fields_str = "name=" + repr_val(node.name) + ", mutable=" + str(node.mutable) } catch e {}
    } elif nt == "FnStatement" {
        try { fields_str = "name=" + repr_val(node.name) } catch e {}
    } elif nt == "AssignStatement" {
        try { fields_str = "operator=" + repr_val(node.operator) } catch e {}
    } elif nt == "BinaryOp" {
        try { fields_str = "operator=" + repr_val(node.operator) } catch e {}
    } elif nt == "UnaryOp" {
        try { fields_str = "operator=" + repr_val(node.operator) } catch e {}
    } elif nt == "ImportStatement" {
        try { fields_str = "path=" + repr_val(node.path) } catch e {}
    } elif nt == "ClassStatement" {
        try { fields_str = "name=" + repr_val(node.name) } catch e {}
    } elif nt == "ForStatement" {
        try { fields_str = "variable=" + repr_val(node.variable) } catch e {}
    }

    show prefix + cyan(nt) + "(" + fields_str + ")"

    try { if node.body != null { print_node(node.body, indent + 1) } } catch e {}
    try { if node.value != null and type(node.value) != "string" and type(node.value) != "number" and type(node.value) != "bool" { print_node(node.value, indent + 1) } } catch e {}
    try { if node.expression != null { print_node(node.expression, indent + 1) } } catch e {}
    try { if node.condition != null { print_node(node.condition, indent + 1) } } catch e {}
    try { if node.left != null { print_node(node.left, indent + 1) } } catch e {}
    try { if node.right != null { print_node(node.right, indent + 1) } } catch e {}
    try { if node.target != null { print_node(node.target, indent + 1) } } catch e {}
    try { if node.callee != null { print_node(node.callee, indent + 1) } } catch e {}
    try { if node.arguments != null { print_node(node.arguments, indent + 1) } } catch e {}
    try { if node.object != null { print_node(node.object, indent + 1) } } catch e {}
    try { if node.elements != null { print_node(node.elements, indent + 1) } } catch e {}
    try { if node.iterable != null { print_node(node.iterable, indent + 1) } } catch e {}
    try { if node.operand != null { print_node(node.operand, indent + 1) } } catch e {}
    try { if node.values != null and type(node.values) == "list" { print_node(node.values, indent + 1) } } catch e {}
    try { if node.statements != null { print_node(node.statements, indent + 1) } } catch e {}
    try { if node.try_body != null { print_node(node.try_body, indent + 1) } } catch e {}
    try { if node.catch_body != null { print_node(node.catch_body, indent + 1) } } catch e {}
    try { if node.else_body != null { print_node(node.else_body, indent + 1) } } catch e {}
    try { if node.methods != null { print_node(node.methods, indent + 1) } } catch e {}
}

fn repr_val(v) {
    if v == null { return "null" }
    if type(v) == "string" { return "\"" + v + "\"" }
    return str(v)
}

-- ── Shell / REPL delegation ─────────────────────────────

fn start_shell() {
    repl_start()
}

fn start_repl() {
    start_shell()
}

-- ── Package management ──────────────────────────────────

fn do_init_package() {
    if exists("clarity.toml") {
        show "  clarity.toml already exists"
        return null
    }
    let toml = "[package]\nname = \"my-project\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    write("clarity.toml", toml)
    show "  Created clarity.toml"
}

fn do_install_packages(cli_args) {
    if not exists("clarity.toml") {
        show "  No clarity.toml found. Run 'clarity init' first."
        return null
    }

    from "package.clarity" import install_packages, add_package

    -- Check if a specific package was named: clarity install <pkg> [version]
    if len(cli_args) >= 2 and not starts(cli_args[1], "--") {
        let pkg_name = cli_args[1]
        mut spec = "*"
        if len(cli_args) >= 3 and not starts(cli_args[2], "--") {
            spec = cli_args[2]
        }
        add_package(pkg_name, spec)
        return null
    }

    install_packages()
}

fn do_publish() {
    if not exists("clarity.toml") {
        show "  No clarity.toml found. Run 'clarity init' first."
        return null
    }
    from "package.clarity" import publish_package
    publish_package()
}

fn do_search(cli_args) {
    if len(cli_args) < 2 {
        show red("Usage: clarity search <query>")
        exit(1)
    }
    let query = cli_args[1]
    from "package.clarity" import search_packages
    let results = search_packages(query)
    if len(results) == 0 {
        show "  No packages found for '{query}'"
        return null
    }
    show ""
    show "  Search results for '{query}':"
    show ""
    for pkg in results {
        let name = if has(pkg, "name") { pkg["name"] } else { "?" }
        let desc = if has(pkg, "description") { pkg["description"] } else { "" }
        let latest = if has(pkg, "latest") { pkg["latest"] } else { "" }
        show "  " + bold(green(name)) + " " + dim("v" + latest)
        if len(desc) > 0 {
            show "    " + desc
        }
    }
    show ""
    show "  " + str(len(results)) + " package(s) found"
}

fn do_info(cli_args) {
    if len(cli_args) < 2 {
        show red("Usage: clarity info <package-name>")
        exit(1)
    }
    let name = cli_args[1]
    from "package.clarity" import show_package_info
    let info = show_package_info(name)
    if info == null {
        return null
    }
    show ""
    show "  " + bold(green(name))
    if has(info, "description") and len(info["description"]) > 0 {
        show "  " + info["description"]
    }
    if has(info, "latest") {
        show "  Latest: " + info["latest"]
    }
    if has(info, "versions") {
        let vers = keys(info["versions"])
        show "  Versions: " + join(vers, ", ")
    }
    show ""
}

-- ── App subcommands ─────────────────────────────────────

fn _print_app_usage() {
    show "Usage: clarity app <subcommand> [args]"
    show ""
    show "Subcommands:"
    show "  new <dir>             Scaffold a new app project"
    show "                          --template <basic|gui>"
    show "                          --author <name> --description <text>"
    show "  list                  List installed apps"
    show "  install <name>        Install an app from the registry"
    show "  remove <name>         Uninstall an app"
    show "  info <name>           Show registry metadata for an app"
    show "  search <query>        Search the app catalogue"
}

fn _arg_value(cli_args, flag) {
    mut i = 0
    while i < len(cli_args) {
        if cli_args[i] == flag and i + 1 < len(cli_args) {
            return cli_args[i + 1]
        }
        i += 1
    }
    return null
}

fn do_app(cli_args) {
    if len(cli_args) < 2 {
        _print_app_usage()
        return null
    }
    let sub = cli_args[1]

    if sub == "new" {
        if len(cli_args) < 3 {
            show red("Usage: clarity app new <dir> [--template basic|gui]")
            exit(1)
        }
        let dest = cli_args[2]
        mut opts = {}
        let tpl = _arg_value(cli_args, "--template")
        if tpl != null { opts["template"] = tpl }
        let author = _arg_value(cli_args, "--author")
        if author != null { opts["author"] = author }
        let descr = _arg_value(cli_args, "--description")
        if descr != null { opts["description"] = descr }
        let name = _arg_value(cli_args, "--name")
        if name != null { opts["name"] = name }
        let result = scaffold_app(dest, opts)
        show ""
        show "  Created " + bold(green(result["name"])) + " (" + result["template"] + " template) at " + dest
        for f in result["created"] {
            show "    " + dim("•") + " " + f
        }
        show ""
        show "  Next: " + cyan("cd " + dest + " && clarity run main.clarity")
        return null
    }

    if sub == "list" {
        let store = app_store()
        let installed = store.installed()
        if len(installed) == 0 {
            show "  No apps installed."
            return null
        }
        show ""
        for record in installed {
            show "  " + bold(green(record["name"])) + " " + dim("v" + record["version"]) + "  " + dim(record["dir"])
        }
        show ""
        return null
    }

    if sub == "install" {
        if len(cli_args) < 3 {
            show red("Usage: clarity app install <name>")
            exit(1)
        }
        let name = cli_args[2]
        let store = app_store()
        try {
            let entry = store.install(name)
            show "  " + green("installed") + " " + entry.name + " v" + entry.version
        } catch e {
            show red("  install failed: " + str(e))
            exit(1)
        }
        return null
    }

    if sub == "remove" {
        if len(cli_args) < 3 {
            show red("Usage: clarity app remove <name>")
            exit(1)
        }
        let name = cli_args[2]
        let store = app_store()
        if store.remove(name) {
            show "  " + green("removed") + " " + name
        } else {
            show "  " + yellow(name) + " not installed"
        }
        return null
    }

    if sub == "info" {
        if len(cli_args) < 3 {
            show red("Usage: clarity app info <name>")
            exit(1)
        }
        let store = app_store()
        let info = store.info(cli_args[2])
        if info == null {
            show "  Not found in registry."
            return null
        }
        show ""
        show "  " + bold(green(info.name)) + " " + dim("v" + info.version)
        if len(info.description) > 0 { show "  " + info.description }
        if len(info.author) > 0 { show "  Author: " + info.author }
        if len(info.categories) > 0 { show "  Categories: " + join(info.categories, ", ") }
        if info.rating > 0 { show "  Rating: " + str(info.rating) }
        show ""
        return null
    }

    if sub == "search" {
        if len(cli_args) < 3 {
            show red("Usage: clarity app search <query>")
            exit(1)
        }
        let store = app_store()
        let results = store.search(cli_args[2])
        if len(results) == 0 {
            show "  No apps found."
            return null
        }
        show ""
        for entry in results {
            show "  " + bold(green(entry.name)) + " " + dim("v" + entry.version)
            if len(entry.description) > 0 { show "    " + entry.description }
        }
        show ""
        return null
    }

    show red("Unknown app subcommand: " + sub)
    _print_app_usage()
    exit(1)
}

-- ── OS subcommands ──────────────────────────────────────
--
-- `clarity os build` produces the image the boot gate boots, and `clarity
-- os run` boots it with the gate's QEMU flags. Two architectures:
--
--   x86_64   zig build          kernel/zig-out/bin/clarity-kernel
--            grub-mkrescue      dist/claritos.iso          (GRUB + xorriso)
--   aarch64  zig build aarch64  kernel/zig-out/bin/clarity-kernel-aarch64.img
--            copy               dist/claritos-aarch64.img  (nothing else)
--
-- The default is the host's own architecture, so an Apple Silicon Mac
-- builds and boots the aarch64 image, which needs no GRUB at all. Both
-- kernels carry their userspace inside the image; there is no separate
-- runtime to build.

let _OS_KERNEL_DIR = "kernel"
let _OS_X86_KERNEL = "kernel/zig-out/bin/clarity-kernel"
let _OS_ARM_IMAGE = "kernel/zig-out/bin/clarity-kernel-aarch64.img"
let _OS_ISO_PATH = "dist/claritos.iso"
let _OS_ARM_PATH = "dist/claritos-aarch64.img"
-- The markers the boot gate asserts last: on x86_64 the kernel printing
-- that both user processes ran and it outlived them; on aarch64 that a
-- compiled Clarity program ran at EL0, which is the point of the exercise.
let _OS_X86_MARKER = "KyanOS: userspace complete."
let _OS_ARM_MARKER = "[ok] demo: a Clarity program ran on aarch64"

fn _print_os_usage() {
    show "Usage: clarity os <subcommand> [--arch x86_64|aarch64] [args]"
    show ""
    show "Subcommands:"
    show "  build              Build the kernel and its boot image:"
    show "                       x86_64  " + _OS_ISO_PATH + " (GRUB rescue ISO)"
    show "                       aarch64 " + _OS_ARM_PATH + " (ARM64 Image)"
    show "  iso                Alias for `build`"
    show "  run                Boot the image under QEMU, serial console in this terminal"
    show "                       --window           show the framebuffer too (aarch64: ramfb + keyboard)"
    show "                       --idle <seconds>   aarch64: kernel command line clarity.idle"
    show "                       --boot-test [<s>]  headless; expect <s> on serial, else exit 1"
    show "                                          (default: the marker the CI gate asserts)"
    show "                       --timeout <n>      boot-test timeout in seconds (default 120)"
    show "                       --no-rebuild       fail if the image is missing instead of building"
    show "  install            Write the ISO to a USB stick (not yet implemented)"
    show "  help               Show this message"
    show ""
    show "--arch defaults to this machine's architecture. Needs zig 0.13 and"
    show "qemu-system-x86_64 or qemu-system-aarch64; the x86_64 ISO also needs"
    show "grub-mkrescue and xorriso."
}

fn _has_arg(cli_args, flag) {
    mut i = 0
    while i < len(cli_args) {
        if cli_args[i] == flag { return true }
        i += 1
    }
    return false
}

fn _tool_installed(name) {
    let r = exec_full("command -v " + name + " >/dev/null 2>&1 && echo yes || echo no")
    return trim(r.stdout) == "yes"
}

fn _zig_installed() { return _tool_installed("zig") }

fn _os_arch(cli_args) {
    let given = _arg_value(cli_args, "--arch")
    if given != null {
        if given == "x86_64" or given == "x86-64" or given == "amd64" { return "x86_64" }
        if given == "aarch64" or given == "arm64" { return "aarch64" }
        show red("  unknown --arch " + given + "; use x86_64 or aarch64")
        exit(1)
    }
    let m = trim(exec_full("uname -m").stdout)
    if m == "arm64" or m == "aarch64" { return "aarch64" }
    return "x86_64"
}

fn _os_image_path(arch) {
    if arch == "aarch64" { return _OS_ARM_PATH }
    return _OS_ISO_PATH
}

fn _zig_build(step) {
    let cmd = if len(step) > 0 { "zig build " + step } else { "zig build" }
    show "  " + dim(cmd) + " in " + _OS_KERNEL_DIR + " ..."
    let r = exec_full("cd " + _OS_KERNEL_DIR + " && " + cmd + " 2>&1")
    if r.exit_code != 0 {
        show red("  kernel build failed (exit " + str(r.exit_code) + "):")
        show r.stdout
        exit(1)
    }
}

fn os_cmd_build(cli_args) {
    from "os_build.clarity" import os_image_builder, aarch64_image, iso_packer, iso_packer_hint

    let arch = _os_arch(cli_args)
    if not _zig_installed() {
        show red("  zig not on PATH. Install Zig 0.13 (https://ziglang.org/download/) and retry.")
        exit(1)
    }
    if arch == "x86_64" and iso_packer() == null {
        show red("  grub-mkrescue and xorriso are needed to write the x86_64 ISO.")
        show "  " + iso_packer_hint()
        exit(1)
    }

    show ""
    show bold("  Building KyanOS (" + arch + ")")
    show ""

    mut out = ""
    if arch == "aarch64" {
        _zig_build("aarch64")
        out = aarch64_image(_OS_ARM_IMAGE, _OS_ARM_PATH)
    } else {
        _zig_build("")
        show "  " + dim("grub-mkrescue") + " ..."
        let b = os_image_builder({"output": _OS_ISO_PATH, "volume_id": "KYANOS"})
        b.set_kernel(_OS_X86_KERNEL)
        out = b.build()
    }

    show ""
    show "  " + green("Built ") + out
    show "  " + dim("boot it: clarity os run --arch " + arch)
    show ""
}

-- The QEMU command line, token by token. These are the gate's flags
-- (.github/workflows/os-boot.yml) and kernel/RUNNING.md's, on purpose.
fn _os_qemu_argv(arch, image, window, idle) {
    mut argv = []
    if arch == "aarch64" {
        push(argv, "qemu-system-aarch64")
        push(argv, "-M"); push(argv, "virt,gic-version=2")
        push(argv, "-cpu"); push(argv, "cortex-a72")
        push(argv, "-m"); push(argv, "512")
        push(argv, "-kernel"); push(argv, image)
        if idle != null {
            push(argv, "-append"); push(argv, "clarity.idle=" + str(idle))
        }
        if window {
            push(argv, "-device"); push(argv, "ramfb")
            push(argv, "-device"); push(argv, "virtio-keyboard-device")
            push(argv, "-display"); push(argv, "default")
        } else {
            push(argv, "-display"); push(argv, "none")
        }
    } else {
        push(argv, "qemu-system-x86_64")
        push(argv, "-cpu"); push(argv, "qemu64,+sse,+sse2")
        push(argv, "-m"); push(argv, "512")
        push(argv, "-cdrom"); push(argv, image)
        push(argv, "-boot"); push(argv, "d")
        if not window {
            push(argv, "-display"); push(argv, "none")
        }
    }
    push(argv, "-serial"); push(argv, "stdio")
    push(argv, "-no-reboot")
    return argv
}

fn _os_shell_command(argv) {
    mut parts = []
    for tok in argv { push(parts, _quote(tok)) }
    return join(parts, " ")
}

-- A boot test runs QEMU in the background, watches its serial log, and
-- stops QEMU the moment the marker appears or the time runs out. Waiting
-- for QEMU to exit would mean waiting the whole timeout every time: the
-- kernel halts in a wfi loop when it is done and QEMU stays up. The loop
-- is plain sh so it needs no `timeout`, which macOS does not ship.
fn _os_boot_test_script(cmd, log, marker, timeout_s) {
    mut lines = []
    push(lines, "#!/bin/sh")
    push(lines, "rm -f " + _quote(log))
    push(lines, cmd + " > " + _quote(log) + " 2>&1 &")
    push(lines, "w=$!")
    push(lines, "n=0")
    push(lines, "while kill -0 $w 2>/dev/null; do")
    push(lines, "  if grep -qF -- " + _quote(marker) + " " + _quote(log) + " 2>/dev/null; then kill $w; wait $w 2>/dev/null; exit 0; fi")
    push(lines, "  n=$((n + 1))")
    push(lines, "  if [ $n -ge " + str(timeout_s) + " ]; then kill $w; wait $w 2>/dev/null; exit 124; fi")
    push(lines, "  sleep 1")
    push(lines, "done")
    push(lines, "wait $w")
    return join(lines, "\n") + "\n"
}

fn os_cmd_run(cli_args) {
    let arch = _os_arch(cli_args)
    let image = _os_image_path(arch)
    let no_rebuild = _has_arg(cli_args, "--no-rebuild")
    let window = _has_arg(cli_args, "--window")
    let idle_given = _arg_value(cli_args, "--idle")
    let timeout_s = _arg_value(cli_args, "--timeout") ?? "120"

    -- --boot-test alone means the gate's marker for this architecture.
    mut marker = null
    if _has_arg(cli_args, "--boot-test") {
        let given = _arg_value(cli_args, "--boot-test")
        if given != null and not starts(given, "--") {
            marker = given
        } else {
            marker = if arch == "aarch64" { _OS_ARM_MARKER } else { _OS_X86_MARKER }
        }
    }

    if not exists(image) {
        if no_rebuild {
            show red("  no image at " + image + " (--no-rebuild set; not building).")
            exit(1)
        }
        show "  " + dim("no image at " + image + ", building first") + " ..."
        os_cmd_build(cli_args)
    }

    let qemu_bin = if arch == "aarch64" { "qemu-system-aarch64" } else { "qemu-system-x86_64" }
    if not _tool_installed(qemu_bin) {
        show red("  " + qemu_bin + " not on PATH. macOS: brew install qemu. Debian/Ubuntu: apt install " + (if arch == "aarch64" { "qemu-system-arm" } else { "qemu-system-x86" }))
        exit(1)
    }

    -- A boot test wants the kernel to give up waiting for input quickly;
    -- a person at the console gets the kernel's own default.
    mut idle = idle_given
    if idle == null and marker != null and arch == "aarch64" { idle = "3" }
    let argv = _os_qemu_argv(arch, image, window and marker == null, idle)
    let cmd = _os_shell_command(argv)

    if marker != null {
        let log = "dist/boot-test.log"
        let script = "dist/boot-test.sh"
        show ""
        show bold("  Boot test (" + arch + "): ") + "expecting " + cyan(marker) + " on serial within " + timeout_s + " s"
        show "  " + dim(cmd)
        show ""
        write(script, _os_boot_test_script(cmd, log, marker, int(timeout_s)))
        let r = exec_full("sh " + _quote(script) + " 2>&1")
        let serial = if exists(log) { read(log) } else { "" }
        show serial
        if len(trim(r.stdout)) > 0 { show r.stdout }
        show ""
        if contains(serial, marker) {
            show "  " + green("PASS ") + "saw " + marker
        } else {
            show "  " + red("FAIL ") + "never saw " + marker + " within " + timeout_s + " s (log: " + log + ")"
            exit(1)
        }
        return null
    }

    show ""
    show bold("  Booting KyanOS (" + arch + ")") + dim("   serial console below; Ctrl-A then X quits QEMU")
    show "  " + dim(cmd)
    show ""
    let code = exec_tty(cmd)
    if code != 0 {
        show yellow("  qemu exited with status " + str(code))
        exit(code)
    }
}

fn os_cmd_install(cli_args) {
    show ""
    show yellow("  `clarity os install` is not yet implemented.")
    show ""
    show "  Write the x86_64 ISO to a USB stick by hand:"
    show ""
    show "    " + cyan("dd if=" + _OS_ISO_PATH + " of=/dev/sdX bs=4M status=progress")
    show ""
}

fn do_os(cli_args) {
    if len(cli_args) < 2 {
        _print_os_usage()
        return null
    }
    let sub = cli_args[1]

    if sub == "help" or sub == "--help" or sub == "-h" {
        _print_os_usage()
        return null
    }
    if sub == "build" or sub == "iso" {
        os_cmd_build(cli_args)
        return null
    }
    if sub == "run" {
        os_cmd_run(cli_args)
        return null
    }
    if sub == "install" {
        os_cmd_install(cli_args)
        return null
    }

    show red("Unknown os subcommand: " + sub)
    _print_os_usage()
    exit(1)
}

-- ── LSP delegation ──────────────────────────────────────

fn start_lsp() {
    let stdlib_dir = _dirname(_abspath("lexer.clarity"))
    let lsp_path = stdlib_dir + "/lsp.clarity"
    if exists(lsp_path) {
        from "lsp.clarity" import start_server
        start_server()
    } else {
        show yellow("  >> lsp.clarity not found")
    }
}

-- ── Main entry point ────────────────────────────────────

fn main() {
    let cli_args = args()

    if len(cli_args) == 0 {
        start_shell()
        return null
    }

    let command = cli_args[0]

    -- Help
    if command == "help" or command == "--help" or command == "-h" {
        _banner()
        _help()
        return null
    }

    -- Version
    if command == "version" or command == "--version" or command == "-v" {
        show "Clarity v{VERSION}"
        return null
    }

    -- Run
    if command == "run" {
        if len(cli_args) < 2 {
            show red("Usage: clarity run <file.clarity> [--fast]")
            exit(1)
        }
        let fast_mode = contains(cli_args, "--fast")
        let file_arg = cli_args[1]
        mut program_args = []
        mut ai = 2
        while ai < len(cli_args) {
            if cli_args[ai] != "--fast" { push(program_args, cli_args[ai]) }
            ai += 1
        }
        if fast_mode {
            run_file_fast(file_arg, program_args)
        } else {
            run_file(file_arg, program_args)
        }
        return null
    }

    -- Shell
    if command == "shell" {
        start_shell()
        return null
    }

    -- REPL
    if command == "repl" {
        start_repl()
        return null
    }

    -- Check
    if command == "check" {
        if len(cli_args) < 2 {
            show red("Usage: clarity check <file.clarity> [--types]")
            exit(1)
        }
        let type_check = contains(cli_args, "--types")
        check_file(cli_args[1], type_check)
        return null
    }

    -- Tokens
    if command == "tokens" {
        if len(cli_args) < 2 {
            show red("Usage: clarity tokens <file.clarity>")
            exit(1)
        }
        show_tokens(cli_args[1])
        return null
    }

    -- AST
    if command == "ast" {
        if len(cli_args) < 2 {
            show red("Usage: clarity ast <file.clarity>")
            exit(1)
        }
        show_ast(cli_args[1])
        return null
    }

    -- Init
    if command == "init" {
        do_init_package()
        return null
    }

    -- Install
    if command == "install" {
        do_install_packages(cli_args)
        return null
    }

    -- Publish
    if command == "publish" {
        do_publish()
        return null
    }

    -- Search
    if command == "search" {
        do_search(cli_args)
        return null
    }

    -- Info
    if command == "info" {
        do_info(cli_args)
        return null
    }

    -- Transpile
    if command == "transpile" {
        do_transpile(cli_args)
        return null
    }

    -- Build
    if command == "build" {
        build(cli_args)
        return null
    }

    -- Native compile: Clarity → C → a real native binary (no runtime).
    if command == "cc" {
        cc_file(cli_args)
        return null
    }

    -- App subcommands (Phase 64)
    if command == "app" {
        do_app(cli_args)
        return null
    }

    -- OS subcommands (clarity os build / run / iso / install)
    if command == "os" {
        do_os(cli_args)
        return null
    }

    -- Launch the KyanOS desktop in a real OS window (SDL2 host)
    if command == "desktop" {
        from "kyan_desktop.clarity" import kyan_desktop
        from "theme_kyan.clarity" import kyan_obsidian
        from "host.clarity" import host_run, host_supported
        if not host_supported() {
            show "KyanOS desktop needs an SDL2 windowing host, unavailable on this platform."
            return null
        }
        let d = kyan_desktop(1280, 800, kyan_obsidian())
        d.boot(null)
        d.open("prism", 150, 96, 700, 470)
        show "Launching KyanOS — close the window to exit."
        host_run(d, {"title": "KyanOS"})
        return null
    }

    -- Smoke test
    if command == "smoke" {
        from "test_smoke.clarity" import run_smoke_tests
        run_smoke_tests()
        return null
    }

    -- Install self
    if command == "install-self" {
        install_self(cli_args)
        return null
    }

    -- LSP
    if command == "lsp" {
        start_lsp()
        return null
    }

    -- Lint (full 7-rule linter)
    if command == "lint" {
        do_lint(cli_args)
        return null
    }

    -- Debug (self-hosted)
    if command == "debug" {
        if len(cli_args) < 2 {
            show red("Usage: clarity debug <file.clarity>")
            exit(1)
        }
        debug_file(cli_args[1])
        return null
    }

    -- Profile (self-hosted)
    if command == "profile" {
        if len(cli_args) < 2 {
            show red("Usage: clarity profile <file.clarity>")
            exit(1)
        }
        profile_file(cli_args[1])
        return null
    }

    -- Doc (self-hosted)
    if command == "doc" {
        do_doc(cli_args)
        return null
    }

    -- Format (self-hosted)
    if command == "fmt" {
        do_fmt(cli_args)
        return null
    }

    -- Test
    if command == "test" {
        do_test(cli_args)
        return null
    }

    -- Bench
    if command == "bench" {
        -- _find_stdlib_dir, not _dirname(_abspath("lexer.clarity")): the
        -- latter resolves against the working directory, so `clarity bench`
        -- only found the file when run from inside stdlib/ and reported it as
        -- missing everywhere else. The same helper every other command uses
        -- also looks in ./stdlib and ../stdlib.
        let stdlib_dir = _find_stdlib_dir()
        let bench_path = if stdlib_dir == null { null } else { stdlib_dir + "/benchmark.clarity" }
        if bench_path != null and exists(bench_path) {
            run_file(bench_path, [])
        } else {
            show red("  >> cannot find benchmark.clarity (looked next to the working directory, ./stdlib and ../stdlib)")
            exit(1)
        }
        return null
    }

    -- If the argument looks like a .clarity file, run it directly
    if exists(command) and ends(command, ".clarity") {
        run_file(command, [])
        return null
    }

    -- Unknown command
    show red("Unknown command: {command}")
    show dim("Run 'clarity help' for usage.")
    exit(1)
}

-- ── Lint command (full 7-rule linter) ──────────────────

fn do_lint(cli_args) {
    mut paths = []
    mut i = 1
    while i < len(cli_args) {
        let arg = cli_args[i]
        if not starts(arg, "--") { push(paths, arg) }
        i += 1
    }

    if len(paths) == 0 {
        show "Usage: clarity lint <file|dir>"
        exit(1)
    }

    let files = _collect_clarity_files(paths)
    mut total_issues = 0

    for filepath in files {
        try {
            let source = read(filepath)
            let diagnostics = lint_source(source, filepath)

            if len(diagnostics) > 0 {
                for d in diagnostics {
                    mut color = yellow(upper(d["severity"]))
                    if d["severity"] == "info" { color = cyan(upper(d["severity"])) }
                    elif d["severity"] == "error" { color = red(upper(d["severity"])) }
                    mut code_str = ""
                    if d["code"] != null { code_str = " [" + d["code"] + "]" }
                    mut loc = ""
                    if d["line"] != null { loc = ":" + str(d["line"]) }
                    show "  " + color + code_str + " " + filepath + loc + ": " + d["message"]
                }
                total_issues += len(diagnostics)
            } else {
                show green("  OK") + "  " + filepath
            }
        } catch e {
            show red("  ERROR") + " " + filepath + ": " + str(e)
            total_issues += 1
        }
    }

    show ""
    show "  " + str(len(files)) + " file(s) checked, " + str(total_issues) + " issue(s) found"

    if total_issues > 0 { exit(1) }
}

-- ── Format command (full AST formatter) ─────────────────

-- One file in, its formatted source out, nothing else on stdout. An editor
-- reads this and replaces the buffer with it, so anything else printed here
-- would end up in the user's file, and a file that could not be formatted
-- must produce no output at all and a non-zero exit, leaving the buffer
-- alone.
-- Complain on stderr. `show` writes to stdout, which in --stdout mode is the
-- file the editor is about to write back, so a message printed there would
-- be pasted into the user's source.
fn _eprint(msg) {
    exec("printf '%s\\n' " + _quote(msg) + " 1>&2")
}

fn _fmt_to_stdout(paths) {
    -- Nothing here may reach stdout but the formatted source itself.
    if len(paths) != 1 {
        _eprint("clarity fmt --stdout takes exactly one file")
        exit(1)
    }
    let filepath = paths[0]
    if not exists(filepath) {
        _eprint("clarity fmt --stdout: no such file: " + filepath)
        exit(1)
    }
    if not ends(filepath, ".clarity") {
        _eprint("clarity fmt --stdout: not a Clarity file: " + filepath)
        exit(1)
    }
    mut formatted = null
    try {
        formatted = format_source(read(filepath), filepath)
    } catch e {
        -- The editor asks for this on a file the user is still typing, so a
        -- file that does not parse is the common case, not an exceptional
        -- one: say why on stderr, write nothing, and exit non-zero, which
        -- leaves the buffer untouched.
        _eprint("clarity fmt --stdout: " + filepath + ": " + str(e))
        exit(1)
    }
    -- show adds a newline of its own and the formatted source already ends
    -- with one, so the last one is dropped: an editor that wrote back what
    -- it read would otherwise grow a blank line at every format.
    if ends(formatted, "\n") {
        show substring(formatted, 0, len(formatted) - 1)
    } else {
        show formatted
    }
}

fn do_fmt(cli_args) {
    let check_only = contains(cli_args, "--check")
    let write_mode = contains(cli_args, "--write")
    -- --stdout writes the formatted source and nothing else, which is what
    -- an editor needs: it replaces the buffer with what it reads back. The
    -- default mode prints the source only when formatting changed it, so an
    -- editor asking for a file that was already formatted read an empty
    -- string and emptied the file.
    let to_stdout = contains(cli_args, "--stdout")

    mut paths = []
    mut i = 1
    while i < len(cli_args) {
        let arg = cli_args[i]
        if not starts(arg, "--") { push(paths, arg) }
        i += 1
    }

    if len(paths) == 0 {
        show "Usage: clarity fmt <file|dir> [--check] [--write] [--stdout]"
        exit(1)
    }

    if to_stdout {
        _fmt_to_stdout(paths)
        return null
    }

    let files = _collect_clarity_files(paths)
    mut changed_count = 0
    -- A file the formatter refuses is a failure, and used to be printed and
    -- then forgotten: `fmt --check` said "all files formatted correctly"
    -- with an ERROR line above it, and exited 0.
    mut error_count = 0

    for filepath in files {
        try {
            let original = read(filepath)
            let formatted = format_source(original, filepath)
            let changed = formatted != original

            if changed {
                changed_count += 1
                if check_only {
                    show "  UNFORMATTED  " + filepath
                } elif write_mode {
                    write(filepath, formatted)
                    show "  FORMATTED    " + filepath
                } else {
                    show formatted
                }
            } else {
                if check_only or write_mode {
                    show green("  OK") + "           " + filepath
                }
            }
        } catch e {
            error_count += 1
            show red("  ERROR") + "        " + filepath + ": " + str(e)
        }
    }

    if error_count > 0 {
        show ""
        show red("  " + str(error_count) + " file(s) could not be formatted")
        exit(1)
    }

    if check_only {
        if changed_count > 0 {
            show ""
            show "  " + str(changed_count) + " file(s) need formatting"
            exit(1)
        } else {
            show ""
            show "  All " + str(len(files)) + " file(s) formatted correctly"
        }
    } elif write_mode {
        show ""
        show green("  " + str(len(files)) + " file(s) processed")
    }
}

-- ── Doc command (self-hosted docgen) ────────────────────

fn do_doc(cli_args) {
    if len(cli_args) < 2 {
        show red("Usage: clarity doc <file|dir> [--md|--json] [-o output]")
        exit(1)
    }

    let target = cli_args[1]

    -- Determine format
    mut fmt = "terminal"
    if contains(cli_args, "--md") { fmt = "markdown" }
    elif contains(cli_args, "--json") { fmt = "json" }

    -- Output path
    mut output_path = null
    mut i = 0
    while i < len(cli_args) {
        if cli_args[i] == "-o" and i + 1 < len(cli_args) {
            output_path = cli_args[i + 1]
        }
        i += 1
    }

    if _is_dir(target) {
        -- Generate docs for all .clarity files in directory
        let files = _collect_clarity_files([target])
        mut all_output = []
        for filepath in files {
            try {
                let source = read(filepath)
                let result = generate_docs(source, filepath, fmt)
                push(all_output, result)
            } catch e {
                show red("  ERROR") + " " + filepath + ": " + str(e)
            }
        }
        let combined = join(all_output, "\n")
        if output_path != null {
            write(output_path, combined)
            show green("  Documentation written to " + output_path)
        } else {
            show combined
        }
    } else {
        if not exists(target) {
            show red("  >> File not found: " + target)
            exit(1)
        }
        let source = read(target)
        let result = generate_docs(source, target, fmt)
        if output_path != null {
            write(output_path, result)
            show green("  Documentation written to " + output_path)
        } else {
            show result
        }
    }
}

-- ── Test command ────────────────────────────────────────

fn do_test(cli_args) {
    let verbose = contains(cli_args, "--verbose") or contains(cli_args, "-v")

    mut paths = []
    mut i = 1
    while i < len(cli_args) {
        let arg = cli_args[i]
        if not starts(arg, "--") and not starts(arg, "-v") {
            push(paths, arg)
        }
        i += 1
    }

    if len(paths) == 0 {
        paths = ["stdlib"]
    }

    -- Collect test files
    mut test_files = []
    for p in paths {
        if exists(p) and ends(p, ".clarity") {
            push(test_files, p)
        } else {
            let find_result = exec_full("find " + _quote(p) + " -name 'test_*.clarity' -type f 2>/dev/null | sort")
            let found = split(trim(find_result.stdout), "\n")
            for f in found {
                if len(trim(f)) > 0 {
                    push(test_files, trim(f))
                }
            }
        }
    }

    if len(test_files) == 0 {
        show "  No test files found (looking for test_*.clarity)"
        exit(1)
    }

    show ""
    show "  Running " + str(len(test_files)) + " test file(s)..."
    show ""

    mut passed = 0
    mut failed = 0

    for filepath in test_files {
        try {
            let source = read(filepath)
            let tokens = tokenize(source, filepath)
            let tree = parse(tokens, source)
            let interp = Interpreter(null, _dirname(_abspath(filepath)))
            interp.run(tree)
            passed += 1
            show green("  PASS") + "  " + filepath
        } catch e {
            failed += 1
            show red("  FAIL") + "  " + filepath
            if verbose {
                show "        " + str(e)
            }
        }
    }

    let total = passed + failed
    show ""
    show "  " + str(passed) + " passed, " + str(failed) + " failed / " + str(total) + " total"
    show ""

    if failed > 0 { exit(1) }
}

-- ── Transpile command ───────────────────────────────────

fn do_transpile(cli_args) {
    let is_bundle = contains(cli_args, "--bundle")

    -- Parse -o output path
    mut output_path = null
    mut i = 0
    while i < len(cli_args) {
        if (cli_args[i] == "-o" or cli_args[i] == "--out") and i + 1 < len(cli_args) {
            output_path = cli_args[i + 1]
        }
        i += 1
    }

    if is_bundle {
        -- Bundle mode: transpile entire stdlib
        let stdlib_dir = _resolve_stdlib_dir()
        let dist_dir = output_path ?? (replace(stdlib_dir, "stdlib", "native") + "/dist")
        transpile_bundle(stdlib_dir, dist_dir)
        return null
    }

    -- Single file mode
    mut file_path = null
    i = 1
    while i < len(cli_args) {
        let arg = cli_args[i]
        if not starts(arg, "-") {
            file_path = arg
            break
        }
        if arg == "-o" or arg == "--out" {
            i += 2
            continue
        }
        i += 1
    }

    if file_path == null {
        show red("Usage: clarity transpile <file.clarity> [-o output.js]")
        show red("       clarity transpile --bundle [-o dist_dir]")
        exit(1)
    }

    if not exists(file_path) {
        show red("  >> File not found: " + file_path)
        exit(1)
    }

    try {
        let js = transpile_with_runtime(file_path)
        let out = output_path ?? replace(file_path, ".clarity", ".js")
        write(out, js)
        show green("  Transpiled") + ": " + file_path + " -> " + out
    } catch e {
        show red("  Transpile error: " + str(e))
        exit(1)
    }
}

-- ── Run ─────────────────────────────────────────────────

main()
