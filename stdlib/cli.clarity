-- Clarity CLI — fully self-hosted command-line interface.
-- All commands implemented in Clarity. No Python dependency.

from "lexer.clarity" import tokenize
from "parser.clarity" import parse
from "interpreter.clarity" import Interpreter, interpret
from "terminal.clarity" import bold, green, cyan, red, yellow, dim
from "linter.clarity" import Linter, lint_source
from "formatter.clarity" import Formatter, format_source
-- At module level on purpose. The CI test jobs transpile this file with the
-- previous release's binary, whose transpiler learns that an imported name
-- is a class only from a top-level import; imported inside run_file_fast,
-- VM was constructed without `new` by that transpiler and every `run
-- --fast` in a release-bootstrapped build died before running anything.
from "bytecode.clarity" import compile_to_bytecode, VM, optimize
from "type_checker.clarity" import TypeChecker, check_types_source
from "docgen.clarity" import generate_docs
from "debugger.clarity" import debug_file
from "profiler.clarity" import profile_file
from "transpile.clarity" import transpile_with_runtime, transpile_bundle
from "build.clarity" import build
from "install.clarity" import install_self
from "repl.clarity" import repl_start
from "app_scaffold.clarity" import scaffold_app
from "app_store.clarity" import app_store
from "errors.clarity" import format_error
from "c_codegen.clarity" import compile_to_c, compile_to_c_freestanding
from "c_modules.clarity" import resolve_native_imports
from "path.clarity" import stem

