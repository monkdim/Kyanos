-- Resolving `import` for native compilation.
--
-- `clarity cc` emits one C translation unit, and C has no module system, so
-- an import cannot become a link-time reference — the imported code has to be
-- in the same unit. This module flattens a program and its import graph into
-- a single AST: each imported file is parsed, its own imports resolved first,
-- and its top-level declarations spliced in ahead of the importer's.
--
-- Consequences worth stating, because they are visible to anyone compiling:
--
--   * Top-level names are module-scoped. Two modules that both define
--     `fn helper` each get their own, renamed to `<module>__helper`, and
--     every reference that resolves to one follows it — see c_scope.clarity
--     for how a reference is resolved. Names unique across the whole graph
--     are left exactly as written.
--   * A module is included once however many times it is imported, and a
--     cycle terminates instead of recursing.
--   * `from "x.clarity" import a` still pulls in all of x. C has nothing
--     finer, and taking only `a` would break x's own internal references.
--   * A module's top-level statements run at startup, in dependency order —
--     the same thing importing it does in the interpreter.
--
-- `import math` (a runtime-provided module, no path) is left alone; those are
-- builtins, not files.

from "lexer.clarity" import tokenize
from "parser.clarity" import parse
from "ast_nodes.clarity" import Program
from "c_scope.clarity" import scope_modules, declared_name

-- Directory part of a path, without shelling out to dirname.
fn _dir_of(path) {
    let parts = split(path, "/")
    if len(parts) <= 1 { return "." }
    mut out = []
    mut i = 0
    while i < len(parts) - 1 { push(out, parts[i]); i += 1 }
    let joined = join(out, "/")
    if len(joined) == 0 { return "/" }
    return joined
}

fn _join_path(dir, rel) {
    if starts(rel, "/") { return rel }
    if dir == "." { return rel }
    return dir + "/" + rel
}

fn _locate(rel, base_dir, extra_dir) {
    let here = _join_path(base_dir, rel)
    if exists(here) { return here }
    if extra_dir != null {
        let there = _join_path(extra_dir, rel)
        if exists(there) { return there }
    }
    return null
}

-- Walk the import graph, collecting one record per module in dependency
-- order. Each record is
--
--   { "key": the resolved path, which is the module's identity
--     "label": what to call it in a message
--     "body": its top-level statements, imports removed
--     "imports": { name -> key of the module it came from } }
--
-- Dependencies are collected first, so a module's declarations are already
-- present by the time the importer's own code refers to them.
fn _collect(tree, base_dir, extra_dir, label, key, seen, mods) {
    mut imports = {}

    for stmt in tree.body {
        if stmt.node_type != "ImportStatement" { continue }
        if stmt.path == null { continue }
        let full = _locate(stmt.path, base_dir, extra_dir)
        if full == null {
            throw "native compile: cannot find module '" + stmt.path + "' imported by " + label
        }
        -- `from "p" import a, b` makes exactly a and b visible here, and they
        -- resolve to p's declarations. `import "p"` binds the module as an
        -- object instead, so it makes no unqualified name visible — nothing
        -- to record, and the module is still spliced for its side effects.
        if stmt.names != null {
            for n in stmt.names { imports[n] = full }
        }
        if has(seen, full) { continue }
        seen[full] = true
        let src = read(full)
        _collect(parse(tokenize(src, full), src), _dir_of(full), extra_dir, stmt.path, full, seen, mods)
    }

    mut body = []
    for stmt in tree.body {
        if stmt.node_type == "ImportStatement" { continue }
        push(body, stmt)
    }
    push(mods, { "key": key, "label": label, "body": body, "imports": imports })
    return null
}

-- Flatten `tree` and everything it imports into one Program.
--
-- `base_dir` is the directory of the file being compiled; `extra_dir` is an
-- optional second place to look (the stdlib), matching how the interpreter
-- resolves a bare "bits.clarity". Pass null for no fallback.
--
-- `root_path` is the path of the file `tree` was parsed from. It matters when
-- an import cycle leads back to the root: without it the root is not in the
-- visited set, so it is spliced once through the cycle and once as the root,
-- and every name it declares looks like a duplicate definition. Pass null
-- only when the tree did not come from a file.
fn resolve_native_imports(tree, base_dir, extra_dir, root_path) {
    mut seen = {}
    mut mods = []
    let root_key = root_path ?? "<main>"
    if root_path != null { seen[root_path] = true }
    _collect(tree, base_dir, extra_dir, "<main>", root_key, seen, mods)

    -- `from "p" import a` where p does not declare a: say so here, naming the
    -- module, the way `clarity run` does. Left to fall through, the reference
    -- reached the C backend as a name nothing declared, and the best it could
    -- say was that the name is not defined -- true, but it would not say the
    -- import was the reason.
    mut declares = {}
    for m in mods {
        mut names = []
        for stmt in m["body"] {
            let dn = declared_name(stmt)
            if dn != null { push(names, dn) }
        }
        declares[m["key"]] = names
    }
    for m in mods {
        for wanted in keys(m["imports"]) {
            let from_key = m["imports"][wanted]
            if not has(declares, from_key) { continue }
            if not contains(declares[from_key], wanted) {
                throw "native compile: '" + wanted + "' not found in '" + from_key +
                    "', imported by " + m["label"]
            }
        }
    }

    -- Names declared in more than one module are given module-scoped ones,
    -- and every reference that resolves to them follows. This used to be an
    -- error naming both files, which made a native build impossible for any
    -- program importing more than a handful of stdlib modules.
    scope_modules(mods)

    mut body = []
    for m in mods {
        for stmt in m["body"] { push(body, stmt) }
    }
    return Program(body)
}
