exec_full("rm -rf /tmp/_clarity_site_test")

-- ── Release pipeline (with injected fakes) ──

show "-- Phase 75: release pipeline --"

class FakeGit {
    fn init() {
        this.dirty = false
        this.branch = "main"
        this.tags = []
        this.last = "v0.9.0"
        this.commits = [
            {"sha": "abc1", "subject": "Phase 75: polish"},
            {"sha": "def2", "subject": "Phase 74: ISO + UX"},
            {"sha": "ghi3", "subject": "Phase 73: compositor"}
        ]
        this.created_tags = []
        this.pushed_tags = []
    }
    fn status() { return {"dirty": this.dirty, "branch": this.branch} }
    fn tag_exists(t) { return contains(this.tags, t) }
    fn last_tag() { return this.last }
    fn log_since(_t) { return this.commits }
    fn log_all() { return this.commits }
    fn create_tag(t, _m) { push(this.created_tags, t); push(this.tags, t); return true }
    fn push_tag(t) { push(this.pushed_tags, t); return true }
}

class FakeBuilder {
    fn init() { this.calls = 0 }
    fn build(opts) {
        this.calls = this.calls + 1
        return {
            "ok": true,
            "artefacts": [
                {"name": "kyanos-1.0.0.iso", "path": "/tmp/kyanos.iso", "size": 240000000, "size_mb": 240, "url": "https://example/iso"},
                {"name": "kyanos-1.0.0.tar.gz", "path": "/tmp/kyanos.tgz", "size": 30000000, "size_mb": 30, "url": "https://example/tgz"}
            ]
        }
    }
    fn sha256(_path) { return "abc123def456" }
}

class FakePublisher {
    fn init() { this.published = [] }
    fn publish(opts) {
        push(this.published, opts)
        return {"ok": true, "url": "https://github.com/monkdim/Clarity/releases/tag/" + opts["tag"]}
    }
}

let fake_git = FakeGit()
let fake_builder = FakeBuilder()
let fake_publisher = FakePublisher()
let fake_gate = release_gate(bp, fp_clean, mp, alp)  -- the passing gate

let rel = release({
    "version": "1.0.0",
    "git": fake_git,
    "builder": fake_builder,
    "publisher": fake_publisher,
    "gate": fake_gate
})

let ok = rel.run()
assert(ok, "release pipeline succeeded")
assert(contains(fake_git.created_tags, "v1.0.0"), "tag created")
assert(contains(fake_git.pushed_tags, "v1.0.0"), "tag pushed")
assert_eq(fake_builder.calls, 1, "builder invoked once")
assert_eq(len(fake_publisher.published), 1, "publisher invoked once")
assert(contains(rel.changelog, "Phase 75"), "changelog includes Phase 75")
assert(contains(rel.release_notes, "kyanos-1.0.0.iso"), "notes include ISO")
assert(contains(rel.release_notes, "abc123def456"), "notes include SHA256")
let summary = rel.summary()
assert(summary["ok"], "summary ok")

-- Dirty tree blocks the release
let dirty_git = FakeGit()
dirty_git.dirty = true
let rel_dirty = release({"version": "1.0.0", "git": dirty_git, "builder": fake_builder, "publisher": fake_publisher})
assert(not rel_dirty.run(), "dirty tree blocks release")

-- Failing gate blocks the release
let bad_release_gate = release_gate(bp_slow, fp_clean, mp, alp)
let rel_bad = release({"version": "1.0.1", "git": FakeGit(), "builder": fake_builder, "publisher": fake_publisher, "gate": bad_release_gate})
assert(not rel_bad.run(), "failing gate blocks release")

-- Dry run skips publish
let rel_dry = release({"version": "1.0.2", "git": FakeGit(), "builder": fake_builder, "publisher": fake_publisher, "dry_run": true})
assert(rel_dry.run(), "dry run succeeds")
mut found_skipped = false
for s in rel_dry.steps { if s["kind"] == "publish" and s["status"] == "skipped" { found_skipped = true } }
assert(found_skipped, "publish step skipped in dry-run")

-- ── Summary ────────────────────────

show ""
show "Phase 75: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " phase 75 test(s) failed" }
