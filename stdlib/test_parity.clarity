-- Interpreter versus bytecode VM: one language, two engines, one semantics.
--
-- `clarity run` walks the tree; `clarity run --fast` compiles to bytecode and
-- runs that. A program must not care which it got. The native compiler has
-- had a harness that runs every program both ways and diffs the output since
-- it existed (test_c_codegen.clarity); the VM had nothing equivalent, and the
-- audit asked for this suite by name. It is modelled on that one: `same(tag,
-- src)` runs a program through both engines and asserts the output is
-- identical, so matching the interpreter *is* the specification.
--
-- What it found on its first run is recorded at the bottom.

from "lexer.clarity" import tokenize
from "parser.clarity" import parse
from "interpreter.clarity" import Interpreter
from "bytecode.clarity" import compile_to_bytecode, VM, optimize

mut PASSED = 0
mut FAILED = 0

fn interp_run(src) {
    let i = Interpreter(null, null)
    i.run(parse(tokenize(src, "<parity>"), src))
    return join(i.output, "\n")
}

fn vm_run(src) {
    let code = compile_to_bytecode(parse(tokenize(src, "<parity>"), src))
    optimize(code)
    let vm = VM()
    vm.run(code)
    return join(vm.output, "\n")
}

-- Both engines run the program; the outputs must be identical. An engine
-- that throws where the other does not is a divergence too, so the throw is
-- caught and compared as text.
fn same(tag, src) {
    mut a = ""
    mut b = ""
    try { a = interp_run(src) } catch e { a = "THREW: " + str(e) }
    try { b = vm_run(src) } catch e { b = "THREW: " + str(e) }
    -- A case that fails in both engines, or prints nothing in either,
    -- compares equal while testing nothing at all: the first version of this
    -- suite had four such cases, written in syntax the parser does not read
    -- (`match` arms with `=>`, `try` without `catch`), and they passed. A
    -- program meant to be refused belongs in both_fail_naming, so here a
    -- throw or an empty run is a broken case, reported as a failure of the
    -- suite itself rather than a parity result.
    if starts(a, "THREW: ") {
        FAILED += 1
        show "  BROKEN CASE: " + tag + " does not run: " + a
        return null
    }
    if a == "" {
        FAILED += 1
        show "  BROKEN CASE: " + tag + " prints nothing"
        return null
    }
    if a == b {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: " + tag
        show "    interpreter: " + a
        show "    vm:          " + b
    }
}

-- Where the engines legitimately differ in wording, the shared part is what
-- matters: both must fail, and both must name the same thing.
fn both_fail_naming(tag, src, needle) {
    mut a = ""
    mut b = ""
    try { interp_run(src); a = "no throw" } catch e { a = str(e) }
    try { vm_run(src); b = "no throw" } catch e { b = str(e) }
    if contains(a, needle) and contains(b, needle) {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: " + tag + " (both should fail naming '" + needle + "')"
        show "    interpreter: " + a
        show "    vm:          " + b
    }
}

show "-- Parity: values and operators --"
same("integers", "show 1\nshow 0\nshow -3")
same("floats", "show 1.5\nshow 0.1 + 0.2\nshow 3.0")
same("integer division and modulo", "show 7 / 2\nshow 7 % 2\nshow -7 % 2")
same("exponent", "show 2 ** 10\nshow 2 ** 0.5")
same("comparison", "show 1 < 2\nshow 2 <= 2\nshow 3 > 4\nshow \"a\" < \"b\"")
same("equality across types", "show 1 == 1.0\nshow \"1\" == 1\nshow null == null\nshow [1] == [1]")
-- Collections compare by contents and instances by identity, in every
-- engine. The native compiler compared both by pointer, so these are here to
-- keep the two interpreters pinned to the answers it was made to match.
same("lists compare by contents", "show [1, 2] == [1, 2]\nshow [1, 2] == [2, 1]\nshow [1, [2, [3]]] == [1, [2, [3]]]\nshow [] == []\nshow [1, 2] != [2, 1]")
same("maps compare by contents, not insertion order", "show {\"a\": 1, \"b\": 2} == {\"b\": 2, \"a\": 1}\nshow {\"a\": 1} == {\"a\": 2}\nshow {\"a\": 1} == {\"a\": 1, \"b\": 2}\nshow {} == {}")
same("instances and closures compare by identity", "class C {\n    fn init(v) { this.v = v }\n}\nlet c = C(1)\nshow C(1) == C(1)\nshow c == c\nlet f = fn(x) { return x }\nlet g = fn(x) { return x }\nshow f == g\nshow f == f\nfn h() { return 1 }\nshow h == h")
same("boolean operators", "show true and false\nshow true or false\nshow not true")
same("truthiness", "show 0 or \"fallback\"\nshow \"\" or \"fallback\"\nshow [] or \"fallback\"")
same("null coalescing", "let a = null\nshow a ?? 5\nshow 0 ?? 5")
same("bitwise", "show 6 & 3\nshow 6 | 3\nshow 6 ^ 3\nshow 1 << 4\nshow 256 >> 4")
same("string concatenation and repeat", "show \"a\" + \"b\"\nshow repeat(\"ab\", 3)")
same("string interpolation", "let n = 3\nshow \"n is {n} and twice is {n * 2}\"")
same("escapes", "show \"a\\nb\"\nshow \"tab\\there\"\nshow \"quote\\\"inside\"")
same("interpolation of collections", "let xs = [1, 2]\nlet m = {\"a\": 1}\nshow \"xs {xs} m {m}\"")
same("interpolation of other types", "let b = true\nlet n = null\nlet f = 1.5\nshow \"{b} {n} {f}\"")
same("interpolation of a call and a property", "class C {\n    fn init() { this.v = 7 }\n}\nfn f() { return 2 }\nlet c = C()\nshow \"{c.v} and {f()}\"")
same("interpolation of an instance", "class C {\n    fn init() { this.v = 1 }\n}\nshow \"{C()}\"")
same("braces that are not interpolation", "show \"if x { 1 } else { 2 }\"\nshow \"{1}\"\nshow \"{ n }\"")
same("a raw string does not interpolate", "let n = 5\nshow r\"raw {n}\"\nshow \"cooked {n}\"")
-- Two interpolations in one string are evaluated left to right, so one that
-- has a side effect is seen by the next.
same("interpolations run left to right", "mut c = 0\nfn bump() { c += 1; return c }\nshow \"{bump()} then {bump()}\"")
same("an unclosed brace stays literal", "let n = 1\nshow \"open {n and {n}\"")

show "-- Parity: builtins both engines must have --"
-- Presence is checked statically by test_runtime_surface; this is the
-- behaviour. The two engines kept separate builtin tables, and the
-- difference was 22 public names wide: `hash`, `pad_left`, `encode64` and
-- the byte readers were builtins under `clarity run` and undefined
-- variables under `run --fast`.
same("hashing and base64", "show hash(\"abc\")\nshow encode64(\"hi\")\nshow decode64(encode64(\"hi\"))")
same("padding", "show pad_left(\"7\", 3, \"0\")\nshow pad_right(\"7\", 3, \".\")")
same("display and repr", "show display({\"a\": 1})\nshow repr(\"x\")\nshow repr(1.5)")
-- display() and repr() became reachable only when the builtin tables were
-- reconciled, and both engines had registered the *runtime's* display, which
-- does not know what an instance is: it walked instance -> class -> method
-- closures -> environment -> instance until the stack ran out, so
-- `display(Q())` for any class was a RangeError under `clarity run` and an
-- empty error body under --fast. They go through each engine's own display
-- now, which knows about instances and about to_string().
same("display of every kind of value", "show display(5)\nshow display(1.5)\nshow display(\"s\")\nshow display(true)\nshow display(null)\nshow display([1, 2])\nshow display([\"a\", \"b\"])\nshow display({\"a\": 1, \"b\": \"x\"})")
same("display of an instance", "class Q {\n    fn init() { this.n = 1 }\n}\nshow display(Q())")
same("display of an instance with to_string", "class P {\n    fn init(v) { this.v = v }\n    fn to_string() { return \"P<{this.v}>\" }\n}\nshow display(P(7))\nshow repr(P(8))")
same("repr quotes a string and nothing else", "show repr(\"s\")\nshow repr(5)\nshow repr([1, \"a\"])\nshow repr({\"k\": \"v\"})")
same("set drops duplicates", "show set([3, 1, 3, 2])")
same("compose and tap", "let f = compose(fn(x) { return x + 1 }, fn(x) { return x * 2 })\nshow f(5)\nshow tap(7, fn(v) { show \"tapped \" + str(v) })")
same("regular expressions", "show regex_match(\"[0-9]\", \"a1\")\nshow regex_find(\"[0-9]\", \"a1b2\")\nshow regex_replace(\"[0-9]\", \"a1b2\", \"#\")\nshow regex_split(\",\", \"a,b,c\")\nshow regex_search(\"z\", \"abc\")")
same("a regex match with groups", "show exec_full_regex(\"([0-9]+)-([0-9]+)\", \"range 10-20\")")
same("print is show", "print(\"printed\")\nshow \"shown\"")

show "-- Parity: collections --"
same("list literal and index", "let xs = [1, 2, 3]\nshow xs\nshow xs[0]\nshow xs[-1]")
same("list slicing", "let xs = [1, 2, 3, 4, 5]\nshow xs[1..3]\nshow xs[..2]\nshow xs[2..]")
same("list builtins", "let xs = [3, 1, 2]\nshow len(xs)\nshow sort(xs)\nshow reverse(xs)\nshow sum([1, 2, 3])")
same("map literal and access", "let m = {\"a\": 1, \"b\": 2}\nshow m[\"a\"]\nshow len(keys(m))\nshow has(m, \"b\")")
same("map iteration order", "let m = {\"z\": 1, \"a\": 2, \"m\": 3}\nfor k in keys(m) { show k }")
same("nested structures", "let d = {\"xs\": [1, [2, 3]], \"m\": {\"k\": \"v\"}}\nshow d[\"xs\"][1][0]\nshow d[\"m\"][\"k\"]")
same("map and filter", "show map([1, 2, 3], fn(x) { return x * 2 })\nshow filter([1, 2, 3, 4], fn(x) { return x % 2 == 0 })")
same("reduce", "show reduce([1, 2, 3, 4], fn(acc, x) { return acc + x }, 0)")
same("list comprehension", "show [x * x for x in [1, 2, 3]]")
same("comprehension with a condition", "show [x for x in [1, 2, 3, 4, 5] if x % 2 == 1]")

show "-- Parity: indexing and property access --"
-- Indexing something that cannot be indexed, and reading past either end of
-- a list or a string, are errors. The VM answered null for both bounds
-- cases, so a program that walked off the end kept going under --fast and
-- stopped under `clarity run`. Each case is caught and reported as a word,
-- so the engines' different error wording is not what is being compared.
same("indexing what cannot be indexed", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet z = null\nlet n = 5\nlet b = true\nt(\"null[0]\", fn() { return z[0] })\nt(\"null.f\", fn() { return z.f })\nt(\"int[0]\", fn() { return n[0] })\nt(\"int.f\", fn() { return n.f })\nt(\"bool[0]\", fn() { return b[0] })\nt(\"bool.f\", fn() { return b.f })")
same("reading past the end of a list", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet xs = [1, 2]\nt(\"[0]\", fn() { return xs[0] })\nt(\"[-1]\", fn() { return xs[-1] })\nt(\"[2]\", fn() { return xs[2] })\nt(\"[-3]\", fn() { return xs[-3] })\nt(\"[str]\", fn() { return xs[\"a\"] })")
same("reading past the end of a string", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet s = \"ab\"\nt(\"[0]\", fn() { return s[0] })\nt(\"[-1]\", fn() { return s[-1] })\nt(\"[2]\", fn() { return s[2] })\nt(\"[-3]\", fn() { return s[-3] })")
-- Indexing is the lenient way of asking and `.field` is the strict one: a
-- map answers null for a key it does not hold, an instance does not.
same("a map is lenient, an instance is not", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nclass C {\n    fn init() { this.a = 1 }\n}\nlet m = {\"a\": 1}\nlet c = C()\nt(\"map[a]\", fn() { return m[\"a\"] })\nt(\"map[b]\", fn() { return m[\"b\"] })\nt(\"map.b\", fn() { return m.b })\nt(\"map[0]\", fn() { return m[0] })\nt(\"obj.a\", fn() { return c.a })\nt(\"obj.missing\", fn() { return c.missing })\nt(\"obj[a]\", fn() { return c[\"a\"] })\nt(\"obj[0]\", fn() { return c[0] })")
-- `a?.b` is null whenever `a.b` would have failed, not only when a is null.
same("optional chaining", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nclass C {\n    fn init() { this.a = 1 }\n}\nlet z = null\nlet c = C()\nlet m = {\"a\": 1}\nt(\"null?.f\", fn() { return z?.f })\nt(\"obj?.a\", fn() { return c?.a })\nt(\"obj?.missing\", fn() { return c?.missing })\nt(\"map?.a\", fn() { return m?.a })\nt(\"map?.b\", fn() { return m?.b })\nt(\"int?.f\", fn() { return 5?.f })\nt(\"chain\", fn() { return z?.a?.b })")

show "-- Parity: control flow --"
same("if / elif / else", "let x = 5\nif x > 10 { show \"big\" } elif x > 3 { show \"mid\" } else { show \"small\" }")
same("while with break and continue", "mut i = 0\nwhile i < 10 {\n    i += 1\n    if i % 2 == 0 { continue }\n    if i > 7 { break }\n    show i\n}")
same("for over a range", "for i in range(3) { show i }")
same("for over a list", "for c in [\"a\", \"b\"] { show c }")
same("nested loops with break", "for i in range(3) {\n    for j in range(3) {\n        if j == 1 { break }\n        show \"{i}{j}\"\n    }\n}")
same("break leaves the enclosing loop running", "for i in range(3) {\n    for j in range(5) {\n        if j == 2 { break }\n    }\n    show i\n}")
same("continue in a for", "for i in range(5) {\n    if i % 2 == 0 { continue }\n    show i\n}")
same("break out of a while inside a for", "for i in range(2) {\n    mut j = 0\n    while true {\n        j += 1\n        if j > 1 { break }\n    }\n    show \"{i} {j}\"\n}")
same("if expression", "let x = 5\nshow if x > 3 { \"yes\" } else { \"no\" }")
same("match", "let v = 2\nmatch v {\n    when 1 { show \"one\" }\n    when 2 { show \"two\" }\n    else { show \"other\" }\n}")
same("match falls through to else", "match \"z\" {\n    when \"a\" { show \"a\" }\n    else { show \"other\" }\n}")
same("match on a computed value", "fn f(x) {\n    match x {\n        when 0 { return \"zero\" }\n        when 1 { return \"one\" }\n        else { return \"many\" }\n    }\n}\nshow f(0)\nshow f(1)\nshow f(9)")

show "-- Parity: functions --"
same("call and return", "fn add(a, b) { return a + b }\nshow add(2, 3)")
same("recursion", "fn fib(n) {\n    if n <= 1 { return n }\n    return fib(n - 1) + fib(n - 2)\n}\nshow fib(12)")
same("default-ish missing argument", "fn f(a, b) { return b }\nshow f(1)")
same("rest parameters", "fn count(...xs) { return len(xs) }\nshow count()\nshow count(1, 2, 3)")
same("rest after fixed", "fn tail(first, ...rest) { return rest }\nshow tail(1, 2, 3)")
same("closures capture", "fn make(n) { return fn(x) { return x + n } }\nlet add5 = make(5)\nshow add5(3)")
same("closure over a mutable variable", "mut total = 0\nlet bump = fn() { total += 1 }\nbump()\nbump()\nshow total")
same("lambda shorthand", "show map([1, 2, 3], x => x * 3)")
same("function as a value", "fn f() { return 1 }\nlet g = f\nshow g()\nshow f")
same("higher order", "fn apply(f, v) { return f(v) }\nshow apply(x => x + 1, 10)")
same("pipe operator", "fn double(x) { return x * 2 }\nshow 5 |> double")

show "-- Parity: evaluation order --"
-- Operands run left to right, and a short-circuit operator evaluates its
-- left side once. Both engines agree; the native compiler did not, which is
-- what these were written for.
same("operands run left to right", "mut log = []\nfn t(name, v) { push(log, name); return v }\nshow [t(\"a\", 1), t(\"b\", 2)]\nshow { \"x\": t(\"c\", 3), \"y\": t(\"d\", 4) }\nshow str(t(\"l\", 5)) + str(t(\"r\", 6))\nshow log")
same("a method receiver runs before the arguments", "mut log = []\nfn t(name, v) { push(log, name); return v }\nclass Box {\n    fn init(n) { this.n = n }\n    fn add(a) { return this.n + a }\n}\nshow t(\"recv\", Box(1)).add(t(\"arg\", 2))\nshow log")
same("an operand that throws stops the ones after it", "mut log = []\nfn t(name, v) { push(log, name); return v }\nfn boom() { throw \"x\" }\ntry { show [t(\"first\", 1), boom(), t(\"never\", 2)] } catch e { show \"caught\" }\nshow log")
same("or evaluates its left side once", "mut c = 0\nfn bump() { c += 1; return c }\nshow bump() or false\nshow c")
same("and evaluates its left side once", "mut c = 0\nfn zero() { c += 1; return 0 }\nshow zero() and true\nshow c")
-- And the right side does not run at all when the left has already decided.
-- The VM compiled both sides and then combined them, so `false and side()`
-- called side() — which is how collections.clarity's own
-- `if len(items) == 1 and type(items[0]) == "list"` came to read items[0] of
-- an empty list under --fast.
same("and does not run its right side", "mut ran = false\nfn side() { ran = true; return true }\nshow false and side()\nshow ran")
same("or does not run its right side", "mut ran = false\nfn side() { ran = true; return true }\nshow true or side()\nshow ran")
same("a guard protects what follows it", "fn first_is_list(items) {\n    return len(items) == 1 and type(items[0]) == \"list\"\n}\nshow first_is_list([])\nshow first_is_list([[1]])\nshow first_is_list([1])")
same("chained guards", "let m = {\"a\": 1}\nlet xs = []\nshow has(m, \"b\") and m[\"b\"] > 0\nshow len(xs) > 0 and xs[0] == 1\nshow len(xs) == 0 or xs[0] == 1")

show "-- Parity: generators --"
-- Clarity's generators are eager: a body that yields runs to the end and
-- the call returns the list of what it yielded. The VM compiled `yield` to
-- the value alone and collected nothing, so `counter(3)` was null under
-- --fast and a loop over it ran zero times.
same("a generator returns what it yielded", "fn counter(n) {\n    mut i = 0\n    while i < n {\n        yield i * 10\n        i += 1\n    }\n}\nshow counter(3)")
same("a for loop over a generator", "fn counter(n) {\n    mut i = 0\n    while i < n {\n        yield i\n        i += 1\n    }\n}\nfor v in counter(4) { show v }")
same("a generator that yields conditionally", "fn evens(n) {\n    mut i = 0\n    while i < n {\n        if i % 2 == 0 { yield i }\n        i += 1\n    }\n}\nshow evens(7)")
same("a generator over a generator", "fn evens(n) {\n    mut i = 0\n    while i < n {\n        if i % 2 == 0 { yield i }\n        i += 1\n    }\n}\nfn scaled(n) {\n    for v in evens(n) { yield v * 100 }\n}\nshow scaled(7)")
same("a function that never yields is unchanged", "fn plain() { return 5 }\nshow plain()")
-- What was collected wins over what the return statement says, and the
-- returned expression is still evaluated.
same("return inside a generator", "fn early(n) {\n    yield 1\n    if n > 0 { return \"ignored\" }\n    yield 2\n}\nshow early(1)\nshow early(0)")
same("a recursive generator", "fn down(n) {\n    if n <= 0 { return null }\n    yield n\n    for v in down(n - 1) { yield v }\n}\nshow down(3)")
same("a generator method", "class Box {\n    fn init(items) { this.items = items }\n    fn doubled() {\n        for it in this.items { yield it * 2 }\n    }\n}\nshow Box([1, 2, 3]).doubled()")
same("a closure inside a generator is not one", "fn outer(n) {\n    let triple = fn(x) { return x * 3 }\n    mut i = 0\n    while i < n {\n        yield triple(i)\n        i += 1\n    }\n}\nshow outer(4)")
same("yield is an expression", "fn g() {\n    let a = yield 7\n    show \"yielded \" + str(a)\n}\nshow g()")
same("a generator with a try", "fn risky(n) {\n    try {\n        yield 1\n        if n > 0 { throw \"boom\" }\n        yield 2\n    } catch e {\n        yield 99\n    }\n}\nshow risky(1)\nshow risky(0)")
same("map over a generator", "fn evens(n) {\n    mut i = 0\n    while i < n {\n        if i % 2 == 0 { yield i }\n        i += 1\n    }\n}\nshow map(evens(6), fn(x) { return x * 2 })")
-- A yield anywhere an expression can go, including the places a walker
-- that only knew about calls and lists would miss.
same("yield inside a map literal", "fn g(n) {\n    let d = { \"a\": yield n, \"b\": yield n + 1 }\n    show d\n}\nshow g(5)")
same("yield inside a range", "fn r(n) {\n    for v in (yield n)..(yield n + 2) { show v }\n}\nshow r(1)")

show "-- Parity: spread and destructuring --"
-- `...xs` compiled to the value alone in the VM, so it was taken whole
-- rather than opened out: `[1, ...[2, 3], 4]` was `[1, [2, 3], 4]` and
-- `f(...[1, 2, 3])` passed one list and two nulls. A spread in a *map*
-- crashed the VM's compiler outright, with a host TypeError about
-- node.node_type, so a program using it did not run at all.
same("spread into a call", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nfn three(p, q, r) { return [p, q, r] }\nlet xs = [2, 3]\nt(\"only\", fn() { return three(...[1, 2, 3]) })\nt(\"after\", fn() { return three(1, ...xs) })\nt(\"empty\", fn() { return three(1, 2, ...[]) })")
same("spread into a call with a rest parameter", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nfn rest_fn(a, ...rest) { return [a, rest] }\nlet xs = [2, 3]\nt(\"rest\", fn() { return rest_fn(1, ...xs) })\nt(\"non-list\", fn() { return rest_fn(...5) })")
same("spread into a list", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet xs = [2, 3]\nt(\"middle\", fn() { return [1, ...xs, 4] })\nt(\"only\", fn() { return [...xs] })\nt(\"empty\", fn() { return [...[], 1] })\nt(\"nested\", fn() { return [...[1, [2]], 3] })\nt(\"non-list\", fn() { return [1, ...5] })")
same("spread into a map", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet m = {\"a\": 1, \"b\": 2}\nt(\"after\", fn() { return {...m, \"c\": 3} })\nt(\"before\", fn() { return {\"a\": 9, ...m} })\nt(\"overridden\", fn() { return {...m, \"a\": 9} })\nt(\"two\", fn() { return {...m, ...{\"c\": 3}} })\nt(\"non-map\", fn() { return {...\"x\"} })")
same("destructuring a list", "let [a, b] = [1, 2]\nshow a\nshow b\nlet [f, ...r] = [1, 2, 3, 4]\nshow f\nshow r")
same("assigning two names at once", "mut x = 1\nmut y = 2\nx, y = y, x\nshow x\nshow y")

-- A name in scope is what a call means, whatever else the name refers to at
-- module level. Both engines agree; the native compiler did not.
same("a local shadows a global", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nfn helper(x) { return x * 2 }\nclass K {\n    fn init() {}\n    fn use(helper) { return helper(3) }\n}\nt(\"function parameter\", fn() {\n    let g = fn(helper) { return helper(7) }\n    return g(fn(v) { return v + 300 })\n})\nt(\"method parameter\", fn() { return K().use(fn(v) { return v + 100 }) })\nt(\"builtin\", fn() {\n    let g = fn(len) { return len(5) }\n    return g(fn(v) { return v + 1 })\n})\nt(\"a let\", fn() {\n    let helper = fn(v) { return v + 50 }\n    return helper(1)\n})\nt(\"a loop variable\", fn() {\n    mut out = []\n    for helper in [fn(v) { return v + 9 }] { push(out, helper(1)) }\n    return out\n})\nt(\"a catch binding\", fn() {\n    mut r = 0\n    try { throw fn(v) { return v + 7 } } catch helper { r = helper(1) }\n    return r\n})\nt(\"a destructured name\", fn() {\n    let [helper] = [fn(v) { return v + 11 }]\n    return helper(1)\n})\nt(\"a class name\", fn() {\n    let K = fn(v) { return v + 13 }\n    return K(1)\n})\nt(\"not callable\", fn() {\n    let helper = 5\n    return helper(1)\n})\nt(\"the global still works\", fn() { return helper(4) })")

show "-- Parity: builtin methods --"
-- A list, a string and a number have methods, and the VM had five of the
-- thirty as plain *properties* and threw for the rest: `xs.sort()`,
-- `s.split(" ")` and `s.trim()` — ordinary lines — all failed under --fast
-- while working under `clarity run`. `n.abs()` failed in both, because the
-- interpreter tested for a type named "number" and `type(5)` is "int".
same("a list's methods", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet xs = [3, 1, 2]\nt(\"length\", fn() { return xs.length() })\nt(\"first\", fn() { return xs.first() })\nt(\"last\", fn() { return xs.last() })\nt(\"reverse\", fn() { return xs.reverse() })\nt(\"sort\", fn() { return xs.sort() })\nt(\"join\", fn() { return xs.join(\"-\") })\nt(\"contains\", fn() { return xs.contains(1) })\nt(\"empty\", fn() { return xs.empty() })\nt(\"count\", fn() { return xs.count() })\nt(\"slice\", fn() { return xs.slice(1, 3) })\nt(\"index\", fn() { return xs.index(1) })\nt(\"copy\", fn() { return xs.copy() })\nt(\"unknown\", fn() { return xs.nope() })")
same("a string's methods", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet s = \"Hello World\"\nt(\"length\", fn() { return s.length() })\nt(\"upper\", fn() { return s.upper() })\nt(\"lower\", fn() { return s.lower() })\nt(\"trim\", fn() { return \"  x  \".trim() })\nt(\"split\", fn() { return s.split(\" \") })\nt(\"replace\", fn() { return s.replace(\"World\", \"there\") })\nt(\"contains\", fn() { return s.contains(\"World\") })\nt(\"starts\", fn() { return s.starts(\"Hello\") })\nt(\"ends\", fn() { return s.ends(\"World\") })\nt(\"chars\", fn() { return \"ab\".chars() })\nt(\"count\", fn() { return s.count() })\nt(\"reverse\", fn() { return \"abc\".reverse() })\nt(\"empty\", fn() { return \"\".empty() })\nt(\"slice\", fn() { return s.slice(0, 5) })\nt(\"find\", fn() { return s.find(\"World\") })\nt(\"repeat\", fn() { return \"ab\".repeat(2) })\nt(\"unknown\", fn() { return s.nope() })")
same("a number's methods", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet n = 0 - 5\nt(\"abs\", fn() { return n.abs() })\nt(\"str\", fn() { return n.str() })\nt(\"unknown\", fn() { return n.nope() })")
same("a method named but not called is bound to its receiver", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet s = \"Hello\"\nlet xs = [3, 1]\nt(\"bound string\", fn() { let f = s.upper\n    return f() })\nt(\"bound list\", fn() { let g = xs.sort\n    return g() })\nt(\"bound with an argument\", fn() { let h = s.starts\n    return h(\"He\") })\nt(\"unknown bound\", fn() { let k = s.nope\n    return k() })\nt(\"in a closure\", fn() { return map([\"a\", \"b\"], fn(c) { return c.upper() }) })")

show "-- Parity: classes --"
same("class with a method", "class C {\n    fn init() { this.x = 1 }\n    fn get() { return this.x }\n}\nshow C().get()")
same("mutation through a method", "class Counter {\n    fn init() { this.n = 0 }\n    fn bump() { this.n += 1; return this.n }\n}\nlet c = Counter()\nc.bump()\nshow c.bump()")
same("constructor arguments", "class P {\n    fn init(a, b) { this.a = a; this.b = b }\n    fn sum() { return this.a + this.b }\n}\nshow P(2, 3).sum()")
same("inheritance", "class A {\n    fn init() { this.v = 1 }\n    fn who() { return \"A\" }\n}\nclass B < A {\n    fn who() { return \"B\" }\n}\nlet b = B()\nshow b.who()\nshow b.v")
same("field access and assignment", "class Box {\n    fn init() { this.v = 0 }\n}\nlet b = Box()\nb.v = 7\nshow b.v")
same("a property set to null still reads back as null", "class C {\n    fn init() { this.x = null }\n}\nshow C().x")
same("a missing map key is null, and stays null", "let m = {\"a\": 1}\nshow m[\"b\"]\nshow m.b")

-- A class that says how it prints says so for every engine. The VM never
-- looked for a to_string method, so `show p`, `str(p)`, `"" + p` and
-- `"{p}"` were all `<P instance>` under --fast and the class's own
-- rendering under `clarity run`.
same("to_string decides how an instance shows", "class P {\n    fn init(v) { this.v = v }\n    fn to_string() { return \"P<{this.v}>\" }\n}\nshow P(1)")
same("to_string through str, concatenation and interpolation", "class P {\n    fn init(v) { this.v = v }\n    fn to_string() { return \"P<{this.v}>\" }\n}\nlet p = P(2)\nshow str(p)\nshow \"\" + p\nshow \"{p}\"")
same("to_string inside a collection", "class P {\n    fn init(v) { this.v = v }\n    fn to_string() { return \"P<{this.v}>\" }\n}\nshow [P(3), P(4)]\nshow { \"k\": P(5) }")
same("a class without to_string keeps the default", "class Q {\n    fn init() { this.n = 1 }\n}\nshow Q()\nshow [Q()]")
same("to_string is inherited", "class P {\n    fn init(v) { this.v = v }\n    fn to_string() { return \"P<{this.v}>\" }\n}\nclass U < P { }\nshow U()")
-- Displaying a value must not be able to end the program, so a to_string
-- that throws falls back to the default rendering.
same("a to_string that throws falls back", "class S {\n    fn init() {}\n    fn to_string() { throw \"nope\" }\n}\nshow S()")
same("a to_string that does not return a string", "class R {\n    fn init() {}\n    fn to_string() { return 42 }\n}\nclass T {\n    fn init() {}\n    fn to_string() { return [1, 2] }\n}\nshow R()\nshow T()")

show "-- Parity: errors --"
same("try / catch", "try { throw \"boom\" } catch e { show \"caught \" + str(e) }")
same("catch does not swallow the rest", "try { throw \"x\" } catch e { show \"a\" }\nshow \"b\"")
same("throw from a function", "fn f() { throw \"inner\" }\ntry { f() } catch e { show str(e) }")
same("try with finally", "try { show \"body\" } catch e { show \"catch\" } finally { show \"finally\" }")
same("finally runs after a throw", "try { throw \"x\" } catch e { show \"caught\" } finally { show \"cleanup\" }")
same("nested try", "try {\n    try { throw \"inner\" } catch e { throw \"rethrown\" }\n} catch e2 { show str(e2) }")
same("finally runs when the catch body throws", "try {\n    try { throw \"a\" } catch e { throw \"b\" } finally { show \"fin\" }\n} catch e2 { show \"outer \" + str(e2) }")
same("finally runs on return", "fn f() {\n    try { return \"r\" } catch e { show \"c\" } finally { show \"fin\" }\n}\nshow f()")
same("finally on a return from inside a loop", "fn f() {\n    try {\n        for i in range(3) { if i == 1 { return i } }\n    } catch e { show \"c\" } finally { show \"fin\" }\n    return -1\n}\nshow f()")
same("nested finally on a return", "fn f() {\n    try {\n        try { return \"r\" } catch e { show \"ci\" } finally { show \"inner\" }\n    } catch e2 { show \"co\" } finally { show \"outer\" }\n}\nshow f()")
same("break out of a try runs its finally", "for i in range(2) {\n    try { break } catch e { show \"c\" } finally { show \"fin\" }\n}\nshow \"after\"")
same("continue out of a try runs its finally", "for i in range(2) {\n    try { continue } catch e { show \"c\" } finally { show \"fin {i}\" }\n}\nshow \"after\"")
same("a try left by break stops catching", "for i in range(1) {\n    try { break } catch e { show \"WRONG\" }\n}\ntry { throw \"boom\" } catch e { show \"right \" + str(e) }")
same("a try left by return stops catching", "fn f() {\n    try { return 1 } catch e { show \"WRONG\" }\n}\nshow f()\ntry { throw \"boom\" } catch e { show \"right \" + str(e) }")

show "-- Parity: comprehensions --"
same("list comprehension", "let xs = [1, 2, 3, 4]\nshow [y * 2 for y in xs]")
same("list comprehension with a condition", "let xs = [1, 2, 3, 4]\nshow [y for y in xs if y % 2 == 0]")
same("list comprehension over a map", "let m = {\"a\": 1, \"b\": 2}\nshow [k for k in m]")
same("list comprehension over a string", "show [c for c in \"ab\"]")
same("list comprehension over a range", "show [i * i for i in range(4)]")
same("nested list comprehensions", "show [[a * b for b in [1, 2]] for a in [10, 20]]")
same("a comprehension over a comprehension", "show [q + 1 for q in [z * 2 for z in [1, 2, 3]] if q > 2]")
same("map comprehension, one target", "let m = {\"a\": 1, \"b\": 2}\nshow {k: k for k in m}")
same("map comprehension over entries", "let m = {\"a\": 1, \"b\": 2}\nshow {k: v for k, v in entries(m)}")
same("map comprehension with a condition", "let m = {\"a\": 1, \"b\": 2}\nshow {k: v for k, v in entries(m) if v > 1}")
same("map comprehension over ragged rows", "show {p: q for p, q in [[1], [2, 3]]}")
same("map comprehension whose items are not lists", "show {p: p for p, q in [1, 2]}")
same("a comprehension reads the enclosing scope", "let scale = 10\nfn f() { return [n * scale for n in [1, 2]] }\nshow f()")

show "-- Parity: an instance reads like its fields --"
-- The VM handed the VMInstance itself to these, so keys(obj) came back
-- ["_clarityType", "klass", "properties"] and `for k in keys(obj)` walked the
-- engine's own representation.
same("keys, values and entries of an instance", "class A { fn init(n) { this.n = n } }\nlet a = A(5)\na.extra = 9\nshow sort(keys(a))\nshow values(a)\nshow entries(a)")
same("has on an instance", "class A { fn init(n) { this.n = n } }\nlet a = A(5)\nshow has(a, \"n\")\nshow has(a, \"nope\")")
-- len(instance) answered 3 whatever the instance held -- the count of the
-- engine's own internal properties -- and contradicted len(keys(a)) beside it.
same("len of an instance is its field count", "class A { fn init(n) { this.n = n } }\nlet a = A(5)\nshow [len(a), len(keys(a))]\na.extra = 9\nshow [len(a), len(keys(a))]\nclass B { fn init() { this.p = 1\n this.q = 2\n this.r = 3 } }\nshow [len(B()), len(keys(B()))]")
same("walking an instance by its keys", "class P { fn init() { this.x = 1\n this.y = 2 } }\nlet p = P()\nmut out = []\nfor k in keys(p) { push(out, k + \"=\" + str(p[k])) }\nshow out")
same("a method taken as a value", "class Dog {\n    fn init(n) { this.name = n }\n    fn speak() { return this.name + \" barks\" }\n}\nlet d = Dog(\"Rex\")\nlet f = d.speak\nshow f()\nshow d.speak()")
same("inheritance seen from outside", "class Animal {\n    fn init(n) { this.name = n }\n    fn speak() { return this.name + \" makes a sound\" }\n    fn describe() { return \"I am \" + this.name + \" and \" + this.speak() }\n    fn to_string() { return \"<Animal \" + this.name + \">\" }\n}\nclass Dog < Animal {\n    fn init(n, b) { this.name = n\n        this.breed = b }\n    fn speak() { return this.name + \" barks\" }\n}\nlet d = Dog(\"Rex\", \"lab\")\nshow d.speak()\nshow d.describe()\nshow str(d)\nshow type(d)\nshow sort(keys(d))\nlet g = d.describe\nshow g()")

show "-- Parity: what examples/ was tripping over --"
-- Each of these came out of running all seventeen files in examples/ under
-- both engines. Four did not match; these are the four faults, each reduced
-- to the smallest program that shows it.

-- examples/async_generators.clarity died in the VM's compiler with
-- "undefined is not an object": compile_DecoratedStatement read
-- node.statement, and the parser calls the field target.
same("a decorated function", "fn twice(wrapped) {\n    return fn(...args) {\n        wrapped(...args)\n        wrapped(...args)\n    }\n}\n\n@twice\nfn say_hello() {\n    show \"Hello!\"\n}\n\nsay_hello()")
same("a decorator that returns a value", "fn plus_one(f) { return fn(x) { return f(x) + 1 } }\n@plus_one\nfn double(n) { return n * 2 }\nshow double(5)")

-- examples/patterns.clarity printed "42 is a unknown": the VM's _type_name
-- ended in "unknown" instead of handing back what the host said, and the
-- host already distinguishes int from float.
same("type() names a number", "show type(42)\nshow type(4.5)\nshow type(\"s\")\nshow type(true)\nshow type(null)\nshow type([1])\nshow type({\"a\": 1})")
same("matching on type()", "fn classify(x) {\n    match type(x) {\n        when \"int\" { return \"an integer\" }\n        when \"float\" { return \"a float\" }\n        else { return \"something else\" }\n    }\n}\nshow classify(42)\nshow classify(4.5)\nshow classify(\"s\")")

-- examples/classes.clarity called null: the VM compiled an enum to a plain
-- map, so Color.Red worked by accident and Color.names() did not exist.
same("an enum is a value with members", "enum Color { Red = \"#FF0000\", Green = \"#00FF00\", Blue = \"#0000FF\" }\nshow Color.Red\nshow Color.names()\nshow Color.values()\nshow Color.entries()\nshow Color.has(\"Red\")\nshow Color.has(\"Mauve\")")
same("an enum says what it is", "enum C { A = 1, B = 2 }\nshow C\nshow str(C)\nshow type(C)")
same("an enum with implicit values", "enum D { X, Y }\nshow D.X\nshow D.Y\nshow D.values()")
both_fail_naming("an enum member that does not exist", "enum C { A = 1 }\nshow C.nope()", "nope")
-- An enum is not a map, and the VM used to let a subscript through because
-- it compiled one to a map.
same("an enum is not a map", "enum C { A = 1 }\ntry { show C[\"A\"] } catch e { show str(e) }")
same("an enum passed around and read dynamically", "enum Color { Red = \"#F00\", Green = \"#0F0\" }\nfn describe(e) { return str(e) + \" has \" + str(len(e.names())) + \" members\" }\nshow describe(Color)\nlet e = Color\nshow e.Red\nshow e.entries()\nshow e.has(\"Red\")\nlet f = e.names\nshow f()\nshow [Color, Color]\nshow Color == Color")
same("an unknown member read dynamically", "enum Color { Red = \"#F00\" }\nlet e = Color\ntry { show e.Mauve } catch err { show str(err) }")

-- examples/control_flow.clarity lost the line: the VM threw the
-- interpreter's words for an engine-raised error but never its line, so a
-- program that caught one and showed it read differently under --fast.
same("an engine-raised error carries its line", "try { show 1 / 0 } catch e { show str(e) }\ntry { let xs = [1]\n show xs[9] } catch e2 { show str(e2) }\ntry { show nope } catch e3 { show str(e3) }")
same("a not-callable error names the type", "fn t(l, f) { try { show l + \": \" + str(f()) } catch e { show l + \": \" + str(e) } }\nt(\"int\", fn() { let v = 5\n return v() })\nt(\"list\", fn() { let v = [1]\n return v() })\nt(\"null\", fn() { let v = null\n return v() })")
-- A program's own throw carries no line in either engine, and must not
-- start getting one now that engine errors do.
same("a thrown value of the program's own is left alone", "try { throw \"boom\" } catch e { show str(e) }\ntry { throw {\"code\": 7} } catch e2 { show str(e2) }")

show "-- Parity: block scoping --"
-- Every one of these answered a value under --fast where `clarity run`
-- raises a NameError, because the VM kept a frame's whole contents in one
-- flat map and blocks did not scope at all.
same("a for variable does not outlive its loop", "fn f() {\n    for z in [1, 2, 3] { }\n    return z\n}\ntry { show f() } catch e { show str(e) }")
same("a loop does not clobber an outer name", "fn f() {\n    let y = 99\n    for y in [1, 2] { }\n    return y\n}\nshow f()")
same("a let in an if body is the block's own", "fn f() {\n    if true { let q = 5 }\n    return q\n}\ntry { show f() } catch e { show str(e) }")
same("a let in a while body is the block's own", "fn f() {\n    mut i = 0\n    while i < 1 {\n        let w = 7\n        i += 1\n    }\n    return w\n}\ntry { show f() } catch e { show str(e) }")
same("a catch variable is the catch block's own", "fn f() {\n    try { throw \"x\" } catch ce { }\n    return ce\n}\ntry { show f() } catch e { show str(e) }")
same("a let in a try body is the block's own", "fn f() {\n    try { let a = 1 } catch e { }\n    return a\n}\ntry { show f() } catch e { show str(e) }")
same("a let in a finally body is the block's own", "fn f() {\n    try { } catch e { } finally { let c = 3 }\n    return c\n}\ntry { show f() } catch e { show str(e) }")
same("a let in a match arm is the arm's own", "fn f() {\n    match 1 { when 1 { let d = 4 } }\n    return d\n}\ntry { show f() } catch e { show str(e) }")
same("a comprehension variable is the comprehension's own", "fn f() {\n    let r = [v * 2 for v in [1, 2]]\n    return v\n}\ntry { show f() } catch e { show str(e) }")
same("a block shadows without overwriting", "let p = 1\nif true {\n    let p = 2\n    show p\n}\nshow p")
same("a closure made in a loop captures that round", "mut fs = []\nfor k in [1, 2, 3] { push(fs, fn() { return k }) }\nmut out = []\nfor g in fs { push(out, g()) }\nshow out")
same("nested loops may share a variable name", "mut out = []\nfor k in [1, 2] {\n    for k in [10, 20] { push(out, k) }\n    push(out, k)\n}\nshow out")
-- A block still reads and writes what encloses it.
same("a block reads and writes the scope around it", "fn f() {\n    let o = 5\n    mut acc = 0\n    for k in [1, 2] { acc += o }\n    return acc\n}\nshow f()")
same("break and continue leave their blocks cleanly", "mut out = []\nfor k in [1, 2, 3, 4] {\n    let d = k * 10\n    if k == 2 { continue }\n    if k == 4 { break }\n    push(out, d)\n}\nshow out")
same("a finally runs when a break leaves its block", "for k in [1, 2] {\n    try {\n        let z = k\n        break\n    } catch e { } finally { show \"fin\" }\n}\nshow \"after\"")
same("an error thrown inside a block lands in the catch", "fn f() {\n    mut seen = \"no\"\n    try {\n        if true {\n            let inner = 1\n            throw \"boom\"\n        }\n    } catch e { seen = str(e) }\n    return seen\n}\nshow f()")

show "-- Parity: slices --"
same("list slice", "let xs = [10, 20, 30, 40]\nshow xs[1..3]\nshow xs[..2]\nshow xs[0..4]")
same("a slice past the end", "let xs = [10, 20, 30, 40]\nshow xs[2..99]\nshow xs[9..12]\nshow xs[3..1]")
same("a slice with a negative bound", "let xs = [10, 20, 30, 40]\nshow xs[-1..2]\nshow xs[0..-1]")
-- The VM answered a substring here and the interpreter a list of characters.
-- Which of the two the language should mean is an open question recorded in
-- GAPS.md; that the engines agree is not.
same("a string slice", "let s = \"hello\"\nshow s[1..3]\nshow s[..2]\nshow s[-2..1]")
-- And the VM refused this outright with "Cannot slice map".
same("slicing a map", "let m = {\"a\": 1, \"b\": 2}\nshow m[0..1]")
same("a null bound is a missing bound", "let xs = [10, 20, 30, 40]\nshow xs[null..2]")
same("a slice is a copy", "let xs = [10, 20]\nlet c = xs[0..2]\npush(c, 99)\nshow c\nshow xs")
same("a slice of a slice", "let xs = [10, 20, 30, 40]\nshow xs[0..3][1..2]")
same("slice and copy as methods", "let xs = [10, 20, 30, 40]\nshow xs.slice(1, 3)\nshow xs.slice(1)\nshow xs.copy()")

show "-- Parity: nested functions --"
same("a nested fn", "fn outer(n) {\n    fn inner(x) { return x + 1 }\n    return inner(n)\n}\nshow outer(1)")
same("a nested fn closes over a local", "fn f(n) {\n    let bump = 10\n    fn add(x) { return x + bump }\n    return add(n)\n}\nshow f(1)")
same("a nested fn shadows a top-level one", "fn helper(x) { return x * 100 }\nfn f(n) {\n    fn helper(x) { return x + 1 }\n    return helper(n)\n}\nshow f(1)\nshow helper(1)")
same("a nested fn is a value", "fn f() {\n    fn g(x) { return x * 3 }\n    return map([1, 2], g)\n}\nshow f()")

-- Calling with the wrong number of arguments. Both engines bind the
-- parameters a function declares and no more: a missing one is null, a
-- surplus one is evaluated for its effect and its value dropped. That holds
-- for a builtin as well as for a function the program wrote, and it is what
-- the native backend had to be taught — it used to emit a call to a variable
-- nothing declares and fail in the C compiler.
same("too few arguments bind null", "fn f(a, b) { return [a, b] }\nshow f(1)")
same("surplus arguments to a function are dropped",
     "mut n = 0\nfn bump() { n = n + 1; return n }\nfn one(a) { return a }\n" +
     "show one(bump(), bump())\nshow n")
same("surplus arguments to a builtin are evaluated and dropped",
     "mut n = 0\nfn bump() { n = n + 1; return n }\n" +
     "show sort([3, 1, 2], bump())\nshow n\nshow len(\"ab\", \"cd\")\n" +
     "show upper(\"a\", \"b\")\nshow str(7, 8)")

-- The lexer is one piece of code for both engines, so an exponent either
-- reads in both or in neither. It read in neither: `1.5e10` was 1.5 followed
-- by the identifier e10, which the reference has documented as a float
-- literal for as long as there has been a reference.
same("float exponent literals",
     "show 1.5e10\nshow 2.0E-3\nshow 1e3\nshow 1.5e-3\nshow 6.02e23\n" +
     "show type(1e3)\nshow type(1.5e-3)")
-- Every operator the parser produces, in one program. `is` was in the
-- grammar, in the reference under Logical operators and in this engine's
-- interpreter, and the bytecode compiler had never heard of it: the whole
-- program died with "CompileError: Unknown binary operator: is". `~` was the
-- mirror image — the VM ran it, the interpreter raised "Unknown unary
-- operator".
same("every operator the parser produces",
     "show 6 + 3\nshow 6 - 3\nshow 6 * 3\nshow 6 / 3\nshow 7 % 3\n" +
     "show 2 ** 10\nshow 6 == 3\nshow 6 != 3\nshow 6 < 3\nshow 6 > 3\n" +
     "show 6 <= 3\nshow 6 >= 3\nshow true and false\nshow true or false\n" +
     "show 6 is 6\nshow 6 & 3\nshow 6 | 3\nshow 6 ^ 3\nshow 6 << 1\n" +
     "show 6 >> 1\nshow not true\nshow -6\nshow ~6")
same("is is ==",
     "show 1 is 1\nshow 1 is 2\nshow \"a\" is \"a\"\nshow [1] is [1]\n" +
     "show null is null\nshow (1 is 1) == (1 == 1)")
same("~ is JavaScript's",
     "show ~0\nshow ~6\nshow ~-1\nshow ~2147483647\nshow ~1.5\n" +
     "show ~4294967296\nshow ~(1 << 31)")

same("bitwise operands go through ToInt32",
     "show 1.5 & 3\nshow -1.5 | 0\nshow 2.9 ^ 1\nshow 4294967297 & 0xFF\n" +
     "show (1 << 31)\nshow -8 >> 1\nshow 1e20 & 0xFF")
same("a number past the exact integer range",
     "show 100000000000000000000\nshow 0xFFFFFFFFFFFFFFFF\n" +
     "show 4611686018427387904 * 4\nshow 2 ** 64\nshow 1e21\nshow 1e-7")
-- An exponent needs at least one digit, so `1e` is still the number 1
-- followed by the name `e` — which the standard library defines as Euler's
-- number. Both engines have to keep reading it that way.
same("a bare e after a number is not an exponent",
     "show 1e\nshow e\nshow 2 * e")

-- A name the program binds is the thing that gets called, even when a
-- builtin answers to it too. Both engines agree; the native backend did not.
same("a binding wins over the builtin it shadows",
     "fn sort(xs) { return \"mine\" }\nshow sort([3, 1, 2])\n" +
     "let upper = fn(s) { return \"mine:\" + s }\nshow upper(\"a\")\n" +
     "fn outer() {\n    let len = fn(x) { return \"inner\" }\n" +
     "    return fn() { return len([1, 2]) }\n}\nshow outer()()")

-- Both engines must refuse the same broken programs. The wording is not
-- required to match (the interpreter names the property, the VM says the
-- value is not callable), but both must fail, and both must name the thing
-- the program got wrong.
show "-- Parity: both engines refuse the same programs --"
both_fail_naming("undefined variable", "show nope", "nope")
-- and for this one the wording *is* required to match: the VM used to say
-- "RuntimeError: Undefined variable: nope" with no line, so a program that
-- caught the error and showed it read differently under --fast.
same("the wording of an undefined-name error", "try { show nope } catch e { show str(e) }")
same("an unbound map-comprehension target names itself", "try { show {p: q for p, q in [1, 2]} } catch e { show str(e) }")
both_fail_naming("calling a missing method", "class C {\n    fn init() { this.x = 1 }\n}\nC().nope()", "nope")
both_fail_naming("reading a property that does not exist", "class C {\n    fn init() { this.x = 1 }\n}\nshow C().missing", "missing")
both_fail_naming("calling a non-function", "let x = 5\nx()", "callable")
both_fail_naming("index out of a map that has no such key", "let m = {}\nshow m[\"a\"].b", "a")
both_fail_naming("an error after a try was left by break", "for i in range(1) {\n    try { break } catch e { show \"WRONG\" }\n}\nshow nope", "nope")
both_fail_naming("an error after a try was left by return", "fn f() {\n    try { return 1 } catch e { show \"WRONG\" }\n}\nfn g() { throw \"boom\" }\nshow f()\ng()", "boom")

show ""
show "Parity: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " parity test(s) failed" }

-- What the first run found, all of it in the VM, all of it reproducible on
-- the v1.0.1 release binary with `clarity run <file> --fast`:
--
-- 1. String interpolation was not implemented. `show "n is {n}"` printed
--    `n is {n}` verbatim, so the language's headline string feature was
--    wrong under --fast.
-- 2. `break` left its iterator on the stack, which corrupted the enclosing
--    loop: two nested loops where the inner one breaks printed 0 and then
--    3 forever instead of 0 1 2.
-- 3. `finally` was never compiled: the block simply did not run, on the
--    normal path, after a catch, or when the catch rethrew.
-- 4. `return` from inside a `try` did not return; the return signal escaped
--    as an uncaught value and the program died with `{}`.
-- 5. Reading a property an instance does not have returned null, where the
--    interpreter names the class and the property and stops.
