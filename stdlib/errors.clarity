-- Friendly error rendering.
--
-- Clarity throws errors as plain strings that embed their position —
-- "... at line N, column C" for lexer/parser errors, "... (line N)" for
-- runtime errors. This module recovers that position from the message and
-- renders the offending source line with a caret under the exact spot, so a
-- typo points you straight at itself instead of just naming a line number.

-- The integer that immediately follows `marker` in `msg` (or null).
fn _num_after(msg, marker) {
    let idx = index_of(msg, marker)
    if idx < 0 { return null }
    mut digits = ""
    mut i = idx + len(marker)
    while i < len(msg) {
        let ch = substring(msg, i, i + 1)
        if contains("0123456789", ch) { digits = digits + ch } else { break }
        i += 1
    }
    if len(digits) == 0 { return null }
    return int(digits)
}

-- Pull {line, column} out of an error message. Either may be null.
fn error_position(msg) {
    return {"line": _num_after(msg, "line "), "column": _num_after(msg, "column ")}
}

-- Render an error with a source-line snippet and a caret. `source` and
-- `path` may be null (falls back to just the message). Returns a plain
-- multi-line string; the caller decides on colour.
fn format_error(err, source, path) {
    -- A `throw` that nobody caught arrives as the interpreter's own control
    -- signal, a map holding the thrown value and the line it left from. It
    -- used to be printed as it stands, so a program ending in `throw "boom"`
    -- told the user `{__signal__: "throw", value: "boom"}` while the same
    -- program under `run --fast` said `boom`. The value is what was thrown
    -- and the value is what is shown, in both.
    mut thrown = err
    mut thrown_line = null
    if type(err) == "map" and has(err, "__signal__") and err["__signal__"] == "throw" {
        thrown = err["value"]
        if has(err, "line") and err["line"] != null and err["line"] > 0 {
            thrown_line = err["line"]
        }
    }
    mut msg = str(thrown)
    -- A host error — a stack overflow, most often — arrives as an object
    -- whose properties are not enumerable, so str() rendered it as `{}` and
    -- the program was told it had failed without being told anything else:
    --
    --   fn f(n) { return f(n + 1) }
    --   show f(0)        ->   Clarity Error in x.clarity:  {}
    --
    -- Its name and message are there; they just have to be asked for. A
    -- Clarity map with a "message" key has that key among its own, so the
    -- empty-keys test is what tells the two apart.
    if type(thrown) == "map" and len(keys(thrown)) == 0 and has(thrown, "message") {
        let host_name = if has(thrown, "name") { str(thrown["name"]) } else { "Error" }
        msg = host_name + ": " + str(thrown["message"])
    }
    let where = if path != null { " in " + path } else { "" }
    mut out = "Clarity Error" + where + ":\n\n  " + msg + "\n"

    mut pos = error_position(msg)
    -- A thrown value carries no position of its own; the signal knows where
    -- the `throw` was.
    if thrown_line != null { pos = {"line": thrown_line, "column": null} }
    if pos["line"] != null and source != null {
        let lines = split(source, "\n")
        let li = pos["line"] - 1
        if li >= 0 and li < len(lines) {
            let gutter = "  " + str(pos["line"]) + " | "
            out = out + "\n" + gutter + lines[li] + "\n"
            -- caret only when we actually know the column, so we never point
            -- confidently at the wrong character
            if pos["column"] != null and pos["column"] >= 1 {
                out = out + repeat(" ", len(gutter) + pos["column"] - 1) + "^\n"
            }
        }
    }
    return out
}
