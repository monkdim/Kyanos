-- Clarity → C native-compilation tests (stage 1).
--
-- For each program: run it through the tree-walking interpreter AND compile
-- it to C, build the C with a real compiler, run the binary — then assert the
-- native output matches the interpreter exactly. This proves the generated C
-- is not just well-formed but semantically faithful.
--
-- Skipped gracefully where no C compiler is on PATH.

from "lexer.clarity" import tokenize
from "parser.clarity" import parse
from "interpreter.clarity" import Interpreter
from "c_codegen.clarity" import compile_to_c, compile_to_c_freestanding

mut PASSED = 0
mut FAILED = 0
fn assert_eq(actual, expected, msg) {
    if actual == expected { PASSED += 1 }
    else { FAILED += 1; show "  FAIL: {msg}\n    interp: {expected}\n    native: {actual}" }
}

-- Pick a C compiler that's actually present.
fn _find_cc() {
    for cc in ["cc", "gcc", "clang"] {
        let r = exec_full(cc + " --version")
        if len(trim(r.stdout)) > 0 { return cc }
    }
    return null
}
let CC = _find_cc()
-- FFI programs pull dlsym, which needs libdl on Linux (a stub on modern glibc);
-- on macOS dlsym is in libSystem. Non-FFI programs strip the helper at -O2, so
-- the extra flag is harmless everywhere.
let LDL = if CC != null and contains(exec("uname"), "Linux") { " -ldl" } else { "" }
-- /proc-backed features (read_mem) only work on Linux; gate their native checks.
let IS_LINUX = CC != null and contains(exec("uname"), "Linux")
let IS_DARWIN = CC != null and contains(exec("uname"), "Darwin")
-- x86-64 Linux only: inline function-code patching (hook.clarity) emits x86-64
-- machine code, and self-modifying code elsewhere needs extra care.
let IS_X64 = IS_LINUX and contains(exec("uname -m"), "x86_64")

-- Where a stdlib source file is, depending on where the runner was started.
fn _find_file(name) {
    for cand in ["stdlib", ".", "../stdlib"] {
        if exists(cand + "/" + name) { return cand + "/" + name }
    }
    return null
}

fn interp_run(src) {
    let i = Interpreter(null, null)
    i.run(parse(tokenize(src, "<t>"), src))
    return join(i.output, "\n")
}

-- Compile `src` to a native binary and return its stdout (trimmed).
--
-- A compile that fails used to leave no binary and therefore empty output,
-- which reads as "the program printed nothing" — a wrong answer rather than
-- a broken build, and on a platform you cannot reach there is nothing to go
-- on. The compiler's own words come back instead, and a binary that dies
-- without printing says so with its exit status, so a failure names itself.
fn _compile_native(src, tag) {
    let c = compile_to_c(parse(tokenize(src, "<t>"), src))
    let cfile = "/tmp/_clc_" + tag + ".c"
    let bin = "/tmp/_clc_" + tag
    if exists(bin) { exec_full("rm -f " + bin) }
    write(cfile, c)
    let comp = exec_full(CC + " -O2 -w " + cfile + " -o " + bin + " -lm" + LDL)
    if comp.exit_code != 0 { return "C COMPILE FAILED: " + trim(comp.stderr) }
    if not exists(bin) { return "C COMPILE PRODUCED NO BINARY: " + trim(comp.stderr) }
    return null
}

fn _ran(r) {
    if r.exit_code != 0 and trim(r.stdout) == "" {
        return "NATIVE RUN FAILED (exit " + str(r.exit_code) + "): " + trim(r.stderr)
    }
    return trim(r.stdout)
}

fn native_run(src, tag) {
    let failed = _compile_native(src, tag)
    if failed != null { return failed }
    return _ran(exec_full("/tmp/_clc_" + tag))
}

fn same(tag, src) {
    assert_eq(native_run(src, tag), trim(interp_run(src)), tag)
}

-- Compile and run with CLARITY_GC=1 so mid-run collection actually happens.
-- The default arena never frees, so a rooting bug is invisible without this.
fn native_run_gc(src, tag) {
    let failed = _compile_native(src, tag)
    if failed != null { return failed }
    return _ran(exec_full("CLARITY_GC=1 /tmp/_clc_" + tag))
}

fn same_gc(tag, src) {
    -- Mid-run collection is off by default and documented as experimental
    -- precisely because conservative stack scanning is optimiser- and
    -- ABI-sensitive; ROADMAP names a precise (shadow-stack) collector as the
    -- fix. On darwin-arm64 it is not merely sensitive: a program holding two
    -- live allocations across a collection is killed, and that is true with
    -- the temporaries in volatile storage, at a collection per allocation,
    -- and of cases that predate this suite's ordering work. linux-x64 and
    -- linux-arm64 both pass, so it is Apple's toolchain rather than arm64.
    --
    -- So these cases still compile and run there — with the arena, which is
    -- what ships by default on that platform — and only the mid-run
    -- collection they would otherwise pin goes unchecked. Skipping the
    -- program entirely would hide a real answer; asserting a feature the
    -- project says does not work there would be asserting fiction.
    if IS_DARWIN {
        assert_eq(native_run(src, tag), trim(interp_run(src)), tag)
        return null
    }
    assert_eq(native_run_gc(src, tag), trim(interp_run(src)), tag)
}

-- Native-only check: FFI calls into libc/libm have no interpreter counterpart
-- (the interpreter's FFI is a different, Bun-based surface), so we assert the
-- compiled binary's output against a known-good expected string.
fn nat_eq(tag, src, expected) {
    assert_eq(native_run(src, tag), expected, tag)
}

if CC == null {
    show "-- C codegen: no C compiler on PATH — native compile tests skipped --"
} else {
    show "-- C codegen: compiling with '" + CC + "' --"
    if IS_DARWIN {
        show "-- C codegen: mid-run GC cases run without CLARITY_GC here (see same_gc) --"
    }

    same("arithmetic", "show 2 + 3 * 4\nshow 10 - 6 / 2\nshow 2 ** 10\nshow 17 % 5\nshow -(4 + 1)")
    same("integer_div_float", "show 12 / 4\nshow 7 / 2")
    same("float_math", "show 1.5 + 2.5\nshow 3.0 * 2.0\nshow 10.0 / 4.0")
    same("booleans", "show true\nshow false\nshow not true\nshow 5 > 3 and 2 < 1")
    same("comparisons", "show 5 > 3\nshow 3 >= 3\nshow 2 == 2\nshow 2 != 3\nshow \"a\" < \"b\"")
    same("variables", "let x = 40\nmut y = 2\ny = y + x\ny += 1\nshow y")
    same("strings", "let n = \"Clarity\"\nshow \"hi \" + n + \"!\"\nshow \"a\" + \"b\" + \"c\"")
    same("if_elif_else", "fn grade(n) { if n >= 90 { return \"A\" } elif n >= 80 { return \"B\" } else { return \"C\" } }\nshow grade(95)\nshow grade(85)\nshow grade(70)")
    same("while_loop", "mut i = 0\nmut s = 0\nwhile i < 5 { if i % 2 == 0 { s = s + i }\ni = i + 1 }\nshow s")
    same("recursion", "fn fib(n) { if n < 2 { return n }\nreturn fib(n - 1) + fib(n - 2) }\nshow fib(20)")
    same("mutual_recursion", "fn is_even(n) { if n == 0 { return true }\nreturn is_odd(n - 1) }\nfn is_odd(n) { if n == 0 { return false }\nreturn is_even(n - 1) }\nshow is_even(10)\nshow is_odd(7)")
    same("factorial_loop", "fn fact(n) { mut r = 1\nmut i = 1\nwhile i <= n { r = r * i\ni = i + 1 }\nreturn r }\nshow fact(10)")

    -- ── stage 2: lists, maps, for-loops, builtins ──
    same("list_literal", "show [1, 2, 3]\nshow [\"a\", \"b\"]\nshow []")
    same("list_index", "let xs = [10, 20, 30]\nshow xs[0]\nshow xs[2]\nshow xs[-1]")
    same("list_len_push", "mut xs = [1, 2]\npush(xs, 3)\npush(xs, 4)\nshow len(xs)\nshow xs")
    same("list_index_assign", "mut xs = [1, 2, 3]\nxs[1] = 99\nxs[0] += 5\nshow xs")
    same("map_literal", "show {\"a\": 1, \"b\": 2}\nshow {\"x\": [1, 2], \"y\": \"hi\"}")
    same("map_index", "let m = {\"a\": 1, \"b\": 2}\nshow m[\"a\"]\nshow m[\"b\"]")
    same("map_ops", "mut m = {\"a\": 1}\nm[\"b\"] = 2\nshow len(m)\nshow has(m, \"a\")\nshow has(m, \"z\")")
    same("for_list", "mut s = 0\nfor x in [1, 2, 3, 4] { s = s + x }\nshow s")
    same("for_range", "mut s = 0\nfor i in range(5) { s = s + i }\nshow s\nfor j in range(2, 5) { show j }")
    same("for_string", "for c in \"abc\" { show c }")
    same("for_map_keys", "let m = {\"a\": 1, \"b\": 2}\nmut s = 0\nfor k in m { s = s + m[k] }\nshow s")
    same("contains_str", "show contains(\"hello world\", \"world\")\nshow contains(\"abc\", \"z\")")
    same("contains_list", "show contains([1, 2, 3], 2)\nshow contains([1, 2, 3], 9)")
    same("str_builtin", "show str(42) + \"!\"\nshow \"n=\" + str(3 + 4)")
    same("nested_loops", "mut total = 0\nfor i in range(3) { for j in range(3) { total = total + i * j } }\nshow total")

    -- Builtins that worked in the interpreter and had no case in the C
    -- backend at all, so any program using one simply failed to compile. Each
    -- is asserted against the interpreter rather than a literal, because
    -- matching the interpreter *is* the specification.
    same("bi_print", "print(\"x\")\nprint(\"a\", 1, true)\nprint()")
    same("bi_pop", "mut a = [1, 2, 3]\nshow pop(a)\nshow a\nshow pop([])")
    same("bi_sort", "show sort([3, 1, 2])\nshow sort([\"b\", \"a\"])\nshow sort([])\nshow sort([2.5, 1.5])")
    -- Stability: equal-comparing elements must keep their original order, or
    -- native and interpreter disagree on a list this small only by luck.
    same("bi_sort_stable", "let xs = [[2, \"a\"], [1, \"b\"], [2, \"c\"], [1, \"d\"]]\nshow map(sort(map(xs, fn(p) { return p[0] })), fn(v) { return v })")
    same("bi_reverse", "show reverse([1, 2, 3])\nshow reverse(\"abc\")\nshow reverse([])")
    same("bi_unique", "show unique([1, 1, 2, 3, 2])\nshow unique([\"a\", \"a\"])\nshow unique([])")
    same("bi_flat", "show flat([[1], [2, 3], []])\nshow flat([1, [2]])")
    same("bi_zip", "show zip([1, 2], [3, 4])\nshow zip([1, 2, 3], [4, 5])\nshow zip([1], [2], [3])")
    same("bi_find", "show find([1, 2, 3], fn(x) { return x > 1 })\nshow find([1, 2], fn(x) { return x > 9 })")
    same("bi_every_some", "show every([1, 2], fn(x) { return x > 0 })\nshow every([1, 2], fn(x) { return x > 1 })\nshow some([1, 2], fn(x) { return x > 1 })\nshow some([1, 2], fn(x) { return x > 9 })")
    same("bi_values_entries", "let m = {\"a\": 1, \"b\": 2}\nshow values(m)\nshow entries(m)")
    same("bi_merge", "show merge({\"a\": 1}, {\"b\": 2})\nshow merge({\"a\": 1}, {\"a\": 2})\nshow merge({\"a\": 1}, {\"b\": 2}, {\"c\": 3})")
    same("bi_bool", "show bool(1)\nshow bool(0)\nshow bool(\"\")\nshow bool([])\nshow bool(null)")
    same("bi_pow", "show pow(2, 10)\nshow pow(2, 0)\nshow pow(2.0, 0.5)")

    -- Language constructs the backend had no case for, so a program using
    -- one refused to compile: six of the seventeen files in examples/ did.
    same("lang_range", "for i in 1..4 { show i }\nshow 0..3\nmut s = 0\nfor i in 2..6 { s = s + i }\nshow s")
    same("lang_pipe", "fn double(x) { return x * 2 }\nfn addn(x, n) { return x + n }\nshow 5 |> double\nshow 5 |> addn(3)\nshow [1, 2, 3] |> len\nshow \"  hi  \" |> trim |> upper")
    same("lang_match", "fn classify(n) { match n { when 1 { return \"one\" }\nwhen 2 { return \"two\" }\nelse { return \"many\" } } }\nshow classify(1)\nshow classify(2)\nshow classify(9)")
    -- No arm matches and there is no else: the match must fall through rather
    -- than run the last arm or skip the rest of the program.
    same("lang_match_no_default", "match \"x\" { when \"y\" { show \"nope\" } }\nshow \"after\"")
    same("lang_match_in_loop", "mut hits = 0\nfor v in [1, 2, 3, 1] { match v { when 1 { hits = hits + 10 }\nwhen 2 { hits = hits + 100 }\nelse { hits = hits + 1 } } }\nshow hits")
    -- The subject is evaluated once, however many arms are tested.
    same("lang_match_subject_once", "mut calls = 0\nfn subj() { calls = calls + 1\nreturn 3 }\nmatch subj() { when 1 { show \"a\" }\nwhen 2 { show \"b\" }\nelse { show \"c\" } }\nshow calls")
    same("lang_interface", "interface Shape { fn area() }\nclass Sq impl Shape { fn init(s) { this.s = s }\nfn area() { return this.s * this.s } }\nshow Sq(4).area()")

    -- Exceptions. Every file in the compiler chain uses try/catch, so until
    -- these compiled, `clarity cc` could not build the Clarity compiler.
    same("exc_catch", "fn risky(n) { if n > 2 { throw \"too big: \" + str(n) }\nreturn n * 10 }\nfn guarded(n) { try { return risky(n) } catch e { return \"caught \" + e } }\nshow guarded(1)\nshow guarded(5)")
    -- A throw crossing several frames, which is the case a plain C return
    -- could not express and setjmp/longjmp exists for.
    same("exc_deep", "fn d3() { throw \"from-deep\" }\nfn d2() { return d3() }\nfn d1() { return d2() }\nfn catcher() { try { return d1() } catch e { return \"got \" + e } }\nshow catcher()")
    -- Nested handlers: a throw from inside a catch must reach the *enclosing*
    -- handler, not the one it is already inside, which would loop forever.
    same("exc_nested", "fn nested() { try { try { throw \"inner\" } catch e { throw \"wrapped(\" + e + \")\" } } catch e2 { return e2 } }\nshow nested()")
    same("exc_finally", "mut log = []\nfn f(n) { try { if n > 2 { throw \"big\" }\npush(log, \"try-ok\")\nreturn \"ret-\" + str(n) } catch e { push(log, \"catch-\" + e)\nreturn \"caught\" } finally { push(log, \"finally-\" + str(n)) } }\nshow f(1)\nshow f(5)\nshow log")
    -- `finally` when the catch block leaves by return or by throw. Both used
    -- to skip it: the interpreter propagated the signal straight out of the
    -- catch, and the backend emitted the finally only on the fall-through
    -- path. A `same()` alone could not have caught that — the two agreed
    -- with each other while both were wrong — so the expected output is
    -- asserted directly as well.
    same("exc_finally_paths", "mut log = []\nfn a() { try { push(log, \"try\")\nreturn \"T\" } catch e { push(log, \"catch\")\nreturn \"C\" } finally { push(log, \"fin-try\") } }\nfn b() { try { throw \"boom\" } catch e { push(log, \"catch\")\nreturn \"C\" } finally { push(log, \"fin-catch\") } }\nfn c() { try { try { throw \"inner\" } catch e { push(log, \"rethrowing\")\nthrow \"wrapped\" } finally { push(log, \"fin-rethrow\") } } catch outer { return \"outer got \" + outer } }\nshow a()\nshow b()\nshow c()\nshow log")
    nat_eq("exc_finally_paths_exact", "mut log = []\nfn a() { try { push(log, \"try\")\nreturn \"T\" } catch e { push(log, \"catch\")\nreturn \"C\" } finally { push(log, \"fin-try\") } }\nfn b() { try { throw \"boom\" } catch e { push(log, \"catch\")\nreturn \"C\" } finally { push(log, \"fin-catch\") } }\nfn c() { try { try { throw \"inner\" } catch e { push(log, \"rethrowing\")\nthrow \"wrapped\" } finally { push(log, \"fin-rethrow\") } } catch outer { return \"outer got \" + outer } }\nshow a()\nshow b()\nshow c()\nshow log", "T\nC\nouter got wrapped\n[\"try\", \"fin-try\", \"catch\", \"fin-catch\", \"rethrowing\", \"fin-rethrow\"]")
    same("exc_payloads", "fn t(v) { try { throw v } catch e { return e } }\nshow t(42)\nshow t([1, 2])\nshow t({\"a\": 1})")
    -- A local written inside the try and read after the catch. C leaves a
    -- non-volatile local of the setjmp's own function indeterminate here, so
    -- this is what the volatile storage is for; without it the value is
    -- whatever happened to be in a register.
    same("exc_mutated_local", "fn m() { mut acc = 0\ntry { acc = acc + 5\nthrow \"x\" } catch e { acc = acc + 100 }\nreturn acc }\nshow m()")
    -- The same shape as exc_mutated_local, but inside a closure. A closure is
    -- its own C function, so it decides on its own whether its locals need
    -- volatile storage; taking the enclosing function's answer would leave a
    -- closure with a try, written at top level, with ordinary locals.
    same("exc_closure_local", "let f = fn(n) { mut acc = n\ntry { acc = acc + 5\nthrow \"x\" } catch e { acc = acc + 100 }\nreturn acc }\nshow f(1)\nshow map([1, 2], f)")
    -- A throw from inside a closure has to reach the caller's handler, across
    -- the C frames the higher-order builtin adds.
    same("exc_through_hof", "fn run() { try { return map([1, 2, 3], fn(x) { if x == 2 { throw \"at \" + str(x) }\nreturn x }) } catch e { return \"caught \" + e } }\nshow run()")
    same("exc_gc", "fn t(v) { try { throw v } catch e { return e } }\nmut i = 0\nmut last = \"\"\nwhile i < 20000 { last = t(\"payload-\" + str(i))\ni = i + 1 }\nshow last")
    -- An uncaught throw is deliberately *not* compared against the
    -- interpreter: the interpreter prints its internal signal object and
    -- exits 0, while the compiled binary reports on stderr and exits 1. The
    -- native behaviour is the better one, so this asserts it directly rather
    -- than matching the interpreter's.
    nat_eq("exc_uncaught_stdout", "show \"before\"\nthrow \"boom\"\nshow \"after\"", "before")

    -- The last builtins with no native implementation. base64 is checked at
    -- all three padding lengths, and the digests are the published FIPS 180-4
    -- vectors — matching the interpreter here also means matching everyone
    -- else's sha256, which is the point of a hash.
    same("bi_base64", "show encode64(\"hi\")\nshow encode64(\"a\")\nshow encode64(\"abc\")\nshow encode64(\"hello world!\")\nshow decode64(encode64(\"round trip with padding\"))\nshow decode64(\"aGVsbG8=\")")
    same("bi_hash", "show hash(\"\")\nshow hash(\"abc\")\nshow hash(\"The quick brown fox jumps over the lazy dog\")")
    -- cwd and random cannot be compared value-for-value — one depends on where
    -- the test runs and the other is meant to differ every time — so this
    -- asserts the type, which is the part that must agree.
    same("bi_cwd_random_types", "show type(cwd())\nshow type(random())\nshow type(random(10))\nshow type(random(5, 9))")
    nat_eq("bi_random_range", "mut ok = true\nmut i = 0\nwhile i < 500 { let r = random(5, 9)\nif r < 5 or r >= 9 { ok = false }\ni = i + 1 }\nshow ok", "true")

    -- ── stage 3: classes ──
    same("class_counter", "class Counter { fn init(start) { this.n = start }\nfn inc() { this.n = this.n + 1 }\nfn get() { return this.n } }\nlet c = Counter(5)\nc.inc()\nc.inc()\nshow c.get()")
    same("class_to_string", "class Point { fn init(x, y) { this.x = x\nthis.y = y }\nfn to_string() { return \"(\" + str(this.x) + \", \" + str(this.y) + \")\" } }\nshow Point(3, 4)")
    same("class_default_display", "class Empty { fn init() {} }\nshow Empty()")
    same("class_mutation", "class Calc { fn init() { this.total = 0 }\nfn add(x) { this.total = this.total + x }\nfn double() { this.total = this.total * 2 }\nfn result() { return this.total } }\nlet k = Calc()\nk.add(3)\nk.double()\nshow k.result()")
    same("class_field_list", "class Stack { fn init() { this.items = [] }\nfn put(x) { push(this.items, x) }\nfn size() { return len(this.items) } }\nlet s = Stack()\ns.put(10)\ns.put(20)\nshow s.size()\nshow s.items")
    same("class_method_calls_method", "class Greeter { fn init(name) { this.name = name }\nfn greeting() { return \"Hello, \" + this.name }\nfn shout() { return this.greeting() + \"!\" } }\nshow Greeter(\"Kyan\").shout()")
    same("class_inheritance", "class Animal { fn init(name) { this.name = name }\nfn speak() { return \"...\" }\nfn describe() { return this.name + \" says \" + this.speak() } }\nclass Dog < Animal { fn speak() { return \"woof\" } }\nlet d = Dog(\"Rex\")\nshow d.describe()")

    -- ── enums ──
    -- An enum is a compile-time table here: its members become C globals
    -- initialised before any module-level binding, and `E.member` resolves
    -- while compiling. Everything below is diffed against the interpreter.
    same("enum_members", "enum Color { Red, Green, Blue }\nshow Color.Red\nshow Color.Green\nshow Color.Blue")
    same("enum_explicit_values", "enum Status { Ok = 200, NotFound = 404, Error = 500 }\nshow Status.Ok\nshow Status.NotFound\nshow Status.Error")
    same("enum_names", "enum Color { Red, Green, Blue }\nshow Color.names()")
    same("enum_values", "enum Status { Ok = 200, NotFound = 404 }\nshow Status.values()")
    same("enum_entries", "enum Status { Ok = 200, NotFound = 404 }\nshow Status.entries()")
    same("enum_has", "enum Color { Red, Green }\nshow Color.has(\"Red\")\nshow Color.has(\"Blue\")")
    same("enum_in_expression", "enum Status { Ok = 200, Missing = 404 }\nfn describe(code) {\n    if code == Status.Ok { return \"fine\" }\n    if code == Status.Missing { return \"missing\" }\n    return \"unknown\"\n}\nshow describe(200)\nshow describe(404)\nshow describe(1)\nshow Status.Ok + 1")
    -- A function defined above the enum still sees it: module scope in
    -- Clarity is the whole file, so the table is registered before any body
    -- is emitted.
    same("enum_used_before_declared", "fn label(l) { return \"level=\" + Level.names()[l] }\nenum Level { Low = \"low\", High = \"high\" }\nshow Level.Low\nshow label(1)")
    same("enum_two_enums", "enum A { X, Y }\nenum B { P = 10, Q = 20 }\nshow A.Y + B.P\nshow A.names()\nshow B.values()")
    -- A member holding a string is heap-allocated, so the collector has to
    -- see the global holding it. Without rooting this prints garbage once
    -- mid-run collection starts.
    same_gc("enum_string_members_gc", "enum Level { Low = \"low\", High = \"high\" }\nmut junk = []\nmut i = 0\nwhile i < 20000 {\n    junk = [str(i), str(i + 1)]\n    i += 1\n}\nshow Level.Low\nshow Level.names()\nshow Level.values()")

    -- ── generators ──
    -- Eager, as in the interpreter: a body that yields collects into a list
    -- and the call returns it. In C that is one list local per call, so a
    -- recursive or nested generator keeps its own without any of the
    -- coroutine machinery a lazy generator would need.
    same("gen_basic", "fn counter(n) {\n    mut i = 0\n    while i < n {\n        yield i * 10\n        i += 1\n    }\n}\nshow counter(3)")
    same("gen_for_loop", "fn counter(n) {\n    mut i = 0\n    while i < n {\n        yield i\n        i += 1\n    }\n}\nfor v in counter(4) { show v }")
    same("gen_conditional", "fn evens(n) {\n    mut i = 0\n    while i < n {\n        if i % 2 == 0 { yield i }\n        i += 1\n    }\n}\nshow evens(7)")
    same("gen_nested", "fn evens(n) {\n    mut i = 0\n    while i < n {\n        if i % 2 == 0 { yield i }\n        i += 1\n    }\n}\nfn scaled(n) {\n    for v in evens(n) { yield v * 100 }\n}\nshow scaled(7)")
    same("gen_return_wins", "fn early(n) {\n    yield 1\n    if n > 0 { return \"ignored\" }\n    yield 2\n}\nshow early(1)\nshow early(0)")
    same("gen_recursive", "fn down(n) {\n    if n <= 0 { return null }\n    yield n\n    for v in down(n - 1) { yield v }\n}\nshow down(3)")
    same("gen_method", "class Box {\n    fn init(items) { this.items = items }\n    fn doubled() {\n        for it in this.items { yield it * 2 }\n    }\n}\nshow Box([1, 2, 3]).doubled()")
    same("gen_closure_inside", "fn outer(n) {\n    let triple = fn(x) { return x * 3 }\n    mut i = 0\n    while i < n {\n        yield triple(i)\n        i += 1\n    }\n}\nshow outer(4)")
    same("gen_yield_is_expression", "fn g() {\n    let a = yield 7\n    show \"yielded \" + str(a)\n}\nshow g()")
    same("gen_with_try", "fn risky(n) {\n    try {\n        yield 1\n        if n > 0 { throw \"boom\" }\n        yield 2\n    } catch e {\n        yield 99\n    }\n}\nshow risky(1)\nshow risky(0)")
    same("gen_map_over", "fn evens(n) {\n    mut i = 0\n    while i < n {\n        if i % 2 == 0 { yield i }\n        i += 1\n    }\n}\nshow map(evens(6), fn(x) { return x * 2 })")
    -- The scan that decides whether a function is a generator has to walk
    -- every place an expression can appear, or a yield in one of them
    -- compiles as "yield outside a function". One yield per expression
    -- here on purpose: two would also be testing the order C evaluates
    -- arguments in, which is a separate defect (see GAPS.md).
    same("gen_in_map_literal", "fn g(n) {\n    let d = { \"a\": yield n, \"b\": 1 }\n    show d\n}\nshow g(5)")
    same("gen_in_range", "fn r(n) {\n    for v in (yield n)..3 { show v }\n}\nshow r(1)")

    -- ── string interpolation ──
    -- The compiler emitted a string literal's braces verbatim, so every
    -- interpolated string in a native build printed the source text of what
    -- it should have interpolated — silently, with no error, and with a
    -- length to match. The rules are the interpreter's, checked against it
    -- here: `{X}` interpolates only when X starts with a letter or an
    -- underscore, braces nest, an unbalanced brace is literal, and an
    -- expression that does not parse stays as the text it was written as.
    same("interp_name", "let name = \"world\"\nshow \"hello {name}\"")
    same("interp_length", "let n = 42\nshow len(\"a{n}b\")")
    same("interp_expression", "let n = 7\nshow \"n is {n}, twice {n * 2}\"")
    same("interp_call", "fn f(x) { return x * 2 }\nlet n = 7\nshow \"call {f(n)}\"")
    same("interp_index_and_member", "let xs = [1, 2]\nlet m = { \"a\": 9 }\nshow \"idx {xs[0]} member {m.a}\"")
    same("interp_collections", "let xs = [1, 2]\nlet ss = [\"a\", \"b\"]\nlet m = { \"a\": 1 }\nshow \"l={xs} s={ss} m={m}\"")
    same("interp_scalars", "let f = 3.5\nlet t = true\nlet z = null\nshow \"f={f} t={t} z={z}\"")
    same("interp_to_string", "class P {\n    fn init() {}\n    fn to_string() { return \"P7\" }\n}\nshow \"obj {P()}\"")
    -- A brace that is not interpolation stays as written, which is what lets
    -- a program print code.
    same("interp_prose", "show \"if true { 1 } else { 2 }\"")
    same("interp_unbalanced", "show \"unbalanced {name\"\nshow \"brace only {\"")
    same("interp_not_an_identifier", "show \"digit {1 + 2}\"\nshow \"empty {}\"")
    same("interp_raw_string", "let n = 5\nshow r\"raw {n}\"\nshow \"cooked {n}\"")
    -- Two interpolations are two operands of one C expression, and C picks
    -- the order it evaluates them in — so they go through temporaries in
    -- source order, as the interpreter evaluates them.
    same("interp_order", "mut c = 0\nfn bump() { c += 1; return c }\nshow \"{bump()} then {bump()}\"")
    same("interp_in_a_generator", "fn labels(n) {\n    mut i = 0\n    while i < n {\n        yield \"item-{i}\"\n        i += 1\n    }\n}\nshow labels(3)")
    same("interp_in_a_method", "class Box {\n    fn init(n) { this.n = n }\n    fn label() { return \"box {this.n}\" }\n}\nshow Box(4).label()")
    same("interp_in_a_closure", "let n = 3\nshow map([1, 2], fn(x) { return \"v{x} of {n}\" })")
    -- Every piece is a fresh heap string, so a collection mid-run has to see
    -- the temporaries the concatenation is holding.
    same_gc("interp_gc", "mut junk = []\nmut i = 0\nwhile i < 20000 {\n    junk = [\"x{i}\"]\n    i += 1\n}\nshow \"done {len(junk)} at {i}\"")

    -- ── to_string ──
    -- Native already rendered an instance through its to_string; what it did
    -- not do was survive one that throws, which the other two engines fall
    -- back from rather than letting a `show` end the program.
    same("to_string_throws", "class S {\n    fn init() {}\n    fn to_string() { throw \"nope\" }\n}\nshow S()\nshow \"after {S()}\"")
    same("to_string_throws_in_a_collection", "class S {\n    fn init() {}\n    fn to_string() { throw \"nope\" }\n}\nshow [S(), S()]")
    same("to_string_throw_does_not_break_a_real_try", "class S {\n    fn init() {}\n    fn to_string() { throw \"nope\" }\n}\ntry {\n    show S()\n    throw \"real\"\n} catch e { show \"caught \" + str(e) }")

    -- ── display and repr ──
    -- Builtins in both other engines and nothing here, so a program calling
    -- one failed with a C compiler error about an undeclared `v_display`.
    same("display_values", "show display(5)\nshow display(1.5)\nshow display(\"s\")\nshow display(true)\nshow display(null)\nshow display([1, 2])\nshow display([\"a\", \"b\"])\nshow display({\"a\": 1, \"b\": \"x\"})")
    same("display_instance", "class Q {\n    fn init() { this.n = 1 }\n}\nclass P {\n    fn init(v) { this.v = v }\n    fn to_string() { return \"P<{this.v}>\" }\n}\nshow display(Q())\nshow display(P(7))")
    same("repr_values", "show repr(\"s\")\nshow repr(5)\nshow repr([1, \"a\"])\nshow repr({\"k\": \"v\"})")
    -- A builtin missing from _NATIVE_BUILTINS is captured rather than called
    -- when a closure names it, so check both through one.
    same("display_in_a_closure", "show map([1, [2, 3], \"s\"], fn(x) { return display(x) })\nshow map([\"a\", 1], fn(x) { return repr(x) })")

    -- ── evaluation order ──
    -- The emitter builds every multi-operand construct as one C expression,
    -- and C does not define the order a call's arguments are evaluated in.
    -- GCC picks right to left, so every operand with a side effect ran
    -- backwards relative to `clarity run`: `[bump(), bump()]` was [2, 1]
    -- against the interpreter's [1, 2]. Each case records the order the
    -- operands actually ran in and diffs it against the interpreter.
    same("order_list", "mut log = []\nfn t(name, v) { push(log, name); return v }\nshow [t(\"a\", 1), t(\"b\", 2), t(\"c\", 3)]\nshow log")
    same("order_map", "mut log = []\nfn t(name, v) { push(log, name); return v }\nshow { \"x\": t(\"a\", 1), \"y\": t(\"b\", 2) }\nshow log")
    same("order_binary", "mut log = []\nfn t(name, v) { push(log, name); return v }\nshow str(t(\"l\", 1)) + str(t(\"r\", 2))\nshow log")
    same("order_call_arguments", "mut log = []\nfn t(name, v) { push(log, name); return v }\nfn two(a, b) { return [a, b] }\nshow two(t(\"a\", 1), t(\"b\", 2))\nshow log")
    same("order_method_receiver_first", "mut log = []\nfn t(name, v) { push(log, name); return v }\nclass Box {\n    fn init(n) { this.n = n }\n    fn add(a, b) { return this.n + a + b }\n}\nshow t(\"recv\", Box(10)).add(t(\"x\", 1), t(\"y\", 2))\nshow log")
    same("order_index", "mut log = []\nfn t(name, v) { push(log, name); return v }\nlet xs = [[1, 2], [3, 4]]\nshow t(\"obj\", xs)[t(\"idx\", 1)]\nshow log")
    same("order_range", "mut log = []\nfn t(name, v) { push(log, name); return v }\nshow t(\"s\", 0)..t(\"e\", 3)\nshow log")
    same("order_pipe", "mut log = []\nfn t(name, v) { push(log, name); return v }\nfn tri(a, b, c) { return a + b + c }\nshow t(\"p\", 1) |> tri(t(\"q\", 2), t(\"r\", 3))\nshow log")
    same("order_nested", "mut log = []\nfn t(name, v) { push(log, name); return v }\nfn two(a, b) { return a + b }\nshow [two(t(\"a\", 1), t(\"b\", 2)), two(t(\"c\", 3), t(\"d\", 4))]\nshow log")
    -- The other half of the same question: if an operand throws, the ones
    -- after it must not have run.
    same("order_throw_stops_the_rest", "mut log = []\nfn t(name, v) { push(log, name); return v }\nfn boom() { throw \"x\" }\ntry { show [t(\"first\", 1), boom(), t(\"never\", 2)] } catch e { show \"caught\" }\nshow log")
    -- `a or b` needs a twice, and naming it twice in the C ternary ran it
    -- twice: `bump() or false` left the counter at 2 and handed back the
    -- second call's value.
    same("order_or_evaluates_once", "mut c = 0\nfn bump() { c += 1; return c }\nshow bump() or false\nshow c")
    same("order_and_evaluates_once", "mut c = 0\nfn zero() { c += 1; return 0 }\nshow zero() and true\nshow c")
    same("order_short_circuit_still_skips", "mut log = []\nfn t(name, v) { push(log, name); return v }\nshow false and t(\"skipped\", 1)\nshow true or t(\"also skipped\", 1)\nshow log")
    -- Ordering binds the operands to temporaries, and the collection is
    -- then built through a named local: every cl_list_add allocates, and a
    -- half-built list living only in a register between two of them is
    -- invisible to a collector that scans the stack.
    same_gc("order_collection_gc", "mut junk = []\nmut i = 0\nwhile i < 20000 {\n    junk = [str(i), str(i + 1)]\n    i += 1\n}\nshow junk\nmut m = {}\nmut k = 0\nwhile k < 20000 {\n    m = { \"a\": str(k), \"b\": str(k + 1) }\n    k += 1\n}\nshow m")

    -- ── equality ──
    -- `==` compared a list or a map by its pointer, so [1, 2] == [1, 2] was
    -- false in a native build and true in both other engines: every native
    -- program that compared collections was silently wrong. And every
    -- pointer-backed value fell through to a comparison of the Value's
    -- integer field, which is 0 in all of them, so any two closures were
    -- equal.
    same("eq_lists", "show [1, 2] == [1, 2]\nshow [1, 2] == [2, 1]\nshow [1, 2] == [1, 2, 3]\nshow [] == []\nshow [1, 2] != [1, 2]\nshow [1, 2] != [2, 1]")
    same("eq_nested_lists", "show [1, [2, [3]]] == [1, [2, [3]]]\nshow [1, [2, [3]]] == [1, [2, [4]]]")
    same("eq_maps", "show {\"a\": 1, \"b\": 2} == {\"b\": 2, \"a\": 1}\nshow {\"a\": 1} == {\"a\": 2}\nshow {\"a\": 1} == {\"a\": 1, \"b\": 2}\nshow {} == {}")
    same("eq_across_types", "show [1] == 1\nshow [1] == \"1\"\nshow [1] == null\nshow {\"a\": 1} == [1]\nshow [1.0] == [1]\nshow [null] == [null]\nshow [true] == [true]\nshow [\"a\"] == [\"a\"]")
    -- An instance is still identity, as in every engine.
    same("eq_instances", "class C {\n    fn init(v) { this.v = v }\n}\nlet c = C(1)\nshow C(1) == C(1)\nshow c == c\nshow [C(1)] == [C(1)]")
    same("eq_closures", "let f = fn(x) { return x }\nlet g = fn(x) { return x }\nshow f == g\nshow f == f\nfn h() { return 1 }\nfn k() { return 2 }\nshow h == k\nshow h == h\nshow [h] == [h]")
    same("eq_closure_from_the_same_expression", "fn mk() { return fn(x) { return x } }\nshow mk() == mk()")
    -- `when` compares with the same equality, so an arm matching a list
    -- never fired natively.
    same("eq_in_a_match", "let v = [1, 2]\nmatch v {\n    when [1, 2] { show \"pair\" }\n    else { show \"other\" }\n}")
    same_gc("eq_gc", "mut junk = []\nmut i = 0\nwhile i < 20000 {\n    junk = [str(i)]\n    i += 1\n}\nshow [\"a\", \"b\"] == [\"a\", \"b\"]\nshow {\"k\": [1, 2]} == {\"k\": [1, 2]}")
    -- The collection is a local holding heap values, so mid-run collection
    -- has to see it through the C stack.
    same_gc("gen_gc", "fn words(n) {\n    mut i = 0\n    while i < n {\n        yield \"item-\" + str(i)\n        i += 1\n    }\n}\nmut junk = []\nmut k = 0\nwhile k < 20000 {\n    junk = [str(k)]\n    k += 1\n}\nshow words(4)")

    -- ── indexing and property access ──
    -- Native answered null for every one of these: indexing null, reading a
    -- property of null, an index past either end, a property an object does
    -- not have. A compiled program carried the mistake onwards instead of
    -- stopping at it, and a `try` written to catch exactly this never fired.
    same("index_what_cannot_be_indexed", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet z = null\nlet n = 5\nlet b = true\nt(\"null[0]\", fn() { return z[0] })\nt(\"null.f\", fn() { return z.f })\nt(\"int[0]\", fn() { return n[0] })\nt(\"int.f\", fn() { return n.f })\nt(\"bool[0]\", fn() { return b[0] })\nt(\"bool.f\", fn() { return b.f })")
    same("index_list_bounds", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet xs = [1, 2]\nt(\"[0]\", fn() { return xs[0] })\nt(\"[-1]\", fn() { return xs[-1] })\nt(\"[2]\", fn() { return xs[2] })\nt(\"[-3]\", fn() { return xs[-3] })\nt(\"[str]\", fn() { return xs[\"a\"] })")
    same("index_string_bounds", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet s = \"ab\"\nt(\"[0]\", fn() { return s[0] })\nt(\"[-1]\", fn() { return s[-1] })\nt(\"[2]\", fn() { return s[2] })\nt(\"[-3]\", fn() { return s[-3] })")
    same("index_map_and_instance", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nclass C {\n    fn init() { this.a = 1 }\n}\nlet m = {\"a\": 1}\nlet c = C()\nt(\"map[a]\", fn() { return m[\"a\"] })\nt(\"map[b]\", fn() { return m[\"b\"] })\nt(\"map.b\", fn() { return m.b })\nt(\"map[0]\", fn() { return m[0] })\nt(\"obj.a\", fn() { return c.a })\nt(\"obj.missing\", fn() { return c.missing })\nt(\"obj[a]\", fn() { return c[\"a\"] })\nt(\"obj[0]\", fn() { return c[0] })")
    -- `?.` did not compile at all, so the one way to read a field that might
    -- not be there was unavailable in a native build.
    same("optional_chaining", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nclass C {\n    fn init() { this.a = 1 }\n}\nlet z = null\nlet c = C()\nlet m = {\"a\": 1}\nt(\"null?.f\", fn() { return z?.f })\nt(\"obj?.a\", fn() { return c?.a })\nt(\"obj?.missing\", fn() { return c?.missing })\nt(\"map?.a\", fn() { return m?.a })\nt(\"map?.b\", fn() { return m?.b })\nt(\"int?.f\", fn() { return 5?.f })\nt(\"chain\", fn() { return z?.a?.b })")
    -- The error a bounds failure raises is a real throw, catchable where it
    -- happens and not only at the top.
    same("index_error_is_catchable_in_place", "let xs = [1]\nmut seen = []\nfor i in [0, 1, 2] {\n    try { push(seen, xs[i]) } catch e { push(seen, \"miss\") }\n}\nshow seen")

    -- ── destructuring, spread, and the rest of what examples/ needs ──
    -- `clarity cc` refused DestructureLetStatement, MultiAssignStatement and
    -- SpreadExpression outright, which is what kept the last examples from
    -- compiling. Everything here is diffed against the interpreter.
    same("destructure_list", "let [a, b] = [1, 2]\nshow a\nshow b\nlet [c, d, e] = [1, 2]\nshow e\nlet [f, ...rest] = [1, 2, 3, 4]\nshow f\nshow rest\nlet [g, ...none] = [1]\nshow none")
    same("destructure_map", "let {x, y} = { \"x\": 1, \"y\": 2, \"z\": 3 }\nshow x\nshow y\nlet {q} = { \"x\": 1 }\nshow q")
    same("destructure_wrong_type", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nt(\"list pattern\", fn() { let [a, b] = 5\n    return a })\nt(\"map pattern\", fn() { let {a} = 5\n    return a })")
    same("destructure_in_a_function", "fn swap_ends(xs) {\n    let [first, ...rest] = xs\n    return [rest, first]\n}\nshow swap_ends([1, 2, 3])")
    same("multi_assign", "mut x = 1\nmut y = 2\nx, y = y, x\nshow x\nshow y\nmut a = 0\nmut b = 0\na, b = 1 + 1, 2 + 2\nshow a\nshow b")
    same("multi_assign_into_a_collection", "let xs = [0, 0]\nlet m = { \"k\": 0 }\nxs[0], m[\"k\"] = 7, 8\nshow xs\nshow m")
    same("spread_into_a_call", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nfn three(p, q, r) { return [p, q, r] }\nlet xs = [2, 3]\nt(\"only\", fn() { return three(...[1, 2, 3]) })\nt(\"after\", fn() { return three(1, ...xs) })\nt(\"empty\", fn() { return three(1, 2, ...[]) })")
    same("spread_into_a_rest_parameter", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nfn rest_fn(a, ...rest) { return [a, rest] }\nlet xs = [2, 3]\nt(\"rest\", fn() { return rest_fn(1, ...xs) })\nt(\"non-list\", fn() { return rest_fn(...5) })")
    same("spread_into_a_list", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet xs = [2, 3]\nt(\"middle\", fn() { return [1, ...xs, 4] })\nt(\"only\", fn() { return [...xs] })\nt(\"empty\", fn() { return [...[], 1] })\nt(\"non-list\", fn() { return [1, ...5] })")
    same("spread_into_a_map", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet m = {\"a\": 1, \"b\": 2}\nt(\"after\", fn() { return {...m, \"c\": 3} })\nt(\"before\", fn() { return {\"a\": 9, ...m} })\nt(\"overridden\", fn() { return {...m, \"a\": 9} })\nt(\"two\", fn() { return {...m, ...{\"c\": 3}} })\nt(\"non-map\", fn() { return {...\"x\"} })")
    same("spread_into_a_constructor", "class P {\n    fn init(a, b) { this.a = a; this.b = b }\n    fn sum() { return this.a + this.b }\n}\nshow P(...[2, 3]).sum()")
    same("spread_into_a_method", "class Box {\n    fn init() {}\n    fn add(a, b) { return a + b }\n}\nshow Box().add(...[2, 3])")
    -- A decorator rebinds the function's name to what it returns, so the name
    -- is a value and calls go through it.
    same("decorated_function", "fn twice(f) {\n    return fn(...args) { f(...args); f(...args) }\n}\n@twice\nfn hello() { show \"hi\" }\nhello()")
    same("decorated_function_as_a_value", "fn tag(f) {\n    return fn(x) { return \"<\" + str(f(x)) + \">\" }\n}\n@tag\nfn double(x) { return x * 2 }\nshow double(4)\nshow map([1, 2], double)")
    -- `await x` is x, here as in the interpreter: there is no scheduler.
    same("await_is_its_value", "fn fetch_it() { return 7 }\nasync fn go() {\n    let v = await fetch_it()\n    return v + 1\n}\nshow go()")
    -- `show a, b` is one line with a space between.
    same("show_several_values", "let xs = [1, 2]\nshow \"a:\", xs\nshow 1, 2, 3\nshow \"x\"")
    -- Dividing by zero is an error, as in both other engines; `%` by zero is
    -- NaN, and NaN prints as NaN rather than C's own spelling.
    same("division_by_zero", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nt(\"int\", fn() { return 1 / 0 })\nt(\"float\", fn() { return 1.0 / 0.0 })\nt(\"mod\", fn() { return 1 % 0 })")
    -- A function stored in a map or a field is called before a method of the
    -- same name, and a callee that is any other expression is called too.
    same("calling_a_stored_function", "fn t(label, f) { try { show label + \": \" + str(f()) } catch e { show label + \": THROWS\" } }\nlet m = { \"f\": fn(x) { return x * 2 } }\nt(\"map\", fn() { return m.f(3) })\nt(\"indexed\", fn() { return m[\"f\"](3) })\nclass C {\n    fn init() { this.g = fn(x) { return x + 1 } }\n    fn meth(x) { return x * 10 }\n}\nlet c = C()\nt(\"method\", fn() { return c.meth(2) })\nt(\"field\", fn() { return c.g(2) })")

    -- Every file in examples/ compiles. That was the roadmap item this work
    -- closes, and it is the kind of claim that goes stale silently, so it is
    -- checked rather than asserted: the compiler is handed each example and
    -- has to produce C for it. Running them is a separate matter — the FFI
    -- examples are native-only and have no interpreter counterpart.
    let _ex_dir = if exists("examples") { "examples" } else { "../examples" }
    if exists(_ex_dir) {
        mut _ex_total = 0
        mut _ex_refused = []
        for _ex_name in split(trim(exec("ls " + _ex_dir + " | grep '\\.clarity$'")), "\n") {
            let _ex_file = _ex_dir + "/" + trim(_ex_name)
            if len(trim(_ex_name)) > 0 and exists(_ex_file) {
                _ex_total += 1
                let _ex_src = read(_ex_file)
                try {
                    compile_to_c(parse(tokenize(_ex_src, _ex_file), _ex_src))
                } catch _ex_err {
                    push(_ex_refused, trim(_ex_name) + ": " + str(_ex_err))
                }
            }
        }
        assert_eq(_ex_total >= 17, true, "every example was found (" + str(_ex_total) + ")")
        assert_eq(len(_ex_refused), 0, "every example compiles: " + join(_ex_refused, "; "))
    }

    -- ── stage 4: closures ──
    same("closure_map", "show map([1, 2, 3], fn(x) { return x * 2 })")
    same("closure_capture", "let factor = 10\nshow map([1, 2, 3], fn(x) { return x * factor })")
    same("closure_filter", "show filter([1, 2, 3, 4, 5, 6], fn(x) { return x % 2 == 0 })")
    same("closure_reduce", "show reduce([1, 2, 3, 4], fn(a, b) { return a + b }, 0)")
    same("closure_var_call", "let add = fn(a, b) { return a + b }\nshow add(3, 4)")
    same("closure_returns_closure", "fn adder(n) { return fn(x) { return x + n } }\nlet add5 = adder(5)\nshow add5(10)\nshow add5(100)")
    same("closure_multi_capture", "let a = 1\nlet b = 100\nshow map([1, 2, 3], fn(x) { return x * a + b })")
    -- closures capture collections/objects by their (shared) pointer, so
    -- mutating through the capture is visible outside — matching the interpreter.
    same("closure_captures_list", "let acc = []\neach([1, 2, 3], fn(x) { push(acc, x * x) })\nshow acc")
    same("closure_captures_object", "class Box { fn init() { this.n = 0 }\nfn add(x) { this.n = this.n + x } }\nlet b = Box()\neach([1, 2, 3, 4], fn(x) { b.add(x) })\nshow b.n")

    -- ── stage 5/6: allocation, then the mark-sweep GC ──
    -- Heavy allocation crosses the GC threshold and exercises list-growth-by-
    -- copy; output must still match the interpreter exactly.
    same("arena_bulk_alloc", "mut acc = []\nmut i = 0\nwhile i < 30000 { push(acc, i * 2)\ni = i + 1 }\nshow len(acc)\nshow acc[29999]\nshow acc[0]")
    same("arena_string_churn", "mut s = \"\"\nmut i = 0\nwhile i < 2000 { s = s + \"ab\"\ni = i + 1 }\nshow len(s)")
    -- Heavy allocation through the GC-tracked allocator (mid-run collection is
    -- off by default — see CLARITY_GC): live data must remain correct while a
    -- lot of per-iteration garbage is allocated and dropped.
    same("gc_live_data_correct", "mut kept = []\nmut i = 0\nwhile i < 20000 { let junk = [i, i, i, i]\npush(kept, i * 2)\ni = i + 1 }\nshow len(kept)\nshow kept[0]\nshow kept[19999]")
    -- A captured, mutated collection inside a returned closure stays correct
    -- across a lot of allocation.
    same("gc_closure_state_correct", "fn counter() { mut c = [0]\nreturn fn() { c[0] = c[0] + 1\nreturn c[0] } }\nlet next = counter()\nmut i = 0\nwhile i < 20000 { let g = [i, i, i]\nnext()\ni = i + 1 }\nshow next()")

    -- ── stage 7: native app stdlib — strings, file I/O, args/env ──
    same("str_case_trim", "show upper(trim(\"  hi there  \"))\nshow lower(\"MixEd\")")
    same("str_split_join", "show split(\"a,b,c\", \",\")\nshow join([\"x\", \"y\", \"z\"], \"-\")\nshow split(\"one two three\", \" \")")
    same("str_replace", "show replace(\"foo bar foo baz\", \"foo\", \"X\")")
    same("str_starts_ends", "show starts(\"hello\", \"he\")\nshow ends(\"hello\", \"lo\")\nshow starts(\"hello\", \"x\")")
    same("str_substring", "show substring(\"clarity\", 0, 5)\nshow substring(\"clarity\", 3, 7)\nshow substring(\"clarity\", -3, 5)")
    same("str_chars_index", "show char_at(\"abc\", 1)\nshow char_code(\"A\")\nshow from_char_code(66)\nshow index_of(\"hello world\", \"world\")\nshow index_of(\"abc\", \"z\")")
    same("str_pad_repeat_chars", "show pad_left(\"7\", 4) + \"|\"\nshow pad_right(\"7\", 4) + \"|\"\nshow repeat(\"ab\", 3)\nshow chars(\"hi\")")
    same("str_predicates", "show is_digit(\"123\")\nshow is_digit(\"12a\")\nshow is_alpha(\"abc\")\nshow is_alnum(\"a1b2\")\nshow is_space(\"   \")")
    same("str_int_float_conv", "show int(\"42\") + 8\nshow float(\"3.5\") * 2.0\nlet nums = map(split(\"5 10 15\", \" \"), fn(x) { return int(x) })\nshow reduce(nums, fn(a, b) { return a + b }, 0)")

    -- File I/O: write then read back, exists, line count. Both the interpreter
    -- and the native binary hit the real filesystem, so results must match.
    same("file_write_read", "let p = \"/tmp/_clc_s7_file.txt\"\nwrite(p, \"line1\\nline2\\nline3\")\nshow read(p)\nshow exists(p)\nshow exists(\"/tmp/_clc_nope_xyz\")\nshow len(lines(p))")
    same("file_append", "let p = \"/tmp/_clc_s7_app.txt\"\nwrite(p, \"a\")\nappend(p, \"b\")\nappend(p, \"c\")\nshow read(p)")

    -- ── stage 8: exec/process + math ──
    same("math_basic", "show abs(-5)\nshow abs(-3.5)\nshow floor(3.7)\nshow ceil(3.2)\nshow round(2.5)\nshow round(3.14159, 2)\nshow sqrt(16.0)")
    same("math_agg", "show sum([1, 2, 3, 4])\nshow min([3, 1, 2])\nshow max([3, 1, 2])\nshow min(5, 3)\nshow max(5, 3)\nshow sum([1.5, 2.5])")
    -- exec: both the interpreter and the native binary run the real shell command
    same("exec_echo", "show exec(\"echo hello\")\nshow exec(\"echo one; echo two\")")
    same("exec_full_cmd", "show trim(exec_full(\"echo hi\").stdout)\nshow exec_full(\"echo hi\").exit_code\nshow exec_full(\"exit 3\").exit_code")

    -- ── stage 9: JSON (single-quoted JSON literals keep the escaping sane) ──
    same("json_parse_display", "let o = json_parse('{\"name\": \"Kyan\", \"age\": 3, \"pi\": 3.14, \"ok\": true, \"nil\": null, \"tags\": [\"a\", \"b\"]}')\nshow o\nshow o.name\nshow o.tags[1]\nshow o.pi")
    same("json_parse_nested", "let o = json_parse('{\"a\": 1, \"nested\": {\"x\": [10, 20, 30]}}')\nshow o.a\nshow o.nested.x[2]\nshow len(keys(o))")
    same("json_string_basic", "show json_string({\"a\": 1, \"b\": [true, null, \"x\"], \"c\": {\"d\": 2.5}})")
    same("json_string_types", "show json_string([1, \"two\", false])\nshow json_string(\"hi\\nthere\")")
    same("json_roundtrip", "let s = '{\"k\": [1, 2, 3], \"s\": \"hello\", \"n\": 42}'\nshow json_string(json_parse(s))")
    same("json_numbers", "let o = json_parse('[1, 2.5, -3, 100]')\nshow o\nshow sum(o)")

    -- ── stage 10: binary I/O + bitwise ops (RE/mod foundation) ──
    same("bitwise_ops", "show 12 & 10\nshow 12 | 10\nshow 12 ^ 10\nshow 1 << 4\nshow 255 >> 4\nshow 6 & 3 | 8")
    same("bitwise_precedence", "show 1 + 2 << 3\nshow (255 & 15) + (1 << 2)")
    -- little-endian u32 decode from raw bytes — the core RE primitive. The high
    -- byte sets bit 31, so the current 32-bit-signed semantics wrap it negative;
    -- native must match the interpreter exactly (pins the semantics for the
    -- planned 64-bit-bitwise follow-up).
    same("le_u32_decode", "let b = [33, 67, 101, 135]\nshow b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24)")
    -- big-endian u16 decode
    same("be_u16_decode", "let b = [1, 44]\nshow (b[0] << 8) | b[1]")
    same("bytes_roundtrip", "write_bytes(\"/tmp/_clc_b10.bin\", [72, 105, 33, 0, 255])\nlet r = read_bytes(\"/tmp/_clc_b10.bin\")\nshow r\nshow len(r)\nshow r[0]\nshow r[4]")
    -- magic-byte sniffing: does the file start with the PNG signature?
    same("magic_sniff", "write_bytes(\"/tmp/_clc_png.bin\", [137, 80, 78, 71, 13, 10, 26, 10, 99])\nlet b = read_bytes(\"/tmp/_clc_png.bin\")\nlet png = [137, 80, 78, 71]\nmut ok = true\nfor i in range(4) { if b[i] != png[i] { ok = false } }\nshow ok\nshow b[1]")

    -- ── stage 11: native FFI — call C directly from a compiled binary ──
    -- (native-only: the interpreter's FFI is a separate Bun-based surface)
    nat_eq("ffi_strlen", "show ffi_call(\"strlen\", \"ls\", [\"hello, world\"])", "12")
    nat_eq("ffi_abs", "show ffi_call(\"abs\", \"ll\", [-7])", "7")
    nat_eq("ffi_toupper", "show ffi_call(\"toupper\", \"ll\", [97])", "65")
    -- ffi_sym resolves a real symbol to a non-zero address
    nat_eq("ffi_sym", "let a = ffi_sym(\"strlen\")\nshow a != 0\nshow ffi_sym(\"no_such_symbol_xyz\")", "true\n0")
    -- compose: use an FFI result in ordinary Clarity control flow
    nat_eq("ffi_compose", "let n = ffi_call(\"strlen\", \"ls\", [\"clarity\"])\nif n > 5 { show \"long: \" + str(n) } else { show \"short\" }", "long: 7")

    -- ── stage 12: RE byte toolkit (bytes.clarity) compiles for free ──
    -- These are the real bytes.clarity function bodies, inlined so the harness
    -- (which doesn't resolve module imports) can compile them. Each proves the
    -- pure-Clarity RE primitives produce identical output native vs interpreter.

    -- Unsigned readers use arithmetic, not `<< 24`, so a high u32 stays UNSIGNED
    -- (0x87654321 = 2271560481) instead of sign-wrapping like the stage-10
    -- `le_u32_decode` case does; the signed reader wraps it back explicitly.
    same("re_readers", "fn u16le(b,o){return b[o]+b[o+1]*256}\nfn u32le(b,o){return b[o]+b[o+1]*256+b[o+2]*65536+b[o+3]*16777216}\nfn i32le(b,o){let v=u32le(b,o)\nif v>=2147483648{return v-4294967296}\nreturn v}\nlet b=[33,67,101,135]\nshow u16le(b,0)\nshow u32le(b,0)\nshow i32le(b,0)")

    -- big-endian readers + a 64-bit little-endian read (exact below 2^53)
    same("re_be_u64", "fn u16be(b,o){return b[o]*256+b[o+1]}\nfn u32be(b,o){return b[o]*16777216+b[o+1]*65536+b[o+2]*256+b[o+3]}\nfn u32le(b,o){return b[o]+b[o+1]*256+b[o+2]*65536+b[o+3]*16777216}\nfn u64le(b,o){return u32le(b,o)+u32le(b,o+4)*4294967296}\nshow u16be([1,44],0)\nshow u32be([222,173,190,239],0)\nshow u64le([33,67,101,135,1,0,0,0],0)")

    -- writers append encoded bytes onto a buffer; read them back unsigned
    same("re_writers", "fn u32le(b,o){return b[o]+b[o+1]*256+b[o+2]*65536+b[o+3]*16777216}\nfn put_u32le(b,v){push(b,v&255)\npush(b,(v>>8)&255)\npush(b,(v>>16)&255)\npush(b,(v>>24)&255)}\nmut w=[]\nput_u32le(w,3735928559)\nshow w\nshow u32le(w,0)")

    -- hex formatting
    same("re_hex", "fn hexch(n){return char_at(\"0123456789abcdef\",n&15)}\nfn hex_byte(v){let b=v&255\nreturn hexch((b>>4)&15)+hexch(b&15)}\nfn to_hex(buf){mut p=[]\nfor b in buf{push(p,hex_byte(b))}\nreturn join(p,\" \")}\nshow hex_byte(15)\nshow hex_byte(167)\nshow to_hex([127,69,76,70])")

    -- AOB signature scanning with wildcards — the RE centrepiece. code is a tiny
    -- x86-64 prologue: 55 48 89 E5 (push rbp; mov rbp,rsp) then E8 rel32 (call).
    same("re_scan", "fn hexval(ch){let c=char_code(ch)\nif c>=48 and c<=57{return c-48}\nif c>=97 and c<=102{return c-87}\nif c>=65 and c<=70{return c-55}\nreturn -1}\nfn parse_pattern(sig){mut out=[]\nfor tok in split(trim(sig),\" \"){if len(tok)==0{continue}\nif tok==\"??\" or tok==\"?\" or tok==\"*\"{push(out,-1)\ncontinue}\nif len(tok)==2{let hi=hexval(char_at(tok,0))\nlet lo=hexval(char_at(tok,1))\nif hi>=0 and lo>=0{push(out,hi*16+lo)\ncontinue}}\npush(out,-1)}\nreturn out}\nfn match_at(buf,pat,off){let n=len(pat)\nif off<0 or off+n>len(buf){return false}\nmut i=0\nwhile i<n{let p=pat[i]\nif p>=0 and buf[off+i]!=p{return false}\ni=i+1}\nreturn true}\nfn find_pattern(buf,pat){let n=len(pat)\nif n==0{return -1}\nlet last=len(buf)-n\nmut off=0\nwhile off<=last{if match_at(buf,pat,off){return off}\noff=off+1}\nreturn -1}\nfn scan(buf,sig){return find_pattern(buf,parse_pattern(sig))}\nlet code=[85,72,137,229,232,17,34,51,68,195]\nshow parse_pattern(\"48 8B ?? E8\")\nshow scan(code,\"E8 ?? ?? ?? ??\")\nshow scan(code,\"48 89 E5\")\nshow scan(code,\"90 90 90\")")

    -- find_all: every offset a pattern matches
    same("re_find_all", "fn match_at(buf,pat,off){let n=len(pat)\nif off<0 or off+n>len(buf){return false}\nmut i=0\nwhile i<n{let p=pat[i]\nif p>=0 and buf[off+i]!=p{return false}\ni=i+1}\nreturn true}\nfn find_all(buf,pat){mut hits=[]\nlet n=len(pat)\nif n==0{return hits}\nlet last=len(buf)-n\nmut off=0\nwhile off<=last{if match_at(buf,pat,off){push(hits,off)}\noff=off+1}\nreturn hits}\nshow find_all([171,0,171,0,171],[171])")

    -- classic hex dump (all-printable input keeps the ascii gutter ASCII-clean)
    same("re_hexdump", "fn hexch(n){return char_at(\"0123456789abcdef\",n&15)}\nfn hex_byte(v){let b=v&255\nreturn hexch((b>>4)&15)+hexch(b&15)}\nfn hexdump(buf){mut out=[]\nlet total=len(buf)\nmut row=0\nwhile row<total{mut oh=\"\"\nmut sh=28\nwhile sh>=0{oh=oh+hexch((row>>sh)&15)\nsh=sh-4}\nmut hp=\"\"\nmut ap=\"\"\nmut col=0\nwhile col<16{let idx=row+col\nif idx<total{let b=buf[idx]\nhp=hp+hex_byte(b)+\" \"\nif b>=32 and b<127{ap=ap+from_char_code(b)}else{ap=ap+\".\"}}else{hp=hp+\"   \"}\ncol=col+1}\npush(out,oh+\"  \"+hp+\" |\"+ap+\"|\")\nrow=row+16}\nreturn join(out,\"\\n\")}\nshow hexdump([72,105,33])")

    -- ── stage 13: live-process memory access (read_mem builtin) ──
    -- read_mem/proc are Linux-only, and addresses differ between the interpreter
    -- and the compiled process, so this is a native-only property check rather
    -- than a same()-diff: the compiled binary reads its OWN /proc/self/maps,
    -- resolves a mapping's base with read_mem, and confirms it sees the ELF magic
    -- of a mapped image in live memory. Proves the native read_mem path works.
    if IS_LINUX {
        nat_eq("mem_read_self_elf", "fn hx(s){mut v=0\nfor ch in chars(s){let c=char_code(ch)\nmut d=-1\nif c>=48 and c<=57{d=c-48}\nif c>=97 and c<=102{d=c-87}\nif c>=65 and c<=70{d=c-55}\nif d>=0{v=v*16+d}}\nreturn v}\nlet ls=lines(\"/proc/self/maps\")\nmut ok=false\nmut i=0\nwhile i<len(ls) and i<40 and not ok{let line=ls[i]\nlet dash=index_of(line,\"-\")\nif dash>0{let addr=hx(substring(line,0,dash))\nlet b=read_mem(0,addr,4)\nif len(b)==4 and b[0]==127 and b[1]==69 and b[2]==76 and b[3]==70{ok=true}}\ni=i+1}\nif ok{show \"ok\"}else{show \"no elf region found\"}", "ok")
    } else {
        show "-- stage 13 read_mem: non-Linux, native check skipped --"
    }

    -- ── stage 14: write_mem — poke a live process's memory ──
    -- Error path is portable: writing to unmapped address 0 returns 0 on every
    -- platform (open fails without /proc; pwrite fails with it).
    nat_eq("write_mem_badaddr", "show write_mem(0, 0, [1, 2, 3])", "0")
    -- Real mutation is Linux-only: build a unique marker string on the heap, find
    -- it in a writable region via read_mem, overwrite its first byte with 'Z',
    -- and confirm the string now reads 'Z' — self-modifying live memory, proving
    -- write_mem actually writes. Safe: it only touches its own heap string.
    if IS_LINUX {
        nat_eq("write_mem_mutate", "fn hx(s){mut v=0\nfor ch in chars(s){let c=char_code(ch)\nmut d=-1\nif c>=48 and c<=57{d=c-48}\nif c>=97 and c<=102{d=c-87}\nif c>=65 and c<=70{d=c-55}\nif d>=0{v=v*16+d}}\nreturn v}\nfn find_marker(m){let ls=lines(\"/proc/self/maps\")\nfor line in ls{let sp=index_of(line,\" \")\nif sp>0{let range=substring(line,0,sp)\nlet dash=index_of(range,\"-\")\nif dash>0{let perms=substring(line,sp+1,sp+5)\nif char_at(perms,0)==\"r\" and char_at(perms,1)==\"w\"{let start=hx(substring(range,0,dash))\nlet size=hx(substring(range,dash+1,len(range)))-start\nif size>0 and size<8388608{let buf=read_mem(0,start,size)\nmut i=0\nlet mlen=len(m)\nwhile i+mlen<=len(buf){mut ok=true\nmut j=0\nwhile j<mlen and ok{if buf[i+j]!=char_code(char_at(m,j)){ok=false}\nj=j+1}\nif ok{return start+i}\ni=i+1}}}}}}\nreturn -1}\nlet marker=\"CLARITY_WM_\"+\"MARK_\"+str(31337)+\"_END\"\nlet addr=find_marker(marker)\nmut result=\"notfound\"\nif addr>=0{write_mem(0,addr,[char_code(\"Z\")])\nif char_at(marker,0)==\"Z\"{result=\"ok\"}else{result=\"unchanged\"}}\nshow result", "ok")
    } else {
        show "-- stage 14 write_mem mutation: non-Linux, native check skipped --"
    }

    -- ── stage 15: 64-bit-capable bit manipulation (bits.clarity) ──
    -- Pure computation, so these diff native vs interpreter directly. The point
    -- is values ABOVE 2^31, where the plain `<<`/`&` operators (32-bit-signed)
    -- would mangle results but these arithmetic/decomposition helpers stay exact
    -- to 2^53.
    same("bits_shifts", "fn pow2(n){mut v=1\nmut i=0\nwhile i<n{v=v*2\ni=i+1}\nreturn v}\nfn shl(x,n){return x*pow2(n)}\nfn shr(x,n){return int(x/pow2(n))}\nfn mask(x,b){return x%pow2(b)}\nshow shl(255,32)\nshow shr(shl(255,32),32)\nshow mask(3735928559,16)\nshow pow2(48)")
    same("bits_getbits", "fn pow2(n){mut v=1\nmut i=0\nwhile i<n{v=v*2\ni=i+1}\nreturn v}\nfn get_bits(x,s,c){return int(x/pow2(s))%pow2(c)}\nshow get_bits(3735928559,16,16)\nshow get_bits(3735928559,0,16)\nshow get_bits(171*pow2(40),40,8)")
    same("bits_ops", "fn u32(r){if r<0{return r+4294967296}\nreturn r}\nfn band(a,b){let lo=u32((a%4294967296)&(b%4294967296))\nlet hi=u32(int(a/4294967296)&int(b/4294967296))\nreturn hi*4294967296+lo}\nfn bor(a,b){let lo=u32((a%4294967296)|(b%4294967296))\nlet hi=u32(int(a/4294967296)|int(b/4294967296))\nreturn hi*4294967296+lo}\nfn bxor(a,b){let lo=u32((a%4294967296)^(b%4294967296))\nlet hi=u32(int(a/4294967296)^int(b/4294967296))\nreturn hi*4294967296+lo}\nshow band(0x1000000FF,0x1FF)\nshow bor(0x100000000,0xFF)\nshow bxor(0x1000000FF,0x100000000)\nshow band(0xABCDEF012345,0xFFFFFF000000)")
    same("bits_tohex", "fn to_hex(x,d){mut v=x\nmut out=\"\"\nmut c=0\nwhile c<d{out=char_at(\"0123456789abcdef\",v%16)+out\nv=int(v/16)\nc=c+1}\nreturn out}\nshow to_hex(0xABCDEF012345,12)\nshow to_hex(255,2)\nshow to_hex(0,4)")

    -- ── stage 16: native FFI ffi_open — bind any shared library ──
    -- Native-only (the interpreter's FFI is a separate Bun surface), and
    -- Linux-gated (libm.so.6 path + --as-needed behaviour). This is the exact
    -- limitation stage 11 documented: under --as-needed the compiled binary
    -- never references libm, so `pow` isn't loaded and RTLD_DEFAULT can't find it
    -- (ffi_sym -> 0). ffi_open("libm.so.6") dlopen's it with RTLD_GLOBAL, and now
    -- ffi_sym/ffi_call reach it — pow(2, 10) = 1024.
    if IS_LINUX {
        nat_eq("ffi_open_libm", "show ffi_sym(\"pow\") != 0\nlet h = ffi_open(\"libm.so.6\")\nshow h != 0\nshow ffi_sym(\"pow\") != 0\nshow ffi_call(\"pow\", \"ddd\", [2.0, 10.0])", "false\ntrue\ntrue\n1024")
    } else {
        show "-- stage 16 ffi_open: non-Linux, native check skipped --"
    }

    -- ── stage 17: native FFI buffers + generic word-arg calls ──
    -- Portable (libc memset/memcpy/calloc on Linux and macOS): allocate a raw
    -- buffer, pass its pointer to a C function, and marshal the result back.
    -- Proves pointer args ('p') and the ffi_buffer/read/write path — the layer a
    -- real library binding (Capstone, a codec) needs. (Backward compat of the
    -- generic caller is covered by the stage-11 ffi_strlen/abs/toupper cases,
    -- which now route through the same path.)
    nat_eq("ffi_buffer_memset", "let b=ffi_buffer(8)\nffi_call(\"memset\",\"vpll\",[b,65,5])\nshow ffi_read(b,5)\nffi_free(b)", "[65, 65, 65, 65, 65]")
    nat_eq("ffi_buffer_memcpy", "let src=ffi_buffer(4)\nffi_write(src,[1,2,3,4])\nlet dst=ffi_buffer(4)\nffi_call(\"memcpy\",\"pppl\",[dst,src,4])\nshow ffi_read(dst,4)\nffi_free(src)\nffi_free(dst)", "[1, 2, 3, 4]")

    -- ── stage 18: function hooking (hook.clarity) ──
    -- x86-64 Linux only: resolve abs() via FFI, patch its prologue in live .text
    -- (through /proc/self/mem, which reaches read-only executable pages) so it
    -- returns 99, then restore the saved bytes. Proves inline code hooking works
    -- native and is reversible.
    if IS_X64 {
        nat_eq("hook_return", "fn ret_patch(v){return [184,v&255,(v>>8)&255,(v>>16)&255,(v>>24)&255,195]}\nfn hook_return(pid,addr,value){let p=ret_patch(value)\nlet orig=read_mem(pid,addr,len(p))\nif len(orig)!=len(p){return []}\nwrite_mem(pid,addr,p)\nreturn orig}\nlet addr=ffi_sym(\"abs\")\nshow ffi_call(\"abs\",\"ll\",[-7])\nlet saved=hook_return(0,addr,99)\nshow ffi_call(\"abs\",\"ll\",[-7])\nwrite_mem(0,addr,saved)\nshow ffi_call(\"abs\",\"ll\",[-7])", "7\n99\n7")
    } else {
        show "-- stage 18 hook: not x86-64 Linux, native check skipped --"
    }

    -- ── stage 19: binary-format DSL (binformat.clarity) ──
    -- Describe a layout as a list of field specs, then emit values -> bytes and
    -- parse bytes -> values. Pure computation, so it diffs native vs interpreter
    -- directly (the real module compiles for free the same way). u32be exercises
    -- the unsigned >2^31 path (magic 0xCAFEBABE = 3405691582).
    same("binformat_roundtrip", "fn put_u8(b,v){push(b,v&255)}\nfn put_u16le(b,v){push(b,v&255)\npush(b,(v>>8)&255)}\nfn put_u32be(b,v){push(b,(v>>24)&255)\npush(b,(v>>16)&255)\npush(b,(v>>8)&255)\npush(b,v&255)}\nfn u8(b,o){return b[o]}\nfn u16le(b,o){return b[o]+b[o+1]*256}\nfn u32be(b,o){return b[o]*16777216+b[o+1]*65536+b[o+2]*256+b[o+3]}\nfn tsize(t){if t==\"u8\"{return 1}\nif t==\"u16le\"{return 2}\nif t==\"u32be\"{return 4}\nreturn 0}\nfn rd(b,o,t){if t==\"u8\"{return u8(b,o)}\nif t==\"u16le\"{return u16le(b,o)}\nif t==\"u32be\"{return u32be(b,o)}\nreturn 0}\nfn wr(b,v,t){if t==\"u8\"{put_u8(b,v)}\nelif t==\"u16le\"{put_u16le(b,v)}\nelif t==\"u32be\"{put_u32be(b,v)}}\nfn emit(fmt,vals){mut b=[]\nfor f in fmt{wr(b,vals[f[\"name\"]],f[\"type\"])}\nreturn b}\nfn parse(fmt,b,start){mut out={}\nmut off=start\nfor f in fmt{out[f[\"name\"]]=rd(b,off,f[\"type\"])\noff=off+tsize(f[\"type\"])}\nreturn out}\nlet HDR=[{name:\"magic\",type:\"u32be\"},{name:\"ver\",type:\"u16le\"},{name:\"flag\",type:\"u8\"}]\nlet bytes=emit(HDR,{\"magic\":3405691582,\"ver\":7,\"flag\":1})\nshow bytes\nlet g=parse(HDR,bytes,0)\nshow g[\"magic\"]\nshow g[\"ver\"]\nshow g[\"flag\"]")


    -- ── stage 20: disassembly on-ramp (capstone.clarity) ──
    -- Bind libcapstone at runtime via ffi_open + buffers and decode x86-64
    -- machine code into instructions. Linux-gated: CI installs libcapstone-dev on
    -- the Linux runners (Capstone is a cross-disassembler, so x86-64 decodes on
    -- both linux-x64 and linux-arm64); macOS has no capstone, so it skips. Native-
    -- only (the interpreter has no ffi_* surface). Decodes a tiny prologue:
    -- push rbp; mov rbp,rsp; mov eax,0x2a; ret.
    if IS_LINUX {
        nat_eq("capstone_disasm", "fn ru64(p){let b=ffi_read(p,8)\nreturn b[0]+b[1]*256+b[2]*65536+b[3]*16777216+(b[4]+b[5]*256+b[6]*65536+b[7]*16777216)*4294967296}\nfn cstr(p,m){let b=ffi_read(p,m)\nmut s=\"\"\nfor c in b{if c==0{break}\ns=s+from_char_code(c)}\nreturn s}\nfn lay(){let v=ffi_call(\"cs_version\",\"lll\",[0,0])\nif int(v/256)>=5{return [248,42,74]}\nreturn [240,34,66]}\nfn dis(code,addr){if ffi_open(\"libcapstone.so.4\")==0 and ffi_open(\"libcapstone.so.5\")==0 and ffi_open(\"libcapstone.so\")==0{return []}\nlet l=lay()\nlet hbuf=ffi_buffer(8)\nif ffi_call(\"cs_open\",\"lllp\",[3,8,hbuf])!=0{return []}\nlet handle=ru64(hbuf)\nlet cbuf=ffi_buffer(len(code))\nffi_write(cbuf,code)\nlet ibuf=ffi_buffer(8)\nlet count=ffi_call(\"cs_disasm\",\"llplllp\",[handle,cbuf,len(code),addr,0,ibuf])\nlet base=ru64(ibuf)\nmut out=[]\nmut i=0\nwhile i<count{let ins=base+i*l[0]\npush(out,cstr(ins+l[1],32)+\" \"+cstr(ins+l[2],160))\ni=i+1}\nreturn out}\nfor m in dis([85,72,137,229,184,42,0,0,0,195],4096){show trim(m)}", "push rbp\nmov rbp, rsp\nmov eax, 0x2a\nret")
    } else {
        show "-- stage 20 capstone: not Linux, native check skipped --"
    }
    -- ── module-level bindings ──
    -- A `let`/`mut` at file scope is visible to every function in the file.
    -- These were emitted as locals of main(), so a function referencing one
    -- failed to compile at all ("'v__K' undeclared"), which is what stopped
    -- real stdlib modules from compiling natively.
    same("global_let_read", "let K = [7, 11, 13]\nfn pick(i) { return K[i] }\nshow pick(0)\nshow pick(2)")
    same("global_string", "let NAME = \"clarity\"\nfn greet() { return \"hi \" + NAME }\nshow greet()")
    same("global_mut_write", "mut counter = 0\nfn bump() { counter = counter + 1\nreturn counter }\nshow bump()\nshow bump()\nshow counter")
    same("global_map", "let CFG = {\"w\": 3, \"h\": 4}\nfn area() { return CFG[\"w\"] * CFG[\"h\"] }\nshow area()")
    same("global_before_use", "let A = 2\nlet B = A * 3\nfn total() { return A + B }\nshow total()")
    same("global_used_by_class", "let SCALE = 10\nclass Box { fn init(n) { this.n = n }\nfn big() { return this.n * SCALE } }\nshow Box(4).big()")

    -- Module-level bindings live at C file scope, outside the conservative
    -- collector's stack scan, so they are rooted explicitly. Writing CACHE from
    -- inside a function leaves the global as the only reference once fill()
    -- returns: without the root table this segfaults under CLARITY_GC=1.
    -- Linux only, and deliberately so. Mid-run collection is opt-in precisely
    -- because conservative stack scanning is fragile across ABIs and
    -- optimisers, and this program is one of the cases: under CLARITY_GC=1 on
    -- darwin-arm64 the binary dies partway through `churn`, with or without
    -- the root table. That is the pre-existing fragility the prelude warns
    -- about (see "Precise GC" on the roadmap), not something the rooting fix
    -- introduces — but it means this platform cannot answer the question the
    -- test asks, so it is asserted where the GC is sound.
    --
    -- 20k iterations is ~4 MiB of garbage against a 1 MiB threshold, so
    -- several collections happen; more only makes the test slower.
    if IS_LINUX {
        same_gc("global_gc_rooted", "mut CACHE = []\nfn fill() { CACHE = [\"alpha\", \"beta\", \"gamma\"]\nreturn len(CACHE) }\nfn churn(n) { mut i = 0\nmut last = []\nwhile i < n { last = [i, \"pad-\" + str(i), [i, i]]\ni = i + 1 }\nreturn len(last) }\nshow fill()\nshow churn(20000)\nshow CACHE[0] + \"/\" + CACHE[1] + \"/\" + CACHE[2]")
    } else {
        show "-- global_gc_rooted: mid-run GC unreliable on this platform, skipped --"
    }

    -- ── expression forms the backend used to reject ──
    -- Each of these is core language surface that only surfaced as missing
    -- when a real stdlib module was compiled for the first time.
    same("if_expression", "let a = if 1 > 0 { \"yes\" } else { \"no\" }\nshow a\nfn pick(n) { return if n % 2 == 0 { \"even\" } else { \"odd\" } }\nshow pick(4)\nshow pick(7)")
    -- The untaken arm must not run: C's ?: is lazy and so is the interpreter.
    same("if_expression_is_lazy", "mut n = 0\nfn bump() { n = n + 1\nreturn 1 }\nlet b = if false { bump() } else { 0 }\nshow b\nshow n")
    same("null_coalesce", "let a = null\nshow a ?? \"fallback\"\nshow \"set\" ?? \"fallback\"\nlet m = {\"k\": 1}\nshow m[\"k\"] ?? 0")
    -- The left side is evaluated exactly once, so a ternary naming it twice
    -- would be wrong: `n` must end at 1, not 2.
    same("null_coalesce_evaluates_left_once", "mut n = 0\nfn bump() { n = n + 1\nreturn n }\nshow bump() ?? 99\nshow n")
    same("type_builtin", "show type(null)\nshow type(true)\nshow type(1)\nshow type(1.5)\nshow type(\"s\")\nshow type([1])\nshow type({\"a\": 1})\nclass Foo { fn init() {} }\nshow type(Foo())")

    -- A top-level function mentioned as a value, rather than called. The
    -- reference used to emit `v_twice`, a variable that does not exist; it
    -- now emits a closure wrapping the C function. The shadowing cases are
    -- the ones that matter: when a local or a parameter binds the same name,
    -- that is what the program meant, and the function must not win.
    same("function_as_value", "fn twice(n) { return n * 2 }\nfn apply(f, n) { return f(n) }\nshow apply(twice, 5)")
    same("function_as_value_two_args", "fn add(a, b) { return a + b }\nfn apply2(f, a, b) { return f(a, b) }\nshow apply2(add, 3, 4)")
    same("function_as_value_zero_args", "fn nine() { return 9 }\nfn apply(f, n) { return f(n) }\nshow apply(nine, 0)")
    same("function_as_value_in_map", "fn twice(n) { return n * 2 }\nshow map([1, 2, 3], twice)")
    same("local_shadows_function_name", "fn twice(n) { return n * 2 }\nfn shadow() { let twice = 99\nreturn twice }\nshow shadow()")
    same("param_shadows_function_name", "fn twice(n) { return n * 2 }\nfn shadow2(twice) { return twice + 1 }\nshow shadow2(7)")

    -- ── stage 21: TCP sockets ──
    -- Native-only: the interpreter's I/O is Bun's, which has no synchronous
    -- socket call to diff against, so this asserts the compiled binary's
    -- output directly (the same shape the FFI and capstone checks use).
    --
    -- The whole round trip happens in one process on loopback: bind port 0 so
    -- the kernel picks a free one rather than racing whatever else is on the
    -- machine, connect, accept, send, receive. Blocking calls are safe in this
    -- order because the listen backlog completes the connect before accept()
    -- is reached. The last exchange sends a NUL in the middle of the payload,
    -- which is the case a string-based API would silently truncate.
    nat_eq("tcp_roundtrip",
        "let srv = tcp_listen(0)\nshow srv >= 0\nlet port = tcp_port(srv)\nshow port > 0\n" +
        "let cli = tcp_connect(\"127.0.0.1\", port)\nshow cli >= 0\nlet peer = tcp_accept(srv)\nshow peer >= 0\n" +
        "show tcp_send(cli, \"hello sockets\")\nlet got = tcp_recv(peer, 64)\nshow len(got)\n" +
        "mut s = \"\"\nfor b in got { s = s + from_char_code(b) }\nshow s\n" +
        "show tcp_send(peer, [65, 0, 66])\nshow tcp_recv(cli, 16)\n" +
        "tcp_close(cli)\ntcp_close(peer)\ntcp_close(srv)",
        "true\ntrue\ntrue\ntrue\n13\n13\nhello sockets\n3\n[65, 0, 66]")

    -- A refused connection has to come back as -1, not abort the program: a
    -- compiled tool that dies on an unreachable host is much less useful than
    -- one that can report it. Port 1 on loopback is reliably closed.
    nat_eq("tcp_connect_refused", "show tcp_connect(\"127.0.0.1\", 1)", "-1")

    -- Writing to a peer that has closed raises SIGPIPE, whose default action
    -- kills the process. The point of this case is simply that the program is
    -- still alive to print afterwards.
    nat_eq("tcp_send_after_peer_close",
        "let srv = tcp_listen(0)\nlet port = tcp_port(srv)\n" +
        "let cli = tcp_connect(\"127.0.0.1\", port)\nlet peer = tcp_accept(srv)\ntcp_close(peer)\n" +
        "mut i = 0\nwhile i < 8 { tcp_send(cli, \"data after close\")\ni = i + 1 }\n" +
        "show \"survived\"\ntcp_close(cli)\ntcp_close(srv)",
        "survived")

    -- ── every builtin _builtin_call emits is in _NATIVE_BUILTINS ──
    --
    -- Those two lists have to agree, and nothing made them. _NATIVE_BUILTINS
    -- is what _is_global consults to decide whether a name used inside a
    -- closure is a free variable to capture; _builtin_call is what turns a
    -- name into runtime C. Twenty names were in the second and not the first,
    -- so a closure calling sort, entries, hash, find, pop, print, values or
    -- thirteen others captured it as a variable and emitted a `v_sort` that
    -- nothing declares. The failure surfaced in the C compiler, on generated
    -- code, naming a variable the program never wrote.
    --
    -- Checked against the source text rather than at run time because
    -- _builtin_call is a chain of `if name == "..."`, which nothing can
    -- enumerate from inside the program. Reading the compiler's own source is
    -- unusual for a test; leaving the invariant unchecked is worse.
    let cg_path = _find_file("c_codegen.clarity")
    if cg_path == null {
        show "  (c_codegen.clarity not found from here — builtin table check skipped)"
    } else {
        let cg = read(cg_path)
        let decl_start = index_of(cg, "let _NATIVE_BUILTINS = {")
        let body_start = index_of(cg, "fn _builtin_call(name, args) {")
        assert_eq(decl_start >= 0 and body_start >= 0, true, "builtin_tables_located")
        if decl_start >= 0 and body_start >= 0 {
            let tail = substring(cg, decl_start, len(cg))
            let decl_text = substring(tail, 0, index_of(tail, "\n}\n"))
            -- Every quoted string in the table literal is a builtin name.
            -- Odd-indexed pieces of a split on the quote character are what
            -- was between quotes.
            let decl_pieces = split(decl_text, "\"")
            mut declared = {}
            mut di = 1
            while di < len(decl_pieces) { declared[decl_pieces[di]] = true
                                          di += 2 }

            -- Every `if name == "x"` in _builtin_call names a builtin it
            -- emits. The first piece of the split is what came before the
            -- first one, so it is skipped.
            let call_pieces = split(substring(cg, body_start, len(cg)), "if name == \"")
            mut missing = []
            mut ci = 1
            while ci < len(call_pieces) {
                let piece = call_pieces[ci]
                let q = index_of(piece, "\"")
                if q > 0 {
                    let name = substring(piece, 0, q)
                    if not has(declared, name) and not contains(missing, name) { push(missing, name) }
                }
                ci += 1
            }
            assert_eq(join(sort(missing), " "), "", "every emitted builtin is declared in _NATIVE_BUILTINS")
        }
    }

    -- And the consequence, end to end: each of these inside a closure.
    same("builtins_inside_a_closure",
        "let names = [\"c\", \"a\", \"b\"]\n" +
        "each([1], fn(_) { show sort(names) })\n" +
        "each([1], fn(_) { show str(len(entries({ \"k\": 1 }))) })\n" +
        "each([1], fn(_) { show hash(\"abc\") })\n" +
        "each([1], fn(_) { show str(find([1, 2, 3], fn(v) { return v > 1 })) })\n" +
        "each([1], fn(_) { show str(some([1, 2], fn(v) { return v > 1 })) })\n" +
        "each([1], fn(_) { show str(every([1, 2], fn(v) { return v > 0 })) })\n" +
        "each([1], fn(_) { show reverse([1, 2, 3]) })\n" +
        "each([1], fn(_) { show unique([1, 1, 2]) })\n" +
        "each([1], fn(_) { show values({ \"a\": 1 }) })\n" +
        "each([1], fn(_) { show flat([[1], [2]]) })\n" +
        "each([1], fn(_) { show str(pow(2.0, 3.0)) })\n" +
        "each([1], fn(_) { show encode64(\"hi\") + decode64(\"aGk=\") })\n" +
        "each([1], fn(_) { show str(bool(1)) })\n" +
        "each([1], fn(_) { mut l = [1, 2]\n show str(pop(l)) })")

    -- A local that shadows a builtin name is still a local, so a closure
    -- referring to it has to capture it. The reference used to be left
    -- uncaptured — the compiler saw a builtin — and the closure body named a
    -- variable nothing declared.
    same("closure_captures_a_shadowed_builtin",
        "fn go() {\n" +
        "    let lines = [\"x\", \"y\"]\n" +
        "    let sort = 3\n" +
        "    let time = \"noon\"\n" +
        "    each([1], fn(_) { show str(len(lines)) + \"/\" + str(sort) + \"/\" + time })\n" +
        "    return null\n" +
        "}\n" +
        "go()\n" +
        "each([1], fn(_) { show sort([2, 1]) })")

    -- ── rest parameters ───────────────────────────────────
    -- The emitted C is fixed-arity, so a variadic Clarity function needs the
    -- surplus arguments gathered into a list — and the callee needs to know
    -- how many it was given, which is why every calling convention here now
    -- carries a count. Before this, `fn f(a, ...rest)` emitted
    -- `Value v_...rest`, which is not C.
    same("rest_top_level",
        "fn f(a, ...rest) { return str(a) + \":\" + join(rest, \",\") + \":\" + str(len(rest)) }\n" +
        "show f(1)\nshow f(1, 2)\nshow f(1, 2, 3)")
    same("rest_only",
        "fn g(...all) { return str(len(all)) + \"=\" + join(all, \"+\") }\n" +
        "show g()\nshow g(7, 8, 9)")
    same("rest_in_class",
        "class C {\n" +
        "    fn init(name, ...tags) { this.name = name\n this.tags = tags }\n" +
        "    fn describe(...extra) { return this.name + \"[\" + join(this.tags, \",\") + \"]\" + str(len(extra)) }\n" +
        "}\n" +
        "let c = C(\"x\", \"a\", \"b\")\n" +
        "show c.describe()\nshow c.describe(1, 2)")
    same("rest_in_closure",
        "let lam = fn(a, ...more) { return str(a) + \"|\" + str(len(more)) + \"|\" + join(more, \".\") }\n" +
        "show lam(1)\nshow lam(1, 2, 3)\n" +
        "show map([1, 2, 3], fn(x, ...ignored) { return x * 10 })")
    same("rest_as_value",
        "fn named(a, ...tail) { return str(a) + \"-\" + str(len(tail)) }\n" +
        "let v = named\nshow v(5)\nshow v(5, 6, 7)\n" +
        "fn nofix(...only) { return str(len(only)) }\n" +
        "let n = nofix\nshow n(1, 2, 3, 4)")

    -- A call that supplies fewer arguments than the function declares gets
    -- null for the rest, which is what the interpreter does. The emitted C
    -- used to read past the end of the argument array instead — and a method
    -- with parameters called with none was handed a null pointer.
    same("missing_arguments_are_null",
        "fn two(a, b) { return str(a) + \"/\" + str(b) }\n" +
        "show two(1)\nshow two()\n" +
        "class M {\n    fn init() { this.k = 1 }\n    fn m(a, b) { return str(a) + \"~\" + str(b) }\n}\n" +
        "show M().m()\nshow M().m(9)")

    -- ── objects answer keys/values/entries/has ────────────
    -- An object is a map with a class name attached, and asking it what it
    -- holds should say so. It did not: the three backends gave three
    -- different answers — the interpreter returned its own ClarityInstance
    -- fields (_clarityType, klass, properties), the native build returned an
    -- empty list, and only the transpiled one answered with the program's own
    -- field names. `same` compares the interpreter against the native binary,
    -- so this pins two of the three together; the third is what they were
    -- both brought into line with.
    same("object_keys",
        "class P {\n" +
        "    fn init(x, y) { this.x = x\n this.y = y }\n" +
        "}\n" +
        "let p = P(3, 4)\n" +
        "show keys(p)\n" +
        "show values(p)\n" +
        "show entries(p)\n" +
        "show has(p, \"x\")\n" +
        "show has(p, \"nope\")\n" +
        "show len(keys(p))\n" +
        "show p[\"x\"]\n" +
        "show p[\"missing\"]\n" +
        "mut total = 0\n" +
        "for k in sort(keys(p)) { total = total + p[k] }\n" +
        "show total\n" +
        "p[\"x\"] = 30\n" +
        "show p.x\n" +
        "show sort(keys(p))")

    -- A string inside a container prints quoted. It did in two backends and
    -- not in the third, which showed ["a", "b"] as [a, b] — and disagreed
    -- with its own map display, which quoted.
    same("container_display",
        "show [\"a\", \"b\"]\n" +
        "show str([\"a\", \"b\"])\n" +
        "show { \"k\": \"v\" }\n" +
        "show [1, \"two\", true, null]\n" +
        "show [[\"nested\"]]\n" +
        "show join([\"a\", \"b\"], \"-\")")

    -- ── the freestanding profile ──────────────────────────
    -- `clarity cc --freestanding` is for a target with no operating system
    -- underneath. What it has to guarantee is narrow and checkable: the
    -- emitted C must compile with nothing but the C library's own headers,
    -- and any builtin it dropped must be refused in Clarity rather than
    -- failing later inside the C compiler.

    let FS_SRC = "class Shape {\n" +
        "    fn init(n) { this.n = n }\n" +
        "    fn area() { return sqrt(float(this.n)) * 3.0 }\n" +
        "}\n" +
        "fn risky(x) { if x < 0 { throw \"negative\" }\n return x * 2 }\n" +
        "mut acc = []\n" +
        "for s in [Shape(4), Shape(9)] { push(acc, str(round(s.area()))) }\n" +
        "show join(acc, \",\")\n" +
        "try { show str(risky(-1)) } catch e { show \"caught \" + str(e) } finally { show \"done\" }\n" +
        "let m = { \"b\": 2, \"a\": 1 }\n" +
        "for k in sort(keys(m)) { show upper(k) + \":\" + str(m[k]) }\n" +
        "show str(17 % 5) + \" \" + trim(\"  p  \") + \" \" + json_string(m) + \" \" + hash(\"abc\")\n"

    let fs_c = compile_to_c_freestanding(parse(tokenize(FS_SRC, "<t>"), FS_SRC))

    -- The define has to precede the prelude, or the prelude's #ifndefs never
    -- see it and the POSIX half comes back.
    assert_eq(starts(fs_c, "#define CLARITY_FREESTANDING 1"), true, "freestanding_define_first")

    -- It still has to be a whole program.
    assert_eq(contains(fs_c, "int main("), true, "freestanding_has_main")

    -- Excluded builtins are refused in Clarity, naming the builtin, rather
    -- than reaching the C compiler as an undeclared function.
    let BAD_CALLS = {
        "read": "read(\"f\")", "write": "write(\"f\", \"x\")", "exists": "exists(\"f\")",
        "exec": "exec(\"true\")", "time": "time()", "sleep": "sleep(0)",
        "tcp_listen": "tcp_listen(0)", "ffi_sym": "ffi_sym(\"strlen\")", "read_mem": "read_mem(0, 0, 1)"
    }
    for bad in sort(keys(BAD_CALLS)) {
        let prog = BAD_CALLS[bad]
        mut msg = ""
        try { compile_to_c_freestanding(parse(tokenize(prog, "<t>"), prog)) }
        catch e { msg = str(e) }
        assert_eq(contains(msg, bad + "()") and contains(msg, "--freestanding"), true, "freestanding_refuses_" + bad)
    }

    -- And the same builtins must still work in the hosted profile: the flag
    -- adds a mode, it does not remove one.
    assert_eq(contains(compile_to_c(parse(tokenize("show exists(\"/\")", "<t>"), "show exists(\"/\")")), "cl_exists("), true, "hosted_keeps_exists")

    -- The real check: compile the emitted C against a C library that has
    -- *only* the freestanding headers, with -nostdinc so the host's POSIX
    -- headers are unreachable. If this builds, the profile's claim — "this
    -- needs a C library, not an operating system" — is true rather than
    -- asserted. Needs clang for its resource directory (stddef.h/stdarg.h are
    -- the compiler's, not the library's); skipped where clang is absent.
    let res_dir = trim(exec("clang -print-resource-dir 2>/dev/null"))
    if len(res_dir) == 0 {
        show "  (no clang — freestanding stub-libc link check skipped)"
    } else {
        let dir = "/tmp/_clc_fslibc"
        exec("rm -rf " + dir + " && mkdir -p " + dir)
        write(dir + "/stdio.h", "#pragma once\n#include <stddef.h>\n#include <stdarg.h>\n" +
            "int printf(const char*, ...);\nint snprintf(char*, size_t, const char*, ...);\nint sprintf(char*, const char*, ...);\n")
        write(dir + "/stdlib.h", "#pragma once\n#include <stddef.h>\n" +
            "void* malloc(size_t);\nvoid* calloc(size_t, size_t);\nvoid* realloc(void*, size_t);\nvoid free(void*);\n" +
            "void exit(int);\nvoid abort(void);\nlong strtol(const char*, char**, int);\ndouble strtod(const char*, char**);\n" +
            "char* getenv(const char*);\nint rand(void);\nvoid srand(unsigned);\n" +
            "void qsort(void*, size_t, size_t, int (*)(const void*, const void*));\n#define RAND_MAX 2147483647\n")
        write(dir + "/string.h", "#pragma once\n#include <stddef.h>\n" +
            "size_t strlen(const char*);\nchar* strcpy(char*, const char*);\nchar* strcat(char*, const char*);\n" +
            "int strcmp(const char*, const char*);\nint strncmp(const char*, const char*, size_t);\n" +
            "char* strstr(const char*, const char*);\nvoid* memcpy(void*, const void*, size_t);\nvoid* memset(void*, int, size_t);\n")
        write(dir + "/math.h", "#pragma once\ndouble fabs(double);\ndouble floor(double);\ndouble ceil(double);\ndouble round(double);\n" +
            "double sqrt(double);\ndouble sin(double);\ndouble cos(double);\ndouble tan(double);\n" +
            "double log(double);\ndouble pow(double, double);\ndouble fmod(double, double);\n")
        write(dir + "/ctype.h", "#pragma once\nint isdigit(int);\nint isalpha(int);\nint isalnum(int);\nint isspace(int);\nint toupper(int);\nint tolower(int);\n")
        write(dir + "/setjmp.h", "#pragma once\ntypedef long jmp_buf[32];\nint setjmp(jmp_buf);\nvoid longjmp(jmp_buf, int);\n")

        let fs_cfile = "/tmp/_clc_freestanding.c"
        let fs_obj = "/tmp/_clc_freestanding.o"
        write(fs_cfile, fs_c)
        exec("rm -f " + fs_obj)
        let r = exec_full("clang -O2 -ffreestanding -nostdinc -I " + dir + " -I " + res_dir + "/include -c " + fs_cfile + " -o " + fs_obj)
        if not exists(fs_obj) {
            FAILED += 1
            show "  FAIL: freestanding_stub_libc\n" + r.stderr
        } else {
            PASSED += 1
        }
        exec("rm -rf " + dir)
    }

    exec("rm -f /tmp/_clc_*")
}

show ""
show "C codegen: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " C codegen test(s) failed" }
