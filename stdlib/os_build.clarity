-- The image `clarity os build` produces: the one the boot gate boots.
--
-- x86_64 boots from a GRUB rescue ISO. The kernel is a multiboot2 ELF, and
-- QEMU's `-kernel` refuses it, so the image has to carry a boot loader:
-- GRUB's own El Torito boot image, which only grub-mkrescue can lay down.
-- This builder stages a directory holding the kernel and a grub.cfg and
-- hands it to grub-mkrescue, exactly what .github/workflows/os-boot.yml
-- and kernel/tools/run_x86.sh do. If this image boots and the gate's does
-- not, the difference is not the image.
--
-- What it replaced: an ISO packed in pure Clarity (iso9660.clarity) with
-- the kernel ELF written where the El Torito boot image goes. The BIOS
-- loads that sector and jumps into the ELF header; QEMU prints nothing
-- and never reaches the kernel. That image was also never produced,
-- because the command first tried to build a QuickJS runtime that nothing
-- vendors, and stopped there. The kernel needs no separate runtime: its
-- userspace (clarity-init and the compiled Clarity demo) is linked into
-- the kernel image by kernel/build.zig.
--
-- aarch64 does not use an ISO at all. QEMU's `-kernel` takes the ARM64
-- Image the kernel build already writes, so that side is a copy.
--
--     let b = os_image_builder({"output": "dist/claritos.iso"})
--     b.set_kernel("kernel/zig-out/bin/clarity-kernel")
--     b.build()                              -- runs grub-mkrescue
--
-- plan() lists what build() will do, so the steps can be checked without
-- a kernel or GRUB on the machine, which is what the test suite does.

let DEFAULT_VOLUME_ID = "KYANOS"
let DEFAULT_OUTPUT = "dist/claritos.iso"

class OsImageBuilder {
    fn init(opts) {
        let o = opts ?? {}
        this.output = if has(o, "output") { o["output"] } else { DEFAULT_OUTPUT }
        this.volume_id = if has(o, "volume_id") { o["volume_id"] } else { DEFAULT_VOLUME_ID }
        this.cmdline = if has(o, "cmdline") { o["cmdline"] } else { "" }
        this.timeout_s = if has(o, "timeout_s") { o["timeout_s"] } else { 0 }
        this.staging = if has(o, "staging") { o["staging"] } else { _dirname(this.output) + "/iso" }
        this.kernel = null
        this.runtime = null
        this.extra_files = []          -- [{src, dst}] dst is a path inside the image
    }

    fn set_kernel(path) { this.kernel = path }
    -- A separate init binary is optional: the kernel image the gate boots
    -- carries its own. Kept for an image that ships one as a file.
    fn set_runtime(path) { this.runtime = path }
    fn add_extra(src, dst) { push(this.extra_files, {"src": src, "dst": dst}) }

    -- ── Plan: the steps build() takes, in order ──────────

    fn plan() {
        mut ops = []
        push(ops, {"kind": "mkdir", "path": this.staging + "/boot/grub"})
        if this.kernel != null {
            push(ops, {"kind": "copy", "src": this.kernel, "dst": this.staging + "/boot/clarity-kernel"})
        }
        if this.runtime != null {
            push(ops, {"kind": "copy", "src": this.runtime, "dst": this.staging + "/bin/clarity-init"})
        }
        for extra in this.extra_files {
            push(ops, {"kind": "copy", "src": extra["src"], "dst": this.staging + extra["dst"]})
        }
        push(ops, {"kind": "write", "path": this.staging + "/boot/grub/grub.cfg", "content": this.grub_cfg()})
        push(ops, {"kind": "pack", "image": this.output, "label": this.volume_id, "from": this.staging})
        return ops
    }

    -- One entry, no menu wait: the image boots unattended, which is what a
    -- boot test and a person who just ran `clarity os run` both want.
    fn grub_cfg() {
        mut lines = []
        push(lines, "set timeout=" + str(this.timeout_s))
        push(lines, "set default=0")
        push(lines, "menuentry \"KyanOS\" {")
        if len(this.cmdline) > 0 {
            push(lines, "    multiboot2 /boot/clarity-kernel " + this.cmdline)
        } else {
            push(lines, "    multiboot2 /boot/clarity-kernel")
        }
        push(lines, "    boot")
        push(lines, "}")
        return join(lines, "\n") + "\n"
    }

    fn validate() {
        mut errors = []
        if this.kernel == null { push(errors, "missing kernel: call set_kernel(path)") }
        if not ends(this.output, ".iso") { push(errors, "output should end in .iso") }
        return errors
    }

    -- ── Build ─────────────────────────────

    fn build() {
        let errs = this.validate()
        if len(errs) > 0 { throw "OsImageBuildError: " + join(errs, "; ") }
        if not exists(this.kernel) {
            throw "OsImageBuildError: no kernel at " + this.kernel + " (run `zig build` in kernel/)"
        }
        let packer = iso_packer()
        if packer == null {
            throw "OsImageBuildError: grub-mkrescue and xorriso are needed to write a bootable ISO. " + iso_packer_hint()
        }
        for op in this.plan() { this._execute(op) }
        if not exists(this.output) {
            throw "OsImageBuildError: grub-mkrescue ran but wrote no " + this.output
        }
        return this.output
    }

    fn _execute(op) {
        let kind = op["kind"]
        if kind == "mkdir" {
            _run("mkdir -p " + _q(op["path"]))
        } elif kind == "copy" {
            _run("mkdir -p " + _q(_dirname(op["dst"])))
            _run("cp " + _q(op["src"]) + " " + _q(op["dst"]))
        } elif kind == "write" {
            write(op["path"], op["content"])
        } elif kind == "pack" {
            _run("mkdir -p " + _q(_dirname(op["image"])))
            _run(this.pack_command(op) + " 2>&1")
        }
    }

    -- grub-mkrescue takes its own options and hands the rest to xorriso in
    -- mkisofs mode, where the volume id is `-V`. `--volid=` is not a
    -- grub-mkrescue option; xorriso rejects it and no image is written,
    -- which is what the first run of this builder found.
    fn pack_command(op) {
        return "grub-mkrescue -o " + _q(op["image"]) + " -V " + _q(op["label"]) + " " + _q(op["from"])
    }
}

fn os_image_builder(opts) { return OsImageBuilder(opts) }

-- ── The aarch64 image ──────────────────

-- The ARM64 Image `zig build aarch64` writes is what QEMU boots with
-- `-kernel`; there is nothing to pack. This copies it to where `os run`
-- looks, and says so if the build never produced it.
fn aarch64_image(kernel_img, output) {
    if not exists(kernel_img) {
        throw "OsImageBuildError: no image at " + kernel_img + " (run `zig build aarch64` in kernel/)"
    }
    _run("mkdir -p " + _q(_dirname(output)))
    _run("cp " + _q(kernel_img) + " " + _q(output))
    return output
}

-- ── The host's tools ───────────────────

-- "grub-mkrescue" when the ISO can be written here, else null. Both tools
-- are needed: grub-mkrescue drives xorriso to write the image.
fn iso_packer() {
    let r = exec_full("command -v grub-mkrescue >/dev/null 2>&1 && command -v xorriso >/dev/null 2>&1 && echo yes || echo no")
    if trim(r.stdout) == "yes" { return "grub-mkrescue" }
    return null
}

fn iso_packer_hint() {
    return "Debian/Ubuntu: apt install grub-pc-bin grub-common xorriso mtools. macOS: brew install xorriso, and grub-mkrescue needs a cross GRUB; the aarch64 image (`clarity os build --arch aarch64`) needs neither."
}

-- ── Helpers ────────────────────────────

fn _run(cmd) {
    let r = exec_full(cmd)
    if r.exit_code != 0 {
        throw "OsImageBuildError: `" + cmd + "` failed (exit " + str(r.exit_code) + "): " + trim(r.stdout)
    }
    return r
}

fn _q(s) {
    let escaped = replace(str(s), "'", "'\\''")
    return "'" + escaped + "'"
}

fn _dirname(path) {
    mut i = len(path) - 1
    while i >= 0 {
        if char_at(path, i) == "/" {
            if i == 0 { return "/" }
            return substring(path, 0, i)
        }
        i -= 1
    }
    return "."
}
