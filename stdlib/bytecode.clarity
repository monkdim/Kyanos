-- Clarity Bytecode Compiler and Virtual Machine — self-hosting implementation
-- Complete bytecode compiler covering all 49 AST node types.
-- Includes: optimizer (constant folding, dead code elimination, peephole),
-- class/instance support, try/catch, break/continue, match, enums, comprehensions.
--
-- Usage:
--   from "bytecode.clarity" import compile_to_bytecode, VM, optimize
--   let code = compile_to_bytecode(ast_tree)
--   optimize(code)
--   let vm = VM()
--   vm.run(code)

-- ── Opcodes ──────────────────────────────────────────────

-- The VM resolves imports itself: a module is source that has to be
-- tokenized, parsed and compiled like the program that imports it.
from "lexer.clarity" import tokenize
from "parser.clarity" import parse

let OP_CONST = 0        -- Push constant from pool
let OP_POP = 1          -- Discard top of stack
let OP_ADD = 2
let OP_SUB = 3
let OP_MUL = 4
let OP_DIV = 5
let OP_MOD = 6
let OP_POW = 7
let OP_NEG = 8
let OP_NOT = 9
let OP_EQ = 10
let OP_NEQ = 11
let OP_LT = 12
let OP_GT = 13
let OP_LTE = 14
let OP_GTE = 15
let OP_LOAD = 16        -- Load variable by name (from constant pool)
let OP_STORE = 17       -- Store into existing variable
let OP_STORE_NEW = 18   -- Declare new variable
let OP_JUMP = 19        -- Unconditional jump
let OP_JUMP_FALSE = 20  -- Jump if top is falsy (pops)
let OP_CALL = 21        -- Call function with N args
let OP_RETURN = 22      -- Return from function
let OP_MAKE_LIST = 23   -- Create list from N items on stack
let OP_MAKE_MAP = 24    -- Create map from N key-value pairs on stack
let OP_GET_IDX = 25     -- Index access
let OP_SET_IDX = 26     -- Index assignment
let OP_GET_PROP = 27    -- Property access
let OP_SET_PROP = 28    -- Property assignment
let OP_PRINT = 29       -- Show statement — print N values
let OP_MAKE_FN = 30     -- Create function from code object
let OP_DUP = 31         -- Duplicate top
let OP_ITER_INIT = 32   -- Create iterator from iterable
let OP_ITER_NEXT = 33   -- Get next from iterator (pushes value + bool)
let OP_AND = 34
let OP_OR = 35
let OP_BIT_AND = 36
let OP_BIT_OR = 37
let OP_BIT_XOR = 38
let OP_BIT_NOT = 39
let OP_LSHIFT = 40
let OP_RSHIFT = 41
let OP_RANGE = 42       -- Create range from two ints
let OP_NULL = 43        -- Push null
let OP_TRUE = 44        -- Push true
let OP_FALSE = 45       -- Push false
let OP_CONCAT = 46      -- String concatenation
let OP_PIPE = 47        -- Pipe: call function with value as first arg
let OP_THROW = 48       -- Throw exception (pop value, throw it)
let OP_MAKE_CLASS = 49  -- Create class (operand = num_methods)
let OP_SLICE = 50       -- Slice: pop end, start, obj; push obj[start:end]
let OP_SETUP_TRY = 51   -- Set up try handler (operand = catch IP)
let OP_POP_TRY = 52     -- Remove try handler
let OP_SWAP = 53        -- Swap top two stack values
let OP_ROT3 = 54        -- Rotate top 3: [a, b, c] -> [c, a, b]
let OP_JUMP_TRUE = 55   -- Jump if top is truthy (pops)
let OP_IMPORT = 56      -- Import a module (operand = const index of {path, names, alias, line})
let OP_YIELD = 57       -- Collect the top of the stack into this frame's yields
let OP_GET_PROP_OPT = 58 -- `a?.b`: the property, or null if reading it fails
let OP_SPREAD = 59      -- Mark the top of the stack as spread into what follows
let OP_COMP_BIND = 60   -- Bind one target of a multi-variable map comprehension
let OP_PUSH_SCOPE = 61  -- Enter a block: names bound after this are its own
let OP_POP_SCOPE = 62   -- Leave a block, and everything it bound with it
let OP_MAKE_ENUM = 63   -- Wrap a member map as an enum (operand = const name)
let OP_HALT = 255

-- Opcode names for disassembly
let OP_NAMES = {
    0: "CONST", 1: "POP", 2: "ADD", 3: "SUB", 4: "MUL", 5: "DIV",
    6: "MOD", 7: "POW", 8: "NEG", 9: "NOT", 10: "EQ", 11: "NEQ",
    12: "LT", 13: "GT", 14: "LTE", 15: "GTE", 16: "LOAD", 17: "STORE",
    18: "STORE_NEW", 19: "JUMP", 20: "JUMP_FALSE", 21: "CALL", 22: "RETURN",
    23: "MAKE_LIST", 24: "MAKE_MAP", 25: "GET_IDX", 26: "SET_IDX",
    27: "GET_PROP", 28: "SET_PROP", 29: "PRINT", 30: "MAKE_FN", 31: "DUP",
    32: "ITER_INIT", 33: "ITER_NEXT", 34: "AND", 35: "OR", 36: "BIT_AND",
    37: "BIT_OR", 38: "BIT_XOR", 39: "BIT_NOT", 40: "LSHIFT", 41: "RSHIFT",
    42: "RANGE", 43: "NULL", 44: "TRUE", 45: "FALSE", 46: "CONCAT",
    47: "PIPE", 48: "THROW", 49: "MAKE_CLASS", 50: "SLICE",
    51: "SETUP_TRY", 52: "POP_TRY", 53: "SWAP", 54: "ROT3",
    55: "JUMP_TRUE", 56: "IMPORT", 57: "YIELD", 58: "GET_PROP_OPT",
    59: "SPREAD", 60: "COMP_BIND", 61: "PUSH_SCOPE", 62: "POP_SCOPE",
    63: "MAKE_ENUM", 255: "HALT"
}

-- ── Bytecode container ──────────────────────────────────

class CodeObject {
    fn init(name) {
        this.name = name ?? "<main>"
        this.instructions = []
        this.constants = []
        this.lines = []
    }

    fn emit(op, operand, line) {
        let op_val = op ?? 0
        let operand_val = operand ?? 0
        let line_val = line ?? 0
        push(this.instructions, [op_val, operand_val])
        push(this.lines, line_val)
        return len(this.instructions) - 1
    }

    fn add_const(value) {
        mut i = 0
        while i < len(this.constants) {
            let existing = this.constants[i]
            if type(existing) == type(value) {
                let t = type(value)
                if t == "number" or t == "string" or t == "bool" or t == "null" {
                    if existing == value {
                        return i
                    }
                }
            }
            i += 1
        }
        push(this.constants, value)
        return len(this.constants) - 1
    }

    fn patch_jump(idx) {
        let instr = this.instructions[idx]
        let op = instr[0]
        this.instructions[idx] = [op, len(this.instructions)]
    }

    fn disassemble() {
        mut lines = ["=== {this.name} ==="]
        push(lines, "Constants: {_bc_display_list(this.constants)}")
        mut i = 0
        while i < len(this.instructions) {
            let instr = this.instructions[i]
            let op = instr[0]
            let operand = instr[1]
            let name = if has(OP_NAMES, op) { OP_NAMES[op] } else { str(op) }
            mut extra = ""
            if op == OP_CONST or op == OP_LOAD or op == OP_STORE or op == OP_STORE_NEW or op == OP_GET_PROP or op == OP_SET_PROP {
                if operand < len(this.constants) {
                    extra = "  ; {_bc_repr(this.constants[operand])}"
                }
            }
            push(lines, "  {_pad_left(str(i), 4)}  {_pad_right(name, 14)} {_pad_right(str(operand), 6)}{extra}")
            i += 1
        }
        return join(lines, "\n")
    }
}

-- ── Compiler ─────────────────────────────────────────────

class Compiler {
    fn init() {
        this.code = CodeObject(null)
        this.loop_stack = []   -- [{start, break_patches, try_base, scope_base}]
        -- How many block scopes this point is inside, within this function.
        -- Leaving a loop early has to close the ones between here and it,
        -- the same way _unwind_tries closes its trys.
        this.scope_depth = 0
        -- The try regions this point is inside, innermost last, each with
        -- its finally body or null. Leaving one early — by return, break or
        -- continue — has to run its finally and drop its handler, which is
        -- what the interpreter does as the signal unwinds through it.
        this.open_tries = []
    }

    fn compile(program) {
        mut i = 0
        while i < len(program.body) {
            this.compile_node(program.body[i])
            i += 1
        }
        this.code.emit(OP_HALT)
        return this.code
    }

    fn compile_node(node) {
        let nt = node.node_type
        -- Statements
        if nt == "ExpressionStatement" { return this.compile_ExpressionStatement(node) }
        if nt == "LetStatement" { return this.compile_LetStatement(node) }
        if nt == "DestructureLetStatement" { return this.compile_DestructureLetStatement(node) }
        if nt == "AssignStatement" { return this.compile_AssignStatement(node) }
        if nt == "MultiAssignStatement" { return this.compile_MultiAssignStatement(node) }
        if nt == "FnStatement" { return this.compile_FnStatement(node) }
        if nt == "ReturnStatement" { return this.compile_ReturnStatement(node) }
        if nt == "ShowStatement" { return this.compile_ShowStatement(node) }
        if nt == "IfStatement" { return this.compile_IfStatement(node) }
        if nt == "WhileStatement" { return this.compile_WhileStatement(node) }
        if nt == "ForStatement" { return this.compile_ForStatement(node) }
        if nt == "TryCatch" { return this.compile_TryCatch(node) }
        if nt == "ThrowStatement" { return this.compile_ThrowStatement(node) }
        if nt == "BreakStatement" { return this.compile_BreakStatement(node) }
        if nt == "ContinueStatement" { return this.compile_ContinueStatement(node) }
        if nt == "ClassStatement" { return this.compile_ClassStatement(node) }
        if nt == "EnumStatement" { return this.compile_EnumStatement(node) }
        if nt == "InterfaceStatement" { return this.compile_InterfaceStatement(node) }
        if nt == "MatchStatement" { return this.compile_MatchStatement(node) }
        if nt == "ImportStatement" { return this.compile_ImportStatement(node) }
        if nt == "DecoratedStatement" { return this.compile_DecoratedStatement(node) }
        if nt == "Block" { return this.compile_Block(node) }
        -- Expressions
        if nt == "NumberLiteral" { return this.compile_NumberLiteral(node) }
        if nt == "StringLiteral" { return this.compile_StringLiteral(node) }
        if nt == "BoolLiteral" { return this.compile_BoolLiteral(node) }
        if nt == "NullLiteral" { return this.compile_NullLiteral(node) }
        if nt == "Identifier" { return this.compile_Identifier(node) }
        if nt == "ThisExpression" { return this.compile_ThisExpression(node) }
        if nt == "BinaryOp" { return this.compile_BinaryOp(node) }
        if nt == "UnaryOp" { return this.compile_UnaryOp(node) }
        if nt == "CallExpression" { return this.compile_CallExpression(node) }
        if nt == "ListLiteral" { return this.compile_ListLiteral(node) }
        if nt == "MapLiteral" { return this.compile_MapLiteral(node) }
        if nt == "IndexExpression" { return this.compile_IndexExpression(node) }
        if nt == "MemberExpression" { return this.compile_MemberExpression(node) }
        if nt == "OptionalMemberExpression" { return this.compile_OptionalMemberExpression(node) }
        if nt == "SliceExpression" { return this.compile_SliceExpression(node) }
        if nt == "RangeExpression" { return this.compile_RangeExpression(node) }
        if nt == "PipeExpression" { return this.compile_PipeExpression(node) }
        if nt == "FnExpression" { return this.compile_FnExpression(node) }
        if nt == "IfExpression" { return this.compile_IfExpression(node) }
        if nt == "NullCoalesce" { return this.compile_NullCoalesce(node) }
        if nt == "SpreadExpression" { return this.compile_SpreadExpression(node) }
        if nt == "ComprehensionExpression" { return this.compile_ComprehensionExpression(node) }
        if nt == "MapComprehensionExpression" { return this.compile_MapComprehensionExpression(node) }
        if nt == "AskExpression" { return this.compile_AskExpression(node) }
        if nt == "AwaitExpression" { return this.compile_AwaitExpression(node) }
        if nt == "YieldExpression" { return this.compile_YieldExpression(node) }
        throw "CompileError: Cannot compile node type: {nt}"
    }

    -- ── Statement compilers ─────────────────────────────

    fn compile_ExpressionStatement(node) {
        this.compile_node(node.expression)
        let line = node.line ?? 0
        this.code.emit(OP_POP, 0, line)
    }

    fn compile_LetStatement(node) {
        this.compile_node(node.value)
        let name_idx = this.code.add_const(node.name)
        let line = node.line ?? 0
        this.code.emit(OP_STORE_NEW, name_idx, line)
    }

    fn compile_DestructureLetStatement(node) {
        let line = node.line ?? 0
        this.compile_node(node.value)
        if node.kind == "list" {
            mut i = 0
            while i < len(node.targets) {
                let target = node.targets[i]
                if starts(target, "...") {
                    -- Rest: slice from i to end
                    let rest_name = substring(target, 3)
                    this.code.emit(OP_DUP, 0, line)
                    this.code.emit(OP_CONST, this.code.add_const(i), line)
                    this.code.emit(OP_NULL, 0, line)
                    this.code.emit(OP_SLICE, 0, line)
                    let name_idx = this.code.add_const(rest_name)
                    this.code.emit(OP_STORE_NEW, name_idx, line)
                    break
                } else {
                    this.code.emit(OP_DUP, 0, line)
                    this.code.emit(OP_CONST, this.code.add_const(i), line)
                    this.code.emit(OP_GET_IDX, 0, line)
                    let name_idx = this.code.add_const(target)
                    this.code.emit(OP_STORE_NEW, name_idx, line)
                }
                i += 1
            }
        } elif node.kind == "map" {
            mut i = 0
            while i < len(node.targets) {
                let target = node.targets[i]
                this.code.emit(OP_DUP, 0, line)
                let key_idx = this.code.add_const(target)
                this.code.emit(OP_CONST, key_idx, line)
                this.code.emit(OP_GET_IDX, 0, line)
                let name_idx = this.code.add_const(target)
                this.code.emit(OP_STORE_NEW, name_idx, line)
                i += 1
            }
        }
        this.code.emit(OP_POP, 0, line)
    }

    fn compile_AssignStatement(node) {
        let target = node.target
        let line = node.line ?? 0

        if target.node_type == "Identifier" {
            if node.operator == "=" {
                this.compile_node(node.value)
            } else {
                -- Compound: load current, compile value, apply op
                let name_idx = this.code.add_const(target.name)
                this.code.emit(OP_LOAD, name_idx, line)
                this.compile_node(node.value)
                if node.operator == "+=" { this.code.emit(OP_ADD, 0, line) }
                elif node.operator == "-=" { this.code.emit(OP_SUB, 0, line) }
                elif node.operator == "*=" { this.code.emit(OP_MUL, 0, line) }
                elif node.operator == "/=" { this.code.emit(OP_DIV, 0, line) }
                elif node.operator == "%=" { this.code.emit(OP_MOD, 0, line) }
            }
            let name_idx = this.code.add_const(target.name)
            this.code.emit(OP_STORE, name_idx, line)
        } elif target.node_type == "IndexExpression" {
            this.compile_node(target.object)
            this.compile_node(target.index)
            if node.operator == "=" {
                this.compile_node(node.value)
            } else {
                -- Compound: obj[idx] op= val
                this.code.emit(OP_DUP, 0, line)       -- dup idx
                this.code.emit(OP_ROT3, 0, line)       -- rotate to get obj on top
                this.code.emit(OP_DUP, 0, line)        -- dup obj
                this.code.emit(OP_ROT3, 0, line)       -- bring idx up
                this.code.emit(OP_GET_IDX, 0, line)    -- get current value
                this.compile_node(node.value)
                if node.operator == "+=" { this.code.emit(OP_ADD, 0, line) }
                elif node.operator == "-=" { this.code.emit(OP_SUB, 0, line) }
                elif node.operator == "*=" { this.code.emit(OP_MUL, 0, line) }
                elif node.operator == "/=" { this.code.emit(OP_DIV, 0, line) }
            }
            this.code.emit(OP_SET_IDX, 0, line)
        } elif target.node_type == "MemberExpression" {
            this.compile_node(target.object)
            let prop_idx = this.code.add_const(target.property)
            if node.operator == "=" {
                this.compile_node(node.value)
            } else {
                this.code.emit(OP_DUP, 0, line)
                this.code.emit(OP_GET_PROP, prop_idx, line)
                this.compile_node(node.value)
                if node.operator == "+=" { this.code.emit(OP_ADD, 0, line) }
                elif node.operator == "-=" { this.code.emit(OP_SUB, 0, line) }
                elif node.operator == "*=" { this.code.emit(OP_MUL, 0, line) }
                elif node.operator == "/=" { this.code.emit(OP_DIV, 0, line) }
            }
            this.code.emit(OP_SET_PROP, prop_idx, line)
        }
    }

    fn compile_MultiAssignStatement(node) {
        let line = node.line ?? 0
        -- Evaluate all values first
        mut i = 0
        while i < len(node.values) {
            this.compile_node(node.values[i])
            i += 1
        }
        -- Store in reverse order (values are on stack top-down)
        mut j = len(node.targets) - 1
        while j >= 0 {
            let target = node.targets[j]
            if target.node_type == "Identifier" {
                let name_idx = this.code.add_const(target.name)
                this.code.emit(OP_STORE, name_idx, line)
            }
            j -= 1
        }
    }

    fn compile_FnStatement(node) {
        this._compile_function(node.name, node.params, node.body)
        let line = node.line ?? 0
        let name_idx = this.code.add_const(node.name)
        this.code.emit(OP_STORE_NEW, name_idx, line)
    }

    fn _compile_function(name, params, body) {
        -- A function compiled inside a try must not inherit it: a return in
        -- there leaves the inner function, not the try around its text.
        let saved_tries = this.open_tries
        let saved_depth = this.scope_depth
        this.open_tries = []
        this.scope_depth = 0
        let result = this._compile_function_body(name, params, body)
        this.open_tries = saved_tries
        this.scope_depth = saved_depth
        return result
    }

    fn _compile_function_body(name, params, body) {
        let fn_compiler = Compiler()
        fn_compiler.code = CodeObject(name ?? "<lambda>")
        mut i = 0
        while i < len(body.statements) {
            fn_compiler.compile_node(body.statements[i])
            i += 1
        }
        fn_compiler.code.emit(OP_CONST, fn_compiler.code.add_const(null))
        fn_compiler.code.emit(OP_RETURN)
        let fn_code_idx = this.code.add_const(fn_compiler.code)
        let params_idx = this.code.add_const(params)
        let line = body.line ?? 0
        this.code.emit(OP_MAKE_FN, fn_code_idx, line)
    }

    -- Leave every open try region down to `base`, innermost first: drop its
    -- handler, then run its finally. A jump out of a try that skipped the
    -- handler left it registered on a frame that had moved on, and the next
    -- error in that frame jumped to a catch block in code that was no longer
    -- running.
    -- A block: everything it binds is its own, and goes when it does. Every
    -- block form gets one, because `clarity run` gives every block form an
    -- Environment of its own -- an if body, an else body, a loop body (a
    -- fresh one per iteration, so a closure made in a loop captures *that*
    -- round's variable), a try, a catch, a finally, a match arm and a
    -- comprehension body.
    fn _scoped_block(block, line) {
        this.code.emit(OP_PUSH_SCOPE, 0, line ?? 0)
        this.scope_depth += 1
        this.compile_block(block)
        this.code.emit(OP_POP_SCOPE, 0, line ?? 0)
        this.scope_depth -= 1
    }

    -- Close the blocks between here and `base` without pretending we left
    -- them: the code after a break or continue is still lexically inside.
    fn _unwind_scopes(base, line) {
        mut d = this.scope_depth
        while d > base {
            this.code.emit(OP_POP_SCOPE, 0, line ?? 0)
            d -= 1
        }
    }

    fn _unwind_tries(base) {
        mut ti = len(this.open_tries) - 1
        while ti >= base {
            this.code.emit(OP_POP_TRY, 0, 0)
            let fin = this.open_tries[ti]["finally"]
            if fin != null { this._scoped_block(fin, 0) }
            ti -= 1
        }
    }

    fn compile_ReturnStatement(node) {
        if node.value != null {
            this.compile_node(node.value)
        } else {
            this.code.emit(OP_NULL)
        }
        -- The value stays on the stack across the finally bodies.
        this._unwind_tries(0)
        let line = node.line ?? 0
        this.code.emit(OP_RETURN, 0, line)
    }

    fn compile_ShowStatement(node) {
        mut i = 0
        while i < len(node.values) {
            this.compile_node(node.values[i])
            i += 1
        }
        let line = node.line ?? 0
        this.code.emit(OP_PRINT, len(node.values), line)
    }

    fn compile_IfStatement(node) {
        let line = node.line ?? 0
        this.compile_node(node.condition)
        let jump_false = this.code.emit(OP_JUMP_FALSE, 0, line)
        this._scoped_block(node.body, line)
        let jump_end = this.code.emit(OP_JUMP, 0)
        this.code.patch_jump(jump_false)

        mut has_elifs = false
        try { has_elifs = node.elif_clauses != null and len(node.elif_clauses) > 0 } catch e {}
        if has_elifs {
            mut ei = 0
            mut elif_end_jumps = []
            while ei < len(node.elif_clauses) {
                let clause = node.elif_clauses[ei]
                let elif_cond = clause[0]
                let elif_body = clause[1]
                this.compile_node(elif_cond)
                let elif_jump_false = this.code.emit(OP_JUMP_FALSE, 0, line)
                this._scoped_block(elif_body, line)
                let elif_jump_end = this.code.emit(OP_JUMP, 0)
                push(elif_end_jumps, elif_jump_end)
                this.code.patch_jump(elif_jump_false)
                ei += 1
            }
            if node.else_body != null {
                this._scoped_block(node.else_body, line)
            }
            mut ji = 0
            while ji < len(elif_end_jumps) {
                this.code.patch_jump(elif_end_jumps[ji])
                ji += 1
            }
        } else {
            if node.else_body != null {
                this._scoped_block(node.else_body, line)
            }
        }
        this.code.patch_jump(jump_end)
    }

    fn compile_WhileStatement(node) {
        let line = node.line ?? 0
        let loop_start = len(this.code.instructions)
        push(this.loop_stack, {"start": loop_start, "break_patches": [],
            "try_base": len(this.open_tries), "scope_base": this.scope_depth})

        this.compile_node(node.condition)
        let jump_false = this.code.emit(OP_JUMP_FALSE, 0, line)
        this._scoped_block(node.body, line)
        this.code.emit(OP_JUMP, loop_start)
        this.code.patch_jump(jump_false)

        let loop_ctx = pop(this.loop_stack)
        mut bi = 0
        while bi < len(loop_ctx["break_patches"]) {
            this.code.patch_jump(loop_ctx["break_patches"][bi])
            bi += 1
        }
    }

    fn compile_ForStatement(node) {
        let line = node.line ?? 0
        this.compile_node(node.iterable)
        this.code.emit(OP_ITER_INIT, 0, line)
        let loop_start = len(this.code.instructions)
        push(this.loop_stack, {"start": loop_start, "break_patches": [],
            "try_base": len(this.open_tries), "scope_base": this.scope_depth})

        -- ITER_NEXT peeks the iterator (it does not pop it), so the iterator
        -- must stay on the stack across iterations WITHOUT an extra DUP — a
        -- DUP here leaks one iterator per iteration.
        this.code.emit(OP_ITER_NEXT)
        let jump_end = this.code.emit(OP_JUMP_FALSE, 0)
        -- The loop variable is part of the iteration's own scope, so it does
        -- not outlive the loop and a closure made in the body captures *this*
        -- round's binding. Both were wrong before: `for z in [1,2,3] { }; z`
        -- answered 3, and three closures made in a loop all answered 3.
        this.code.emit(OP_PUSH_SCOPE, 0, line)
        this.scope_depth += 1
        let name_idx = this.code.add_const(node.variable)
        this.code.emit(OP_STORE_NEW, name_idx)
        this.compile_block(node.body)
        this.code.emit(OP_POP_SCOPE, 0, line)
        this.scope_depth -= 1
        this.code.emit(OP_JUMP, loop_start)
        this.code.patch_jump(jump_end)

        -- Both ways out of the loop land on the POP that removes the
        -- iterator. The break jumps used to be patched *after* it was
        -- emitted, so a break left its iterator on the stack; in a nested
        -- loop the leaked inner iterator then stood where the outer loop's
        -- was, and the outer loop repeated its last value forever.
        let loop_ctx = pop(this.loop_stack)
        mut bi = 0
        while bi < len(loop_ctx["break_patches"]) {
            this.code.patch_jump(loop_ctx["break_patches"][bi])
            bi += 1
        }
        this.code.emit(OP_POP)   -- pop iterator
    }

    fn compile_BreakStatement(node) {
        let line = node.line ?? 0
        if len(this.loop_stack) > 0 {
            let loop_ctx = this.loop_stack[len(this.loop_stack) - 1]
            this._unwind_tries(loop_ctx["try_base"])
            this._unwind_scopes(loop_ctx["scope_base"], line)
            let patch_idx = this.code.emit(OP_JUMP, 0, line)
            push(loop_ctx["break_patches"], patch_idx)
        }
    }

    fn compile_ContinueStatement(node) {
        let line = node.line ?? 0
        if len(this.loop_stack) > 0 {
            let loop_ctx = this.loop_stack[len(this.loop_stack) - 1]
            this._unwind_tries(loop_ctx["try_base"])
            this._unwind_scopes(loop_ctx["scope_base"], line)
            this.code.emit(OP_JUMP, loop_ctx["start"], line)
        }
    }

    -- A `finally` block runs whichever way the try is left. The VM did not
    -- compile node.finally_body at all, so `try { show "a" } catch e {}
    -- finally { show "b" }` printed both lines under the interpreter and
    -- only "a" under `run --fast`. It is emitted on every way out: the
    -- normal path, the catch path, a catch that throws (through a guard
    -- handler that runs it and rethrows), and a return, break or continue
    -- that leaves the region early (see _unwind_tries). The parser requires
    -- a catch, so there is no try/finally an error passes straight through.
    fn compile_TryCatch(node) {
        let line = node.line ?? 0
        let try_start = this.code.emit(OP_SETUP_TRY, 0, line)
        push(this.open_tries, {"finally": node.finally_body})
        this._scoped_block(node.try_body, line)
        pop(this.open_tries)
        this.code.emit(OP_POP_TRY, 0, line)
        if node.finally_body != null { this._scoped_block(node.finally_body, line) }
        let jump_end = this.code.emit(OP_JUMP, 0)
        -- Patch try handler to point here (catch block)
        this.code.patch_jump(try_start)
        -- The catch variable belongs to the catch block, not to the function
        -- around it: `try { throw "x" } catch e { }` used to leave `e` bound
        -- afterwards here, where `clarity run` does not.
        this.code.emit(OP_PUSH_SCOPE, 0, line)
        this.scope_depth += 1
        -- Store error into catch variable
        if node.catch_var != null {
            let var_idx = this.code.add_const(node.catch_var)
            this.code.emit(OP_STORE_NEW, var_idx, line)
        } else {
            this.code.emit(OP_POP, 0, line)
        }
        -- A catch block that throws must still run the finally on its way
        -- out, so the catch body gets a handler of its own whose only job is
        -- to run the finally and rethrow. Without it `try { throw "a" }
        -- catch e { throw "b" } finally { show "fin" }` skipped the finally
        -- under the VM and ran it under the interpreter.
        if node.finally_body == null {
            this.compile_block(node.catch_body)
            this.code.emit(OP_POP_SCOPE, 0, line)
            this.scope_depth -= 1
            this.code.patch_jump(jump_end)
            return null
        }

        let catch_guard = this.code.emit(OP_SETUP_TRY, 0, line)
        push(this.open_tries, {"finally": node.finally_body})
        this.compile_block(node.catch_body)
        pop(this.open_tries)
        this.code.emit(OP_POP_TRY, 0, line)
        this.code.emit(OP_POP_SCOPE, 0, line)
        this.scope_depth -= 1
        this._scoped_block(node.finally_body, line)
        let jump_end2 = this.code.emit(OP_JUMP, 0)
        this.code.patch_jump(catch_guard)
        this._scoped_block(node.finally_body, line)
        this.code.emit(OP_THROW, 0, line)
        this.code.patch_jump(jump_end)
        this.code.patch_jump(jump_end2)
    }

    fn compile_ThrowStatement(node) {
        let line = node.line ?? 0
        this.compile_node(node.value)
        this.code.emit(OP_THROW, 0, line)
    }

    fn compile_ClassStatement(node) {
        let line = node.line ?? 0
        -- Push class name
        let name_idx = this.code.add_const(node.name)
        this.code.emit(OP_CONST, name_idx, line)
        -- Push parent class or null
        if node.parent != null {
            let parent_idx = this.code.add_const(node.parent)
            this.code.emit(OP_LOAD, parent_idx, line)
        } else {
            this.code.emit(OP_NULL, 0, line)
        }
        -- Compile each method
        let methods = node.methods
        mut i = 0
        while i < len(methods) {
            let method = methods[i]
            let method_name_idx = this.code.add_const(method.name)
            this.code.emit(OP_CONST, method_name_idx, line)
            this._compile_function(method.name, method.params, method.body)
            i += 1
        }
        this.code.emit(OP_MAKE_CLASS, len(methods), line)
        this.code.emit(OP_STORE_NEW, name_idx, line)
    }

    fn compile_EnumStatement(node) {
        let line = node.line ?? 0
        let name_idx = this.code.add_const(node.name)
        -- Build enum as map: {member_name: member_value, ...}
        mut i = 0
        while i < len(node.members) {
            let member = node.members[i]
            let mem_name = if type(member) == "list" { member[0] } else { member }
            let mem_name_idx = this.code.add_const(mem_name)
            this.code.emit(OP_CONST, mem_name_idx, line)
            -- Parser stores members as [name, value-or-null]; only compile
            -- the value when explicitly provided, otherwise default to the
            -- index.
            mut explicit_value = null
            if type(member) == "list" and len(member) > 1 {
                explicit_value = member[1]
            }
            if explicit_value != null {
                this.compile_node(explicit_value)
            } else {
                this.code.emit(OP_CONST, this.code.add_const(i), line)
            }
            i += 1
        }
        this.code.emit(OP_MAKE_MAP, len(node.members), line)
        this.code.emit(OP_MAKE_ENUM, name_idx, line)
        this.code.emit(OP_STORE_NEW, name_idx, line)
    }

    fn compile_InterfaceStatement(node) {
        let line = node.line ?? 0
        let name_idx = this.code.add_const(node.name)
        -- Interfaces compile as a map of method signatures
        mut i = 0
        while i < len(node.methods) {
            let method = node.methods[i]
            let m_name = if type(method) == "map" and has(method, "name") { method["name"] } else { str(method) }
            this.code.emit(OP_CONST, this.code.add_const(m_name), line)
            this.code.emit(OP_TRUE, 0, line)
            i += 1
        }
        this.code.emit(OP_MAKE_MAP, len(node.methods), line)
        this.code.emit(OP_STORE_NEW, name_idx, line)
    }

    fn compile_MatchStatement(node) {
        let line = node.line ?? 0
        this.compile_node(node.subject)
        -- Compile as chain of compare-and-jump
        mut end_jumps = []
        mut i = 0
        while i < len(node.arms) {
            let arm = node.arms[i]
            let pattern = arm[0]
            let body = arm[1]
            mut is_default = false
            try {
                if pattern.node_type == "Identifier" and pattern.name == "_" {
                    is_default = true
                }
            } catch e {}
            if is_default {
                this.code.emit(OP_POP, 0, line)
                this._scoped_block(body, line)
                let jump_end = this.code.emit(OP_JUMP, 0)
                push(end_jumps, jump_end)
            } else {
                this.code.emit(OP_DUP, 0, line)
                this.compile_node(pattern)
                this.code.emit(OP_EQ, 0, line)
                let jump_miss = this.code.emit(OP_JUMP_FALSE, 0, line)
                this.code.emit(OP_POP, 0, line)
                this._scoped_block(body, line)
                let jump_end = this.code.emit(OP_JUMP, 0)
                push(end_jumps, jump_end)
                this.code.patch_jump(jump_miss)
            }
            i += 1
        }
        -- Default arm (else block on the match itself)
        mut has_default = false
        try { has_default = node.default != null } catch e {}
        if has_default {
            this.code.emit(OP_POP, 0, line)
            this._scoped_block(node.default, line)
            let jump_end = this.code.emit(OP_JUMP, 0)
            push(end_jumps, jump_end)
        } else {
            -- Pop the subject value if no arm matched
            this.code.emit(OP_POP, 0, line)
        }
        -- Patch all end jumps
        mut ji = 0
        while ji < len(end_jumps) {
            this.code.patch_jump(end_jumps[ji])
            ji += 1
        }
    }

    -- An import is a runtime act: the VM finds the module, runs it once,
    -- and binds what was asked for into the current frame. Everything the
    -- VM needs to do that travels in one constant, so the error messages
    -- can name the module and the line the same way the interpreter does.
    -- Until this existed the statement compiled to nothing, and `clarity
    -- run --fast` failed on the first name a program imported.
    fn compile_ImportStatement(node) {
        let line = node.line ?? 0
        let spec = {"path": node.path, "names": node.names, "alias": node.alias, "line": line}
        this.code.emit(OP_IMPORT, this.code.add_const(spec), line)
    }

    fn compile_DecoratedStatement(node) {
        let line = node.line ?? 0
        -- The parser calls the decorated thing `target`; this read
        -- `node.statement`, which no DecoratedStatement has, so every
        -- decorated function died in the compiler with "undefined is not an
        -- object (evaluating 'node.node_type')". That is what killed
        -- examples/async_generators.clarity under --fast.
        -- Compile the inner statement first (defines the function)
        this.compile_node(node.target)
        -- Apply decorators in reverse order
        mut i = len(node.decorators) - 1
        while i >= 0 {
            let decorator = node.decorators[i]
            -- Load the decorator function
            this.compile_node(decorator)
            -- Load the function we just defined
            -- The function was stored via STORE_NEW, so we load it back
            if node.target.node_type == "FnStatement" {
                let name_idx = this.code.add_const(node.target.name)
                this.code.emit(OP_LOAD, name_idx, line)
            }
            -- Call decorator with the function as argument
            this.code.emit(OP_CALL, 1, line)
            -- Store the result back
            if node.target.node_type == "FnStatement" {
                let name_idx = this.code.add_const(node.target.name)
                this.code.emit(OP_STORE, name_idx, line)
            } else {
                this.code.emit(OP_POP, 0, line)
            }
            i -= 1
        }
    }

    fn compile_block(block) {
        mut i = 0
        while i < len(block.statements) {
            this.compile_node(block.statements[i])
            i += 1
        }
    }

    fn compile_Block(node) {
        this._scoped_block(node, node.line ?? 0)
    }

    -- ── Expression compilers ────────────────────────────

    fn compile_NumberLiteral(node) {
        let idx = this.code.add_const(node.value)
        let line = node.line ?? 0
        this.code.emit(OP_CONST, idx, line)
    }

    -- A string with {expr} in it is compiled into the pieces and the
    -- expressions, joined with ADD (which converts through the same display
    -- rules the interpreter uses). The VM used to push the text as one
    -- constant, so every interpolation in the language's headline feature
    -- printed its own braces under `run --fast`: `show "n is {n}"` gave
    -- `n is {n}`.
    --
    -- `{` begins an interpolation only when what follows starts with a
    -- letter or underscore, which is the heuristic the interpreter and the
    -- transpiler both use, so `"if x { 1 }"` stays literal in all three.
    fn compile_StringLiteral(node) {
        let line = node.line ?? 0
        mut raw = false
        try { raw = node.raw ?? false } catch e { raw = false }
        if raw or not _has_interpolation(node.value) {
            this.code.emit(OP_CONST, this.code.add_const(node.value), line)
            return null
        }

        let text = node.value
        let text_len = len(text)
        mut literal = ""
        mut emitted = false
        mut i = 0
        while i < text_len {
            let ch = char_at(text, i)
            if ch == "{" and i + 1 < text_len and (is_alpha(char_at(text, i + 1)) or char_at(text, i + 1) == "_") {
                mut j = i + 1
                mut depth = 1
                while j < text_len and depth > 0 {
                    if char_at(text, j) == "{" { depth += 1 }
                    if char_at(text, j) == "}" { depth -= 1 }
                    if depth > 0 { j += 1 }
                }
                if depth != 0 {
                    literal = literal + ch
                    i += 1
                    continue
                }
                let expr_str = substring(text, i + 1, j)
                mut expr_node = null
                mut parsed = false
                -- An expression that does not parse stays literal, which is
                -- what the interpreter does with it. One that parses to
                -- nothing at all contributes nothing, also as there.
                try {
                    let tree = parse(tokenize(expr_str, "<interp>"), expr_str)
                    parsed = true
                    if len(tree.body) > 0 { expr_node = tree.body[0].expression }
                } catch e_parse { parsed = false }
                if not parsed {
                    literal = literal + "{" + expr_str + "}"
                    i = j + 1
                    continue
                }
                if expr_node == null {
                    i = j + 1
                    continue
                }
                this.code.emit(OP_CONST, this.code.add_const(literal), line)
                if emitted { this.code.emit(OP_ADD, 0, line) }
                literal = ""
                emitted = true
                this.compile_node(expr_node)
                this.code.emit(OP_ADD, 0, line)
                i = j + 1
            } else {
                literal = literal + ch
                i += 1
            }
        }
        if len(literal) > 0 or not emitted {
            this.code.emit(OP_CONST, this.code.add_const(literal), line)
            if emitted { this.code.emit(OP_ADD, 0, line) }
        }
        return null
    }

    fn compile_BoolLiteral(node) {
        let line = node.line ?? 0
        if node.value { this.code.emit(OP_TRUE, 0, line) }
        else { this.code.emit(OP_FALSE, 0, line) }
    }

    fn compile_NullLiteral(node) {
        let line = node.line ?? 0
        this.code.emit(OP_NULL, 0, line)
    }

    fn compile_Identifier(node) {
        let idx = this.code.add_const(node.name)
        let line = node.line ?? 0
        this.code.emit(OP_LOAD, idx, line)
    }

    fn compile_ThisExpression(node) {
        let idx = this.code.add_const("this")
        let line = node.line ?? 0
        this.code.emit(OP_LOAD, idx, line)
    }

    fn compile_BinaryOp(node) {
        let line = node.line ?? 0
        let op = node.operator
        -- `and` and `or` short-circuit: the right side runs only when the
        -- left does not already decide the answer. The VM compiled both
        -- sides and then combined them, so `false and side()` *called*
        -- side() under --fast, and collections.clarity's own
        -- `if len(items) == 1 and type(items[0]) == "list"` read items[0] of
        -- an empty list — which answered null while the VM let a read past
        -- the end pass, and became an error the moment it did not.
        if op == "and" or op == "or" {
            this.compile_node(node.left)
            this.code.emit(OP_DUP, 0, line)
            let skip = if op == "and" {
                this.code.emit(OP_JUMP_FALSE, 0, line)
            } else {
                this.code.emit(OP_JUMP_TRUE, 0, line)
            }
            -- The left value decided nothing: drop it and take the right.
            this.code.emit(OP_POP, 0, line)
            this.compile_node(node.right)
            this.code.patch_jump(skip)
            return null
        }
        this.compile_node(node.left)
        this.compile_node(node.right)

        if op == "+" { this.code.emit(OP_ADD, 0, line) }
        elif op == "-" { this.code.emit(OP_SUB, 0, line) }
        elif op == "*" { this.code.emit(OP_MUL, 0, line) }
        elif op == "/" { this.code.emit(OP_DIV, 0, line) }
        elif op == "%" { this.code.emit(OP_MOD, 0, line) }
        elif op == "**" { this.code.emit(OP_POW, 0, line) }
        elif op == "==" { this.code.emit(OP_EQ, 0, line) }
        elif op == "!=" { this.code.emit(OP_NEQ, 0, line) }
        elif op == "<" { this.code.emit(OP_LT, 0, line) }
        elif op == ">" { this.code.emit(OP_GT, 0, line) }
        elif op == "<=" { this.code.emit(OP_LTE, 0, line) }
        elif op == ">=" { this.code.emit(OP_GTE, 0, line) }
        elif op == "and" { this.code.emit(OP_AND, 0, line) }
        elif op == "or" { this.code.emit(OP_OR, 0, line) }
        elif op == "&" { this.code.emit(OP_BIT_AND, 0, line) }
        elif op == "|" { this.code.emit(OP_BIT_OR, 0, line) }
        elif op == "^" { this.code.emit(OP_BIT_XOR, 0, line) }
        elif op == "<<" { this.code.emit(OP_LSHIFT, 0, line) }
        elif op == ">>" { this.code.emit(OP_RSHIFT, 0, line) }
        -- `is` is `==`. docs/reference.html lists it beside and/or/not, and
        -- the interpreter and the bootstrap transpiler have both read it that
        -- way from the start; only this compiler had never heard of it, so a
        -- program using a documented operator died here with
        -- "CompileError: Unknown binary operator: is".
        elif op == "is" { this.code.emit(OP_EQ, 0, line) }
        else { throw "CompileError: Unknown binary operator: {op}" }
    }

    fn compile_UnaryOp(node) {
        let line = node.line ?? 0
        this.compile_node(node.operand)
        if node.operator == "-" { this.code.emit(OP_NEG, 0, line) }
        elif node.operator == "not" { this.code.emit(OP_NOT, 0, line) }
        elif node.operator == "~" { this.code.emit(OP_BIT_NOT, 0, line) }
        -- Falling through emitted nothing and left the operand on the stack,
        -- so an operator this compiler does not know became a silently wrong
        -- program rather than a message. The binary form above has always
        -- said so; this one now does too.
        else { throw "CompileError: Unknown unary operator: {node.operator}" }
    }

    fn compile_CallExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.callee)
        mut i = 0
        while i < len(node.arguments) {
            this.compile_node(node.arguments[i])
            i += 1
        }
        this.code.emit(OP_CALL, len(node.arguments), line)
    }

    fn compile_ListLiteral(node) {
        let line = node.line ?? 0
        mut i = 0
        while i < len(node.elements) {
            this.compile_node(node.elements[i])
            i += 1
        }
        this.code.emit(OP_MAKE_LIST, len(node.elements), line)
    }

    fn compile_MapLiteral(node) {
        let line = node.line ?? 0
        mut i = 0
        while i < len(node.pairs) {
            let pair = node.pairs[i]
            -- `{...m, "b": 2}` is a pair with no key. Compiling the missing
            -- key crashed the compiler itself, with a host TypeError about
            -- node.node_type — so a program using it did not run at all
            -- under --fast. The marked value stands in for both halves and
            -- OP_MAKE_MAP merges it.
            if pair[0] == null {
                this.compile_node(pair[1])
                this.code.emit(OP_NULL, 0, line)
            } else {
                this.compile_node(pair[0])
                this.compile_node(pair[1])
            }
            i += 1
        }
        this.code.emit(OP_MAKE_MAP, len(node.pairs), line)
    }

    fn compile_IndexExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.object)
        this.compile_node(node.index)
        this.code.emit(OP_GET_IDX, 0, line)
    }

    fn compile_MemberExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.object)
        let prop_idx = this.code.add_const(node.property)
        this.code.emit(OP_GET_PROP, prop_idx, line)
    }

    fn compile_OptionalMemberExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.object)
        -- One opcode, because the question `?.` asks is not only "is the
        -- object null": the interpreter answers null whenever reading the
        -- property would have failed at all.
        this.code.emit(OP_GET_PROP_OPT, this.code.add_const(node.property), line)
    }

    fn compile_SliceExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.object)
        if node.start != null {
            this.compile_node(node.start)
        } else {
            this.code.emit(OP_CONST, this.code.add_const(0), line)
        }
        if node.end != null {
            this.compile_node(node.end)
        } else {
            this.code.emit(OP_NULL, 0, line)
        }
        this.code.emit(OP_SLICE, 0, line)
    }

    fn compile_RangeExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.start)
        if node.end != null {
            this.compile_node(node.end)
        } else {
            this.code.emit(OP_NULL)
        }
        this.code.emit(OP_RANGE, 0, line)
    }

    fn compile_PipeExpression(node) {
        let line = node.line ?? 0
        if node.function.node_type == "CallExpression" {
            -- callee first, then value (becomes first arg), then explicit args
            this.compile_node(node.function.callee)
            this.compile_node(node.value)
            mut i = 0
            while i < len(node.function.arguments) {
                this.compile_node(node.function.arguments[i])
                i += 1
            }
            this.code.emit(OP_CALL, len(node.function.arguments) + 1, line)
        } else {
            -- fn |> form: callee first, then value as the single arg
            this.compile_node(node.function)
            this.compile_node(node.value)
            this.code.emit(OP_CALL, 1, line)
        }
    }

    fn compile_FnExpression(node) {
        let line = node.line ?? 0
        let fn_compiler = Compiler()
        fn_compiler.code = CodeObject("<lambda>")
        mut i = 0
        while i < len(node.body.statements) {
            fn_compiler.compile_node(node.body.statements[i])
            i += 1
        }
        fn_compiler.code.emit(OP_CONST, fn_compiler.code.add_const(null))
        fn_compiler.code.emit(OP_RETURN)
        let fn_code_idx = this.code.add_const(fn_compiler.code)
        let params_idx = this.code.add_const(node.params)
        this.code.emit(OP_MAKE_FN, fn_code_idx, line)
    }

    fn compile_IfExpression(node) {
        this.compile_node(node.condition)
        let jump_false = this.code.emit(OP_JUMP_FALSE, 0)
        this.compile_node(node.true_expr)
        let jump_end = this.code.emit(OP_JUMP, 0)
        this.code.patch_jump(jump_false)
        this.compile_node(node.false_expr)
        this.code.patch_jump(jump_end)
    }

    fn compile_NullCoalesce(node) {
        let line = node.line ?? 0
        this.compile_node(node.left)
        -- If not null, skip right side
        this.code.emit(OP_DUP, 0, line)
        this.code.emit(OP_NULL, 0, line)
        this.code.emit(OP_NEQ, 0, line)
        let jump_done = this.code.emit(OP_JUMP_TRUE, 0, line)
        -- Left was null, pop it and use right
        this.code.emit(OP_POP, 0, line)
        this.compile_node(node.right)
        this.code.patch_jump(jump_done)
    }

    -- `...xs` evaluates xs and marks it, so whatever is assembling the values
    -- around it — a list, a map, a call's arguments — knows to open it out
    -- rather than take it whole. It used to compile to the value alone, so
    -- `[1, ...[2, 3], 4]` was `[1, [2, 3], 4]` under --fast and
    -- `f(...[1, 2, 3])` passed one list and two nulls.
    fn compile_SpreadExpression(node) {
        let line = node.line ?? 0
        this.compile_node(node.value)
        this.code.emit(OP_SPREAD, 0, line)
    }

    fn compile_ComprehensionExpression(node) {
        let line = node.line ?? 0
        -- [expr for var in iterable] or [expr for var in iterable if cond]
        this.code.emit(OP_MAKE_LIST, 0, line)   -- result list
        this.compile_node(node.iterable)
        this.code.emit(OP_ITER_INIT, 0, line)
        let loop_start = len(this.code.instructions)
        -- ITER_NEXT peeks the iterator, so no DUP (a DUP leaks one iterator
        -- per iteration — and comprehensions read results off the stack, so
        -- unlike a for-loop the leak actually corrupts them).
        this.code.emit(OP_ITER_NEXT)
        let jump_end = this.code.emit(OP_JUMP_FALSE, 0)
        -- The loop variable is the iteration's own, as it is in a for-loop
        -- and as it is under `clarity run`: it does not outlive the
        -- comprehension, and it does not overwrite an outer name it shadows.
        this.code.emit(OP_PUSH_SCOPE, 0, line)
        this.scope_depth += 1
        let var_idx = this.code.add_const(node.variable)
        this.code.emit(OP_STORE_NEW, var_idx)
        -- Check filter condition if present
        mut jump_skip = -1
        if node.condition != null {
            this.compile_node(node.condition)
            jump_skip = this.code.emit(OP_JUMP_FALSE, 0)
        }
        -- Append the element expression to the result list. Stack here is
        -- [result_list, iterator]. push() mutates the list and returns it,
        -- so the return value threads result_list back for the next round.
        -- OP_CALL expects [callee, arg1, arg2] → push(result_list, value).
        this.code.emit(OP_SWAP, 0, line)        -- [iterator, result_list]
        let push_idx = this.code.add_const("push")
        this.code.emit(OP_LOAD, push_idx, line) -- [iterator, result_list, push]
        this.code.emit(OP_SWAP, 0, line)        -- [iterator, push, result_list]
        this.compile_node(node.expr)            -- [iterator, push, result_list, value]
        this.code.emit(OP_CALL, 2, line)        -- [iterator, result_list]
        this.code.emit(OP_SWAP, 0, line)        -- [result_list, iterator]
        if jump_skip >= 0 {
            this.code.patch_jump(jump_skip)
        }
        this.code.emit(OP_POP_SCOPE, 0, line)
        this.scope_depth -= 1
        this.code.emit(OP_JUMP, loop_start)
        this.code.patch_jump(jump_end)
        this.code.emit(OP_POP)   -- pop iterator, result_list remains
    }

    fn compile_MapComprehensionExpression(node) {
        let line = node.line ?? 0
        this.code.emit(OP_MAKE_MAP, 0, line)    -- result map
        this.compile_node(node.iterable)
        this.code.emit(OP_ITER_INIT, 0, line)
        let loop_start = len(this.code.instructions)
        -- No DUP: ITER_NEXT peeks the iterator (see the list comprehension).
        this.code.emit(OP_ITER_NEXT)
        let jump_end = this.code.emit(OP_JUMP_FALSE, 0)
        this.code.emit(OP_PUSH_SCOPE, 0, line)
        this.scope_depth += 1
        -- The AST stores loop targets as `variables` (a list). One target takes
        -- the item whole; several destructure a list item element-wise, which
        -- is what the interpreter does, so COMP_BIND carries that rule --
        -- including leaving a target after the first unbound when the item is
        -- not a list, so reading it raises the NameError `clarity run` raises.
        if len(node.variables) == 1 {
            let var_idx = this.code.add_const(node.variables[0])
            this.code.emit(OP_STORE_NEW, var_idx)
        } else {
            mut vi = 0
            while vi < len(node.variables) {
                this.code.emit(OP_DUP, 0, line)
                let bind_idx = this.code.add_const({
                    "index": vi, "name": node.variables[vi]
                })
                this.code.emit(OP_COMP_BIND, bind_idx, line)
                vi += 1
            }
            this.code.emit(OP_POP, 0, line)
        }
        mut jump_skip = -1
        if node.condition != null {
            this.compile_node(node.condition)
            jump_skip = this.code.emit(OP_JUMP_FALSE, 0)
        }
        -- result_map[key] = value, threading result_map back. Stack here is
        -- [result_map, iterator]. SET_IDX consumes the map, so DUP a copy
        -- first; it expects [obj, idx, value].
        this.code.emit(OP_SWAP, 0, line)        -- [iterator, result_map]
        this.code.emit(OP_DUP, 0, line)         -- [iterator, result_map, result_map]
        this.compile_node(node.key_expr)        -- [iterator, result_map, result_map, key]
        this.compile_node(node.value_expr)      -- [iterator, result_map, result_map, key, value]
        this.code.emit(OP_SET_IDX, 0, line)     -- [iterator, result_map]
        this.code.emit(OP_SWAP, 0, line)        -- [result_map, iterator]
        if jump_skip >= 0 {
            this.code.patch_jump(jump_skip)
        }
        this.code.emit(OP_POP_SCOPE, 0, line)
        this.scope_depth -= 1
        this.code.emit(OP_JUMP, loop_start)
        this.code.patch_jump(jump_end)
        this.code.emit(OP_POP)
    }

    fn compile_AskExpression(node) {
        let line = node.line ?? 0
        let ask_idx = this.code.add_const("ask")
        this.code.emit(OP_LOAD, ask_idx, line)
        if node.prompt != null {
            this.compile_node(node.prompt)
        } else {
            this.code.emit(OP_CONST, this.code.add_const(""), line)
        }
        this.code.emit(OP_CALL, 1, line)
    }

    fn compile_AwaitExpression(node) {
        -- Await in bytecode mode just evaluates the expression
        this.compile_node(node.value)
    }

    -- `yield v` evaluates to v *and* collects it. Clarity's generators are
    -- eager: a function whose body yields runs to the end and returns the
    -- list of everything it yielded, which is what the interpreter does and
    -- what `for x in gen()` iterates. This used to compile to the value
    -- alone, so `counter(3)` returned null under `run --fast` and the loop
    -- over it ran zero times, against the interpreter's [0, 10, 20].
    fn compile_YieldExpression(node) {
        let line = node.line ?? 0
        if node.value != null {
            this.compile_node(node.value)
        } else {
            this.code.emit(OP_NULL)
        }
        this.code.emit(OP_YIELD, 0, line)
    }
}

-- ── VM Types ─────────────────────────────────────────────

class VMFrame {
    fn init(code, base_pointer) {
        this.code = code
        this.ip = 0
        -- `locals` is the *innermost* scope, and `parents` the blocks around
        -- it, outermost first. A block pushes the current innermost onto
        -- parents and starts a fresh map; leaving it puts the old one back,
        -- and everything the block bound goes with it. Before this the frame
        -- had one flat map, so a `for` variable outlived its loop and a loop
        -- over a name that already existed overwrote it.
        this.locals = {}
        this.parents = []
        this.base_pointer = base_pointer ?? 0
        this.closure = null
        -- What `yield` has collected in this call. Per frame, so a recursive
        -- or nested generator composes without the collections running
        -- together — the interpreter saves and restores one for the same
        -- reason.
        this.yields = []
    }
}

class VMFunction {
    fn init(code, params, name) {
        this._clarityType = "VMFunction"
        this.code = code
        this.params = params
        this.name = name ?? "<fn>"
        -- The enclosing frame's scopes at definition time, innermost first.
        -- A *list* of maps rather than one map, because the frame has a scope
        -- per block it is inside: capturing only the flat map gave every
        -- closure made in a loop the same binding, so `for k in [1,2,3] {
        -- push(fs, fn() { return k }) }` answered [3, 3, 3] where the
        -- interpreter answers [1, 2, 3]. Held by reference, so a closure that
        -- mutates a captured variable still sees later writes.
        this.closure = null
    }

    fn to_string() {
        return "<fn {this.name}>"
    }
}

class VMClass {
    fn init(name, methods, parent) {
        this._clarityType = "VMClass"
        this.name = name
        this.methods = methods
        this.parent = parent ?? null
    }

    fn find_method(name) {
        if has(this.methods, name) {
            return this.methods[name]
        }
        if this.parent != null {
            return this.parent.find_method(name)
        }
        return null
    }

    fn to_string() {
        return "<class {this.name}>"
    }
}

-- An instance's own fields, for the builtins that ask a value what it holds.
-- Without this they were handed the VMInstance itself, so `keys(obj)` came
-- back ["_clarityType", "klass", "properties"] -- the engine's representation,
-- not the program's object -- and `for k in keys(obj) { obj[k] }` walked it.
-- Interpreter._unwrap_props is the same function.
fn _vm_props(v) {
    if type(v) == "VMInstance" { return v.properties }
    return v
}

class VMInstance {
    fn init(klass) {
        this._clarityType = "VMInstance"
        this.klass = klass
        this.properties = {}
    }

    fn get_prop(name) {
        if has(this.properties, name) {
            return this.properties[name]
        }
        let method = this.klass.find_method(name)
        if method != null {
            return VMBoundMethod(this, method)
        }
        return null
    }

    fn to_string() {
        return "<{this.klass.name} instance>"
    }
}

-- `xs.slice(a, b)` and `xs.copy()`, without the interpreter module's
-- helpers: a plain copy of the range, clamped at the end like theirs.
fn _vm_slice(lst, start, end_i) {
    mut out = []
    let stop = if end_i != null { end_i } else { len(lst) }
    -- A missing start is 0, and it is the runtime *value* that decides, so
    -- `xs[null..2]` means `xs[..2]` -- which is what the interpreter's
    -- eval_SliceExpression does with its own null checks.
    mut i = if start != null { start } else { 0 }
    while i < stop and i < len(lst) {
        push(out, lst[i])
        i += 1
    }
    return out
}

-- An enum: its members, and the name it answers to. The VM used to compile
-- one to a plain map, so `Color.Red` worked by accident and `Color.names()`
-- called null -- which is what made examples/classes.clarity die under
-- --fast. Interpreter.ClarityEnum is the same two fields.
class VMEnum {
    fn init(name, members) {
        this._clarityType = "VMEnum"
        this.name = name
        this.members = members
    }

    fn to_string() {
        return "<enum {this.name}>"
    }
}

-- A value marked by `...` — a list opened out into a list or a call's
-- arguments, a map merged into a map. It exists only between OP_SPREAD and
-- whatever assembles the values around it, and never reaches a program.
class VMSpread {
    fn init(value) {
        this._clarityType = "VMSpread"
        this.value = value
    }
}

-- A method retrieved off a VMInstance, with `this` already captured.
-- _call_fn detects this and routes to _call_method so `this` is in scope.
-- `open` plus one more, as a new list; see Interpreter._appended.
fn _appended(open, value) {
    mut out = []
    for o in open { push(out, o) }
    push(out, value)
    return out
}

class VMBoundMethod {
    fn init(instance, method) {
        this._clarityType = "VMBoundMethod"
        this.instance = instance
        this.method = method
    }
}

class VMIterator {
    fn init(items) {
        this._clarityType = "VMIterator"
        this.items = items
        this.index = 0
    }

    fn has_next() {
        return this.index < len(this.items)
    }

    fn next() {
        let val = this.items[this.index]
        this.index = this.index + 1
        return val
    }
}

-- ── Virtual Machine ──────────────────────────────────────

class VM {
    -- `parent` is the VM that is importing a module into this one: the two
    -- share one output stream and one module cache, so a module's `show`
    -- lands where the program's does and a module imported twice runs once.
    fn init(parent) {
        this.stack = []
        this.frames = []
        this.globals = {}
        this.output = if parent != null { parent.output } else { [] }
        this.modules = if parent != null { parent.modules } else { {} }
        -- Where relative imports are looked for after the working directory:
        -- the directory of the file being run. Set by whoever runs a file.
        this.source_dir = null
        this.try_stack = []   -- [{catch_ip: int, stack_depth: int, frame_depth: int}]
        this._setup_builtins()
        -- What a module's namespace is not: a module dict holds only the
        -- names the module itself defined, and this is how they are told
        -- apart from the builtins every frame starts with.
        this.builtin_names = {}
        for k in keys(this.globals) { this.builtin_names[k] = true }
    }

    -- ── Imports ───────────────────────────────────────

    -- Resolve a module the way the interpreter does: as written, then
    -- relative to the running file's directory, then from the standard
    -- library embedded in the binary. The module runs once in a VM of its
    -- own, so its top-level names do not land in the importer's frame,
    -- and its functions keep the module's frame as their closure, which
    -- is how they see the module's other names when called from outside.
    fn _import_module(path_given, line) {
        mut path = path_given
        if not ends(path, ".clarity") { path = path + ".clarity" }
        if not exists(path) and this.source_dir != null {
            let candidate = this.source_dir + "/" + path
            if exists(candidate) { path = candidate }
        }
        if has(this.modules, path) { return this.modules[path] }

        mut source = null
        mut key = path
        if exists(path) {
            source = read(path)
        } else {
            let base = _bc_basename(path)
            let embedded = _embedded_source(base)
            if embedded == null {
                throw "RuntimeError: Cannot find module: {path} (line {line})"
            }
            source = embedded
            key = "<bundle>/" + base
            if has(this.modules, key) { return this.modules[key] }
        }

        let tokens = tokenize(source, key)
        let tree = parse(tokens, source)
        let module_code = compile_to_bytecode(tree)
        optimize(module_code)

        let child = VM(this)
        child.source_dir = _bc_dirname(key)
        let frame = VMFrame(module_code)
        for k in keys(child.globals) { frame.locals[k] = child.globals[k] }
        -- Registered before it runs, so a module that imports its importer
        -- gets the names defined so far instead of running it a second time.
        this.modules[key] = frame.locals
        push(child.frames, frame)
        try {
            child._execute_frame()
            pop(child.frames)
        } catch err {
            pop(child.frames)
            throw err
        }

        mut module_dict = {}
        for k in keys(frame.locals) {
            if not has(this.builtin_names, k) { module_dict[k] = frame.locals[k] }
        }
        this.modules[key] = module_dict
        return module_dict
    }

    fn _bind_import(spec, frame) {
        let path = spec["path"]
        let line = spec["line"]
        let module_dict = this._import_module(path, line)
        let names = spec["names"]
        if names != null and len(names) > 0 {
            for name in names {
                if not has(module_dict, name) {
                    throw "RuntimeError: '{name}' not found in '{path}' (line {line})"
                }
                frame.locals[name] = module_dict[name]
            }
        } else {
            let alias = spec["alias"] ?? replace(replace(path, ".clarity", ""), "/", "_")
            frame.locals[alias] = module_dict
        }
    }

    fn _setup_builtins() {
        let vm = this

        this.globals["len"] = fn(x) { return len(_vm_props(x)) }
        this.globals["push"] = fn(lst, item) { push(lst, item); return lst }
        this.globals["pop"] = fn(lst) { return pop(lst) }
        this.globals["str"] = fn(x) { return vm._display(x) }
        this.globals["int"] = fn(x) { return int(x) }
        this.globals["float"] = fn(x) { return float(x) }
        this.globals["type"] = fn(x) { return vm._type_name(x) }
        this.globals["range"] = fn(...a) {
            if len(a) == 1 { return range(a[0]) }
            if len(a) == 2 { return range(a[0], a[1]) }
            if len(a) == 3 { return range(a[0], a[1], a[2]) }
            throw "range() takes 1-3 arguments"
        }
        this.globals["map"] = fn(lst, f) {
            return map(lst, fn(x) { return vm._call_fn(f, [x]) })
        }
        this.globals["filter"] = fn(lst, f) {
            return filter(lst, fn(x) { return vm._is_truthy(vm._call_fn(f, [x])) })
        }
        this.globals["sort"] = fn(lst) { return sort(lst) }
        -- Reference identity; see the interpreter's registration beside
        -- display() for why the language needs one.
        this.globals["identical"] = fn(a, b) { return identical(a, b) }
        this.globals["reverse"] = fn(lst) { return reverse(lst) }
        this.globals["keys"] = fn(m) { return keys(_vm_props(m)) }
        this.globals["values"] = fn(m) { return values(_vm_props(m)) }
        this.globals["entries"] = fn(m) { return entries(_vm_props(m)) }
        this.globals["has"] = fn(col, key) { return has(_vm_props(col), key) }
        this.globals["sum"] = fn(lst) { return sum(lst) }
        this.globals["abs"] = fn(n) { return abs(n) }
        this.globals["min"] = fn(...a) {
            if len(a) == 1 and type(a[0]) == "list" { return min(a[0]) }
            return min(...a)
        }
        this.globals["max"] = fn(...a) {
            if len(a) == 1 and type(a[0]) == "list" { return max(a[0]) }
            return max(...a)
        }
        this.globals["join"] = fn(lst, sep) {
            let s = sep ?? ""
            return join(map(lst, fn(x) { return vm._display(x) }), s)
        }
        this.globals["split"] = fn(s, sep) { return split(s, sep ?? " ") }
        this.globals["trim"] = fn(s) { return trim(s) }
        this.globals["upper"] = fn(s) { return upper(s) }
        this.globals["lower"] = fn(s) { return lower(s) }
        this.globals["contains"] = fn(h, n) { return contains(h, n) }
        this.globals["starts"] = fn(s, p) { return starts(s, p) }
        this.globals["ends"] = fn(s, p) { return ends(s, p) }
        this.globals["replace"] = fn(s, old, new_s) { return replace(s, old, new_s) }
        this.globals["chars"] = fn(s) { return chars(s) }
        this.globals["char_at"] = fn(s, i) { return char_at(s, i) }
        this.globals["char_code"] = fn(c) { return char_code(c) }
        this.globals["from_char_code"] = fn(n) { return from_char_code(n) }
        this.globals["index_of"] = fn(s, sub) { return index_of(s, sub) }
        this.globals["substring"] = fn(s, start, end_idx) { return substring(s, start, end_idx) }
        this.globals["is_digit"] = fn(c) { return is_digit(c) }
        this.globals["is_alpha"] = fn(c) { return is_alpha(c) }
        this.globals["is_alnum"] = fn(c) { return is_alnum(c) }
        this.globals["is_space"] = fn(c) { return is_space(c) }
        this.globals["repeat"] = fn(s, n) { return repeat(s, n) }
        this.globals["each"] = fn(lst, f) {
            each(lst, fn(x) { vm._call_fn(f, [x]) })
        }
        this.globals["find"] = fn(lst, f) {
            return find(lst, fn(x) { return vm._is_truthy(vm._call_fn(f, [x])) })
        }
        this.globals["every"] = fn(lst, f) {
            return every(lst, fn(x) { return vm._is_truthy(vm._call_fn(f, [x])) })
        }
        this.globals["some"] = fn(lst, f) {
            return some(lst, fn(x) { return vm._is_truthy(vm._call_fn(f, [x])) })
        }
        this.globals["reduce"] = fn(lst, f, initial) {
            mut acc = if initial != null { initial } else { lst[0] }
            mut start = if initial != null { 0 } else { 1 }
            mut i = start
            while i < len(lst) {
                acc = vm._call_fn(f, [acc, lst[i]])
                i += 1
            }
            return acc
        }
        this.globals["flat"] = fn(lst) { return flat(lst) }
        this.globals["unique"] = fn(lst) { return unique(lst) }
        this.globals["merge"] = fn(...maps) { return merge(...maps) }
        this.globals["zip"] = fn(...lists) { return zip(...lists) }

        -- Math
        this.globals["pi"] = pi
        this.globals["e"] = e
        this.globals["sqrt"] = fn(n) { return sqrt(n) }
        this.globals["sin"] = fn(n) { return sin(n) }
        this.globals["cos"] = fn(n) { return cos(n) }
        this.globals["tan"] = fn(n) { return tan(n) }
        this.globals["log"] = fn(n) { return log(n) }
        this.globals["pow"] = fn(a, b) { return pow(a, b) }
        this.globals["floor"] = fn(n) { return floor(n) }
        this.globals["ceil"] = fn(n) { return ceil(n) }
        this.globals["round"] = fn(n) { return round(n) }
        this.globals["random"] = fn(...a) { return random(...a) }

        -- I/O
        this.globals["print"] = fn(...args) {
            let out = join(map(args, fn(a) { return vm._display(a) }), " ")
            show out
            push(vm.output, out)
        }
        this.globals["show"] = fn(...args) {
            let out = join(map(args, fn(a) { return vm._display(a) }), " ")
            show out
            push(vm.output, out)
        }
        this.globals["ask"] = fn(prompt) { return ask(vm._display(prompt ?? "")) }

        -- Type conversions
        this.globals["bool"] = fn(v) { return vm._is_truthy(v) }

        -- System
        this.globals["exec"] = fn(cmd) { return exec(cmd) }
        this.globals["exec_full"] = fn(cmd) { return exec_full(cmd) }
        this.globals["exec_tty"] = fn(cmd) { return exec_tty(cmd) }
        this.globals["exit"] = fn(code) { exit(code ?? 0) }
        this.globals["sleep"] = fn(s) { sleep(s) }
        this.globals["time"] = fn() { return time() }
        this.globals["env"] = fn(k, d) { return env(k, d) }
        this.globals["cwd"] = fn() { return cwd() }
        this.globals["args"] = fn() { return args() }

        -- File I/O
        this.globals["read"] = fn(p) { return read(p) }
        this.globals["write"] = fn(p, c) { return write(p, c) }
        this.globals["append"] = fn(p, c) { return append(p, c) }
        this.globals["exists"] = fn(p) { return exists(p) }
        this.globals["lines"] = fn(p) { return lines(p) }
        this.globals["read_bytes"] = fn(p) { return read_bytes(p) }
        this.globals["write_bytes"] = fn(p, b) { return write_bytes(p, b) }
        this.globals["read_mem"] = fn(pid, addr, ln) { return read_mem(pid, addr, ln) }
        this.globals["write_mem"] = fn(pid, addr, b) { return write_mem(pid, addr, b) }

        -- JSON
        this.globals["json_parse"] = fn(t) { return json_parse(t) }
        this.globals["json_string"] = fn(v) { return json_string(v) }

        -- The rest of what the interpreter offers. This table had 82 names
        -- against the interpreter's 158, and the difference was not a
        -- decision: `hash`, `pad_left`, `encode64` and the byte and memory
        -- readers had been builtins on one engine and undefined variables
        -- on the other since this VM was written, so a program using one
        -- ran under `clarity run` and died under `clarity run --fast`.
        this.globals["pad_left"] = fn(s, n, c) { return pad_left(s, n, c ?? " ") }
        this.globals["pad_right"] = fn(s, n, c) { return pad_right(s, n, c ?? " ") }
        this.globals["hash"] = fn(text, algo) { return hash(text, algo ?? "sha256") }
        this.globals["encode64"] = fn(t) { return encode64(t) }
        this.globals["decode64"] = fn(t) { return decode64(t) }
        -- Through the VM's own display, for the reason the interpreter's
        -- registration gives: the runtime's display does not know what a
        -- VMInstance is and walks it until the stack runs out.
        this.globals["display"] = fn(v) { return vm._display(v) }
        this.globals["repr"] = fn(v) { return vm._repr(v) }
        this.globals["set"] = fn(lst) { return set(lst) }
        this.globals["fetch"] = fn(url) { return fetch(url) }
        this.globals["serve"] = fn(port, handler) {
            return serve(port, fn(...call_args) { return vm._call_fn(handler, call_args) })
        }
        this.globals["compose"] = fn(...fns) {
            return fn(...call_args) {
                mut value = if len(call_args) > 0 { call_args[0] } else { null }
                mut i = len(fns) - 1
                while i >= 0 {
                    value = vm._call_fn(fns[i], [value])
                    i -= 1
                }
                return value
            }
        }
        this.globals["tap"] = fn(v, f) { vm._call_fn(f, [v]); return v }

        -- Regular expressions
        this.globals["regex_match"] = fn(pat, text) { return regex_match(pat, text) }
        this.globals["regex_search"] = fn(pat, text) { return regex_search(pat, text) }
        this.globals["regex_find"] = fn(pat, text) { return regex_find(pat, text) }
        this.globals["regex_replace"] = fn(pat, text, repl) { return regex_replace(pat, text, repl) }
        this.globals["regex_split"] = fn(pat, text) { return regex_split(pat, text) }
        this.globals["exec_full_regex"] = fn(pat, text) { return exec_full_regex(pat, text) }

        -- The low-level bridges: FFI, the pseudo-terminal, the host window
        -- and the embedded stdlib. Internal by their underscore, but the
        -- standard library's own FFI, hooking and graphics modules call
        -- them, so a program that imports one ran under `clarity run` and
        -- died under `clarity run --fast` on an undefined variable.
        this.globals["_embedded_source"] = fn(name) { return _embedded_source(name) }
        this.globals["_host_exe"] = fn() { return _host_exe() }
        this.globals["_ffi_open"] = fn(lib, spec) { return _ffi_open(lib, spec) }
        this.globals["_ffi_bind"] = fn(lib, sym, args, ret) { return _ffi_bind(lib, sym, args, ret) }
        this.globals["_ffi_close"] = fn(h) { return _ffi_close(h) }
        this.globals["_ffi_alloc"] = fn(n) { return _ffi_alloc(n) }
        this.globals["_ffi_alloc_cstring"] = fn(s) { return _ffi_alloc_cstring(s) }
        this.globals["_ffi_read_cstring"] = fn(p) { return _ffi_read_cstring(p) }
        this.globals["_ffi_ptr_addr"] = fn(p) { return _ffi_ptr_addr(p) }
        this.globals["_ffi_pointer_release"] = fn(p) { return _ffi_pointer_release(p) }
        this.globals["_ffi_read_u8"] = fn(p, o) { return _ffi_read_u8(p, o ?? 0) }
        this.globals["_ffi_read_i8"] = fn(p, o) { return _ffi_read_i8(p, o ?? 0) }
        this.globals["_ffi_read_u16"] = fn(p, o) { return _ffi_read_u16(p, o ?? 0) }
        this.globals["_ffi_read_i16"] = fn(p, o) { return _ffi_read_i16(p, o ?? 0) }
        this.globals["_ffi_read_u32"] = fn(p, o) { return _ffi_read_u32(p, o ?? 0) }
        this.globals["_ffi_read_i32"] = fn(p, o) { return _ffi_read_i32(p, o ?? 0) }
        this.globals["_ffi_read_u64"] = fn(p, o) { return _ffi_read_u64(p, o ?? 0) }
        this.globals["_ffi_read_i64"] = fn(p, o) { return _ffi_read_i64(p, o ?? 0) }
        this.globals["_ffi_read_f32"] = fn(p, o) { return _ffi_read_f32(p, o ?? 0) }
        this.globals["_ffi_read_f64"] = fn(p, o) { return _ffi_read_f64(p, o ?? 0) }
        this.globals["_ffi_read_ptr"] = fn(p, o) { return _ffi_read_ptr(p, o ?? 0) }
        this.globals["_ffi_write_u8"] = fn(p, o, v) { _ffi_write_u8(p, o, v) }
        this.globals["_ffi_write_i8"] = fn(p, o, v) { _ffi_write_i8(p, o, v) }
        this.globals["_ffi_write_u16"] = fn(p, o, v) { _ffi_write_u16(p, o, v) }
        this.globals["_ffi_write_i16"] = fn(p, o, v) { _ffi_write_i16(p, o, v) }
        this.globals["_ffi_write_u32"] = fn(p, o, v) { _ffi_write_u32(p, o, v) }
        this.globals["_ffi_write_i32"] = fn(p, o, v) { _ffi_write_i32(p, o, v) }
        this.globals["_ffi_write_u64"] = fn(p, o, v) { _ffi_write_u64(p, o, v) }
        this.globals["_ffi_write_i64"] = fn(p, o, v) { _ffi_write_i64(p, o, v) }
        this.globals["_ffi_write_f32"] = fn(p, o, v) { _ffi_write_f32(p, o, v) }
        this.globals["_ffi_write_f64"] = fn(p, o, v) { _ffi_write_f64(p, o, v) }
        this.globals["_ffi_callback_close"] = fn(h) { return _ffi_callback_close(h) }
        this.globals["_ffi_fill_u32"] = fn(p, o, c, v) { _ffi_fill_u32(p, o, c, v) }
        this.globals["_ffi_blend_u32"] = fn(p, o, c, col) { _ffi_blend_u32(p, o, c, col) }
        this.globals["_ffi_box_blur"] = fn(p, w, h, r, ps) { _ffi_box_blur(p, w, h, r, ps) }
        this.globals["_ffi_blit_scaled_alpha"] = fn(dp, dw, dh, sp, sw, sh, dx, dy, dw2, dh2, a) { _ffi_blit_scaled_alpha(dp, dw, dh, sp, sw, sh, dx, dy, dw2, dh2, a) }
        this.globals["_pty_supported"] = fn() { return _pty_supported() }
        this.globals["_pty_spawn"] = fn(path, argv, cols, rows) { return _pty_spawn(path, argv, cols, rows) }
        this.globals["_pty_read"] = fn(m, n) { return _pty_read(m, n) }
        this.globals["_pty_write"] = fn(m, t) { return _pty_write(m, t) }
        this.globals["_pty_resize"] = fn(m, c, r) { return _pty_resize(m, c, r) }
        this.globals["_pty_poll"] = fn(m) { return _pty_poll(m) }
        this.globals["_pty_close"] = fn(m) { return _pty_close(m) }
        this.globals["_host_supported"] = fn() { return _host_supported() }
        this.globals["_host_open"] = fn(t, w, h) { return _host_open(t, w, h) }
        this.globals["_host_present"] = fn(p, w, h) { return _host_present(p, w, h) }
        this.globals["_host_poll"] = fn() { return _host_poll() }
        this.globals["_host_ticks"] = fn() { return _host_ticks() }
        this.globals["_host_delay"] = fn(ms) { _host_delay(ms) }
        this.globals["_host_close"] = fn() { return _host_close() }
        this.globals["_ffi_copy"] = fn(dst, do_, src, so, n) { _ffi_copy(dst, do_, src, so, n) }
        this.globals["_ffi_write_buffer"] = fn(p, path) { _ffi_write_buffer(p, path) }
        this.globals["_ffi_read_buffer"] = fn(path) { return _ffi_read_buffer(path) }
        -- Same reason the interpreter wraps it: Bun's JSCallback needs a
        -- real JS callable, and what a program passes here is a VM
        -- function object.
        this.globals["_ffi_callback"] = fn(f, a, r) {
            return _ffi_callback(fn(...cb_args) { return vm._call_fn(f, cb_args) }, a, r)
        }

        -- Errors
        this.globals["error"] = fn(msg) { return str(msg) }
    }

    -- Bind arguments to parameter names. A rest parameter arrives from the
    -- parser as "...name" and takes every remaining argument as a list;
    -- binding it by its literal name, as this did, left `name` undefined
    -- inside every function that declared one, which is how the standard
    -- library's Set() failed under --fast on its first line.
    fn _bind_params(frame, param_list, call_args) {
        let params = if type(param_list) == "list" { param_list } else { [] }
        mut i = 0
        while i < len(params) {
            let p = params[i]
            if starts(p, "...") {
                mut rest = []
                mut j = i
                while j < len(call_args) { push(rest, call_args[j]); j += 1 }
                frame.locals[substring(p, 3)] = rest
                return null
            }
            frame.locals[p] = if i < len(call_args) { call_args[i] } else { null }
            i += 1
        }
        return null
    }

    -- The scope in `frame` that holds `name` -- innermost first, then out
    -- through the blocks the frame is inside. null when the frame has no such
    -- name anywhere.
    fn _frame_scope(frame, name) {
        if has(frame.locals, name) { return frame.locals }
        mut pi = len(frame.parents) - 1
        while pi >= 0 {
            if has(frame.parents[pi], name) { return frame.parents[pi] }
            pi -= 1
        }
        return null
    }

    -- The same, over a captured chain (already innermost first).
    fn _chain_scope(chain, name) {
        if chain == null { return null }
        mut ci = 0
        while ci < len(chain) {
            if has(chain[ci], name) { return chain[ci] }
            ci += 1
        }
        return null
    }

    -- What a closure made here should capture: this frame's scopes, innermost
    -- first. A copy of the *list*, sharing the maps -- so a block entered
    -- later does not reach back into a closure already made, but a write to a
    -- variable the closure captured is still seen by it.
    fn _capture_chain(frame) {
        mut chain = [frame.locals]
        mut pi = len(frame.parents) - 1
        while pi >= 0 {
            push(chain, frame.parents[pi])
            pi -= 1
        }
        return chain
    }

    fn _call_fn(f, call_args) {
        let t = type(f)
        if t == "VMFunction" {
            return this._call_vm_fn(f, call_args)
        }
        if t == "VMBoundMethod" {
            return this._call_method(f.instance, f.method, call_args)
        }
        if t == "VMClass" {
            return this._instantiate_class(f, call_args)
        }
        if t == "function" or t == "builtin" {
            return f(...call_args)
        }
        -- The interpreter names the *type*, not the value:
        -- "TypeError: 'int' is not callable". This said
        -- "RuntimeError: Not callable: 5", so a program that caught it and
        -- showed it read differently under --fast. `clarity cc` already
        -- agreed with the interpreter here; this engine was the odd one.
        throw "TypeError: '{type(f)}' is not callable"
    }

    fn _instantiate_class(klass, call_args) {
        let instance = VMInstance(klass)
        let init_method = klass.find_method("init")
        if init_method != null {
            this._call_method(instance, init_method, call_args)
        }
        return instance
    }

    -- Reading `obj.prop`, shared by OP_GET_PROP and its optional form.
    fn _get_prop(obj, prop) {
        let t = type(obj)
        if t == "VMEnum" {
            -- The interpreter's set, in its order: a member first, then the
            -- four an enum answers whatever its members are, then its error.
            if has(obj.members, prop) { return obj.members[prop] }
            if prop == "values" { return fn() { return values(obj.members) } }
            if prop == "names" { return fn() { return keys(obj.members) } }
            if prop == "entries" { return fn() { return entries(obj.members) } }
            if prop == "has" { return fn(name) { return has(obj.members, name) } }
            throw "RuntimeError: Enum {obj.name} has no member '{prop}'"
        }
        if t == "VMInstance" {
            -- A property explicitly set to null is still present and must
            -- read back as null; a name that is neither a property nor a
            -- method is an error, as in the interpreter, which names the
            -- class and the property.
            if has(obj.properties, prop) { return obj.properties[prop] }
            let val = obj.get_prop(prop)
            if val == null { throw "RuntimeError: {obj.klass.name} has no property '{prop}'" }
            return val
        }
        if t == "map" {
            if has(obj, prop) { return obj[prop] }
            return null
        }
        -- A list's and a string's builtin methods, exactly the interpreter's
        -- set and exactly its shape: each is a *method*, so `xs.length` is a
        -- callable and `xs.length()` calls it. The VM had five of the
        -- thirty as plain properties and threw for the rest, so `xs.sort()`,
        -- `s.split(" ")` and `s.trim()` — ordinary lines — all failed under
        -- --fast while working under `clarity run`.
        if t == "list" {
            if prop == "length" { return fn() { return len(obj) } }
            if prop == "push" { return fn(v) { push(obj, v) } }
            if prop == "pop" { return fn() { return pop(obj) } }
            if prop == "first" { return fn() { return if len(obj) > 0 { obj[0] } else { null } } }
            if prop == "last" { return fn() { return if len(obj) > 0 { obj[len(obj) - 1] } else { null } } }
            if prop == "reverse" { return fn() { return reverse(obj) } }
            if prop == "sort" { return fn() { return sort(obj) } }
            if prop == "join" { return fn(sep) { return join(obj, sep ?? "") } }
            if prop == "contains" { return fn(v) { return contains(obj, v) } }
            if prop == "empty" { return fn() { return len(obj) == 0 } }
            if prop == "count" { return fn() { return len(obj) } }
            if prop == "slice" { return fn(start, end_i) { return _vm_slice(obj, start, end_i) } }
            if prop == "index" { return fn(v) { return index_of(obj, v) } }
            if prop == "copy" { return fn() { return _vm_slice(obj, 0, null) } }
            throw "RuntimeError: List has no property '{prop}'"
        }
        if t == "string" {
            if prop == "length" { return fn() { return len(obj) } }
            if prop == "upper" { return fn() { return upper(obj) } }
            if prop == "lower" { return fn() { return lower(obj) } }
            if prop == "trim" { return fn() { return trim(obj) } }
            if prop == "split" { return fn(sep) { return split(obj, sep ?? " ") } }
            if prop == "replace" { return fn(old_s, new_s) { return replace(obj, old_s, new_s) } }
            if prop == "contains" { return fn(sub) { return contains(obj, sub) } }
            if prop == "starts" { return fn(sub) { return starts(obj, sub) } }
            if prop == "ends" { return fn(sub) { return ends(obj, sub) } }
            if prop == "chars" { return fn() { return chars(obj) } }
            if prop == "count" { return fn() { return len(obj) } }
            if prop == "reverse" { return fn() { return reverse(obj) } }
            if prop == "empty" { return fn() { return len(obj) == 0 } }
            if prop == "slice" {
                return fn(start, end_i) {
                    if end_i != null { return substring(obj, start, end_i) }
                    return substring(obj, start, len(obj))
                }
            }
            if prop == "find" { return fn(sub) { return index_of(obj, sub) } }
            if prop == "repeat" { return fn(n) { return repeat(obj, n) } }
            throw "RuntimeError: String has no property '{prop}'"
        }
        if t == "int" or t == "float" {
            if prop == "abs" { return fn() { return abs(obj) } }
            if prop == "str" { return fn() { return str(obj) } }
            throw "RuntimeError: Number has no property '{prop}'"
        }
        if t == "VMClass" {
            -- Static access / enum-like access
            if has(obj.methods, prop) { return obj.methods[prop] }
            -- A name the class does not answer to used to be null here, so a
            -- typo went on quietly and failed later somewhere else. The
            -- interpreter names it and stops, which is the specification --
            -- and the same shape as reading a property an *instance* does not
            -- have, which this engine already refuses.
            throw "TypeError: Cannot access property on class"
        }
        throw "RuntimeError: Cannot access property '{prop}' on {t}"
    }

    fn _call_method(instance, method, call_args) {
        let frame = VMFrame(method.code, len(this.stack))
        frame.locals["this"] = instance
        this._bind_params(frame, method.params, call_args)
        let try_depth = len(this.try_stack)
        push(this.frames, frame)
        try {
            let result = this._execute_frame()
            pop(this.frames)
            this._drop_handlers(try_depth)
            return result
        } catch err {
            pop(this.frames)
            this._drop_handlers(try_depth)
            throw err
        }
    }

    -- An error the engine raises carries the line it happened on under
    -- `clarity run` -- "RuntimeError: Division by zero (line 46)". This engine
    -- threw the same words without it, so a program that caught one and showed
    -- it read differently under --fast. The line is known here and nowhere
    -- deeper, so it is added on the way out of the instruction that raised it.
    --
    -- Only to a string opening with one of the engine's own prefixes: a
    -- program's `throw "boom"` is its own business and carries no line in
    -- either engine. Only when it does not already say a line, so an error
    -- passing out through several frames is not annotated once per frame --
    -- the frame it was raised in gets there first, and that is the right one.
    fn _with_line(err, code, at) {
        if type(err) != "string" { return err }
        if contains(err, "(line ") { return err }
        let engine = starts(err, "RuntimeError: ") or starts(err, "TypeError: ") or
            starts(err, "NameError: ") or starts(err, "ValueError: ")
        if not engine { return err }
        let eline = if at >= 0 and at < len(code.lines) { code.lines[at] } else { 0 }
        if eline == 0 { return err }
        return err + " (line {eline})"
    }

    fn _call_vm_fn(f, call_args) {
        let frame = VMFrame(f.code, len(this.stack))
        frame.closure = f.closure
        this._bind_params(frame, f.params, call_args)
        let try_depth = len(this.try_stack)
        push(this.frames, frame)
        try {
            let result = this._execute_frame()
            pop(this.frames)
            this._drop_handlers(try_depth)
            return result
        } catch err {
            pop(this.frames)
            this._drop_handlers(try_depth)
            throw err
        }
    }

    fn run(code) {
        let frame = VMFrame(code)
        let gkeys = keys(this.globals)
        mut i = 0
        while i < len(gkeys) {
            let k = gkeys[i]
            frame.locals[k] = this.globals[k]
            i += 1
        }
        let try_depth = len(this.try_stack)
        push(this.frames, frame)
        try {
            let result = this._execute_frame()
            pop(this.frames)
            this._drop_handlers(try_depth)
            return result
        } catch err {
            pop(this.frames)
            this._drop_handlers(try_depth)
            throw err
        }
    }

    -- A handler cannot outlive the call that registered it. Handlers are
    -- matched by frame index, so one left behind by a returning frame was
    -- picked up by the next call at the same depth, which then jumped to a
    -- catch block belonging to a different function.
    fn _drop_handlers(depth) {
        while len(this.try_stack) > depth {
            pop(this.try_stack)
        }
    }

    fn _execute_frame() {
        let frame = this.frames[len(this.frames) - 1]
        let code = frame.code

        while frame.ip < len(code.instructions) {
            let instr = code.instructions[frame.ip]
            let op = instr[0]
            let operand = instr[1]
            frame.ip = frame.ip + 1

            -- The whole dispatch runs inside a handler so that engine-raised
            -- errors (division by zero, undefined variable, bad index, …) are
            -- routed to an active try/catch instead of blowing past it. See
            -- the catch at the bottom of the loop.
            try {
            if op == OP_HALT {
                if len(frame.yields) > 0 { return frame.yields }
                if len(this.stack) > 0 { return this.stack[len(this.stack) - 1] }
                return null
            }

            elif op == OP_CONST { push(this.stack, code.constants[operand]) }
            elif op == OP_NULL { push(this.stack, null) }
            elif op == OP_TRUE { push(this.stack, true) }
            elif op == OP_FALSE { push(this.stack, false) }

            elif op == OP_POP {
                if len(this.stack) > 0 { pop(this.stack) }
            }
            elif op == OP_DUP {
                push(this.stack, this.stack[len(this.stack) - 1])
            }
            elif op == OP_SWAP {
                let a = pop(this.stack)
                let b = pop(this.stack)
                push(this.stack, a)
                push(this.stack, b)
            }
            elif op == OP_ROT3 {
                let c = pop(this.stack)
                let b = pop(this.stack)
                let a = pop(this.stack)
                push(this.stack, c)
                push(this.stack, a)
                push(this.stack, b)
            }

            -- Variables
            elif op == OP_LOAD {
                let name = code.constants[operand]
                let load_scope = this._frame_scope(frame, name)
                let load_captured = if load_scope == null { this._chain_scope(frame.closure, name) } else { null }
                if load_scope != null {
                    push(this.stack, load_scope[name])
                } elif load_captured != null {
                    push(this.stack, load_captured[name])
                } elif has(this.globals, name) {
                    push(this.stack, this.globals[name])
                } else {
                    -- Walk up frames for dynamic-scope fallback (e.g.
                    -- methods that need access to defining scope when no
                    -- explicit closure was captured).
                    mut found = false
                    mut fi = len(this.frames) - 2
                    while fi >= 0 {
                        let parent_scope = this._frame_scope(this.frames[fi], name)
                        if parent_scope != null {
                            push(this.stack, parent_scope[name])
                            found = true
                            break
                        }
                        fi -= 1
                    }
                    if not found {
                        -- The same words and the same line `clarity run`
                        -- gives, so a program that catches this and shows it
                        -- reads the same under either engine.
                        let nline = if frame.ip - 1 < len(code.lines) { code.lines[frame.ip - 1] } else { 0 }
                        throw "NameError: '{name}' is not defined (line {nline})"
                    }
                }
            }
            elif op == OP_STORE {
                let name = code.constants[operand]
                let value = pop(this.stack)
                -- Assign where the name lives: the innermost block of this
                -- frame that has it, then what this call captured, then an
                -- enclosing frame. Only a name nothing has becomes new here.
                let store_scope = this._frame_scope(frame, name)
                if store_scope != null {
                    store_scope[name] = value
                } else {
                    let captured = this._chain_scope(frame.closure, name)
                    if captured != null {
                        captured[name] = value
                    } else {
                        mut found = false
                        mut fi = len(this.frames) - 2
                        while fi >= 0 {
                            let parent_scope = this._frame_scope(this.frames[fi], name)
                            if parent_scope != null {
                                parent_scope[name] = value
                                found = true
                                break
                            }
                            fi -= 1
                        }
                        if not found {
                            frame.locals[name] = value
                        }
                    }
                }
            }
            elif op == OP_STORE_NEW {
                let name = code.constants[operand]
                let value = pop(this.stack)
                frame.locals[name] = value
            }
            elif op == OP_IMPORT {
                this._bind_import(code.constants[operand], frame)
            }

            -- Arithmetic
            elif op == OP_ADD {
                let b = pop(this.stack)
                let a = pop(this.stack)
                if type(a) == "string" or type(b) == "string" {
                    push(this.stack, this._display(a) + this._display(b))
                } elif type(a) == "list" and type(b) == "list" {
                    push(this.stack, a + b)
                } else {
                    push(this.stack, a + b)
                }
            }
            elif op == OP_SUB {
                let b = pop(this.stack)
                let a = pop(this.stack)
                push(this.stack, a - b)
            }
            elif op == OP_MUL {
                let b = pop(this.stack)
                let a = pop(this.stack)
                push(this.stack, a * b)
            }
            elif op == OP_DIV {
                let b = pop(this.stack)
                let a = pop(this.stack)
                if b == 0 { throw "RuntimeError: Division by zero" }
                let result = a / b
                if result == floor(result) {
                    push(this.stack, int(result))
                } else {
                    push(this.stack, result)
                }
            }
            elif op == OP_MOD {
                let b = pop(this.stack)
                let a = pop(this.stack)
                push(this.stack, a % b)
            }
            elif op == OP_POW {
                let b = pop(this.stack)
                let a = pop(this.stack)
                push(this.stack, pow(a, b))
            }
            elif op == OP_NEG { push(this.stack, -pop(this.stack)) }
            elif op == OP_NOT { push(this.stack, not this._is_truthy(pop(this.stack))) }

            -- Comparison
            elif op == OP_EQ { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, a == b) }
            elif op == OP_NEQ { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, a != b) }
            elif op == OP_LT { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, a < b) }
            elif op == OP_GT { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, a > b) }
            elif op == OP_LTE { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, a <= b) }
            elif op == OP_GTE { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, a >= b) }

            -- Logical
            elif op == OP_AND {
                let b = pop(this.stack)
                let a = pop(this.stack)
                if this._is_truthy(a) { push(this.stack, b) }
                else { push(this.stack, a) }
            }
            elif op == OP_OR {
                let b = pop(this.stack)
                let a = pop(this.stack)
                if this._is_truthy(a) { push(this.stack, a) }
                else { push(this.stack, b) }
            }

            -- Bitwise
            elif op == OP_BIT_AND { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, int(a) & int(b)) }
            elif op == OP_BIT_OR { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, int(a) | int(b)) }
            elif op == OP_BIT_XOR { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, int(a) ^ int(b)) }
            elif op == OP_BIT_NOT { push(this.stack, ~int(pop(this.stack))) }
            elif op == OP_LSHIFT { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, int(a) << int(b)) }
            elif op == OP_RSHIFT { let b = pop(this.stack); let a = pop(this.stack); push(this.stack, int(a) >> int(b)) }

            -- Control flow
            elif op == OP_JUMP { frame.ip = operand }
            elif op == OP_JUMP_FALSE {
                if not this._is_truthy(pop(this.stack)) { frame.ip = operand }
            }
            elif op == OP_JUMP_TRUE {
                if this._is_truthy(pop(this.stack)) { frame.ip = operand }
            }

            -- Functions
            elif op == OP_MAKE_FN {
                let fn_code = code.constants[operand]
                mut params = []
                if operand + 1 < len(code.constants) {
                    let maybe_params = code.constants[operand + 1]
                    if type(maybe_params) == "list" {
                        mut is_param_list = true
                        mut pi = 0
                        while pi < len(maybe_params) {
                            if type(maybe_params[pi]) != "string" {
                                is_param_list = false
                                break
                            }
                            pi += 1
                        }
                        if is_param_list { params = maybe_params }
                    }
                }
                let vm_fn = VMFunction(fn_code, params, fn_code.name)
                -- Capture the enclosing frame's scopes as the closure env:
                -- the innermost block first, then out. Snapshot the list by
                -- value and the maps by reference, so a closure that mutates
                -- its captured variable still sees later writes, while a
                -- block entered afterwards is none of its business.
                vm_fn.closure = this._capture_chain(frame)
                push(this.stack, vm_fn)
            }
            elif op == OP_SPREAD {
                push(this.stack, VMSpread(pop(this.stack)))
            }
            elif op == OP_PUSH_SCOPE {
                push(frame.parents, frame.locals)
                frame.locals = {}
            }
            elif op == OP_POP_SCOPE {
                if len(frame.parents) > 0 { frame.locals = pop(frame.parents) }
            }
            elif op == OP_MAKE_ENUM {
                push(this.stack, VMEnum(code.constants[operand], pop(this.stack)))
            }
            elif op == OP_COMP_BIND {
                -- One target of `{k: v for a, b in xs}`. A list item is taken
                -- apart element by element, with null past its end; anything
                -- else goes whole to the first target and leaves the rest
                -- unbound, exactly as eval_MapComprehensionExpression does.
                -- Unbound means *removed*: a target left over from an earlier
                -- item must not stand in for one this item does not have.
                let spec = code.constants[operand]
                let item = pop(this.stack)
                let bi = spec["index"]
                let bname = spec["name"]
                if type(item) == "list" {
                    frame.locals[bname] = if bi < len(item) { item[bi] } else { null }
                } elif bi == 0 {
                    frame.locals[bname] = item
                } else {
                    mut kept = {}
                    for lk in keys(frame.locals) {
                        if lk != bname { kept[lk] = frame.locals[lk] }
                    }
                    frame.locals = kept
                }
            }
            elif op == OP_CALL {
                let nargs = operand
                mut raw_args = []
                mut ai = 0
                while ai < nargs {
                    push(raw_args, pop(this.stack))
                    ai += 1
                }
                raw_args = reverse(raw_args)
                -- A spread list becomes that many arguments. Anything else
                -- spread is passed as one, which is what the interpreter
                -- does — `f(...5)` is `f(5)` there rather than an error.
                mut call_args = []
                for a in raw_args {
                    if type(a) == "VMSpread" {
                        if type(a.value) == "list" { for item in a.value { push(call_args, item) } }
                        else { push(call_args, a.value) }
                    } else { push(call_args, a) }
                }
                let callee = pop(this.stack)
                let result = this._call_fn(callee, call_args)
                push(this.stack, result)
            }
            elif op == OP_YIELD {
                -- The value stays on the stack: `yield v` is an expression
                -- worth v, and an expression statement pops it.
                if len(this.stack) > 0 {
                    push(frame.yields, this.stack[len(this.stack) - 1])
                } else {
                    push(frame.yields, null)
                }
            }
            elif op == OP_RETURN {
                -- A body that yielded returns what it yielded, whatever the
                -- return statement said — the interpreter's rule, and what
                -- makes `for x in gen()` iterate the values.
                if len(frame.yields) > 0 {
                    if len(this.stack) > 0 { pop(this.stack) }
                    return frame.yields
                }
                if len(this.stack) > 0 { return pop(this.stack) }
                return null
            }

            -- Collections
            elif op == OP_MAKE_LIST {
                mut raw = []
                mut li = 0
                while li < operand {
                    push(raw, pop(this.stack))
                    li += 1
                }
                raw = reverse(raw)
                mut items = []
                for it in raw {
                    if type(it) == "VMSpread" {
                        if type(it.value) != "list" {
                            throw "TypeError: Can only spread a list into a list"
                        }
                        for item in it.value { push(items, item) }
                    } else { push(items, it) }
                }
                push(this.stack, items)
            }
            elif op == OP_MAKE_MAP {
                mut pairs = []
                mut mi = 0
                while mi < operand {
                    let v = pop(this.stack)
                    let k = pop(this.stack)
                    push(pairs, [k, v])
                    mi += 1
                }
                pairs = reverse(pairs)
                let result_map = {}
                mut mj = 0
                while mj < len(pairs) {
                    let pair = pairs[mj]
                    -- `{...m, "b": 2}` compiles to a pair whose key is the
                    -- marked map and whose value is a placeholder: merge it,
                    -- in order, so a later key wins over a spread one.
                    if type(pair[0]) == "VMSpread" {
                        let spread_val = pair[0].value
                        if type(spread_val) != "map" {
                            throw "TypeError: Can only spread a map into a map"
                        }
                        for k in keys(spread_val) { result_map[k] = spread_val[k] }
                    } else {
                        result_map[pair[0]] = pair[1]
                    }
                    mj += 1
                }
                push(this.stack, result_map)
            }
            elif op == OP_GET_IDX {
                let idx = pop(this.stack)
                let obj = pop(this.stack)
                let t = type(obj)
                -- Reading past either end of a list or a string is an error,
                -- as in the interpreter. The VM answered null, so a program
                -- that walked off the end kept going under --fast and stopped
                -- under `clarity run`. The comparison is the interpreter's,
                -- character for character, so a key that is not a number
                -- still reads as a miss rather than a bounds failure.
                if t == "list" {
                    if idx < -len(obj) or idx >= len(obj) {
                        throw "RuntimeError: Index {idx} out of bounds (list has {len(obj)} items)"
                    }
                    push(this.stack, obj[idx])
                }
                elif t == "map" {
                    if has(obj, idx) { push(this.stack, obj[idx]) }
                    else { push(this.stack, null) }
                }
                elif t == "string" {
                    if idx < -len(obj) or idx >= len(obj) {
                        throw "RuntimeError: Index {idx} out of bounds"
                    }
                    push(this.stack, obj[idx])
                }
                -- An instance reads like the map of its fields, which is what
                -- makes `for k in keys(p) { p[k] }` work; the VM refused it.
                elif t == "VMInstance" {
                    if has(obj.properties, idx) { push(this.stack, obj.properties[idx]) }
                    else { push(this.stack, null) }
                }
                -- The interpreter's words and its kind of error, and the
                -- language's name for the type rather than the VM's internal
                -- one: "TypeError: Cannot index into enum", not
                -- "RuntimeError: Cannot index into VMEnum".
                else { throw "TypeError: Cannot index into {this._type_name(obj)}" }
            }
            elif op == OP_SET_IDX {
                let value = pop(this.stack)
                let idx = pop(this.stack)
                let obj = pop(this.stack)
                obj[idx] = value
            }
            elif op == OP_GET_PROP {
                let prop = code.constants[operand]
                push(this.stack, this._get_prop(pop(this.stack), prop))
            }
            -- `a?.b` is the interpreter's: null when the object is null, and
            -- null when reading the property would have failed for any other
            -- reason too. The VM only guarded the null, so `c?.missing` and
            -- `5?.f` threw under --fast and answered null under `clarity run`.
            elif op == OP_GET_PROP_OPT {
                let prop = code.constants[operand]
                let obj = pop(this.stack)
                if obj == null { push(this.stack, null) }
                else {
                    mut v = null
                    try { v = this._get_prop(obj, prop) } catch e_opt { v = null }
                    push(this.stack, v)
                }
            }
            elif op == OP_SET_PROP {
                let prop = code.constants[operand]
                let value = pop(this.stack)
                let obj = pop(this.stack)
                let t = type(obj)
                if t == "VMInstance" {
                    obj.properties[prop] = value
                } elif t == "map" {
                    obj[prop] = value
                } else {
                    throw "RuntimeError: Cannot set property '{prop}' on {t}"
                }
            }

            -- Range
            elif op == OP_RANGE {
                let end_val = pop(this.stack)
                let start_val = pop(this.stack)
                if end_val == null { push(this.stack, range(start_val, start_val)) }
                else { push(this.stack, range(start_val, end_val)) }
            }

            -- Slice
            elif op == OP_SLICE {
                let end_val = pop(this.stack)
                let start_val = pop(this.stack)
                let obj = pop(this.stack)
                -- Interpreter._slice_range walks whatever it is given with
                -- plain indexing, so a string gives its characters one at a
                -- time and a map gives what its integer keys give. This used
                -- to answer a substring for a string and refuse a map
                -- outright, so `s[1..3]` was "el" here and ["e", "l"] under
                -- `clarity run`. (Whether a string slice *should* be a
                -- substring is a language question, recorded in GAPS.md; the
                -- three engines agreeing is not.)
                push(this.stack, _vm_slice(obj, start_val, end_val))
            }

            -- Print (show)
            elif op == OP_PRINT {
                mut print_vals = []
                mut pi = 0
                while pi < operand {
                    push(print_vals, pop(this.stack))
                    pi += 1
                }
                print_vals = reverse(print_vals)
                let out = join(map(print_vals, fn(v) { return this._display(v) }), " ")
                show out
                push(this.output, out)
            }

            -- Iteration
            elif op == OP_ITER_INIT {
                let iterable = pop(this.stack)
                -- Iterating a map yields its keys (like Python). Without this
                -- the iterator integer-indexes the dict and yields nulls.
                let items = if type(iterable) == "map" { keys(iterable) } else { iterable }
                let iter = VMIterator(items)
                push(this.stack, iter)
            }
            elif op == OP_ITER_NEXT {
                let iterator = this.stack[len(this.stack) - 1]
                if iterator.has_next() {
                    let value = iterator.next()
                    push(this.stack, value)
                    push(this.stack, true)
                } else {
                    push(this.stack, false)
                }
            }

            -- String concatenation
            elif op == OP_CONCAT {
                let b = pop(this.stack)
                let a = pop(this.stack)
                push(this.stack, this._display(a) + this._display(b))
            }

            -- Pipe
            elif op == OP_PIPE {
                let nargs = operand
                mut pipe_args = []
                mut pai = 0
                while pai < nargs {
                    push(pipe_args, pop(this.stack))
                    pai += 1
                }
                pipe_args = reverse(pipe_args)
                let callee = pop(this.stack)
                let piped_value = if len(pipe_args) > 0 { pipe_args[0] } else { null }
                mut full_args = [piped_value]
                mut fai = 1
                while fai < len(pipe_args) {
                    push(full_args, pipe_args[fai])
                    fai += 1
                }
                let result = this._call_fn(callee, full_args)
                push(this.stack, result)
            }

            -- Throw: hand off to the nearest active try handler if there is
            -- one on this frame; otherwise propagate up.
            elif op == OP_THROW {
                let err_val = pop(this.stack)
                if len(this.try_stack) > 0 {
                    let handler = this.try_stack[len(this.try_stack) - 1]
                    if handler["frame_idx"] == len(this.frames) - 1 {
                        pop(this.try_stack)
                        while len(this.stack) > handler["stack_depth"] {
                            pop(this.stack)
                        }
                        while len(frame.parents) > handler["scope_depth"] {
                            frame.locals = pop(frame.parents)
                        }
                        push(this.stack, err_val)
                        frame.ip = handler["catch_ip"]
                        continue
                    }
                }
                throw err_val
            }

            -- Class creation
            elif op == OP_MAKE_CLASS {
                let num_methods = operand
                mut method_pairs = []
                mut ci = 0
                while ci < num_methods {
                    let method_fn = pop(this.stack)
                    let method_name = pop(this.stack)
                    push(method_pairs, [method_name, method_fn])
                    ci += 1
                }
                method_pairs = reverse(method_pairs)
                let parent = pop(this.stack)
                let class_name = pop(this.stack)
                let methods = {}
                mut mi = 0
                while mi < len(method_pairs) {
                    let pair = method_pairs[mi]
                    methods[pair[0]] = pair[1]
                    mi += 1
                }
                let parent_class = if type(parent) == "VMClass" { parent } else { null }
                let klass = VMClass(class_name, methods, parent_class)
                push(this.stack, klass)
            }

            -- Try/catch
            elif op == OP_SETUP_TRY {
                push(this.try_stack, {
                    "catch_ip": operand,
                    "stack_depth": len(this.stack),
                    -- How many blocks deep the try is. An error thrown from
                    -- inside a block in the try body jumps straight to the
                    -- catch, past that block's POP_SCOPE, so the catch has to
                    -- close it on arrival -- or it would run with the try
                    -- body's innermost scope still in place.
                    "scope_depth": len(frame.parents),
                    "frame_idx": len(this.frames) - 1
                })
            }
            elif op == OP_POP_TRY {
                if len(this.try_stack) > 0 {
                    pop(this.try_stack)
                }
            }

            else {
                throw "RuntimeError: Unknown opcode: {op}"
            }
            } catch raw_err {
                let err = this._with_line(raw_err, code, frame.ip - 1)
                -- An engine-raised error reached us. Hand it to the nearest
                -- active try handler on THIS frame — the same routing OP_THROW
                -- does for an explicit `throw` — otherwise let it propagate.
                -- Control-flow signals (return/break/continue) are re-raised by
                -- the host before reaching here, so `err` is always a real
                -- error, never a jump.
                if len(this.try_stack) > 0 {
                    let handler = this.try_stack[len(this.try_stack) - 1]
                    if handler["frame_idx"] == len(this.frames) - 1 {
                        pop(this.try_stack)
                        while len(this.stack) > handler["stack_depth"] {
                            pop(this.stack)
                        }
                        while len(frame.parents) > handler["scope_depth"] {
                            frame.locals = pop(frame.parents)
                        }
                        push(this.stack, err)
                        frame.ip = handler["catch_ip"]
                        continue
                    }
                }
                throw err
            }
        }

        -- Ran off the end of the code rather than through a RETURN: a
        -- generator body that simply finishes is the common case.
        if len(frame.yields) > 0 { return frame.yields }
        if len(this.stack) > 0 { return this.stack[len(this.stack) - 1] }
        return null
    }

    -- ── Helper methods ──────────────────────────────────

    fn _is_truthy(value) {
        if value == null { return false }
        let t = type(value)
        if t == "bool" { return value }
        if t == "int" or t == "float" or t == "number" { return value != 0 }
        if t == "string" { return len(value) > 0 }
        if t == "list" { return len(value) > 0 }
        if t == "map" { return len(keys(value)) > 0 }
        return true
    }

    -- See Interpreter._display_in: `open` is what is being rendered between
    -- here and the top, so a value that contains itself stops rather than
    -- running the stack out. Membership is `identical`, because `==` on a
    -- container is structural and comparing two cyclic values is the same
    -- infinite walk.
    fn _is_open(value, open) {
        for o in open {
            if identical(o, value) { return true }
        }
        return false
    }

    fn _display(value) { return this._display_in(value, []) }

    fn _display_in(value, open) {
        if value == null { return "null" }
        let t = type(value)
        if t == "bool" {
            if value { return "true" }
            return "false"
        }
        if t == "number" {
            if value == floor(value) { return str(int(value)) }
            return str(value)
        }
        if t == "string" { return value }
        if t == "list" {
            if this._is_open(value, open) { return "[...]" }
            let inner = _appended(open, value)
            let items = join(map(value, fn(v) { return this._repr_in(v, inner) }), ", ")
            return "[{items}]"
        }
        if t == "map" {
            if this._is_open(value, open) { return "\{...\}" }
            let inner = _appended(open, value)
            let ks = keys(value)
            let pair_strs = map(ks, fn(k) {
                return "{k}: {this._repr_in(value[k], inner)}"
            })
            return "\{" + join(pair_strs, ", ") + "\}"
        }
        if t == "VMFunction" { return value.to_string() }
        if t == "VMClass" { return value.to_string() }
        if t == "VMEnum" { return value.to_string() }
        if t == "VMInstance" {
            -- A class that says how it prints says so for every engine. The
            -- interpreter calls the instance's own to_string() and displays
            -- what that returns; the VM printed <P instance> instead, so a
            -- class with a to_string() rendered one way under `clarity run`
            -- and in a compiled binary, and another under `run --fast`.
            -- A to_string that throws falls back to the default, as there.
            let ts = value.klass.find_method("to_string")
            if ts != null {
                try {
                    return this._display_in(this._call_method(value, ts, []),
                                            _appended(open, value))
                } catch e_ts { }
            }
            return value.to_string()
        }
        -- A method taken off an instance is a value like any other, and it
        -- had no rendering at all: _display fell through to the host's
        -- str(), which walked this engine's own object graph -- instance to
        -- class to methods and back -- until the stack ran out. `show inst.m`
        -- was "RangeError: Maximum call stack size exceeded" where the other
        -- two engines print something.
        --
        -- The wording is the interpreter's, which is the specification, and
        -- it is a poor one: `<builtin>` for a method the program itself wrote
        -- is the interpreter's host closure showing through, the same shape
        -- as len(instance) answering 3. Saying `<fn m>` in all three needs
        -- the interpreter to keep the method's name through the closure it
        -- binds it into, and a compiled binary to do the same; that is filed
        -- rather than done here, and this at least stops the crash without
        -- inventing a third answer.
        if t == "VMBoundMethod" { return "<builtin>" }
        return str(value)
    }

    fn _repr(value) { return this._repr_in(value, []) }

    fn _repr_in(value, open) {
        if type(value) == "string" { return "\"{value}\"" }
        return this._display_in(value, open)
    }

    fn _type_name(value) {
        if value == null { return "null" }
        let t = type(value)
        if t == "bool" { return "bool" }
        -- The host already distinguishes int from float, so `type(42)` is
        -- "int" and this branch never fires -- which is why the fallthrough
        -- below must hand back what the host said rather than "unknown".
        -- It used to say "unknown", so `match type(x) { when "int" ... }`
        -- took no arm under --fast and examples/patterns.clarity printed
        -- "42 is a unknown".
        if t == "number" {
            if value == floor(value) { return "int" }
            return "float"
        }
        if t == "string" { return "string" }
        if t == "list" { return "list" }
        if t == "map" { return "map" }
        if t == "function" or t == "builtin" { return "function" }
        if t == "VMFunction" { return "function" }
        if t == "VMClass" { return "class" }
        if t == "VMEnum" { return "enum" }
        if t == "VMInstance" { return value.klass.name }
        -- Anything the host already names correctly -- "int", "float", and
        -- whatever else it grows -- passes through, exactly as
        -- Interpreter.cl_type_name ends.
        return t
    }
}

-- ── Optimizer ────────────────────────────────────────────

fn optimize(code) {
    -- Run all optimization passes on a CodeObject.
    _constant_fold(code)
    _dead_code_eliminate(code)
    _peephole(code)
    return code
}

fn _constant_fold(code) {
    -- Fold constant binary operations at bytecode level.
    -- Pattern: CONST a, CONST b, OP -> CONST (a OP b)
    mut i = 0
    while i + 2 < len(code.instructions) {
        let i0 = code.instructions[i]
        let i1 = code.instructions[i + 1]
        let i2 = code.instructions[i + 2]

        if i0[0] == OP_CONST and i1[0] == OP_CONST {
            let a = code.constants[i0[1]]
            let b = code.constants[i1[1]]
            let op = i2[0]

            if type(a) == "number" and type(b) == "number" {
                mut result = null
                mut folded = false

                if op == OP_ADD { result = a + b; folded = true }
                elif op == OP_SUB { result = a - b; folded = true }
                elif op == OP_MUL { result = a * b; folded = true }
                elif op == OP_DIV and b != 0 {
                    result = a / b
                    if result == floor(result) { result = int(result) }
                    folded = true
                }
                elif op == OP_MOD and b != 0 { result = a % b; folded = true }
                elif op == OP_POW { result = pow(a, b); folded = true }
                elif op == OP_EQ { result = a == b; folded = true }
                elif op == OP_NEQ { result = a != b; folded = true }
                elif op == OP_LT { result = a < b; folded = true }
                elif op == OP_GT { result = a > b; folded = true }
                elif op == OP_LTE { result = a <= b; folded = true }
                elif op == OP_GTE { result = a >= b; folded = true }

                if folded {
                    if type(result) == "bool" {
                        if result {
                            code.instructions[i] = [OP_TRUE, 0]
                        } else {
                            code.instructions[i] = [OP_FALSE, 0]
                        }
                    } else {
                        let result_idx = code.add_const(result)
                        code.instructions[i] = [OP_CONST, result_idx]
                    }
                    -- NOP out the other two instructions
                    code.instructions[i + 1] = [OP_POP, 0]
                    code.instructions[i + 2] = [OP_POP, 0]
                    -- Actually, we should replace them with nothing.
                    -- Since we can't remove instructions (would break jumps),
                    -- we'll push+pop which is a no-op. But better: push result once.
                    -- The CONST at i pushes the folded result.
                    -- i+1 and i+2 need to be skipped: use NOP pattern
                    -- NOP = POP after a needed value is wasteful.
                    -- Just leave as POP,POP — they'll be cleaned by peephole.
                }
            }
        }
        i += 1
    }
}

fn _dead_code_eliminate(code) {
    -- After RETURN or THROW, mark subsequent non-jump-target instructions.
    -- We mark them as NOPs (POP with nothing to pop is harmless).
    -- First, collect all jump targets
    let targets = {}
    mut i = 0
    while i < len(code.instructions) {
        let instr = code.instructions[i]
        let op = instr[0]
        if op == OP_JUMP or op == OP_JUMP_FALSE or op == OP_JUMP_TRUE or op == OP_SETUP_TRY {
            targets[instr[1]] = true
        }
        i += 1
    }

    -- Now scan for RETURN/THROW and NOP out dead code until a jump target
    i = 0
    while i < len(code.instructions) {
        let op = code.instructions[i][0]
        if op == OP_RETURN or op == OP_THROW or op == OP_HALT {
            mut j = i + 1
            while j < len(code.instructions) {
                if has(targets, j) { break }
                -- Don't NOP out HALTs
                if code.instructions[j][0] != OP_HALT {
                    code.instructions[j] = [OP_POP, 0]
                }
                j += 1
            }
            i = j
        } else {
            i += 1
        }
    }
}

fn _peephole(code) {
    -- Peephole optimizations:
    -- 1. Remove consecutive POP,POP when stack is likely empty (from constant folding)
    -- 2. CONST x, POP -> (NOP both) — dead expression
    -- 3. DUP, POP -> (NOP both)
    mut i = 0
    while i + 1 < len(code.instructions) {
        let i0 = code.instructions[i]
        let i1 = code.instructions[i + 1]

        -- CONST followed by POP = dead load
        if i0[0] == OP_CONST and i1[0] == OP_POP {
            -- Check this isn't a jump target
            -- (simplified: just do it, the semantics are preserved)
            code.instructions[i] = [OP_POP, 0]
            -- Two consecutive POPs from empty stack are harmless
        }

        -- DUP followed by POP = no-op
        if i0[0] == OP_DUP and i1[0] == OP_POP {
            code.instructions[i] = [OP_POP, 0]
        }

        i += 1
    }
}

-- ── Helper functions ────────────────────────────────────

fn _pad_left(s, width) {
    mut result = s
    while len(result) < width { result = " " + result }
    return result
}

fn _pad_right(s, width) {
    mut result = s
    while len(result) < width { result = result + " " }
    return result
}

fn _bc_display_list(lst) {
    let items = map(lst, fn(v) { return _bc_repr(v) })
    return "[" + join(items, ", ") + "]"
}

fn _bc_repr(value) {
    if value == null { return "null" }
    let t = type(value)
    if t == "string" { return "\"{value}\"" }
    if t == "bool" {
        if value { return "true" }
        return "false"
    }
    if t == "number" { return str(value) }
    if t == "list" { return _bc_display_list(value) }
    if t == "CodeObject" { return "<code {value.name}>" }
    return str(value)
}

-- ── Public API ───────────────────────────────────────────

-- True when a string carries at least one {expr} the language would
-- interpolate. Same heuristic as the interpreter and the transpiler.
fn _has_interpolation(text) {
    let n = len(text)
    mut i = 0
    while i < n - 1 {
        if char_at(text, i) == "{" and (is_alpha(char_at(text, i + 1)) or char_at(text, i + 1) == "_") {
            return true
        }
        i += 1
    }
    return false
}

fn _bc_basename(path) {
    mut i = len(path) - 1
    while i >= 0 {
        if char_at(path, i) == "/" { return substring(path, i + 1, len(path)) }
        i -= 1
    }
    return path
}

fn _bc_dirname(path) {
    mut i = len(path) - 1
    while i >= 0 {
        if char_at(path, i) == "/" {
            if i == 0 { return "/" }
            return substring(path, 0, i)
        }
        i -= 1
    }
    return "."
}

fn compile_to_bytecode(program) {
    let compiler = Compiler()
    return compiler.compile(program)
}
