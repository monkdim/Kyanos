-- Clarity → C code generator (native compilation, stage 17).
--
-- Emits a single self-contained C translation unit for a Clarity program:
-- a small tagged-Value runtime (prelude) plus the program itself, so the
-- output compiles with any C compiler into a real native binary — no Bun,
-- no bytecode VM.
--
-- Stage 1 covers the scalar core: int/float/bool/string/null values,
-- arithmetic/comparison/logical operators, string concatenation, variables,
-- if/while, and user functions with recursion.
--
-- Stage 2 adds lists and maps (dynamic arrays / assoc arrays behind a
-- pointer), indexing and index-assignment, `for` over lists/maps/strings/
-- ranges, and the common builtins (len/push/str/int/float/range/keys/has/
-- contains). Collections display like the interpreter (`[1, 2]`, `{k: v}`).
--
-- Stage 3 adds classes: instances are a class name + a field map (T_OBJECT),
-- methods share a uniform `Value f_Class_method(Value v_this, Value* argv)`
-- convention and dispatch through a runtime table keyed on the instance's
-- class, constructors run `init`, `this.field` reads/writes the field map,
-- and single inheritance resolves methods (and `init`) up the parent chain.
-- Instances print via a `to_string` method if present, else `<Cls instance>`.
--
-- Stage 4 adds closures: `fn(...) {...}` expressions are hoisted to top-level
-- C functions and their free variables snapshotted by value into a capture
-- array (T_CLOSURE). A free-variable analysis walks the body to find what to
-- capture; closures are called through `cl_call`, and `map`/`filter`/`reduce`/
-- `each` are native builtins that drive a closure over a collection. Captured
-- lists/objects share their pointer, so mutation through a capture is visible
-- outside — matching the interpreter. (Reassigning a captured *scalar* only
-- changes the local copy; by-reference scalar capture waits on the GC stage.)
--
-- Stage 5 routed every runtime allocation through a single hook (cl_alloc);
-- stage 6 makes that hook a conservative mark-sweep garbage collector. Each
-- allocation carries a header and is tracked, and the whole set is freed at
-- exit — so by default the runtime is the leak-free arena (safe on every
-- platform). Setting CLARITY_GC turns on *mid-run* collection: the collector
-- flushes registers, scans the C stack and object interiors for pointers,
-- marks the reachable set, and frees the rest (churning ~240 MB of garbage
-- then holds at ~3 MB RSS). Mid-run collection is off by default because
-- conservative scanning is optimiser/ABI sensitive — it showed instability
-- under clang -O2 on arm64 — and stays experimental until a precise
-- (shadow-stack) collector replaces it.
--
-- Stage 7 begins the native *app* stdlib: string ops (upper/lower/trim/split/
-- join/replace/starts/ends/substring/char_at/char_code/from_char_code/
-- index_of/pad_left/pad_right/chars/repeat/is_digit/is_alpha/is_alnum/
-- is_space), file I/O (read/write/append/exists/lines), and process basics
-- (env/args/exit) — all libc-backed. `main` now takes argc/argv. This is what
-- lets a real CLI or file/data tool compile to a standalone binary (a native
-- `wc` builds and runs).
--
-- Stage 8 adds process + math: exec (popen), exec_full (fork + two pipes →
-- {stdout, stderr, exit_code}), sleep, time, and abs/floor/ceil/round/sqrt/
-- sin/cos/tan/log/min/max/sum. Float display now prints the shortest
-- round-tripping form (3.14, not 3.1400000000000001), matching the
-- interpreter.
--
-- Stage 9 adds JSON: a recursive-descent json_parse (objects→maps, arrays→
-- lists, strings with escapes + \uXXXX→UTF-8, numbers→int/float) and a
-- json_string serialiser matching JSON.stringify (compact, insertion order),
-- both over an amortised-O(n) string builder. A native tool reads a JSON
-- config, computes, and emits JSON.
--
-- Stage 10 adds the binary-data foundation for RE tools & game mods:
-- read_bytes/write_bytes (a file ↔ a list of ints 0..255, matching the
-- interpreter) and the bitwise operators (& | ^ << >>). Together they let
-- pure-Clarity code parse and emit binary formats — magic-byte sniffing,
-- little/big-endian integer decoding, hexdumps — all compiling to a native
-- binary.
--
-- Stage 11 adds native FFI: ffi_sym/ffi_call resolve a symbol via
-- dlsym(RTLD_DEFAULT) (covering libc, libm, and anything linked or dlopen'd)
-- and call it through a typed shim (sig = <ret><args>, l/d/s/v). A compiled
-- binary can now call C directly — strlen/abs/toupper from libc, pow from
-- libm. The dlfcn helpers are dead-code-eliminated at -O2 unless the program
-- uses FFI, so non-FFI binaries still link with -lm alone on every platform;
-- FFI binaries add -ldl on Linux (a harmless stub on modern glibc, the real
-- libdl on older).
--
-- Stage 12 needed no compiler change — the RE byte toolkit (stdlib/bytes.clarity:
-- endianness readers/writers + AOB signature scanning) is pure Clarity over the
-- stage-10 primitives, so it compiled for free.
--
-- Stage 13 opens live-process memory access: read_mem(pid, addr, len) pread's
-- another process's /proc/<pid>/mem (pid<=0 = self) into a list of bytes, so a
-- compiled tool can AOB-scan a running target's memory. Linux-backed; a graceful
-- empty list elsewhere. Region enumeration (parsing /proc/<pid>/maps) is
-- pure-Clarity in stdlib/procmem.clarity.
--
-- Stage 14 adds the write side: write_mem(pid, addr, bytes) pwrite's into a
-- target's /proc/<pid>/mem and returns the byte count (0 on failure), so a
-- compiled tool can poke/patch a running process — the trainer counterpart to
-- read_mem.
--
-- Stage 15 needed no compiler change — bits.clarity (64-bit-capable bit
-- manipulation to 2^53) is pure Clarity.
--
-- Stage 16 matures native FFI: ffi_open(path) dlopen's a shared library with
-- RTLD_GLOBAL, so its symbols become resolvable by ffi_sym/ffi_call — a
-- compiled tool can now bind ANY C library (not just already-loaded ones).
--
-- Stage 17 makes that FFI usable for real libraries: ffi_call now has a generic
-- word-argument path (any mix of l/p/s args through one prototype, per the
-- integer-register ABI) instead of a fixed signature table, and raw buffers
-- (ffi_buffer/ffi_read/ffi_write/ffi_free) let a call pass a pointer to memory
-- Clarity owns — out-params, structs, byte regions. Together they cover the
-- pointer-heavy APIs a disassembler (Capstone) or codec needs. Later stages add
-- hooking/detours, the disassembly on-ramp itself, and the network stack.
--
--   let c = compile_to_c(parse(tokenize(src, "x"), src))
--   write("out.c", c)   →   cc out.c -o prog   →   ./prog
--
-- Names are prefixed (v_ for variables/params, f_ for functions) so a
-- Clarity identifier can never collide with a C keyword.

-- String interpolation is not a parser construct: a string literal keeps its
-- braces, and each engine decides for itself what `{x}` means inside one. So
-- the compiler has to tokenize and parse the interpolated expressions the same
-- way the interpreter does at run time.
from "lexer.clarity" import tokenize
from "parser.clarity" import parse

-- ── C runtime prelude ───────────────────────────────────
-- A dynamically-typed Value as a tagged struct; lists/maps/objects/closures
-- hang off `o`. Every allocation is bump-allocated from the arena (cl_alloc)
-- and released together at program exit (cl_arena_free) — see the arena block.
--
-- MAINTAINER NOTE: this prelude is a Clarity *source* string, so it must
-- never contain an open brace directly followed by a letter (`{name`) — the
-- string-interpolation pass reads that as `{expr}`. Always write C blocks and
-- array initializers with a space after `{`. The interpreter tolerates a slip
-- here, but the transpiled binary silently mangles the whole string, so after
-- editing the prelude, rebuild and run `clarity cc` on a sample to verify.

let C_PRELUDE = """#ifndef CLARITY_FREESTANDING
#define _GNU_SOURCE 1
#endif
/* CLARITY_FREESTANDING is defined by `clarity cc --freestanding`, for targets
   with no operating system underneath — KyanOS itself, to begin with. It
   drops the parts of this runtime that are POSIX rather than C: files,
   /proc-backed memory access, process control, dynamic loading and sockets.
   What is left needs a C library of about fifteen functions, which is a
   thing one can write; what it drops needs an operating system that already
   exists, which is the thing being built. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <setjmp.h>
#include <ctype.h>
#ifndef CLARITY_FREESTANDING
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>
#include <time.h>
#include <dlfcn.h>
#include <errno.h>
#include <signal.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <netdb.h>
#endif

/* Fatal-error reporting. Hosted, it goes to stderr, where a diagnostic
   belongs. Freestanding, it goes to printf: a target with no operating system
   has one console, and asking its C library for the whole FILE* machinery —
   stderr, fprintf — to report an error it is about to die from is a large
   thing to require for a small gain. */
static void cl_eprint(const char* prefix, const char* msg){
#ifdef CLARITY_FREESTANDING
  printf("%s%s\n", prefix, msg);
#else
  fprintf(stderr, "%s%s\n", prefix, msg);
#endif
}
static void cl_die(const char* msg){ cl_eprint("", msg); exit(1); }

/* command-line argv, captured in main for the args() builtin */
static int cl_argc = 0;
static char** cl_argv = 0;

/* Conservative stack scanning deliberately reads every word of the C stack,
   including the padding a sanitizer inserts between variables. Exempt the
   scanner from AddressSanitizer's stack instrumentation so those reads aren't
   flagged; heap checks (the ones that would catch a real GC bug) still apply. */
#if defined(__GNUC__) || defined(__clang__)
#define GC_NOSAN __attribute__((no_sanitize_address))
/* main's frame pointer sits above every local in main, so scanning down from
   it to the current stack pointer covers all roots. Taking the address of a
   local would not — the compiler may place that local below other roots. */
#define GC_CAPTURE_STACK_BASE() (gc_stack_base = (char*)__builtin_frame_address(0))
#else
#define GC_NOSAN
#define GC_CAPTURE_STACK_BASE() do { char __b; gc_stack_base = &__b; } while(0)
#endif

typedef enum { T_NULL, T_BOOL, T_INT, T_FLOAT, T_STR, T_LIST, T_MAP, T_OBJECT, T_CLOSURE } Tag;
typedef struct Value Value;
struct Value { Tag t; long i; double f; const char* s; void* o; };
typedef struct { Value* items; long len; long cap; } List;
typedef struct { char** keys; Value* vals; long len; long cap; } Map;
typedef struct { const char* cls; Value fields; } Obj;

/* closures: a function pointer over (arg-array, capture-array) plus the
   captured values (snapshotted by value at creation) */
/* Calling conventions carry the argument count.
   Without it a callee cannot tell `f(1)` from `f(1, 2)`, which is what a rest
   parameter needs to know — and what a fixed parameter needs in order to read
   as null rather than off the end of the array when the caller supplied fewer
   arguments than the function declares. */
typedef Value (*ClFn)(Value*, Value*, long);
typedef struct { ClFn fn; Value* cap; int ncap; } Closure;

/* uniform method calling convention: (self, arg-array) -> Value */
typedef Value (*ClMethod)(Value, Value*, long);
typedef struct { const char* cls; const char* m; ClMethod fn; } ClMethodEntry;
static ClMethodEntry cl_method_table[1024];
static int cl_method_count = 0;

/* mutually-recursive display + deep-equality forward declarations */
static char* cl_to_cstr(Value v);
static char* cl_repr(Value v);
static char* cl_display(Value v);
/* The value a `throw` is carrying. Declared here rather than with the rest
   of the exception machinery because gc_collect scans it as a root, and that
   comes first in the file. */
static Value cl_thrown;
static int cl_equal(Value a, Value b);
static ClMethod cl_find_method(const char* cls, const char* m);
static char* cl_obj_display(Value v);
/* indexing and property access raise the interpreter's errors, and both are
   defined above the exception machinery and the type names they need */
static void cl_throw(Value v);
static Value cl_type_of(Value v);
/* cl_dispatch calls a field that holds a closure, and cl_call is defined
   below it with the rest of the closure machinery */
static Value cl_call(Value f, Value* args, long n);
/* a list, a string and a number have methods; cl_get_field binds one and the
   definitions sit with cl_dispatch below */
static Value cl_builtin_method(Value self, const char* m, Value* a, long n);
static int cl_has_builtin_methods(Value v);
static int cl_bm_known(Value v, const char* m);
static Value cl_bound_builtin_method(Value self, const char* name);
static Value cl_abs(Value v);   /* n.abs(), defined with the math helpers */

/* ── conservative mark-sweep garbage collector (opt-in) ──
   Every runtime value carries a small header and is tracked in a global list.
   The whole set is always released at exit (cl_arena_free), so the default
   behaviour is the leak-free arena: allocate, free once at the end. That is
   what ships on by default, and it is safe on every platform.

   Setting the CLARITY_GC environment variable turns on *mid-run* collection:
   when live bytes cross a threshold, cl_alloc flushes callee-saved registers
   to the stack (setjmp), conservatively scans the whole C stack and the
   interiors of reachable objects for words that point into a tracked
   allocation, marks the reachable set, and frees the rest. This reclaims
   memory during the run, but conservative scanning is layout/optimiser
   sensitive (it has shown instability under clang -O2 on arm64), so it stays
   experimental and off until a precise (shadow-stack) collector replaces it.

   Conservative: an integer that happens to look like a live pointer keeps its
   target alive (safe waste), but a real pointer is never missed as long as it
   sits on the stack or inside another live object. Our codegen never hides a
   pointer in a non-pointer or points into the middle of an allocation, and any
   pointer live across a cl_alloc call is spilled to the stack by the ABI, so
   the root set the scan sees is complete. cl_alloc is the single hook a
   precise/generational collector would later replace.

   The mark phase resolves each scanned word through gc_find, which binary-
   searches a payload-address-sorted snapshot of the live set (rebuilt once per
   collection) — so collecting with many simultaneously-live objects is
   O(n log n), not the quadratic a per-word linear walk would cost. */
typedef struct GCObj { struct GCObj* next; size_t size; unsigned char marked; } GCObj;
static GCObj* gc_head = 0;
static size_t gc_live = 0;
static size_t gc_threshold = 1<<20;      /* first collection after ~1 MiB live */
static char* gc_stack_base = 0;          /* set once at main entry */
static int gc_enabled = 0;               /* opt-in: mid-run collection off by default */

/* mark worklist + address index (plain malloc — not GC-tracked) */
static GCObj** gc_work = 0;
static size_t gc_work_len = 0, gc_work_cap = 0;
static GCObj** gc_index = 0;              /* all live objects, sorted by payload address */
static size_t gc_index_len = 0, gc_index_cap = 0;

/* Module-level Clarity bindings are emitted at C file scope so functions can
   see them, which puts them outside the conservative stack scan. The generated
   program hands the collector the table of their addresses at main entry;
   without it a global's object is swept while still reachable. */
static Value** cl_globals = 0;
static size_t cl_globals_n = 0;

static int gc_cmp(const void* a, const void* b){
  char* pa = (char*)(*(GCObj* const*)a + 1);
  char* pb = (char*)(*(GCObj* const*)b + 1);
  return (pa > pb) - (pa < pb);
}
/* snapshot the object list into a payload-address-sorted array so gc_find can
   binary-search instead of walking every object per scanned word */
static void gc_reindex(void){
  gc_index_len = 0;
  for(GCObj* o=gc_head; o; o=o->next){
    if(gc_index_len >= gc_index_cap){
      gc_index_cap = gc_index_cap ? gc_index_cap*2 : 1024;
      gc_index = (GCObj**)realloc(gc_index, sizeof(GCObj*)*gc_index_cap);
    }
    gc_index[gc_index_len++] = o;
  }
  qsort(gc_index, gc_index_len, sizeof(GCObj*), gc_cmp);
}
/* the tracked allocation containing p, or 0 — interior pointers included */
static GCObj* gc_find(void* p){
  char* c = (char*)p;
  size_t lo = 0, hi = gc_index_len;      /* largest payload start <= c */
  while(lo < hi){
    size_t mid = lo + (hi - lo)/2;
    if((char*)(gc_index[mid]+1) <= c) lo = mid + 1; else hi = mid;
  }
  if(lo == 0) return 0;
  GCObj* o = gc_index[lo-1];
  char* s = (char*)(o+1);
  if(c >= s && c < s + o->size) return o;
  return 0;
}
GC_NOSAN static void gc_scan(char* lo, char* hi){
  /* align the low bound so every read of a void* is aligned */
  lo = (char*)(((size_t)lo + sizeof(void*) - 1) & ~((size_t)(sizeof(void*)-1)));
  for(char* p=lo; p + sizeof(void*) <= hi; p += sizeof(void*)){
    GCObj* o = gc_find(*(void**)p);
    if(o && !o->marked){
      o->marked = 1;
      if(gc_work_len >= gc_work_cap){
        gc_work_cap = gc_work_cap ? gc_work_cap*2 : 256;
        gc_work = (GCObj**)realloc(gc_work, sizeof(GCObj*)*gc_work_cap);
      }
      gc_work[gc_work_len++] = o;
    }
  }
}
GC_NOSAN static void gc_collect(void){
  jmp_buf regs; setjmp(regs);                    /* spill callee-saved regs */
  char probe; char* sp = &probe;
  gc_work_len = 0;
  gc_reindex();                                  /* sorted index for O(log n) gc_find */
  char* lo = sp < gc_stack_base ? sp : gc_stack_base;
  char* hi = sp < gc_stack_base ? gc_stack_base : sp;
  gc_scan(lo, hi);                               /* roots: the live C stack */
  gc_scan((char*)&regs, (char*)&regs + sizeof(regs));
  for(size_t gi=0; gi<cl_globals_n; gi++)      /* roots: module-level bindings */
    gc_scan((char*)cl_globals[gi], (char*)cl_globals[gi] + sizeof(Value));
  gc_scan((char*)&cl_thrown, (char*)&cl_thrown + sizeof(Value));  /* roots: value in flight */
  while(gc_work_len){                            /* transitive closure */
    GCObj* o = gc_work[--gc_work_len];
    gc_scan((char*)(o+1), (char*)(o+1) + o->size);
  }
  GCObj** link = &gc_head;                        /* sweep */
  while(*link){
    GCObj* o = *link;
    if(o->marked){ o->marked = 0; link = &o->next; }
    else { *link = o->next; gc_live -= o->size; free(o); }
  }
}
static void* cl_alloc(size_t n){
  n = (n + 15) & ~((size_t)15);                  /* 16-byte align */
  if(gc_enabled && gc_stack_base && gc_live + n > gc_threshold){
    gc_collect();
    if(gc_live > gc_threshold/2) gc_threshold *= 2;   /* grow to amortise */
  }
  GCObj* o = (GCObj*)malloc(sizeof(GCObj) + n);
  o->size = n; o->marked = 0; o->next = gc_head; gc_head = o;
  gc_live += n;
  return (void*)(o + 1);
}
static char* cl_strdup(const char* s){
  size_t n = strlen(s) + 1;
  char* out = (char*)cl_alloc(n);
  memcpy(out, s, n);
  return out;
}
static void cl_arena_free(void){                 /* release everything at exit */
  GCObj* o = gc_head;
  while(o){ GCObj* nx = o->next; free(o); o = nx; }
  gc_head = 0; free(gc_work); gc_work = 0; free(gc_index); gc_index = 0;
}

static Value cl_null(void){ Value v; v.t=T_NULL; v.i=0; v.f=0; v.s=0; v.o=0; return v; }
static Value cl_bool(long b){ Value v=cl_null(); v.t=T_BOOL; v.i=(b!=0); return v; }
static Value cl_int(long i){ Value v=cl_null(); v.t=T_INT; v.i=i; return v; }
static Value cl_float(double f){ Value v=cl_null(); v.t=T_FLOAT; v.f=f; return v; }
static Value cl_str(const char* s){ Value v=cl_null(); v.t=T_STR; v.s=s; return v; }

/* Lists and maps live behind a pointer, so a Value copy shares the backing
   store — push/index-set mutate through it. Backing storage is arena memory,
   reclaimed wholesale at exit; growth allocates a fresh block and copies. */
static Value cl_list_new(void){
  List* l=(List*)cl_alloc(sizeof(List));
  l->len=0; l->cap=4; l->items=(Value*)cl_alloc(sizeof(Value)*l->cap);
  Value v=cl_null(); v.t=T_LIST; v.o=l; return v;
}
static Value cl_list_add(Value lv, Value item){
  List* l=(List*)lv.o;
  if(l->len>=l->cap){
    long nc=l->cap*2;
    Value* ni=(Value*)cl_alloc(sizeof(Value)*nc);
    memcpy(ni, l->items, sizeof(Value)*l->len);
    l->items=ni; l->cap=nc;
  }
  l->items[l->len++]=item; return lv;
}
static Value cl_map_new(void){
  Map* m=(Map*)cl_alloc(sizeof(Map));
  m->len=0; m->cap=4; m->keys=(char**)cl_alloc(sizeof(char*)*m->cap); m->vals=(Value*)cl_alloc(sizeof(Value)*m->cap);
  Value v=cl_null(); v.t=T_MAP; v.o=m; return v;
}
static Value cl_map_put(Value mv, char* key, Value val){
  Map* m=(Map*)mv.o;
  for(long j=0;j<m->len;j++){ if(strcmp(m->keys[j],key)==0){ m->vals[j]=val; return mv; } }
  if(m->len>=m->cap){
    long nc=m->cap*2;
    char** nk=(char**)cl_alloc(sizeof(char*)*nc);
    Value* nv=(Value*)cl_alloc(sizeof(Value)*nc);
    memcpy(nk, m->keys, sizeof(char*)*m->len);
    memcpy(nv, m->vals, sizeof(Value)*m->len);
    m->keys=nk; m->vals=nv; m->cap=nc;
  }
  m->keys[m->len]=cl_strdup(key); m->vals[m->len]=val; m->len++; return mv;
}

static int cl_is_num(Value v){ return v.t==T_INT || v.t==T_FLOAT; }
static double cl_num(Value v){ return v.t==T_FLOAT ? v.f : (double)v.i; }

/* grow-and-append into a fresh arena buffer (the accumulator is arena memory,
   reclaimed at exit — no per-call free) */
static char* cl_cat(char* a, const char* b){
  size_t la=strlen(a), lb=strlen(b);
  char* out=(char*)cl_alloc(la+lb+1);
  memcpy(out, a, la); memcpy(out+la, b, lb+1);
  return out;
}

static char* cl_to_cstr(Value v){
  if(v.t==T_LIST || v.t==T_MAP) return cl_repr(v);
  if(v.t==T_OBJECT) return cl_obj_display(v);
  if(v.t==T_CLOSURE){ char* b=(char*)cl_alloc(16); strcpy(b, "<closure>"); return b; }
  char* buf = (char*)cl_alloc(64);
  switch(v.t){
    case T_NULL: strcpy(buf, "null"); return buf;
    case T_BOOL: strcpy(buf, v.i ? "true" : "false"); return buf;
    case T_INT: snprintf(buf, 64, "%ld", v.i); return buf;
    case T_FLOAT:
      /* NaN and the infinities print as JavaScript names them, because that
         is what the other two engines show — C's own spelling is "-nan". */
      if(v.f != v.f){ strcpy(buf, "NaN"); return buf; }
      if(v.f > 1.7976931348623157e308){ strcpy(buf, "Infinity"); return buf; }
      if(v.f < -1.7976931348623157e308){ strcpy(buf, "-Infinity"); return buf; }
      if(v.f == (double)(long)v.f && v.f < 1e18 && v.f > -1e18){ snprintf(buf, 64, "%ld", (long)v.f); return buf; }
      /* shortest %g precision that round-trips — matches JS number formatting
         (3.14, not 3.1400000000000001) */
      for(int prec=1; prec<=17; prec++){ snprintf(buf, 64, "%.*g", prec, v.f); if(strtod(buf, 0)==v.f) break; }
      return buf;
    case T_STR: return (char*)v.s;
    default: return buf;
  }
}

/* repr quotes strings and recurses into collections (used inside [] and {}) */
static char* cl_repr(Value v){
  if(v.t==T_STR){
    size_t n=strlen(v.s); char* out=(char*)cl_alloc(n+3);
    out[0]='"'; memcpy(out+1, v.s, n); out[n+1]='"'; out[n+2]=0; return out;
  }
  if(v.t==T_LIST){
    List* l=(List*)v.o; char* out=(char*)cl_alloc(2); strcpy(out, "[");
    for(long j=0;j<l->len;j++){ if(j) out=cl_cat(out, ", "); out=cl_cat(out, cl_repr(l->items[j])); }
    return cl_cat(out, "]");
  }
  if(v.t==T_MAP){
    Map* m=(Map*)v.o; char* out=(char*)cl_alloc(2); strcpy(out, "{");
    for(long j=0;j<m->len;j++){ if(j) out=cl_cat(out, ", "); out=cl_cat(out, m->keys[j]); out=cl_cat(out, ": "); out=cl_cat(out, cl_repr(m->vals[j])); }
    return cl_cat(out, "}");
  }
  return cl_to_cstr(v);
}
/* display leaves top-level strings unquoted but reprs nested collections */
static char* cl_display(Value v){
  if(v.t==T_LIST || v.t==T_MAP) return cl_repr(v);
  if(v.t==T_OBJECT) return cl_obj_display(v);
  return cl_to_cstr(v);
}

static Value cl_concat(Value a, Value b){
  char* sa = cl_to_cstr(a); char* sb = cl_to_cstr(b);
  char* out = (char*)cl_alloc(strlen(sa)+strlen(sb)+1);
  strcpy(out, sa); strcat(out, sb);
  return cl_str(out);
}

static Value cl_add(Value a, Value b){
  if(a.t==T_STR || b.t==T_STR) return cl_concat(a, b);
  if(a.t==T_FLOAT || b.t==T_FLOAT) return cl_float(cl_num(a)+cl_num(b));
  return cl_int(a.i+b.i);
}
static Value cl_sub(Value a, Value b){
  if(a.t==T_FLOAT || b.t==T_FLOAT) return cl_float(cl_num(a)-cl_num(b));
  return cl_int(a.i-b.i);
}
static Value cl_mul(Value a, Value b){
  if(a.t==T_FLOAT || b.t==T_FLOAT) return cl_float(cl_num(a)*cl_num(b));
  return cl_int(a.i*b.i);
}
/* Dividing by zero is an error, as in both other engines; it answered 0 here,
   so a `try` around a division never fired and the wrong number carried on. */
static Value cl_div(Value a, Value b){
  double d = cl_num(b);
  if(d == 0.0) cl_throw(cl_str("RuntimeError: Division by zero"));
  return cl_float(cl_num(a)/d);
}
/* `%` by zero is NaN rather than an error, which is what the other two
   engines answer — it is JavaScript's remainder underneath. */
static Value cl_mod(Value a, Value b){
  if(cl_num(b) == 0.0) return cl_float(0.0/0.0);
  if(a.t==T_FLOAT || b.t==T_FLOAT) return cl_float(fmod(cl_num(a), cl_num(b)));
  return cl_int(a.i % b.i);
}
static Value cl_pow(Value a, Value b){
  if(a.t==T_INT && b.t==T_INT && b.i>=0){
    long r=1, base=a.i, e=b.i; while(e-->0) r*=base; return cl_int(r);
  }
  return cl_float(pow(cl_num(a), cl_num(b)));
}
/* Bitwise ops match the interpreter's JS semantics: operands are truncated to
   signed 32-bit, shift counts masked to 5 bits, results are signed 32-bit.
   (`int` is 32-bit on every platform we target.) 64-bit/unsigned bitwise is a
   tracked follow-up — it needs the numeric tower to grow past JS doubles. */
static Value cl_band(Value a, Value b){ return cl_int((long)((int)a.i & (int)b.i)); }
static Value cl_bor(Value a, Value b){ return cl_int((long)((int)a.i | (int)b.i)); }
static Value cl_bxor(Value a, Value b){ return cl_int((long)((int)a.i ^ (int)b.i)); }
static Value cl_shl(Value a, Value b){ return cl_int((long)((int)a.i << ((int)b.i & 31))); }
static Value cl_shr(Value a, Value b){ return cl_int((long)((int)a.i >> ((int)b.i & 31))); }
static Value cl_neg(Value a){
  if(a.t==T_FLOAT) return cl_float(-a.f);
  return cl_int(-a.i);
}

static int cl_truthy(Value v){
  switch(v.t){
    case T_NULL: return 0;
    case T_BOOL: case T_INT: return v.i!=0;
    case T_FLOAT: return v.f!=0.0;
    case T_STR: return v.s && v.s[0];
    case T_LIST: return ((List*)v.o)->len!=0;
    case T_MAP: return ((Map*)v.o)->len!=0;
    case T_OBJECT: return 1;
    case T_CLOSURE: return 1;
  }
  return 0;
}
static Value cl_not(Value a){ return cl_bool(!cl_truthy(a)); }

/* Lists and maps compare by contents, as both other engines do: a list
   element-wise and in order, a map by key regardless of insertion order. An
   instance compares by identity — C(1) == C(1) is false everywhere — and so
   does a closure, which is why neither falls through to the `i` comparison
   below: `i` is 0 in every pointer-backed Value, so that fallthrough made
   any two closures equal. */
static int cl_equal(Value a, Value b){
  if(a.t==T_STR && b.t==T_STR) return strcmp(a.s, b.s)==0;
  if(cl_is_num(a) && cl_is_num(b)) return cl_num(a)==cl_num(b);
  if(a.t != b.t) return 0;
  if(a.t==T_LIST){
    List* x=(List*)a.o; List* y=(List*)b.o;
    if(x==y) return 1;
    if(x->len != y->len) return 0;
    for(long i=0;i<x->len;i++) if(!cl_equal(x->items[i], y->items[i])) return 0;
    return 1;
  }
  if(a.t==T_MAP){
    Map* x=(Map*)a.o; Map* y=(Map*)b.o;
    if(x==y) return 1;
    if(x->len != y->len) return 0;
    for(long i=0;i<x->len;i++){
      int found=0;
      for(long j=0;j<y->len;j++){
        if(strcmp(x->keys[i], y->keys[j])==0){
          if(!cl_equal(x->vals[i], y->vals[j])) return 0;
          found=1; break;
        }
      }
      if(!found) return 0;
    }
    return 1;
  }
  if(a.t==T_OBJECT || a.t==T_CLOSURE) return a.o==b.o;
  return a.i==b.i;
}
static Value cl_eq(Value a, Value b){ return cl_bool(cl_equal(a,b)); }
static Value cl_neq(Value a, Value b){ return cl_bool(!cl_equal(a,b)); }
static Value cl_lt(Value a, Value b){
  if(a.t==T_STR && b.t==T_STR) return cl_bool(strcmp(a.s,b.s)<0);
  return cl_bool(cl_num(a)<cl_num(b));
}
static Value cl_gt(Value a, Value b){
  if(a.t==T_STR && b.t==T_STR) return cl_bool(strcmp(a.s,b.s)>0);
  return cl_bool(cl_num(a)>cl_num(b));
}
static Value cl_lte(Value a, Value b){
  if(a.t==T_STR && b.t==T_STR) return cl_bool(strcmp(a.s,b.s)<=0);
  return cl_bool(cl_num(a)<=cl_num(b));
}
static Value cl_gte(Value a, Value b){
  if(a.t==T_STR && b.t==T_STR) return cl_bool(strcmp(a.s,b.s)>=0);
  return cl_bool(cl_num(a)>=cl_num(b));
}

/* ── collections: length, indexing, iteration ── */
static long cl_length(Value v){
  if(v.t==T_LIST) return ((List*)v.o)->len;
  if(v.t==T_MAP) return ((Map*)v.o)->len;
  if(v.t==T_STR) return (long)strlen(v.s);
  return 0;
}
/* Reading past the end of a list or a string, and indexing something that
   cannot be indexed at all, are errors — the same errors the interpreter
   raises, in the same words. They used to answer null here, so a compiled
   program carried the mistake onwards instead of stopping at it, and a `try`
   written to catch exactly this never fired. */
static Value cl_index(Value c, Value k){
  if(c.t==T_LIST){
    List* l=(List*)c.o;
    /* A key that is not a number is not an index: the interpreter's bounds
       comparison is false for one, and the lookup answers null. */
    if(!cl_is_num(k)) return cl_null();
    long want=(long)cl_num(k);
    long idx = want < 0 ? want + l->len : want;
    if(idx<0||idx>=l->len){
      char buf[160];
      snprintf(buf, sizeof buf, "RuntimeError: Index %ld out of bounds (list has %ld items)", want, l->len);
      cl_throw(cl_str(cl_strdup(buf)));
    }
    return l->items[idx];
  }
  if(c.t==T_MAP){ Map* m=(Map*)c.o; char* ks=cl_to_cstr(k); for(long j=0;j<m->len;j++) if(strcmp(m->keys[j],ks)==0) return m->vals[j]; return cl_null(); }
  if(c.t==T_STR){
    long n=(long)strlen(c.s);
    if(!cl_is_num(k)) return cl_null();
    long want=(long)cl_num(k);
    long idx = want < 0 ? want + n : want;
    if(idx<0||idx>=n){
      char buf[160];
      snprintf(buf, sizeof buf, "RuntimeError: Index %ld out of bounds", want);
      cl_throw(cl_str(cl_strdup(buf)));
    }
    char* ch=(char*)cl_alloc(2); ch[0]=c.s[idx]; ch[1]=0; return cl_str(ch);
  }
  /* An instance reads like the map of its fields — what makes keys(obj)
     useful, since `for k in keys(p) { p[k] }` is the loop anyone writes next.
     A missing field is null, the same answer a map gives. */
  if(c.t==T_OBJECT){ Obj* o=(Obj*)c.o; return cl_index(o->fields, k); }
  {
    char buf[160];
    snprintf(buf, sizeof buf, "TypeError: Cannot index into %s", cl_type_of(c).s);
    cl_throw(cl_str(cl_strdup(buf)));
  }
  return cl_null();
}
/* ── `...` and destructuring ──
   Spreading opens a list out into a list or a call's arguments and a map into
   a map; a list literal and a map literal refuse anything else, while a call
   passes it as one argument, which is what the interpreter does. */
static Value cl_list_extend(Value acc, Value v){
  if(v.t != T_LIST) cl_throw(cl_str("TypeError: Can only spread a list into a list"));
  List* l=(List*)v.o;
  for(long i=0;i<l->len;i++) acc = cl_list_add(acc, l->items[i]);
  return acc;
}
static Value cl_map_merge(Value acc, Value v){
  if(v.t != T_MAP) cl_throw(cl_str("TypeError: Can only spread a map into a map"));
  Map* m=(Map*)v.o;
  for(long i=0;i<m->len;i++) acc = cl_map_put(acc, m->keys[i], m->vals[i]);
  return acc;
}
static Value cl_args_add(Value acc, Value v){
  if(v.t == T_LIST){ List* l=(List*)v.o; for(long i=0;i<l->len;i++) acc = cl_list_add(acc, l->items[i]); return acc; }
  return cl_list_add(acc, v);
}
/* The argument array a call built as a list, so an arity known only at run
   time can still be passed to the array convention everything here uses. */
static Value* cl_argv_of(Value list){ return ((List*)list.o)->items; }
static void cl_require_list(Value v){
  if(v.t != T_LIST) cl_throw(cl_str("TypeError: Cannot destructure non-list into list pattern"));
}
static void cl_require_map(Value v){
  if(v.t != T_MAP) cl_throw(cl_str("TypeError: Cannot destructure non-map into map pattern"));
}
/* A name past the end of the list binds null rather than failing, as in the
   interpreter: `let [a, b] = [1]` gives b null. */
static Value cl_destructure_at(Value v, long i){
  List* l=(List*)v.o;
  if(i < 0 || i >= l->len) return cl_null();
  return l->items[i];
}
static Value cl_destructure_rest(Value v, long i){
  List* l=(List*)v.o; Value out=cl_list_new();
  for(long j=i;j<l->len;j++) out = cl_list_add(out, l->items[j]);
  return out;
}

static void cl_index_set(Value c, Value k, Value val){
  if(c.t==T_LIST){ List* l=(List*)c.o; long idx=k.i; if(idx<0) idx+=l->len; if(idx>=0&&idx<l->len) l->items[idx]=val; }
  else if(c.t==T_MAP){ char* ks=cl_to_cstr(k); cl_map_put(c, ks, val); }
  else if(c.t==T_OBJECT){ Obj* o=(Obj*)c.o; char* ks=cl_to_cstr(k); cl_map_put(o->fields, ks, val); }
}
/* materialise the thing a for-loop walks: lists as-is, map keys, string chars */
static Value cl_iter(Value v){
  if(v.t==T_LIST) return v;
  if(v.t==T_MAP){ Map* m=(Map*)v.o; Value out=cl_list_new(); for(long j=0;j<m->len;j++) cl_list_add(out, cl_str(m->keys[j])); return out; }
  if(v.t==T_STR){ Value out=cl_list_new(); long n=(long)strlen(v.s); for(long j=0;j<n;j++){ char* ch=(char*)cl_alloc(2); ch[0]=v.s[j]; ch[1]=0; cl_list_add(out, cl_str(ch)); } return out; }
  return cl_list_new();
}

/* ── builtins reachable from native code ── */
static Value cl_range2(Value a, Value b){ Value out=cl_list_new(); for(long j=a.i;j<b.i;j++) cl_list_add(out, cl_int(j)); return out; }
/* An object's field map, or the value unchanged for anything else.
   keys/values/entries/has accept an instance and answer with its fields, the
   same as the interpreter and the transpiled backend do — an object is a map
   with a class name attached, and asking it what it holds should say. */
static Value cl_fields_of(Value v){ if(v.t==T_OBJECT){ Obj* o=(Obj*)v.o; return o->fields; } return v; }
static Value cl_keys(Value vv){ Value v=cl_fields_of(vv); Value out=cl_list_new(); if(v.t==T_MAP){ Map* m=(Map*)v.o; for(long j=0;j<m->len;j++) cl_list_add(out, cl_str(m->keys[j])); } return out; }
static Value cl_has(Value vv, Value k){ Value v=cl_fields_of(vv); if(v.t==T_MAP){ Map* m=(Map*)v.o; char* ks=cl_to_cstr(k); for(long j=0;j<m->len;j++) if(strcmp(m->keys[j],ks)==0) return cl_bool(1); } return cl_bool(0); }
static Value cl_contains(Value a, Value b){
  if(a.t==T_STR){ char* ns=cl_to_cstr(b); return cl_bool(strstr((char*)a.s, ns)!=0); }
  if(a.t==T_LIST){ List* l=(List*)a.o; for(long j=0;j<l->len;j++) if(cl_equal(l->items[j], b)) return cl_bool(1); return cl_bool(0); }
  return cl_bool(0);
}

/* ── objects: instances, fields, method dispatch ── */
static Value cl_object_new(const char* cls){
  Obj* o=(Obj*)cl_alloc(sizeof(Obj));
  o->cls=cls; o->fields=cl_map_new();
  Value v=cl_null(); v.t=T_OBJECT; v.o=o; return v;
}
/* `.field` is the strict way of asking, and indexing is the lenient one: a
   map answers null for a key it does not hold, an instance does not. Reading
   a property off anything that has none is an error, as in both other
   engines; it used to answer null, so a typo compiled into a null that
   surfaced somewhere else entirely. */
/* `a?.b` answers null whenever `a.b` would have failed — not only when a is
   null, which is what the interpreter does and what the name promises. The
   lookup is cl_get_field's, without the errors. */
static Value cl_get_field_opt(Value obj, const char* name){
  Map* m=0;
  if(obj.t==T_OBJECT) m=(Map*)((Obj*)obj.o)->fields.o;
  else if(obj.t==T_MAP) m=(Map*)obj.o;
  else return cl_null();
  for(long j=0;j<m->len;j++) if(strcmp(m->keys[j],name)==0) return m->vals[j];
  return cl_null();
}
static Value cl_get_field(Value obj, const char* name){
  Map* m=0;
  if(obj.t==T_OBJECT) m=(Map*)((Obj*)obj.o)->fields.o;   /* instance field map */
  else if(obj.t==T_MAP) m=(Map*)obj.o;                    /* map.key sugar for map["key"] */
  else if(cl_has_builtin_methods(obj)){
    /* A list, a string or a number has methods rather than fields, and
       naming one without calling it binds it to its receiver. An unknown
       name still raises the interpreter's error, from cl_builtin_method. */
    if(!cl_bm_known(obj, name)) return cl_builtin_method(obj, name, 0, 0);
    return cl_bound_builtin_method(obj, name);
  }
  else {
    char buf[160];
    snprintf(buf, sizeof buf, "TypeError: Cannot access property on %s", cl_type_of(obj).s);
    cl_throw(cl_str(cl_strdup(buf)));
    return cl_null();
  }
  for(long j=0;j<m->len;j++) if(strcmp(m->keys[j],name)==0) return m->vals[j];
  if(obj.t==T_OBJECT){
    char buf[160];
    snprintf(buf, sizeof buf, "RuntimeError: %s has no property '%s'", ((Obj*)obj.o)->cls, name);
    cl_throw(cl_str(cl_strdup(buf)));
  }
  return cl_null();
}
static Value cl_set_field(Value obj, const char* name, Value val){
  if(obj.t==T_OBJECT){ Obj* o=(Obj*)obj.o; cl_map_put(o->fields, (char*)name, val); }
  return val;
}
static void cl_register(const char* cls, const char* m, ClMethod fn){
  if(cl_method_count >= 1024){ cl_die("clarity: method table overflow (>1024 methods)"); }
  cl_method_table[cl_method_count].cls=cls;
  cl_method_table[cl_method_count].m=m;
  cl_method_table[cl_method_count].fn=fn;
  cl_method_count++;
}
static ClMethod cl_find_method(const char* cls, const char* m){
  for(int i=0;i<cl_method_count;i++)
    if(strcmp(cl_method_table[i].cls,cls)==0 && strcmp(cl_method_table[i].m,m)==0)
      return cl_method_table[i].fn;
  return 0;
}
/* obj.method(args): resolve on the instance's class, call with the arg array */
static Value cl_dispatch(Value self, const char* m, Value* a, long n){
  /* A field or a key holding a function is called before a method of the
     same name, which is what both other engines do — and it is the only way
     `counter.next()` works when counter is a map of closures. */
  if(self.t==T_OBJECT || self.t==T_MAP){
    Value f = cl_get_field_opt(self, m);
    if(f.t==T_CLOSURE) return cl_call(f, a, n);
  }
  if(cl_has_builtin_methods(self)) return cl_builtin_method(self, m, a, n);
  const char* cls = (self.t==T_OBJECT) ? ((Obj*)self.o)->cls : "";
  ClMethod fn = cl_find_method(cls, m);
  if(fn) return fn(self, a, n);
  return cl_null();
}
/* instances print via a to_string method if defined, else <Cls instance> */
static char* cl_obj_default_display(Obj* o){
  char* out=(char*)cl_alloc(strlen(o->cls)+16);
  sprintf(out, "<%s instance>", o->cls);
  return out;
}
static char* cl_obj_to_string(Value v);   /* with the exception machinery below */
static char* cl_obj_display(Value v){
  Obj* o=(Obj*)v.o;
  if(cl_find_method(o->cls, "to_string")) return cl_obj_to_string(v);
  return cl_obj_default_display(o);
}

/* ── closures ── */
static Value cl_closure_new(ClFn fn, Value* cap, int ncap){
  Closure* c=(Closure*)cl_alloc(sizeof(Closure));
  c->fn=fn; c->ncap=ncap;
  c->cap=(Value*)cl_alloc(sizeof(Value)*(ncap>0?ncap:1));
  for(int i=0;i<ncap;i++) c->cap[i]=cap[i];
  Value v=cl_null(); v.t=T_CLOSURE; v.o=c; return v;
}
static Value cl_call(Value f, Value* args, long n){
  if(f.t==T_CLOSURE){ Closure* c=(Closure*)f.o; return c->fn(args, c->cap, n); }
  return cl_null();
}

/* The i-th argument, or null past the end.
   Clarity lets a call supply fewer arguments than the function declares, and
   the missing ones are null. Reading a[i] directly was fine only while every
   call site happened to supply them all: a method with parameters called with
   none was handed a null array and dereferenced it. */
static Value cl_arg(Value* a, long n, long i){ return (i < n) ? a[i] : cl_null(); }

/* The arguments from `i` onwards, as a list — a rest parameter's value. */
static Value cl_rest(Value* a, long n, long i){
  Value out = cl_list_new();
  for(long j=i;j<n;j++) cl_list_add(out, a[j]);
  return out;
}

/* higher-order builtins that drive a closure over a collection.
   NB: array initializers keep a space after the opening brace; an open
   brace followed directly by a letter reads as Clarity string interpolation
   while this prelude is still a source literal. */
static Value cl_hof_map(Value lst, Value fn){
  Value out=cl_list_new(); Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value a[1]={ cl_index(it, cl_int(i)) }; cl_list_add(out, cl_call(fn, a, 1)); }
  return out;
}
static Value cl_hof_filter(Value lst, Value fn){
  Value out=cl_list_new(); Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value e=cl_index(it, cl_int(i)); Value a[1]={ e }; if(cl_truthy(cl_call(fn, a, 1))) cl_list_add(out, e); }
  return out;
}
static Value cl_hof_reduce(Value lst, Value fn, Value init){
  Value acc=init; Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value a[2]={ acc, cl_index(it, cl_int(i)) }; acc=cl_call(fn, a, 2); }
  return acc;
}
/* ── encoding, hashing, environment ── */
static const char CL_B64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

static Value cl_encode64(Value v){
  const unsigned char* in = (const unsigned char*)v.s;
  size_t n = strlen((const char*)in);
  size_t outlen = 4 * ((n + 2) / 3);
  char* o = (char*)cl_alloc(outlen + 1);
  size_t i = 0, j = 0;
  while(i + 2 < n){
    unsigned long t = ((unsigned long)in[i]<<16) | ((unsigned long)in[i+1]<<8) | in[i+2];
    o[j++]=CL_B64[(t>>18)&63]; o[j++]=CL_B64[(t>>12)&63];
    o[j++]=CL_B64[(t>>6)&63];  o[j++]=CL_B64[t&63];
    i += 3;
  }
  if(i < n){                       /* 1 or 2 bytes left; pad to a quantum */
    unsigned long t = (unsigned long)in[i] << 16;
    int two = (i + 1 < n);
    if(two) t |= (unsigned long)in[i+1] << 8;
    o[j++]=CL_B64[(t>>18)&63]; o[j++]=CL_B64[(t>>12)&63];
    o[j++]= two ? CL_B64[(t>>6)&63] : '=';
    o[j++]='=';
  }
  o[j]=0;
  return cl_str(o);
}

static int cl_b64_val(char c){
  if(c>='A'&&c<='Z') return c-'A';
  if(c>='a'&&c<='z') return c-'a'+26;
  if(c>='0'&&c<='9') return c-'0'+52;
  if(c=='+') return 62;
  if(c=='/') return 63;
  return -1;                       /* '=' and anything else */
}

static Value cl_decode64(Value v){
  const char* in = v.s; size_t n = strlen(in);
  char* o = (char*)cl_alloc(n + 1);
  size_t j = 0; int quad[4]; int q = 0;
  for(size_t i=0;i<n;i++){
    int d = cl_b64_val(in[i]);
    if(d < 0) continue;            /* skip padding and whitespace */
    quad[q++] = d;
    if(q == 4){
      o[j++] = (char)((quad[0]<<2) | (quad[1]>>4));
      o[j++] = (char)(((quad[1]&15)<<4) | (quad[2]>>2));
      o[j++] = (char)(((quad[2]&3)<<6) | quad[3]);
      q = 0;
    }
  }
  if(q == 3){                      /* two bytes encoded */
    o[j++] = (char)((quad[0]<<2) | (quad[1]>>4));
    o[j++] = (char)(((quad[1]&15)<<4) | (quad[2]>>2));
  } else if(q == 2){               /* one byte encoded */
    o[j++] = (char)((quad[0]<<2) | (quad[1]>>4));
  }
  o[j]=0;
  return cl_str(o);
}

/* SHA-256, FIPS 180-4. The interpreter's hash() is node's createHash('sha256')
   and returns lowercase hex, so this has to agree with it byte for byte. */
static unsigned long cl_rotr(unsigned long x, int n){ return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFFul; }

static Value cl_sha256_hex(Value v){
  static const unsigned long K[64] = {
    0x428a2f98ul,0x71374491ul,0xb5c0fbcful,0xe9b5dba5ul,0x3956c25bul,0x59f111f1ul,0x923f82a4ul,0xab1c5ed5ul,
    0xd807aa98ul,0x12835b01ul,0x243185beul,0x550c7dc3ul,0x72be5d74ul,0x80deb1feul,0x9bdc06a7ul,0xc19bf174ul,
    0xe49b69c1ul,0xefbe4786ul,0x0fc19dc6ul,0x240ca1ccul,0x2de92c6ful,0x4a7484aaul,0x5cb0a9dcul,0x76f988daul,
    0x983e5152ul,0xa831c66dul,0xb00327c8ul,0xbf597fc7ul,0xc6e00bf3ul,0xd5a79147ul,0x06ca6351ul,0x14292967ul,
    0x27b70a85ul,0x2e1b2138ul,0x4d2c6dfcul,0x53380d13ul,0x650a7354ul,0x766a0abbul,0x81c2c92eul,0x92722c85ul,
    0xa2bfe8a1ul,0xa81a664bul,0xc24b8b70ul,0xc76c51a3ul,0xd192e819ul,0xd6990624ul,0xf40e3585ul,0x106aa070ul,
    0x19a4c116ul,0x1e376c08ul,0x2748774cul,0x34b0bcb5ul,0x391c0cb3ul,0x4ed8aa4aul,0x5b9cca4ful,0x682e6ff3ul,
    0x748f82eeul,0x78a5636ful,0x84c87814ul,0x8cc70208ul,0x90befffaul,0xa4506cebul,0xbef9a3f7ul,0xc67178f2ul };
  unsigned long h[8] = {0x6a09e667ul,0xbb67ae85ul,0x3c6ef372ul,0xa54ff53aul,
                        0x510e527ful,0x9b05688cul,0x1f83d9abul,0x5be0cd19ul};
  const unsigned char* msg = (const unsigned char*)v.s;
  size_t len = strlen((const char*)msg);
  size_t total = ((len + 9 + 63) / 64) * 64;
  unsigned char* buf = (unsigned char*)cl_alloc(total);
  memset(buf, 0, total);
  memcpy(buf, msg, len);
  buf[len] = 0x80;
  unsigned long long bits = (unsigned long long)len * 8ull;
  for(int i=0;i<8;i++) buf[total-1-i] = (unsigned char)((bits >> (8*i)) & 0xFF);

  for(size_t off=0; off<total; off+=64){
    unsigned long w[64];
    for(int i=0;i<16;i++){
      const unsigned char* p = buf + off + i*4;
      w[i] = ((unsigned long)p[0]<<24)|((unsigned long)p[1]<<16)|((unsigned long)p[2]<<8)|p[3];
    }
    for(int i=16;i<64;i++){
      unsigned long s0 = cl_rotr(w[i-15],7) ^ cl_rotr(w[i-15],18) ^ (w[i-15] >> 3);
      unsigned long s1 = cl_rotr(w[i-2],17) ^ cl_rotr(w[i-2],19) ^ (w[i-2] >> 10);
      w[i] = (w[i-16] + s0 + w[i-7] + s1) & 0xFFFFFFFFul;
    }
    unsigned long a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],hh=h[7];
    for(int i=0;i<64;i++){
      unsigned long S1 = cl_rotr(e,6) ^ cl_rotr(e,11) ^ cl_rotr(e,25);
      unsigned long ch = (e & f) ^ ((~e & 0xFFFFFFFFul) & g);
      unsigned long t1 = (hh + S1 + ch + K[i] + w[i]) & 0xFFFFFFFFul;
      unsigned long S0 = cl_rotr(a,2) ^ cl_rotr(a,13) ^ cl_rotr(a,22);
      unsigned long mj = (a & b) ^ (a & c) ^ (b & c);
      unsigned long t2 = (S0 + mj) & 0xFFFFFFFFul;
      hh=g; g=f; f=e; e=(d+t1)&0xFFFFFFFFul; d=c; c=b; b=a; a=(t1+t2)&0xFFFFFFFFul;
    }
    h[0]=(h[0]+a)&0xFFFFFFFFul; h[1]=(h[1]+b)&0xFFFFFFFFul;
    h[2]=(h[2]+c)&0xFFFFFFFFul; h[3]=(h[3]+d)&0xFFFFFFFFul;
    h[4]=(h[4]+e)&0xFFFFFFFFul; h[5]=(h[5]+f)&0xFFFFFFFFul;
    h[6]=(h[6]+g)&0xFFFFFFFFul; h[7]=(h[7]+hh)&0xFFFFFFFFul;
  }
  char* o = (char*)cl_alloc(65);
  for(int i=0;i<8;i++) sprintf(o + i*8, "%08lx", h[i]);
  o[64]=0;
  return cl_str(o);
}

static Value cl_cwd(void){
#ifdef CLARITY_FREESTANDING
  /* No working directory without a filesystem. The empty string is what the
     hosted path also returns when getcwd fails, so callers already handle it. */
  return cl_str("");
#else
  char* o = (char*)cl_alloc(4096);
  if(!getcwd(o, 4096)) { o[0]=0; }
  return cl_str(o);
#endif
}

/* Seeded once, lazily: a compiled tool that returns the same "random" numbers
   on every run would be a surprising thing to ship. */
static int cl_rand_ready = 0;
static double cl_rand_unit(void){
  if(!cl_rand_ready){
#ifdef CLARITY_FREESTANDING
    /* No clock and no pid to mix in yet. Stated rather than hidden: on a
       freestanding target the sequence is the same on every run until the
       host gains a time source to seed from. */
    srand(1);
#else
    srand((unsigned)time(0) ^ (unsigned)getpid());
#endif
    cl_rand_ready = 1;
  }
  return (double)rand() / ((double)RAND_MAX + 1.0);
}
static Value cl_random0(void){ return cl_float(cl_rand_unit()); }
static Value cl_random1(Value n){ return cl_int((long)(cl_rand_unit() * cl_num(n))); }
static Value cl_random2(Value a, Value b){
  double lo = cl_num(a), hi = cl_num(b);
  return cl_int((long)(cl_rand_unit() * (hi - lo)) + (long)lo);
}

/* ── exceptions ──
 *
 * A stack of setjmp handlers, innermost first, and one slot for the value in
 * flight. `throw` records the value and longjmps to the nearest handler; with
 * no handler it reports and exits, because a compiled program silently
 * ignoring an uncaught throw would be worse than one that stops.
 *
 * cl_thrown is a GC root — it is often the only reference to the value while
 * the stack that held it is being unwound.
 *
 * Note on setjmp and local variables: C leaves a non-volatile local of the
 * function containing the setjmp indeterminate if it is modified inside the
 * try. The emitter therefore gives `let`/`mut` locals of any function
 * containing a try `volatile` storage. A parameter reassigned inside a try is
 * the one case still relying on the compiler's returns_twice handling rather
 * than on the standard; clang and gcc both spill across setjmp, but it is a
 * gap and is recorded as one.
 */
typedef struct ClHandler { jmp_buf buf; struct ClHandler* prev; } ClHandler;
static ClHandler* cl_handlers = 0;

static void cl_throw(Value v){
  cl_thrown = v;
  if(!cl_handlers){
    cl_eprint("clarity: uncaught throw: ", cl_display(v));
    exit(1);
  }
  longjmp(cl_handlers->buf, 1);
}

/* A to_string() that throws falls back to the default rendering, which is
 * what the interpreter and the VM do: showing a value must not be able to
 * end the program. It needs a handler, so it lives below cl_throw and
 * cl_obj_display reaches it through the forward declaration above. */
static char* cl_obj_to_string(Value v){
  Obj* o=(Obj*)v.o;
  ClMethod ts = cl_find_method(o->cls, "to_string");
  ClHandler h; h.prev = cl_handlers; cl_handlers = &h;
  if(setjmp(h.buf) == 0){
    char* out = cl_display(ts(v, 0, 0));
    cl_handlers = h.prev;
    return out;
  }
  cl_handlers = h.prev;
  return cl_obj_default_display(o);
}

static Value cl_hof_each(Value lst, Value fn){
  Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value a[1]={ cl_index(it, cl_int(i)) }; cl_call(fn, a, 1); }
  return cl_null();
}
static Value cl_hof_find(Value lst, Value fn){
  Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value e=cl_index(it, cl_int(i)); Value a[1]={ e }; if(cl_truthy(cl_call(fn, a, 1))) return e; }
  return cl_null();   /* JS find returns undefined; the interpreter maps that to null */
}
static Value cl_hof_every(Value lst, Value fn){
  Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value a[1]={ cl_index(it, cl_int(i)) }; if(!cl_truthy(cl_call(fn, a, 1))) return cl_bool(0); }
  return cl_bool(1);
}
static Value cl_hof_some(Value lst, Value fn){
  Value it=cl_iter(lst); long n=cl_length(it);
  for(long i=0;i<n;i++){ Value a[1]={ cl_index(it, cl_int(i)) }; if(cl_truthy(cl_call(fn, a, 1))) return cl_bool(1); }
  return cl_bool(0);
}

/* ── app stdlib: list ops ── */
static Value cl_pop(Value lv){
  if(lv.t!=T_LIST) return cl_null();
  List* l=(List*)lv.o; if(l->len==0) return cl_null();
  l->len--; return l->items[l->len];
}
/* JS sorts with (a,b) => a < b ? -1 : a > b ? 1 : 0, over a copy. */
static int cl_sort_cmp(Value a, Value b){
  if(cl_truthy(cl_lt(a,b))) return -1;
  if(cl_truthy(cl_lt(b,a))) return 1;
  return 0;
}
/* Bottom-up merge sort: Array.prototype.sort is required to be stable, and an
   unstable sort would disagree with the interpreter on equal-comparing
   elements — exactly the kind of difference that shows up much later. */
static Value cl_sort(Value lv){
  Value out=cl_list_new();
  if(lv.t!=T_LIST) return out;
  List* src=(List*)lv.o; long n=src->len;
  for(long i=0;i<n;i++) cl_list_add(out, src->items[i]);
  if(n<2) return out;
  List* a=(List*)out.o;
  Value* buf=(Value*)cl_alloc((size_t)n*sizeof(Value));
  for(long width=1; width<n; width*=2){
    for(long lo=0; lo<n; lo+=2*width){
      long mid=lo+width; if(mid>n) mid=n;
      long hi=lo+2*width; if(hi>n) hi=n;
      long i=lo, j=mid, k=lo;
      while(i<mid && j<hi) buf[k++] = (cl_sort_cmp(a->items[j], a->items[i])<0) ? a->items[j++] : a->items[i++];
      while(i<mid) buf[k++]=a->items[i++];
      while(j<hi)  buf[k++]=a->items[j++];
      for(long t=lo;t<hi;t++) a->items[t]=buf[t];
    }
  }
  return out;
}
static Value cl_reverse(Value v){
  if(v.t==T_STR){ size_t n=strlen(v.s); char* o=(char*)cl_alloc(n+1); for(size_t i=0;i<n;i++) o[i]=v.s[n-1-i]; o[n]=0; return cl_str(o); }
  Value out=cl_list_new();
  if(v.t!=T_LIST) return out;
  List* l=(List*)v.o; for(long i=l->len-1;i>=0;i--) cl_list_add(out, l->items[i]);
  return out;
}
/* new Set(...) keeps first occurrences, in order. */
static Value cl_unique(Value lv){
  Value out=cl_list_new();
  if(lv.t!=T_LIST) return out;
  List* l=(List*)lv.o;
  for(long i=0;i<l->len;i++){
    List* o=(List*)out.o; int seen=0;
    for(long j=0;j<o->len;j++) if(cl_equal(o->items[j], l->items[i])){ seen=1; break; }
    if(!seen) cl_list_add(out, l->items[i]);
  }
  return out;
}
/* Array.prototype.flat() with no argument: one level only. */
static Value cl_flat(Value lv){
  Value out=cl_list_new();
  if(lv.t!=T_LIST) return out;
  List* l=(List*)lv.o;
  for(long i=0;i<l->len;i++){
    Value e=l->items[i];
    if(e.t==T_LIST){ List* inner=(List*)e.o; for(long j=0;j<inner->len;j++) cl_list_add(out, inner->items[j]); }
    else cl_list_add(out, e);
  }
  return out;
}
static Value cl_zip(Value* ls, long count){
  Value out=cl_list_new();
  if(count<=0) return out;
  long min=cl_length(ls[0]);
  for(long i=1;i<count;i++){ long n=cl_length(ls[i]); if(n<min) min=n; }
  for(long i=0;i<min;i++){
    Value row=cl_list_new();
    for(long j=0;j<count;j++) cl_list_add(row, cl_index(ls[j], cl_int(i)));
    cl_list_add(out, row);
  }
  return out;
}
static Value cl_values(Value vv){
  Value v=cl_fields_of(vv);
  Value out=cl_list_new();
  if(v.t==T_MAP){ Map* m=(Map*)v.o; for(long j=0;j<m->len;j++) cl_list_add(out, m->vals[j]); }
  return out;
}
static Value cl_entries(Value vv){
  Value v=cl_fields_of(vv);
  Value out=cl_list_new();
  if(v.t==T_MAP){
    Map* m=(Map*)v.o;
    for(long j=0;j<m->len;j++){
      Value pair=cl_list_new();
      cl_list_add(pair, cl_str(m->keys[j]));
      cl_list_add(pair, m->vals[j]);
      cl_list_add(out, pair);
    }
  }
  return out;
}
/* Object.assign({}, ...): later sources win. */
static Value cl_merge(Value* ms, long count){
  Value out=cl_map_new();
  for(long i=0;i<count;i++){
    if(ms[i].t!=T_MAP) continue;
    Map* m=(Map*)ms[i].o;
    for(long j=0;j<m->len;j++) cl_map_put(out, m->keys[j], m->vals[j]);
  }
  return out;
}
/* print(...) is show(...) with the arguments joined by a space, which is what
   the interpreter does for both. */
static Value cl_print(Value* vs, long n){
  char* out=(char*)cl_alloc(1); out[0]=0;
  for(long i=0;i<n;i++){ if(i) out=cl_cat(out, " "); out=cl_cat(out, cl_display(vs[i])); }
  printf("%s\n", out);
  return cl_null();
}

/* ── app stdlib: string ops ── (arena-allocated results) */
static Value cl_upper(Value v){ const char* s=v.s; size_t n=strlen(s); char* o=(char*)cl_alloc(n+1); for(size_t i=0;i<n;i++) o[i]=(char)toupper((unsigned char)s[i]); o[n]=0; return cl_str(o); }
static Value cl_lower(Value v){ const char* s=v.s; size_t n=strlen(s); char* o=(char*)cl_alloc(n+1); for(size_t i=0;i<n;i++) o[i]=(char)tolower((unsigned char)s[i]); o[n]=0; return cl_str(o); }
static Value cl_trim(Value v){ const char* s=v.s; while(*s && isspace((unsigned char)*s)) s++; size_t n=strlen(s); while(n>0 && isspace((unsigned char)s[n-1])) n--; char* o=(char*)cl_alloc(n+1); memcpy(o, s, n); o[n]=0; return cl_str(o); }
static Value cl_str_split(Value v, Value sepv){
  const char* s=v.s; const char* sep=sepv.s; size_t sl=strlen(sep); Value out=cl_list_new();
  if(sl==0){ size_t n=strlen(s); for(size_t i=0;i<n;i++){ char* c=(char*)cl_alloc(2); c[0]=s[i]; c[1]=0; cl_list_add(out, cl_str(c)); } return out; }
  const char* p=s; const char* q;
  while((q=strstr(p, sep))){ size_t len=(size_t)(q-p); char* seg=(char*)cl_alloc(len+1); memcpy(seg, p, len); seg[len]=0; cl_list_add(out, cl_str(seg)); p=q+sl; }
  cl_list_add(out, cl_str(cl_strdup(p))); return out;
}
static Value cl_str_join(Value lv, Value sepv){
  List* l=(List*)lv.o; const char* sep=sepv.s; char* out=(char*)cl_alloc(1); out[0]=0;
  for(long j=0;j<l->len;j++){ if(j) out=cl_cat(out, sep); out=cl_cat(out, cl_display(l->items[j])); }
  return cl_str(out);
}
static Value cl_replace(Value sv, Value ov, Value nv){
  const char* s=sv.s; const char* o=ov.s; const char* n=nv.s; size_t ol=strlen(o);
  if(ol==0) return sv;
  char* out=(char*)cl_alloc(1); out[0]=0; const char* p=s; const char* q;
  while((q=strstr(p, o))){ size_t len=(size_t)(q-p); char* seg=(char*)cl_alloc(len+1); memcpy(seg, p, len); seg[len]=0; out=cl_cat(out, seg); out=cl_cat(out, n); p=q+ol; }
  out=cl_cat(out, p); return cl_str(out);
}
static Value cl_starts(Value sv, Value pv){ const char* s=sv.s; const char* p=pv.s; return cl_bool(strncmp(s, p, strlen(p))==0); }
static Value cl_ends(Value sv, Value pv){ const char* s=sv.s; const char* p=pv.s; size_t sl=strlen(s), pl=strlen(p); return cl_bool(pl<=sl && strcmp(s+sl-pl, p)==0); }
/* JS String.prototype.substring semantics (matches the interpreter): clamp to
   [0,len], swap if start>end. */
static Value cl_substr(Value sv, long i, long j){ const char* s=sv.s; long n=(long)strlen(s); if(i<0) i=0; if(j<0) j=0; if(i>n) i=n; if(j>n) j=n; if(i>j){ long t=i; i=j; j=t; } long len=j-i; char* o=(char*)cl_alloc(len+1); memcpy(o, s+i, (size_t)len); o[len]=0; return cl_str(o); }
static Value cl_char_at(Value sv, long i){ const char* s=sv.s; long n=(long)strlen(s); if(i<0) i+=n; if(i<0||i>=n) return cl_str(""); char* o=(char*)cl_alloc(2); o[0]=s[i]; o[1]=0; return cl_str(o); }
static Value cl_char_code(Value sv){ const char* s=sv.s; return cl_int(s[0] ? (unsigned char)s[0] : 0); }
static Value cl_from_char_code(Value n){ char* o=(char*)cl_alloc(2); o[0]=(char)n.i; o[1]=0; return cl_str(o); }
static Value cl_index_of(Value sv, Value subv){ const char* s=sv.s; const char* q=strstr(s, subv.s); return cl_int(q ? (long)(q-s) : -1); }
static Value cl_pad_left(Value sv, long w){ const char* s=sv.s; long n=(long)strlen(s); if(n>=w) return sv; char* o=(char*)cl_alloc(w+1); long pad=w-n; for(long i=0;i<pad;i++) o[i]=' '; memcpy(o+pad, s, (size_t)n); o[w]=0; return cl_str(o); }
static Value cl_pad_right(Value sv, long w){ const char* s=sv.s; long n=(long)strlen(s); if(n>=w) return sv; char* o=(char*)cl_alloc(w+1); memcpy(o, s, (size_t)n); for(long i=n;i<w;i++) o[i]=' '; o[w]=0; return cl_str(o); }
static Value cl_chars(Value sv){ const char* s=sv.s; size_t n=strlen(s); Value out=cl_list_new(); for(size_t i=0;i<n;i++){ char* c=(char*)cl_alloc(2); c[0]=s[i]; c[1]=0; cl_list_add(out, cl_str(c)); } return out; }
static Value cl_str_repeat(Value sv, long k){ const char* s=sv.s; size_t n=strlen(s); char* o=(char*)cl_alloc(n*(k>0?k:0)+1); o[0]=0; for(long i=0;i<k;i++) memcpy(o+i*n, s, n); o[n*(k>0?k:0)]=0; return cl_str(o); }
static Value cl_is_digit(Value v){ const char* s=v.s; if(!s[0]) return cl_bool(0); for(size_t i=0;s[i];i++) if(!isdigit((unsigned char)s[i])) return cl_bool(0); return cl_bool(1); }
static Value cl_is_alpha(Value v){ const char* s=v.s; if(!s[0]) return cl_bool(0); for(size_t i=0;s[i];i++) if(!isalpha((unsigned char)s[i])) return cl_bool(0); return cl_bool(1); }
static Value cl_is_alnum(Value v){ const char* s=v.s; if(!s[0]) return cl_bool(0); for(size_t i=0;s[i];i++) if(!isalnum((unsigned char)s[i])) return cl_bool(0); return cl_bool(1); }
static Value cl_is_space(Value v){ const char* s=v.s; if(!s[0]) return cl_bool(0); for(size_t i=0;s[i];i++) if(!isspace((unsigned char)s[i])) return cl_bool(0); return cl_bool(1); }

/* ── app stdlib: string/number conversion ── */
static Value cl_conv_int(Value v){ if(v.t==T_STR) return cl_int(strtol(v.s, 0, 10)); if(v.t==T_FLOAT) return cl_int((long)v.f); if(v.t==T_BOOL) return cl_int(v.i); return cl_int(v.i); }
static Value cl_conv_float(Value v){ if(v.t==T_STR) return cl_float(strtod(v.s, 0)); return cl_float(cl_num(v)); }

#ifndef CLARITY_FREESTANDING
/* Excluded by the freestanding profile — file I/O: fopen/fread/fwrite/access. A freestanding target has no
   filesystem to open. */
/* ── app stdlib: file I/O ── */
static Value cl_read_file(Value pv){
  FILE* f=fopen(pv.s, "rb"); if(!f) return cl_null();
  /* Read in a growing loop rather than trusting ftell: virtual files under
     /proc (and pipes/FIFOs) report size 0, so a size-then-read would come back
     empty. This reads to real EOF, so read()/lines() work on /proc/<pid>/maps. */
  size_t cap=4096, len=0; char* buf=(char*)cl_alloc(cap); size_t n;
  while((n=fread(buf+len, 1, cap-len, f))>0){
    len+=n;
    if(len==cap){ size_t ncap=cap*2; char* nb=(char*)cl_alloc(ncap); memcpy(nb, buf, len); buf=nb; cap=ncap; }
  }
  fclose(f); buf[len]=0; return cl_str(buf);
}
static Value cl_write_file(Value pv, Value cv){ FILE* f=fopen(pv.s, "wb"); if(!f) return cl_bool(0); char* s=cl_to_cstr(cv); fwrite(s, 1, strlen(s), f); fclose(f); return cl_bool(1); }
static Value cl_append_file(Value pv, Value cv){ FILE* f=fopen(pv.s, "ab"); if(!f) return cl_bool(0); char* s=cl_to_cstr(cv); fwrite(s, 1, strlen(s), f); fclose(f); return cl_bool(1); }
static Value cl_exists(Value pv){ return cl_bool(access(pv.s, F_OK)==0); }
static Value cl_lines(Value pv){ Value c=cl_read_file(pv); if(c.t==T_NULL) return cl_list_new(); Value nl=cl_str("\n"); return cl_str_split(c, nl); }
/* read_bytes(path): raw file bytes as a list of ints (0..255), matching the
   interpreter's Array.from(readFileSync) for the common (file-exists) case. A
   missing file returns an empty list here rather than aborting — the native
   binary has no exception model to mirror the interpreter's ENOENT throw, and
   graceful [] is the friendlier behaviour for a compiled tool. */
static Value cl_read_bytes(Value pv){
  FILE* f=fopen(pv.s, "rb"); Value out=cl_list_new(); if(!f) return out;
  unsigned char buf[4096]; size_t n;
  while((n=fread(buf, 1, sizeof(buf), f))>0){ for(size_t i=0;i<n;i++) cl_list_add(out, cl_int((long)buf[i])); }
  fclose(f); return out;
}
/* write_bytes(path, list): each list element is coerced to a byte (& 0xFF).
   Returns true on success (matches the interpreter). */
static Value cl_write_bytes(Value pv, Value lv){
  FILE* f=fopen(pv.s, "wb"); if(!f) return cl_bool(0);
  if(lv.t==T_LIST){ List* l=(List*)lv.o; for(long j=0;j<l->len;j++){ unsigned char c=(unsigned char)(l->items[j].i & 0xFF); fwrite(&c, 1, 1, f); } }
  fclose(f); return cl_bool(1);
}
#endif /* !CLARITY_FREESTANDING */
/* type(v): the same names the interpreter reports, including the class name
   for an instance — code that branches on type() has to agree across the two
   backends or the same program means different things compiled. */
static Value cl_type_of(Value v){
  if(v.t==T_NULL) return cl_str("null");
  if(v.t==T_BOOL) return cl_str("bool");
  if(v.t==T_INT) return cl_str("int");
  if(v.t==T_FLOAT) return cl_str("float");
  if(v.t==T_STR) return cl_str("string");
  if(v.t==T_LIST) return cl_str("list");
  if(v.t==T_MAP) return cl_str("map");
  if(v.t==T_CLOSURE) return cl_str("function");
  if(v.t==T_OBJECT) return cl_str(((Obj*)v.o)->cls);
  return cl_str("null");
}

#ifndef CLARITY_FREESTANDING
/* Excluded by the freestanding profile — TCP sockets, and the /proc-backed memory access below them: both are
   the operating system, not the C language. */
/* ── TCP sockets ──
   Blocking IPv4 TCP, thin enough to read in one sitting and enough to build an
   HTTP client and server on top of. Every call reports failure as -1 (or an
   empty list) rather than aborting, the same way the file builtins behave in a
   compiled tool: a native binary that dies on a refused connection is much
   less useful than one that can say so.

   Received data is a list of ints 0..255, not a string. A Value string is a
   NUL-terminated char*, so a response carrying a zero byte — any binary body,
   any TLS record — would be silently truncated. Sending accepts either, since
   a request is usually built as text. */
/* Writing to a socket the peer has closed raises SIGPIPE, whose default
   action is to kill the process — the exact "dies instead of reporting it"
   behaviour the rest of this API avoids. Ignoring it makes send() return
   EPIPE instead, which the caller sees as -1. Done once, lazily, so a program
   that never opens a socket is unaffected. */
static void cl_sock_init(void){
  static int done = 0;
  if(!done){ signal(SIGPIPE, SIG_IGN); done = 1; }
}

static Value cl_tcp_listen(Value portv){
  cl_sock_init();
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if(fd < 0) return cl_int(-1);
  int one = 1;
  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
  struct sockaddr_in a;
  memset(&a, 0, sizeof(a));
  a.sin_family = AF_INET;
  a.sin_addr.s_addr = htonl(INADDR_ANY);
  a.sin_port = htons((unsigned short)portv.i);
  if(bind(fd, (struct sockaddr*)&a, sizeof(a)) < 0){ close(fd); return cl_int(-1); }
  if(listen(fd, 16) < 0){ close(fd); return cl_int(-1); }
  return cl_int(fd);
}

/* The port a listening socket actually got. Passing 0 to tcp_listen asks the
   kernel to pick a free one, which is how a test binds without racing whatever
   else is on the machine. */
static Value cl_tcp_port(Value fdv){
  struct sockaddr_in a;
  socklen_t len = sizeof(a);
  if(getsockname((int)fdv.i, (struct sockaddr*)&a, &len) < 0) return cl_int(-1);
  return cl_int((long)ntohs(a.sin_port));
}

static Value cl_tcp_accept(Value fdv){
  int c = accept((int)fdv.i, 0, 0);
  return cl_int(c < 0 ? -1 : c);
}

static Value cl_tcp_connect(Value hostv, Value portv){
  cl_sock_init();
  char port[16];
  snprintf(port, sizeof(port), "%ld", portv.i);
  struct addrinfo hints, *res = 0;
  memset(&hints, 0, sizeof(hints));
  hints.ai_family = AF_INET;
  hints.ai_socktype = SOCK_STREAM;
  if(getaddrinfo(hostv.s, port, &hints, &res) != 0 || !res) return cl_int(-1);
  int fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
  if(fd < 0){ freeaddrinfo(res); return cl_int(-1); }
  if(connect(fd, res->ai_addr, res->ai_addrlen) < 0){ close(fd); freeaddrinfo(res); return cl_int(-1); }
  freeaddrinfo(res);
  return cl_int(fd);
}

/* Send a string or a list of byte values. Loops until the whole buffer is
   gone: a single send() is free to accept only part of it, and treating a
   short write as success is the classic way to lose the tail of a request. */
static Value cl_tcp_send(Value fdv, Value data){
  const unsigned char* buf = 0;
  unsigned char* tmp = 0;
  size_t n = 0;
  if(data.t == T_STR){ buf = (const unsigned char*)data.s; n = strlen(data.s); }
  else if(data.t == T_LIST){
    List* l = (List*)data.o;
    n = (size_t)l->len;
    tmp = (unsigned char*)cl_alloc(n ? n : 1);
    for(long j=0;j<l->len;j++) tmp[j] = (unsigned char)(l->items[j].i & 0xFF);
    buf = tmp;
  } else return cl_int(-1);
  size_t sent = 0;
  while(sent < n){
    ssize_t k = send((int)fdv.i, buf + sent, n - sent, 0);
    if(k <= 0){ if(errno == EINTR) continue; return cl_int(sent ? (long)sent : -1); }
    sent += (size_t)k;
  }
  return cl_int((long)sent);
}

/* Up to `max` bytes, as they arrive — one recv, not a fill loop, because the
   caller is the only one who knows where a message ends. An empty list means
   the peer closed or the read failed. */
static Value cl_tcp_recv(Value fdv, Value maxv){
  Value out = cl_list_new();
  long max = maxv.i;
  if(max <= 0) return out;
  unsigned char* buf = (unsigned char*)cl_alloc((size_t)max);
  ssize_t k;
  do { k = recv((int)fdv.i, buf, (size_t)max, 0); } while(k < 0 && errno == EINTR);
  if(k <= 0) return out;
  for(ssize_t i=0;i<k;i++) cl_list_add(out, cl_int((long)buf[i]));
  return out;
}

static Value cl_tcp_close(Value fdv){
  if(fdv.i >= 0) close((int)fdv.i);
  return cl_null();
}

/* read_mem(pid, addr, len): read `len` bytes of another process's virtual
   memory at address `addr`, as a list of ints 0..255 (like read_bytes). pid<=0
   means this process (/proc/self/mem). Linux only — on macOS/anywhere without
   /proc, or on an unreadable region / permission failure, it returns the bytes
   it managed to read (empty on total failure) rather than aborting: the same
   friendly behaviour read_bytes gives a compiled tool. Addresses come in as a
   number (int or double); doubles are exact through 2^53, covering the 48-bit
   userspace address space. */
static Value cl_read_mem(Value pidv, Value addrv, Value lenv){
  Value out=cl_list_new();
  long pid=(long)cl_num(pidv);
  unsigned long long addr=(unsigned long long)cl_num(addrv);
  long len=(long)cl_num(lenv); if(len<=0) return out;
  char path[64];
  if(pid>0) snprintf(path, sizeof(path), "/proc/%ld/mem", pid);
  else snprintf(path, sizeof(path), "/proc/self/mem");
  int fd=open(path, O_RDONLY); if(fd<0) return out;
  unsigned char* buf=(unsigned char*)cl_alloc((size_t)len);
  ssize_t n=pread(fd, buf, (size_t)len, (off_t)addr);
  close(fd);
  if(n>0){ for(ssize_t i=0;i<n;i++) cl_list_add(out, cl_int((long)buf[i])); }
  return out;
}
/* write_mem(pid, addr, bytes): write a list of bytes (each & 0xFF) into another
   process's memory at `addr` via /proc/<pid>/mem (pid<=0 = self). Returns the
   number of bytes written (0 on any failure — no /proc, unwritable page, no
   ptrace permission). The target page must be writable; writing self needs no
   special privilege, writing another process needs ptrace permission. */
static Value cl_write_mem(Value pidv, Value addrv, Value lv){
  if(lv.t!=T_LIST) return cl_int(0);
  List* l=(List*)lv.o; long n=l->len; if(n<=0) return cl_int(0);
  long pid=(long)cl_num(pidv);
  unsigned long long addr=(unsigned long long)cl_num(addrv);
  unsigned char* buf=(unsigned char*)cl_alloc((size_t)n);
  for(long i=0;i<n;i++) buf[i]=(unsigned char)(((long)cl_num(l->items[i])) & 0xFF);
  char path[64];
  if(pid>0) snprintf(path, sizeof(path), "/proc/%ld/mem", pid);
  else snprintf(path, sizeof(path), "/proc/self/mem");
  int fd=open(path, O_RDWR); if(fd<0) return cl_int(0);
  ssize_t w=pwrite(fd, buf, (size_t)n, (off_t)addr);
  close(fd);
  if(w<0) return cl_int(0);
  return cl_int((long)w);
}
#endif /* !CLARITY_FREESTANDING */

/* ── builtin methods on a list, a string and a number ──
   `xs.sort()`, `text.split(" ")`, `n.abs()`. These are methods in the
   interpreter, and every one of them answered null here: cl_dispatch looked
   only for a user class's method and found none. The set and the errors are
   the interpreter's. */
static Value cl_bm_index_of(Value c, Value v){
  if(c.t==T_LIST){ List* l=(List*)c.o; for(long j=0;j<l->len;j++) if(cl_equal(l->items[j], v)) return cl_int(j); return cl_int(-1); }
  return cl_index_of(c, v);
}
static Value cl_bm_list_slice(Value c, Value* a, long n){
  List* l=(List*)c.o;
  long start = n > 0 ? (long)cl_num(a[0]) : 0;
  long stop  = (n > 1 && a[1].t != T_NULL) ? (long)cl_num(a[1]) : l->len;
  Value out = cl_list_new();
  for(long j=start; j<stop && j<l->len; j++) if(j>=0) out = cl_list_add(out, l->items[j]);
  return out;
}
static Value cl_bm_arg(Value* a, long n, long i){ return i < n ? a[i] : cl_null(); }
static Value cl_builtin_method(Value self, const char* m, Value* a, long n){
  char buf[160];
  if(self.t==T_LIST){
    if(!strcmp(m,"length") || !strcmp(m,"count")) return cl_int(cl_length(self));
    if(!strcmp(m,"push")) return cl_list_add(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"pop")) return cl_pop(self);
    if(!strcmp(m,"first")){ List* l=(List*)self.o; return l->len ? l->items[0] : cl_null(); }
    if(!strcmp(m,"last")){ List* l=(List*)self.o; return l->len ? l->items[l->len-1] : cl_null(); }
    if(!strcmp(m,"reverse")) return cl_reverse(self);
    if(!strcmp(m,"sort")) return cl_sort(self);
    if(!strcmp(m,"join")) return cl_str_join(self, n > 0 ? a[0] : cl_str(""));
    if(!strcmp(m,"contains")) return cl_contains(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"empty")) return cl_bool(cl_length(self)==0);
    if(!strcmp(m,"slice")) return cl_bm_list_slice(self, a, n);
    if(!strcmp(m,"index")) return cl_bm_index_of(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"copy")) return cl_bm_list_slice(self, 0, 0);
    snprintf(buf, sizeof buf, "RuntimeError: List has no property '%s'", m);
    cl_throw(cl_str(cl_strdup(buf)));
  }
  if(self.t==T_STR){
    if(!strcmp(m,"length") || !strcmp(m,"count")) return cl_int((long)strlen(self.s));
    if(!strcmp(m,"upper")) return cl_upper(self);
    if(!strcmp(m,"lower")) return cl_lower(self);
    if(!strcmp(m,"trim")) return cl_trim(self);
    if(!strcmp(m,"split")) return cl_str_split(self, n > 0 ? a[0] : cl_str(" "));
    if(!strcmp(m,"replace")) return cl_replace(self, cl_bm_arg(a,n,0), cl_bm_arg(a,n,1));
    if(!strcmp(m,"contains")) return cl_contains(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"starts")) return cl_starts(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"ends")) return cl_ends(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"chars")) return cl_chars(self);
    if(!strcmp(m,"reverse")) return cl_reverse(self);
    if(!strcmp(m,"empty")) return cl_bool(strlen(self.s)==0);
    if(!strcmp(m,"slice")){
      long start = n > 0 ? (long)cl_num(a[0]) : 0;
      long stop  = (n > 1 && a[1].t != T_NULL) ? (long)cl_num(a[1]) : (long)strlen(self.s);
      return cl_substr(self, start, stop);
    }
    if(!strcmp(m,"find")) return cl_index_of(self, cl_bm_arg(a,n,0));
    if(!strcmp(m,"repeat")) return cl_str_repeat(self, n > 0 ? (long)cl_num(a[0]) : 0);
    snprintf(buf, sizeof buf, "RuntimeError: String has no property '%s'", m);
    cl_throw(cl_str(cl_strdup(buf)));
  }
  if(cl_is_num(self)){
    if(!strcmp(m,"abs")) return cl_abs(self);
    if(!strcmp(m,"str")) return cl_str(cl_to_cstr(self));
    snprintf(buf, sizeof buf, "RuntimeError: Number has no property '%s'", m);
    cl_throw(cl_str(cl_strdup(buf)));
  }
  return cl_null();
}
static int cl_has_builtin_methods(Value v){
  return v.t==T_LIST || v.t==T_STR || cl_is_num(v);
}
/* Is `name` one of them? Asked before binding, so an unknown name raises the
   interpreter's error at the mention rather than at the call. */
static int cl_bm_known(Value v, const char* m){
  static const char* list_m[] = {"length","count","push","pop","first","last","reverse","sort","join","contains","empty","slice","index","copy",0};
  static const char* str_m[]  = {"length","count","upper","lower","trim","split","replace","contains","starts","ends","chars","reverse","empty","slice","find","repeat",0};
  static const char* num_m[]  = {"abs","str",0};
  const char** t = v.t==T_LIST ? list_m : (v.t==T_STR ? str_m : num_m);
  for(int i=0; t[i]; i++) if(!strcmp(t[i], m)) return 1;
  return 0;
}
/* `let f = text.upper` binds the method to its receiver, so f() is
   text.upper(). The receiver and the name travel in the closure's captures. */
static Value cl_bm_thunk(Value* args, Value* cap, long n){
  return cl_builtin_method(cap[0], cap[1].s, args, n);
}
static Value cl_bound_builtin_method(Value self, const char* name){
  Value cap[2]; cap[0]=self; cap[1]=cl_str(name);
  return cl_closure_new(&cl_bm_thunk, cap, 2);
}

/* ── app stdlib: process/env ── */
static Value cl_env(Value kv, Value dv){ const char* v=getenv(kv.s); if(v) return cl_str(cl_strdup(v)); return dv; }
static Value cl_args(void){ Value out=cl_list_new(); for(int i=1;i<cl_argc;i++) cl_list_add(out, cl_str(cl_argv[i])); return out; }
#ifndef CLARITY_FREESTANDING
/* Excluded by the freestanding profile — process control and the clock: popen/fork/execl/waitpid/nanosleep/
   clock_gettime. */

/* ── app stdlib: exec / process ── */
/* exec(cmd): run via the shell, return stdout with one trailing newline
   stripped (matches the interpreter). */
static Value cl_exec(Value cmdv){
  FILE* p=popen(cmdv.s, "r"); if(!p) return cl_str("");
  char* out=(char*)cl_alloc(1); out[0]=0; char buf[4096]; size_t n;
  while((n=fread(buf, 1, sizeof(buf)-1, p))>0){ buf[n]=0; out=cl_cat(out, buf); }
  pclose(p);
  size_t L=strlen(out); if(L>0 && out[L-1]=='\n') out[L-1]=0;
  return cl_str(out);
}
/* exec_full(cmd): fork + two pipes, capture stdout/stderr separately and the
   exit code, return { stdout, stderr, exit_code }. */
static Value cl_exec_full(Value cmdv){
  int op[2], ep[2]; Value m=cl_map_new();
  if(pipe(op) || pipe(ep)){ cl_map_put(m, "stdout", cl_str("")); cl_map_put(m, "stderr", cl_str("")); cl_map_put(m, "exit_code", cl_int(1)); return m; }
  pid_t pid=fork();
  if(pid==0){ dup2(op[1], 1); dup2(ep[1], 2); close(op[0]); close(op[1]); close(ep[0]); close(ep[1]); execl("/bin/sh", "sh", "-c", cmdv.s, (char*)0); _exit(127); }
  close(op[1]); close(ep[1]);
  char* so=(char*)cl_alloc(1); so[0]=0; char* se=(char*)cl_alloc(1); se[0]=0; char buf[4096]; ssize_t n;
  while((n=read(op[0], buf, sizeof(buf)-1))>0){ buf[n]=0; so=cl_cat(so, buf); }
  while((n=read(ep[0], buf, sizeof(buf)-1))>0){ buf[n]=0; se=cl_cat(se, buf); }
  close(op[0]); close(ep[0]);
  int status=0; waitpid(pid, &status, 0);
  int code = WIFEXITED(status) ? WEXITSTATUS(status) : 1;
  cl_map_put(m, "stdout", cl_str(so)); cl_map_put(m, "stderr", cl_str(se)); cl_map_put(m, "exit_code", cl_int(code));
  return m;
}
static Value cl_sleep(Value sv){ double s=cl_num(sv); struct timespec ts; ts.tv_sec=(time_t)s; ts.tv_nsec=(long)((s-(double)ts.tv_sec)*1e9); nanosleep(&ts, 0); return cl_null(); }
static Value cl_time(void){ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return cl_float((double)ts.tv_sec + (double)ts.tv_nsec/1e9); }
#endif /* !CLARITY_FREESTANDING */

/* ── app stdlib: math ── */
static Value cl_abs(Value v){ if(v.t==T_FLOAT) return cl_float(fabs(v.f)); return cl_int(v.i<0 ? -v.i : v.i); }
static Value cl_floor(Value v){ return cl_int((long)floor(cl_num(v))); }
static Value cl_ceil(Value v){ return cl_int((long)ceil(cl_num(v))); }
static Value cl_round1(Value v){ return cl_int((long)floor(cl_num(v)+0.5)); }  /* round half up, like Math.round */
static Value cl_round2(Value v, Value d){ double f=pow(10.0, (double)d.i); return cl_float(floor(cl_num(v)*f+0.5)/f); }
static Value cl_sqrt(Value v){ return cl_float(sqrt(cl_num(v))); }
static Value cl_sin(Value v){ return cl_float(sin(cl_num(v))); }
static Value cl_cos(Value v){ return cl_float(cos(cl_num(v))); }
static Value cl_tan(Value v){ return cl_float(tan(cl_num(v))); }
static Value cl_log(Value v){ return cl_float(log(cl_num(v))); }
static Value cl_sum(Value lv){ List* l=(List*)lv.o; int isf=0; for(long j=0;j<l->len;j++) if(l->items[j].t==T_FLOAT) isf=1; if(isf){ double a=0; for(long j=0;j<l->len;j++) a+=cl_num(l->items[j]); return cl_float(a); } long a=0; for(long j=0;j<l->len;j++) a+=l->items[j].i; return cl_int(a); }
static Value cl_min2(Value a, Value b){ return cl_num(a)<=cl_num(b) ? a : b; }
static Value cl_max2(Value a, Value b){ return cl_num(a)>=cl_num(b) ? a : b; }
static Value cl_min_list(Value lv){ List* l=(List*)lv.o; if(l->len==0) return cl_null(); Value m=l->items[0]; for(long j=1;j<l->len;j++) if(cl_num(l->items[j])<cl_num(m)) m=l->items[j]; return m; }
static Value cl_max_list(Value lv){ List* l=(List*)lv.o; if(l->len==0) return cl_null(); Value m=l->items[0]; for(long j=1;j<l->len;j++) if(cl_num(l->items[j])>cl_num(m)) m=l->items[j]; return m; }

/* ── app stdlib: JSON ── */
/* amortized-O(n) string builder over arena memory */
typedef struct { char* buf; size_t len; size_t cap; } SB;
static void sb_init(SB* s){ s->cap=16; s->len=0; s->buf=(char*)cl_alloc(s->cap); s->buf[0]=0; }
static void sb_putc(SB* s, char c){ if(s->len+2>s->cap){ s->cap*=2; char* nb=(char*)cl_alloc(s->cap); memcpy(nb, s->buf, s->len); s->buf=nb; } s->buf[s->len++]=c; s->buf[s->len]=0; }
static void sb_puts(SB* s, const char* t){ while(*t) sb_putc(s, *t++); }

static Value j_value(const char** pp);
static void j_ws(const char** pp){ const char* p=*pp; while(*p==' '||*p=='\t'||*p=='\n'||*p=='\r') p++; *pp=p; }
static Value j_string(const char** pp){
  const char* p=*pp; p++;                          /* opening quote */
  SB s; sb_init(&s);
  while(*p && *p!='"'){
    if(*p=='\\'){
      p++; char c=*p++;
      if(c=='n') sb_putc(&s, '\n'); else if(c=='t') sb_putc(&s, '\t'); else if(c=='r') sb_putc(&s, '\r');
      else if(c=='b') sb_putc(&s, '\b'); else if(c=='f') sb_putc(&s, '\f');
      else if(c=='u'){
        int cp=0; for(int k=0;k<4 && *p;k++){ char h=*p++; cp=cp*16 + (h<='9'?h-'0':(tolower((unsigned char)h)-'a'+10)); }
        if(cp<0x80){ sb_putc(&s, (char)cp); }
        else if(cp<0x800){ sb_putc(&s, (char)(0xC0|(cp>>6))); sb_putc(&s, (char)(0x80|(cp&0x3F))); }
        else { sb_putc(&s, (char)(0xE0|(cp>>12))); sb_putc(&s, (char)(0x80|((cp>>6)&0x3F))); sb_putc(&s, (char)(0x80|(cp&0x3F))); }
      }
      else sb_putc(&s, c);                          /* " \ / and any other */
    } else sb_putc(&s, *p++);
  }
  if(*p=='"') p++;
  *pp=p; return cl_str(s.buf);
}
static Value j_number(const char** pp){
  const char* p=*pp; const char* start=p; int isf=0;
  if(*p=='-') p++;
  while(isdigit((unsigned char)*p)) p++;
  if(*p=='.'){ isf=1; p++; while(isdigit((unsigned char)*p)) p++; }
  if(*p=='e'||*p=='E'){ isf=1; p++; if(*p=='+'||*p=='-') p++; while(isdigit((unsigned char)*p)) p++; }
  char tmp[64]; size_t L=(size_t)(p-start); if(L>63) L=63; memcpy(tmp, start, L); tmp[L]=0;
  *pp=p; return isf ? cl_float(strtod(tmp, 0)) : cl_int(strtol(tmp, 0, 10));
}
static Value j_value(const char** pp){
  j_ws(pp); const char* p=*pp; char c=*p;
  if(c=='"') return j_string(pp);
  if(c=='{'){
    p++; Value m=cl_map_new(); *pp=p; j_ws(pp); p=*pp;
    if(*p=='}'){ *pp=p+1; return m; }
    while(1){
      j_ws(pp); Value k=j_string(pp); j_ws(pp); p=*pp; if(*p==':'){ p++; *pp=p; }
      Value v=j_value(pp); cl_map_put(m, (char*)k.s, v); j_ws(pp); p=*pp;
      if(*p==','){ *pp=p+1; continue; }
      if(*p=='}'){ *pp=p+1; }
      break;
    }
    return m;
  }
  if(c=='['){
    p++; Value a=cl_list_new(); *pp=p; j_ws(pp); p=*pp;
    if(*p==']'){ *pp=p+1; return a; }
    while(1){
      Value v=j_value(pp); cl_list_add(a, v); j_ws(pp); p=*pp;
      if(*p==','){ *pp=p+1; continue; }
      if(*p==']'){ *pp=p+1; }
      break;
    }
    return a;
  }
  if(c=='t'){ *pp=p+4; return cl_bool(1); }
  if(c=='f'){ *pp=p+5; return cl_bool(0); }
  if(c=='n'){ *pp=p+4; return cl_null(); }
  if(c=='-' || isdigit((unsigned char)c)) return j_number(pp);
  return cl_null();
}
static Value cl_json_parse(Value sv){ const char* p=sv.s; return j_value(&p); }

static void j_ser(SB* s, Value v);
static void j_ser_str(SB* s, const char* str){
  sb_putc(s, '"');
  for(const char* p=str; *p; p++){
    char c=*p;
    if(c=='"') sb_puts(s, "\\\"");
    else if(c=='\\') sb_puts(s, "\\\\");
    else if(c=='\n') sb_puts(s, "\\n");
    else if(c=='\t') sb_puts(s, "\\t");
    else if(c=='\r') sb_puts(s, "\\r");
    else sb_putc(s, c);
  }
  sb_putc(s, '"');
}
static void j_ser(SB* s, Value v){
  if(v.t==T_NULL){ sb_puts(s, "null"); return; }
  if(v.t==T_BOOL){ sb_puts(s, v.i ? "true" : "false"); return; }
  if(v.t==T_INT || v.t==T_FLOAT){ sb_puts(s, cl_to_cstr(v)); return; }
  if(v.t==T_STR){ j_ser_str(s, v.s); return; }
  if(v.t==T_LIST){ List* l=(List*)v.o; sb_putc(s, '['); for(long j=0;j<l->len;j++){ if(j) sb_putc(s, ','); j_ser(s, l->items[j]); } sb_putc(s, ']'); return; }
  if(v.t==T_MAP){ Map* m=(Map*)v.o; sb_putc(s, '{'); for(long j=0;j<m->len;j++){ if(j) sb_putc(s, ','); j_ser_str(s, m->keys[j]); sb_putc(s, ':'); j_ser(s, m->vals[j]); } sb_putc(s, '}'); return; }
  sb_puts(s, "null");
}
static Value cl_json_string(Value v){ SB s; sb_init(&s); j_ser(&s, v); return cl_str(s.buf); }

#ifndef CLARITY_FREESTANDING
/* Excluded by the freestanding profile — native FFI: dlopen/dlsym. There is no dynamic loader on a target that
   has no operating system. */
/* ── app stdlib: native FFI (dlopen/dlsym) ── */
/* ffi_open(path): dlopen a shared library so its symbols become resolvable by
   ffi_sym/ffi_call. RTLD_GLOBAL folds them into the global scope that
   RTLD_DEFAULT searches, so after ffi_open("libm.so.6") a plain
   ffi_call("pow", …) works even though the program never referenced libm
   directly (the --as-needed case ffi_sym alone couldn't reach). Returns the
   library handle as an int (0 on failure). */
static Value cl_ffi_open(Value pathv){
  if(pathv.t!=T_STR) return cl_int(0);
  void* h = dlopen(pathv.s, RTLD_NOW | RTLD_GLOBAL);
  return cl_int((long)h);
}
/* Raw native buffers for FFI: pass a pointer to a C function that reads/writes
   through it (an out-param, a struct, a byte region), then marshal the result
   back. Kept off the GC heap (malloc/free) so a library may hold the pointer. */
static Value cl_ffi_buffer(Value nv){ long n=(long)cl_num(nv); if(n<=0) return cl_int(0); void* p=calloc(1,(size_t)n); return cl_int((long)p); }
static Value cl_ffi_read(Value pv, Value nv){ Value out=cl_list_new(); unsigned char* p=(unsigned char*)(long)cl_num(pv); long n=(long)cl_num(nv); if(!p||n<=0) return out; for(long i=0;i<n;i++) cl_list_add(out, cl_int((long)p[i])); return out; }
static Value cl_ffi_write(Value pv, Value lv){ unsigned char* p=(unsigned char*)(long)cl_num(pv); if(!p||lv.t!=T_LIST) return cl_int(0); List* l=(List*)lv.o; for(long i=0;i<l->len;i++) p[i]=(unsigned char)(((long)cl_num(l->items[i]))&0xFF); return cl_int(l->len); }
static Value cl_ffi_free(Value pv){ void* p=(void*)(long)cl_num(pv); if(p) free(p); return cl_null(); }
/* ffi_sym(name): raw address of a symbol in the process (RTLD_DEFAULT covers
   libc/libm and anything linked or dlopen'd), as an int (0 if not found). */
static Value cl_ffi_sym(Value namev){ return cl_int((long)dlsym(RTLD_DEFAULT, namev.s)); }
/* ffi_call(name, sig, args): resolve `name` and call it through a typed shim.
   `sig` is <ret><args>: l=long/int, d=double, s=cstring, v=void. Returns an int
   (l), float (d), fresh string (s return), or null (void / unknown sig).
   RTLD_DEFAULT resolves any symbol in a *loaded* library. libc is always
   loaded, so its symbols (strlen/abs/toupper/…) always resolve; a symbol from a
   library the program never otherwise references (e.g. libm's pow under the
   linker's default --as-needed) won't be loaded — an explicit ffi_open(path)
   for such libraries is a follow-up. Unknown symbol → null. */
static Value cl_ffi_call(Value namev, Value sigv, Value argsv){
  void* fp = dlsym(RTLD_DEFAULT, namev.s);
  if(!fp) return cl_null();
  const char* sig = sigv.s;
  List* l = (argsv.t==T_LIST) ? (List*)argsv.o : (List*)0;
  long n = l ? l->len : 0;
  int has_float = 0; for(const char* c=sig; *c; c++) if(*c=='d') has_float=1;
  /* Generic word-argument path: any mix of l (long/int), p (pointer/address),
     and s (cstring) args. On the SysV-x86-64 and AArch64 integer-register ABIs
     these all pass as machine words in the same registers, and surplus
     prototype args are harmless, so one 6-word prototype calls any such
     function — that's what pointer-heavy C libraries (Capstone, zlib, …) need.
     Return per the sig's first char: l/p -> int (address for p), s -> fresh
     string, v -> null. Float args keep the dedicated prototypes below (they use
     a different register class). Not for variadic callees. */
  if(!has_float){
    long w[6] = {0,0,0,0,0,0};
    char rc = sig[0] ? sig[0] : 'v';
    int ai = 0;
    for(const char* c = sig[0] ? sig+1 : sig; *c && ai < 6; c++, ai++){
      Value it = (ai < n && l) ? l->items[ai] : cl_null();
      if(*c=='s') w[ai] = (long)(it.t==T_STR ? it.s : "");
      else        w[ai] = (long)(long long)cl_num(it);   /* l or p: value/address */
    }
    long ret = ((long(*)(long,long,long,long,long,long))fp)(w[0],w[1],w[2],w[3],w[4],w[5]);
    if(rc=='v') return cl_null();
    if(rc=='s') return ret ? cl_str(cl_strdup((char*)ret)) : cl_null();
    return cl_int(ret);   /* l or p */
  }
  double d0 = n>0 ? cl_num(l->items[0]) : 0.0, d1 = n>1 ? cl_num(l->items[1]) : 0.0;
  if(!strcmp(sig, "d"))    return cl_float(((double(*)(void))fp)());
  if(!strcmp(sig, "dd"))   return cl_float(((double(*)(double))fp)(d0));
  if(!strcmp(sig, "ddd"))  return cl_float(((double(*)(double,double))fp)(d0, d1));
  return cl_null();
}
#endif /* !CLARITY_FREESTANDING */

static void cl_show(Value v){ char* s=cl_display(v); printf("%s\n", s); }
/* `show a, b` is one line with a space between the values. */
static void cl_show_all(Value* vs, long n){
  for(long i=0;i<n;i++){ if(i) printf(" "); printf("%s", cl_display(vs[i])); }
  printf("\n");
}
"""

-- ── Helpers ─────────────────────────────────────────────

-- Statement list of a block. Parsed bodies (if/while/fn) are Block nodes
-- carrying `.statements`; tolerate a bare list or null too.
-- Does this statement list contain a try anywhere inside it? Decides whether
-- a function's locals need volatile storage: C leaves a non-volatile local of
-- the function containing a setjmp indeterminate if the try modifies it.
-- Closures are their own C functions and are checked separately when emitted.
-- Does this statement list yield anywhere in it? A nested `fn` is its own
-- call with its own collection, so a yield inside one belongs to it, not to
-- the function being scanned — the same rule the interpreter follows by
-- saving and restoring the collection around every call.
fn _has_yield(stmts) {
    for s in stmts {
        if _stmt_yields(s) { return true }
    }
    return false
}

fn _stmt_yields(s) {
    let nt = s.node_type
    if nt == "ExpressionStatement" { return _expr_yields(s.expression) }
    if nt == "LetStatement" { return s.value != null and _expr_yields(s.value) }
    if nt == "AssignStatement" { return s.value != null and _expr_yields(s.value) }
    if nt == "ReturnStatement" { return s.value != null and _expr_yields(s.value) }
    if nt == "ShowStatement" {
        for v in s.values { if _expr_yields(v) { return true } }
        return false
    }
    if nt == "ThrowStatement" { return s.value != null and _expr_yields(s.value) }
    if nt == "IfStatement" {
        if _expr_yields(s.condition) { return true }
        if _has_yield(_block_stmts(s.body)) { return true }
        if s.elif_clauses != null {
            for clause in s.elif_clauses {
                if _expr_yields(clause[0]) { return true }
                if _has_yield(_block_stmts(clause[1])) { return true }
            }
        }
        if s.else_body != null and _has_yield(_block_stmts(s.else_body)) { return true }
        return false
    }
    if nt == "WhileStatement" {
        if _expr_yields(s.condition) { return true }
        return _has_yield(_block_stmts(s.body))
    }
    if nt == "ForStatement" {
        if _expr_yields(s.iterable) { return true }
        return _has_yield(_block_stmts(s.body))
    }
    if nt == "TryCatch" {
        if _has_yield(_block_stmts(s.try_body)) { return true }
        if s.catch_body != null and _has_yield(_block_stmts(s.catch_body)) { return true }
        if s.finally_body != null and _has_yield(_block_stmts(s.finally_body)) { return true }
        return false
    }
    if nt == "MatchStatement" {
        if _expr_yields(s.subject) { return true }
        -- An arm is [pattern, body]; the fallback arm is `default`, not
        -- `else_body` — reading the wrong name is a runtime error now that a
        -- missing property throws rather than answering null.
        for arm in s.arms { if _has_yield(_block_stmts(arm[1])) { return true } }
        if s.default != null and _has_yield(_block_stmts(s.default)) { return true }
        return false
    }
    if nt == "Block" { return _has_yield(_block_stmts(s)) }
    return false
}

fn _expr_yields(e) {
    if e == null { return false }
    let nt = e.node_type
    if nt == "YieldExpression" { return true }
    -- A nested function is a separate call: its yields are its own.
    if nt == "FnExpression" { return false }
    if nt == "BinaryOp" { return _expr_yields(e.left) or _expr_yields(e.right) }
    if nt == "UnaryOp" { return _expr_yields(e.operand) }
    if nt == "CallExpression" {
        if _expr_yields(e.callee) { return true }
        for a in e.arguments { if _expr_yields(a) { return true } }
        return false
    }
    if nt == "ListLiteral" {
        for el in e.elements { if _expr_yields(el) { return true } }
        return false
    }
    if nt == "MapLiteral" {
        for pair in e.pairs {
            if pair[0] != null and _expr_yields(pair[0]) { return true }
            if _expr_yields(pair[1]) { return true }
        }
        return false
    }
    if nt == "RangeExpression" {
        if _expr_yields(e.start) { return true }
        return e.end != null and _expr_yields(e.end)
    }
    if nt == "SpreadExpression" { return _expr_yields(e.value) }
    if nt == "IndexExpression" { return _expr_yields(e.object) or _expr_yields(e.index) }
    if nt == "MemberExpression" { return _expr_yields(e.object) }
    if nt == "IfExpression" {
        return _expr_yields(e.condition) or _expr_yields(e.true_expr) or _expr_yields(e.false_expr)
    }
    if nt == "NullCoalesce" { return _expr_yields(e.left) or _expr_yields(e.right) }
    if nt == "PipeExpression" { return _expr_yields(e.value) or _expr_yields(e.function) }
    return false
}

fn _has_try(stmts) {
    for s in stmts {
        let nt = s.node_type
        if nt == "TryCatch" { return true }
        if nt == "IfStatement" {
            if _has_try(_block_stmts(s.body)) { return true }
            if s.elif_clauses != null {
                for clause in s.elif_clauses { if _has_try(_block_stmts(clause[1])) { return true } }
            }
            if s.else_body != null and _has_try(_block_stmts(s.else_body)) { return true }
        }
        if nt == "WhileStatement" or nt == "ForStatement" {
            if _has_try(_block_stmts(s.body)) { return true }
        }
        if nt == "MatchStatement" {
            for arm in s.arms { if _has_try(_block_stmts(arm[1])) { return true } }
            if s.default != null and _has_try(_block_stmts(s.default)) { return true }
        }
        if nt == "Block" { if _has_try(_block_stmts(s)) { return true } }
    }
    return false
}

fn _block_stmts(b) {
    if b == null { return [] }
    try { return b.statements } catch e {}
    return b
}

-- An expression whose evaluation nothing else can observe: a literal, a name,
-- or something built only out of those. Anything that can call something —
-- a call, a pipe, a yield, an `ask` — may have a side effect, and an operand
-- that merely *reads* a variable is affected by one that writes it, so a
-- single impure operand makes a whole list order-sensitive.
--
-- Unknown node types answer false, which is the safe direction: the cost of
-- being wrong is a temporary that was not needed.
fn _pure_expr(e) {
    if e == null { return true }
    let nt = e.node_type
    if nt == "NumberLiteral" or nt == "StringLiteral" or nt == "BoolLiteral" or nt == "NullLiteral" { return true }
    if nt == "Identifier" or nt == "ThisExpression" { return true }
    -- Making a closure has no effect; calling one does, and that is a
    -- CallExpression.
    if nt == "FnExpression" { return true }
    if nt == "UnaryOp" { return _pure_expr(e.operand) }
    if nt == "BinaryOp" { return _pure_expr(e.left) and _pure_expr(e.right) }
    if nt == "MemberExpression" { return _pure_expr(e.object) }
    if nt == "IndexExpression" { return _pure_expr(e.object) and _pure_expr(e.index) }
    if nt == "NullCoalesce" { return _pure_expr(e.left) and _pure_expr(e.right) }
    if nt == "IfExpression" {
        return _pure_expr(e.condition) and _pure_expr(e.true_expr) and _pure_expr(e.false_expr)
    }
    if nt == "RangeExpression" {
        if not _pure_expr(e.start) { return false }
        return e.end == null or _pure_expr(e.end)
    }
    if nt == "ListLiteral" {
        for el in e.elements { if not _pure_expr(el) { return false } }
        return true
    }
    if nt == "MapLiteral" {
        for pair in e.pairs {
            if pair[0] != null and not _pure_expr(pair[0]) { return false }
            if not _pure_expr(pair[1]) { return false }
        }
        return true
    }
    return false
}

-- Does the order these operands are evaluated in matter? One of them has to
-- be able to change something the others can see.
fn _order_matters(nodes) {
    if len(nodes) < 2 { return false }
    for n in nodes { if not _pure_expr(n) { return true } }
    return false
}

-- Split a string literal's text into the pieces the interpreter would build
-- it from: literal text, and expressions to evaluate and display. Returns
-- null when there is nothing to interpolate, so the caller emits a plain C
-- string literal.
--
-- The rules are Interpreter._interpolate_string's, to the character: `{X}`
-- is interpolation only when X starts with a letter or an underscore, so
-- prose like "if true { 1 } else { 2 }" survives verbatim; braces nest; an
-- unbalanced `{` is literal; an expression that does not parse stays as the
-- text it was written as, braces included; and one that parses to nothing
-- contributes nothing.
--
-- The result always begins with a literal piece, possibly empty, because
-- the concatenation has to start from a string: `"{n} apples"` is
-- `"" + n + " apples"`, and starting it at `n` would be adding a string to
-- a number rather than the other way round.
fn _interp_parts(text) {
    if index_of(text, "{") < 0 { return null }
    let text_len = len(text)
    mut parts = []
    mut literal = ""
    mut any = false
    mut i = 0
    while i < text_len {
        let ch = char_at(text, i)
        if ch == "{" and i + 1 < text_len and (is_alpha(char_at(text, i + 1)) or char_at(text, i + 1) == "_") {
            mut j = i + 1
            mut depth = 1
            while j < text_len and depth > 0 {
                if char_at(text, j) == "{" { depth += 1 }
                if char_at(text, j) == "}" { depth -= 1 }
                if depth > 0 { j += 1 }
            }
            if depth != 0 {
                literal = literal + ch
                i += 1
                continue
            }
            let expr_str = substring(text, i + 1, j)
            mut expr_node = null
            mut parsed = false
            try {
                let tree = parse(tokenize(expr_str, "<interp>"), expr_str)
                parsed = true
                if len(tree.body) > 0 { expr_node = tree.body[0].expression }
            } catch e_parse { parsed = false }
            if not parsed {
                literal = literal + "{" + expr_str + "}"
                i = j + 1
                continue
            }
            if expr_node != null {
                push(parts, { "kind": "lit", "text": literal })
                push(parts, { "kind": "expr", "node": expr_node })
                literal = ""
                any = true
            }
            i = j + 1
        } else {
            literal = literal + ch
            i += 1
        }
    }
    if not any { return null }
    if len(literal) > 0 { push(parts, { "kind": "lit", "text": literal }) }
    return parts
}

fn _c_escape(s) {
    mut out = ""
    for ch in s {
        if ch == "\"" { out = out + "\\\"" }
        elif ch == "\\" { out = out + "\\\\" }
        elif ch == "\n" { out = out + "\\n" }
        elif ch == "\t" { out = out + "\\t" }
        elif ch == "\r" { out = out + "\\r" }
        else { out = out + ch }
    }
    return out
}

let _BINOPS = {
    "+": "cl_add", "-": "cl_sub", "*": "cl_mul", "/": "cl_div", "%": "cl_mod",
    "**": "cl_pow", "==": "cl_eq", "!=": "cl_neq", "<": "cl_lt", ">": "cl_gt",
    "<=": "cl_lte", ">=": "cl_gte",
    "&": "cl_band", "|": "cl_bor", "^": "cl_bxor", "<<": "cl_shl", ">>": "cl_shr"
}

-- Names that resolve to native runtime helpers rather than a captured
-- variable — a closure never captures these.
let _NATIVE_BUILTINS = {
    "len": 1, "push": 1, "str": 1, "int": 1, "float": 1, "range": 1,
    "keys": 1, "has": 1, "contains": 1, "map": 1, "filter": 1,
    "reduce": 1, "each": 1,
    "upper": 1, "lower": 1, "trim": 1, "split": 1, "join": 1, "replace": 1,
    "starts": 1, "ends": 1, "substring": 1, "char_at": 1, "char_code": 1,
    "from_char_code": 1, "index_of": 1, "pad_left": 1, "pad_right": 1,
    "chars": 1, "repeat": 1, "is_digit": 1, "is_alpha": 1, "is_alnum": 1,
    "is_space": 1, "read": 1, "write": 1, "append": 1, "exists": 1,
    "lines": 1, "read_bytes": 1, "write_bytes": 1, "read_mem": 1, "write_mem": 1, "env": 1, "args": 1, "exit": 1,
    "exec": 1, "exec_full": 1, "sleep": 1, "time": 1,
    "abs": 1, "floor": 1, "ceil": 1, "round": 1, "sqrt": 1, "sin": 1,
    "cos": 1, "tan": 1, "log": 1, "sum": 1, "min": 1, "max": 1,
    "json_parse": 1, "json_string": 1, "type": 1,
    "ffi_open": 1, "ffi_buffer": 1, "ffi_read": 1, "ffi_write": 1, "ffi_free": 1, "ffi_sym": 1, "ffi_call": 1,
    "tcp_listen": 1, "tcp_port": 1, "tcp_accept": 1, "tcp_connect": 1,
    "tcp_send": 1, "tcp_recv": 1, "tcp_close": 1,
    -- These twenty were emitted by _builtin_call and missing here, which is
    -- not a cosmetic gap: this set is what _is_global consults to decide
    -- whether a name inside a closure is a free variable. A builtin missing
    -- from it was captured instead of called, so the closure was handed a
    -- `v_sort` that nothing declares — and the failure landed in the C
    -- compiler, on generated code, naming a variable the program never wrote.
    -- test_c_codegen cross-checks the two lists against the source now.
    "bool": 1, "cwd": 1, "decode64": 1, "display": 1, "encode64": 1, "entries": 1,
    "repr": 1,
    "every": 1, "find": 1, "flat": 1, "hash": 1, "merge": 1, "pop": 1,
    "pow": 1, "print": 1, "random": 1, "reverse": 1, "some": 1, "sort": 1,
    "unique": 1, "values": 1, "zip": 1
}

-- Builtins the freestanding profile removes. These are the ones whose C
-- helpers live behind `#ifndef CLARITY_FREESTANDING` in the prelude, so a
-- program that calls one would reach an undeclared function and fail deep in
-- the C compiler with a message about the generated file. Refusing here fails
-- at the Clarity level instead, naming the builtin and the reason.
--
-- `env` and `args` are *not* here: getenv and argv are ISO C, and a
-- freestanding host that has neither can supply a getenv returning NULL and an
-- argc of zero. `exit` likewise — <stdlib.h>, not POSIX.
let _FREESTANDING_EXCLUDED = {
    "read": "file I/O", "write": "file I/O", "append": "file I/O",
    "exists": "file I/O", "lines": "file I/O",
    "read_bytes": "file I/O", "write_bytes": "file I/O",
    "read_mem": "/proc-backed memory access", "write_mem": "/proc-backed memory access",
    "exec": "process control", "exec_full": "process control",
    "sleep": "the system clock", "time": "the system clock",
    "tcp_listen": "sockets", "tcp_port": "sockets", "tcp_accept": "sockets",
    "tcp_connect": "sockets", "tcp_send": "sockets", "tcp_recv": "sockets",
    "tcp_close": "sockets",
    "ffi_open": "dynamic loading", "ffi_buffer": "dynamic loading",
    "ffi_read": "dynamic loading", "ffi_write": "dynamic loading",
    "ffi_free": "dynamic loading", "ffi_sym": "dynamic loading",
    "ffi_call": "dynamic loading"
}

-- ── Code generator ──────────────────────────────────────

-- The variable a parameter binds. `...rest` binds `rest`; the marker says how
-- it is filled in, not what it is called. Getting this wrong made the free
-- variable analysis treat a rest parameter's own name as a capture.
fn _param_name(p) {
    let raw = if type(p) == "list" { p[0] } else { p }
    if starts(raw, "...") { return substring(raw, 3, len(raw)) }
    return raw
}

fn _raw_param(p) {
    if type(p) == "list" { return p[0] }
    return p
}

fn _is_rest(p) {
    let raw = if type(p) == "list" { p[0] } else { p }
    return starts(raw, "...")
}

class CCodegen {
    fn init() {
        this.errors = []
        this.loop_id = 0
        this.classes = []       -- known class names (for constructor calls)
        this.class_defs = {}    -- name → ClassStatement node (for inheritance)
        this.fn_names = []      -- top-level function names (call → f_name)
        this.closure_id = 0     -- next hoisted-closure id
        this.tmp_id = 0         -- next generated C temporary name
        this.fn_arity = {}      -- top-level function name → parameter count
        this.fn_rest = {}       -- those whose last parameter is a rest one
        this.fn_values = {}     -- functions referenced as values (need a thunk)
        this.local_names = []   -- names bound inside the function being emitted
        this.closure_defs = []  -- emitted closure function bodies (line lists)
        this.volatile_locals = false  -- true while emitting a function with a try
        this.in_generator = false     -- true while emitting a function whose body yields
        this.finally_stack = []       -- finally bodies enclosing the statement being emitted
        this.enums = {}         -- enum name → list of member names, in order
        this.decorated = {}     -- function name → true, when a decorator rebinds it
        this.freestanding = false     -- --freestanding: no OS underneath (see _FREESTANDING_EXCLUDED)
    }

    fn _next_closure() {
        let id = this.closure_id
        this.closure_id += 1
        return id
    }

    -- A name that needs no capture: a native builtin, a top-level function,
    -- or a class (constructor). Everything else referenced inside a closure
    -- but not bound there is a free variable captured by value.
    --
    -- Unless the enclosing function shadows it. `let lines = [...]` in a
    -- function makes `lines` that function's variable, whatever the builtin
    -- of the same name does — so a closure referring to it has to capture it
    -- like any other local. Without this check the reference was left
    -- uncaptured and the closure body named a `v_lines` nothing declared,
    -- which is a C error on generated code about a variable the program did
    -- write, just not where the compiler looked.
    fn _is_global(name) {
        if contains(this.local_names, name) { return false }
        return has(_NATIVE_BUILTINS, name) or contains(this.fn_names, name) or contains(this.classes, name)
    }

    -- Return a copy of set `s` with `name` added (sets are maps used as sets).
    fn _set_add(s, name) {
        mut r = {}
        for k in keys(s) { r[k] = true }
        r[name] = true
        return r
    }

    -- Free-variable analysis for closures. `bound` is the set of names in
    -- scope inside the closure (params, locals, loop vars); `acc` accumulates
    -- the free names (references to the enclosing scope) that must be captured.
    fn _free_expr(node, bound, acc) {
        if node == null { return }
        let nt = node.node_type
        if nt == "Identifier" {
            if not has(bound, node.name) and not this._is_global(node.name) { acc[node.name] = true }
            return
        }
        if nt == "ThisExpression" {
            if not has(bound, "this") { acc["this"] = true }
            return
        }
        if nt == "UnaryOp" { this._free_expr(node.operand, bound, acc); return }
        if nt == "NullCoalesce" {
            this._free_expr(node.left, bound, acc)
            this._free_expr(node.right, bound, acc)
            return
        }
        if nt == "IfExpression" {
            this._free_expr(node.condition, bound, acc)
            this._free_expr(node.true_expr, bound, acc)
            this._free_expr(node.false_expr, bound, acc)
            return
        }
        if nt == "BinaryOp" { this._free_expr(node.left, bound, acc); this._free_expr(node.right, bound, acc); return }
        if nt == "CallExpression" {
            this._free_expr(node.callee, bound, acc)
            for a in node.arguments { this._free_expr(a, bound, acc) }
            return
        }
        if nt == "MemberExpression" { this._free_expr(node.object, bound, acc); return }
        if nt == "IndexExpression" { this._free_expr(node.object, bound, acc); this._free_expr(node.index, bound, acc); return }
        if nt == "ListLiteral" { for el in node.elements { this._free_expr(el, bound, acc) } return }
        if nt == "MapLiteral" {
            for pair in node.pairs {
                if pair[0] != null { this._free_expr(pair[0], bound, acc) }
                this._free_expr(pair[1], bound, acc)
            }
            return
        }
        if nt == "RangeExpression" {
            this._free_expr(node.start, bound, acc)
            if node.end != null { this._free_expr(node.end, bound, acc) }
            return
        }
        if nt == "PipeExpression" {
            this._free_expr(node.value, bound, acc)
            this._free_expr(node.function, bound, acc)
            return
        }
        if nt == "SpreadExpression" { this._free_expr(node.value, bound, acc); return }
        if nt == "FnExpression" {
            mut inner = bound
            for p in node.params {
                let pn = _param_name(p)
                inner = this._set_add(inner, pn)
            }
            this._free_stmts(_block_stmts(node.body), inner, acc)
            return
        }
        -- literals and anything else: no free variables
    }

    fn _free_stmt(node, bound, acc) {
        let nt = node.node_type
        if nt == "LetStatement" { this._free_expr(node.value, bound, acc); return }
        if nt == "AssignStatement" {
            if node.target.node_type == "Identifier" {
                if not has(bound, node.target.name) and not this._is_global(node.target.name) { acc[node.target.name] = true }
            } else {
                this._free_expr(node.target, bound, acc)
            }
            this._free_expr(node.value, bound, acc)
            return
        }
        if nt == "DestructureLetStatement" { this._free_expr(node.value, bound, acc); return }
        if nt == "MultiAssignStatement" {
            for v in node.values { this._free_expr(v, bound, acc) }
            for target in node.targets {
                if target.node_type == "Identifier" {
                    if not has(bound, target.name) and not this._is_global(target.name) { acc[target.name] = true }
                } else {
                    this._free_expr(target, bound, acc)
                }
            }
            return
        }
        if nt == "ExpressionStatement" { this._free_expr(node.expression, bound, acc); return }
        if nt == "ReturnStatement" { if node.value != null { this._free_expr(node.value, bound, acc) } return }
        if nt == "ShowStatement" { for v in node.values { this._free_expr(v, bound, acc) } return }
        if nt == "IfStatement" {
            this._free_expr(node.condition, bound, acc)
            this._free_stmts(_block_stmts(node.body), bound, acc)
            if node.elif_clauses != null {
                for clause in node.elif_clauses {
                    this._free_expr(clause[0], bound, acc)
                    this._free_stmts(_block_stmts(clause[1]), bound, acc)
                }
            }
            if node.else_body != null { this._free_stmts(_block_stmts(node.else_body), bound, acc) }
            return
        }
        if nt == "TryCatch" {
            this._free_stmts(_block_stmts(node.try_body), bound, acc)
            let inner = if node.catch_var != null { this._set_add(bound, node.catch_var) } else { bound }
            if node.catch_body != null { this._free_stmts(_block_stmts(node.catch_body), inner, acc) }
            if node.finally_body != null { this._free_stmts(_block_stmts(node.finally_body), bound, acc) }
            return
        }
        if nt == "ThrowStatement" { this._free_expr(node.value, bound, acc); return }
        if nt == "MatchStatement" {
            this._free_expr(node.subject, bound, acc)
            for arm in node.arms {
                this._free_expr(arm[0], bound, acc)
                this._free_stmts(_block_stmts(arm[1]), bound, acc)
            }
            if node.default != null { this._free_stmts(_block_stmts(node.default), bound, acc) }
            return
        }
        if nt == "WhileStatement" {
            this._free_expr(node.condition, bound, acc)
            this._free_stmts(_block_stmts(node.body), bound, acc)
            return
        }
        if nt == "ForStatement" {
            this._free_expr(node.iterable, bound, acc)
            let inner = this._set_add(bound, node.variable)
            this._free_stmts(_block_stmts(node.body), inner, acc)
            return
        }
        -- break/continue/nested fn declarations: nothing to capture here
    }

    -- Walk a statement list, threading `bound` so a `let` is in scope for the
    -- statements that follow it.
    fn _free_stmts(stmts, bound, acc) {
        mut b = bound
        for s in stmts {
            this._free_stmt(s, b, acc)
            if s.node_type == "LetStatement" { b = this._set_add(b, s.name) }
            -- A pattern binds every name in it, so what follows must not
            -- capture them: without this a closure containing `let [a, b] = xs`
            -- took a and b from its capture array *and* declared them, which
            -- the C compiler rightly called a redefinition.
            if s.node_type == "DestructureLetStatement" {
                for target in s.targets {
                    if starts(target, "...") { b = this._set_add(b, substring(target, 3, len(target))) }
                    else { b = this._set_add(b, target) }
                }
            }
        }
    }

    -- Compile a `fn(...) {...}` expression: hoist it to a top-level C function
    -- and snapshot its free variables by value into a capture array. Returns
    -- the `cl_closure_new(...)` expression that builds the closure Value.
    fn _closure(node) {
        let cid = this._next_closure()
        mut bound = {}
        for p in node.params {
            let pn = _param_name(p)
            bound = this._set_add(bound, pn)
        }
        mut acc = {}
        this._free_stmts(_block_stmts(node.body), bound, acc)
        let caps = keys(acc)

        mut lines = ["Value __closure_" + str(cid) + "(Value* __a, Value* __cap, long __n) {",
                     "  (void)__a; (void)__n;"]
        mut pi = 0
        for p in node.params {
            push(lines, this._bind_param(_raw_param(p), pi))
            pi += 1
        }
        mut ci = 0
        for cn in caps {
            let vname = if cn == "this" { "v_this" } else { "v_" + cn }
            push(lines, "  Value " + vname + " = __cap[" + str(ci) + "];")
            ci += 1
        }
        -- A closure is its own C function, so whether its locals need volatile
        -- storage depends on whether *it* contains a try — not on the function
        -- it was written inside. Without saving and restoring this, a closure
        -- with a try emitted from a context that has none would get ordinary
        -- locals, which is the -O2 hazard the volatile is there to prevent.
        let outer_volatile = this.volatile_locals
        this.volatile_locals = _has_try(_block_stmts(node.body))
        -- And for the same reason, whether this closure is a generator
        -- depends on whether *it* yields: a closure written inside a
        -- generator is a separate call with its own collection.
        let outer_generator = this.in_generator
        this.in_generator = _has_yield(_block_stmts(node.body))
        mut body_lines = []
        for l in this._generator_prologue() { push(body_lines, l) }
        for s in _block_stmts(node.body) { for l in this.stmt(s, 1) { push(body_lines, l) } }
        for l in this._generator_epilogue() { push(body_lines, l) }
        for l in body_lines { push(lines, l) }
        this.volatile_locals = outer_volatile
        this.in_generator = outer_generator
        push(lines, "  return cl_null();")
        push(lines, "}")
        push(this.closure_defs, lines)

        mut cap_exprs = []
        for cn in caps {
            push(cap_exprs, if cn == "this" { "v_this" } else { "v_" + cn })
        }
        let caparr = if len(cap_exprs) == 0 { "0" } else { "(Value[]){" + join(cap_exprs, ", ") + "}" }
        return "cl_closure_new(&__closure_" + str(cid) + ", " + caparr + ", " + str(len(caps)) + ")"
    }

    -- Build a C Value-array argument for a method/constructor call. Zero args
    -- pass NULL (0): a method reading no params never dereferences it.
    -- The arguments a direct call to `name` passes.
    --
    -- A top-level function keeps ordinary C parameters, so the call site is
    -- where the shapes have to line up: missing fixed arguments become null,
    -- and a rest parameter is built from whatever is left over. Clarity
    -- allows both — `f()` on a two-parameter function is null, null — and C
    -- allows neither.
    fn _direct_args(name, args) {
        let declared = this.fn_arity[name] ?? len(args)
        let is_rest = has(this.fn_rest, name)
        let fixed = if is_rest { declared - 1 } else { declared }
        mut out = []
        mut i = 0
        while i < fixed {
            push(out, if i < len(args) { args[i] } else { "cl_null()" })
            i += 1
        }
        if is_rest {
            mut extra = []
            mut j = fixed
            while j < len(args) { push(extra, args[j]); j += 1 }
            if len(extra) == 0 { push(out, "cl_list_new()") }
            else { push(out, "cl_rest((Value[]){" + join(extra, ", ") + "}, " + str(len(extra)) + ", 0)") }
        } elif len(args) > declared {
            -- Surplus arguments to a fixed-arity function are dropped, which
            -- is what the interpreter does; evaluating them anyway would be a
            -- different program.
            return out
        }
        return out
    }

    -- An argument array plus its length, which is what every indirect call
    -- takes now. Zero arguments is a null pointer and a zero count, not an
    -- empty array literal, because C has no zero-length array.
    fn _argv(arg_exprs) {
        if len(arg_exprs) == 0 { return "0, 0" }
        return "(Value[]){" + join(arg_exprs, ", ") + "}, " + str(len(arg_exprs))
    }

    -- Bind one parameter of an array-convention function (a method or a
    -- closure) from `__a`/`__n`. A rest parameter takes everything from its
    -- position onwards; a fixed one reads null past the end.
    fn _bind_param(pname, idx) {
        if starts(pname, "...") {
            return "  Value v_" + substring(pname, 3, len(pname)) +
                   " = cl_rest(__a, __n, " + str(idx) + ");"
        }
        return "  Value v_" + pname + " = cl_arg(__a, __n, " + str(idx) + ");"
    }

    -- Emit a call, given the callee node and its arguments already generated
    -- as C expressions. Shared by CallExpression and PipeExpression so that
    -- `v |> f(a)` resolves builtins, constructors and named top-level
    -- functions exactly as `f(v, a)` does, instead of through a second call
    -- site that would drift from this one.
    -- `f(...xs)`: how many arguments there are is not known while compiling,
    -- so they are collected into a list and the call takes that list's array.
    -- A spread list becomes that many arguments and anything else spread is
    -- passed as one, which is what the interpreter does.
    fn _spread_call(node, is_member) {
        let callee = node.callee
        mut inner = []
        if is_member { push(inner, callee.object) }
        for a in node.arguments {
            if a.node_type == "SpreadExpression" { push(inner, a.value) } else { push(inner, a) }
        }
        let parts = this._ordered_parts(inner)
        let names = parts["names"]
        mut recv = null
        mut ai = 0
        if is_member { recv = names[0]; ai = 1 }
        let aid = this.tmp_id
        this.tmp_id += 1
        let acc = "__as" + str(aid)
        mut body = "volatile Value " + acc + " = cl_list_new(); "
        for a in node.arguments {
            if a.node_type == "SpreadExpression" {
                body = body + acc + " = cl_args_add(" + acc + ", " + names[ai] + "); "
            } else {
                body = body + acc + " = cl_list_add(" + acc + ", " + names[ai] + "); "
            }
            ai += 1
        }
        let argv = "cl_argv_of(" + acc + "), cl_length(" + acc + ")"
        mut call = ""
        if is_member {
            call = "cl_dispatch(" + recv + ", \"" + callee.property + "\", " + argv + ")"
        } elif callee.node_type == "Identifier" {
            if contains(this.classes, callee.name) {
                call = "cl_ctor_" + callee.name + "(" + argv + ")"
            } elif has(this.fn_arity, callee.name) {
                -- A named function takes its parameters individually, so the
                -- call goes through the one closure that wraps it — the same
                -- value `apply(twice, 5)` would pass.
                this.fn_values[callee.name] = true
                call = "cl_call(__fnv_" + callee.name + ", " + argv + ")"
            } elif has(_NATIVE_BUILTINS, callee.name) {
                this.unsupported("spread into the builtin '" + callee.name + "'", node.line)
                return "cl_null()"
            } else {
                call = "cl_call(v_" + callee.name + ", " + argv + ")"
            }
        } else {
            this.unsupported("spread into an indirect call", node.line)
            return "cl_null()"
        }
        return "({ " + parts["decls"] + body + call + "; })"
    }

    -- `recv` is the receiver of a method call, already emitted, when the
    -- caller bound it to a temporary to fix the order it is evaluated in.
    fn _emit_call(callee, args, line, recv) {
        -- obj.method(args) → dynamic dispatch on the instance's class
        if callee.node_type == "MemberExpression" {
            let on_enum = this._enum_call(callee, args, line)
            if on_enum != null { return on_enum }
            let obj = if recv != null { recv } else { this.expr(callee.object) }
            return "cl_dispatch(" + obj + ", \"" + callee.property + "\", " + this._argv(args) + ")"
        }
        if callee.node_type == "Identifier" {
            -- ClassName(args) → construct an instance
            if contains(this.classes, callee.name) {
                return "cl_ctor_" + callee.name + "(" + this._argv(args) + ")"
            }
            -- A decorated function's name holds whatever the decorator
            -- returned, so the call is through that value and not the C
            -- function underneath it.
            if has(this.decorated, callee.name) and not contains(this.local_names, callee.name) {
                return "cl_call(v_" + callee.name + ", " + this._argv(args) + ")"
            }
            let builtin = this._builtin_call(callee.name, args)
            if builtin != "" { return builtin }
            -- A known top-level function calls directly; anything else is a
            -- local holding a closure value, called through cl_call.
            if contains(this.fn_names, callee.name) {
                return "f_" + callee.name + "(" + join(this._direct_args(callee.name, args), ", ") + ")"
            }
            return "cl_call(v_" + callee.name + ", " + this._argv(args) + ")"
        }
        -- Anything else in callee position is a value that should be callable:
        -- `m["f"](3)`, `(fns[i])(x)`. It used to be refused outright.
        return "cl_call(" + this.expr(callee) + ", " + this._argv(args) + ")"
    }

    -- The C name of one enum member's global.
    fn _enum_global(enum_name, member) {
        return "e_" + enum_name + "_" + member
    }

    -- `E.member` when E names an enum, else null so the caller falls through
    -- to an ordinary field read.
    fn _enum_member(node) {
        if node.object.node_type != "Identifier" { return null }
        let enum_name = node.object.name
        if not has(this.enums, enum_name) { return null }
        let members = this.enums[enum_name]
        if contains(members, node.property) {
            return this._enum_global(enum_name, node.property)
        }
        -- The four an enum answers besides its members are calls, handled in
        -- _enum_call; naming one without calling it is a function value, and
        -- there is nothing to hand back.
        if contains(["names", "values", "entries", "has"], node.property) {
            this.unsupported("enum method " + enum_name + "." + node.property + " as a value", node.line)
            return "cl_null()"
        }
        this.reject("enum " + enum_name + " has no member '" + node.property + "'", node.line)
        return "cl_null()"
    }

    -- `E.names()`, `E.values()`, `E.entries()`, `E.has(name)`. Each builds a
    -- fresh value, as the interpreter's do — a caller that mutates the list
    -- it gets back must not change what the next call returns.
    fn _enum_call(callee, args, line) {
        if callee.object.node_type != "Identifier" { return null }
        let enum_name = callee.object.name
        if not has(this.enums, enum_name) { return null }
        let members = this.enums[enum_name]
        let prop = callee.property
        if contains(members, prop) {
            this.reject("calling enum member " + enum_name + "." + prop + ", which is a value", line)
            return "cl_null()"
        }
        if prop == "names" or prop == "values" or prop == "entries" {
            if len(args) != 0 {
                this.reject("enum " + enum_name + "." + prop + " takes no arguments", line)
                return "cl_null()"
            }
            return "cl_enum_" + enum_name + "_" + prop + "()"
        }
        if prop == "has" {
            if len(args) != 1 {
                this.reject("enum " + enum_name + ".has takes one argument", line)
                return "cl_null()"
            }
            return "cl_enum_" + enum_name + "_has(" + args[0] + ")"
        }
        this.reject("enum " + enum_name + " has no member '" + prop + "'", line)
        return "cl_null()"
    }

    -- names(), values(), entries() and has() for one enum, as C functions.
    fn _enum_helpers(enum_name, members) {
        mut lines = []
        push(lines, "static Value cl_enum_" + enum_name + "_names(void) {")
        push(lines, "  Value l = cl_list_new();")
        for m in members { push(lines, "  l = cl_list_add(l, cl_str(\"" + m + "\"));") }
        push(lines, "  return l;")
        push(lines, "}")
        push(lines, "static Value cl_enum_" + enum_name + "_values(void) {")
        push(lines, "  Value l = cl_list_new();")
        for m in members { push(lines, "  l = cl_list_add(l, " + this._enum_global(enum_name, m) + ");") }
        push(lines, "  return l;")
        push(lines, "}")
        push(lines, "static Value cl_enum_" + enum_name + "_entries(void) {")
        push(lines, "  Value l = cl_list_new();")
        for m in members {
            push(lines, "  { Value p = cl_list_new();")
            push(lines, "    p = cl_list_add(p, cl_str(\"" + m + "\"));")
            push(lines, "    p = cl_list_add(p, " + this._enum_global(enum_name, m) + ");")
            push(lines, "    l = cl_list_add(l, p); }")
        }
        push(lines, "  return l;")
        push(lines, "}")
        push(lines, "static Value cl_enum_" + enum_name + "_has(Value name) {")
        for m in members {
            push(lines, "  if (cl_truthy(cl_eq(name, cl_str(\"" + m + "\")))) return cl_bool(1);")
        }
        push(lines, "  return cl_bool(0);")
        push(lines, "}")
        return lines
    }

    fn unsupported(what, line) {
        push(this.errors, "native compile: unsupported " + what + " (line " + str(line ?? 0) + ")")
    }

    -- A program this compiler understands and refuses: not a gap in the
    -- backend but a mistake in the source, and calling it "unsupported"
    -- would send whoever reads it looking for a missing feature.
    fn reject(what, line) {
        push(this.errors, "native compile: " + what + " (line " + str(line ?? 0) + ")")
    }

    -- Unique id for the temporaries a for-loop needs (iterable + index).
    fn next_loop() {
        this.loop_id += 1
        return this.loop_id
    }

    -- A builtin call → runtime C, or "" if `name`/arity isn't a known builtin.
    fn _builtin_call(name, args) {
        let n = len(args)
        if this.freestanding and has(_FREESTANDING_EXCLUDED, name) {
            let why = _FREESTANDING_EXCLUDED[name]
            push(this.errors, "native compile: {name}() is not available under --freestanding ({why} needs an operating system)")
            return "cl_null()"
        }
        if name == "len" and n == 1 { return "cl_int(cl_length(" + args[0] + "))" }
        if name == "push" and n == 2 { return "cl_list_add(" + args[0] + ", " + args[1] + ")" }
        if name == "str" and n == 1 { return "cl_str(cl_to_cstr(" + args[0] + "))" }
        -- display() is str()'s rendering; repr() quotes a string, which is
        -- what a value inside a collection already gets. Both were builtins
        -- in the other two engines and nothing here, so a program calling
        -- one failed with a C compiler error naming v_display.
        if name == "display" and n == 1 { return "cl_str(cl_display(" + args[0] + "))" }
        if name == "repr" and n == 1 { return "cl_str(cl_repr(" + args[0] + "))" }
        if name == "int" and n == 1 { return "cl_conv_int(" + args[0] + ")" }
        if name == "float" and n == 1 { return "cl_conv_float(" + args[0] + ")" }
        if name == "range" and n == 1 { return "cl_range2(cl_int(0), " + args[0] + ")" }
        if name == "range" and n == 2 { return "cl_range2(" + args[0] + ", " + args[1] + ")" }
        if name == "keys" and n == 1 { return "cl_keys(" + args[0] + ")" }
        if name == "has" and n == 2 { return "cl_has(" + args[0] + ", " + args[1] + ")" }
        if name == "contains" and n == 2 { return "cl_contains(" + args[0] + ", " + args[1] + ")" }
        if name == "map" and n == 2 { return "cl_hof_map(" + args[0] + ", " + args[1] + ")" }
        if name == "filter" and n == 2 { return "cl_hof_filter(" + args[0] + ", " + args[1] + ")" }
        if name == "reduce" and n == 3 { return "cl_hof_reduce(" + args[0] + ", " + args[1] + ", " + args[2] + ")" }
        if name == "each" and n == 2 { return "cl_hof_each(" + args[0] + ", " + args[1] + ")" }
        if name == "find" and n == 2 { return "cl_hof_find(" + args[0] + ", " + args[1] + ")" }
        if name == "every" and n == 2 { return "cl_hof_every(" + args[0] + ", " + args[1] + ")" }
        if name == "some" and n == 2 { return "cl_hof_some(" + args[0] + ", " + args[1] + ")" }
        if name == "pop" and n == 1 { return "cl_pop(" + args[0] + ")" }
        if name == "sort" and n == 1 { return "cl_sort(" + args[0] + ")" }
        if name == "reverse" and n == 1 { return "cl_reverse(" + args[0] + ")" }
        if name == "unique" and n == 1 { return "cl_unique(" + args[0] + ")" }
        if name == "flat" and n == 1 { return "cl_flat(" + args[0] + ")" }
        if name == "values" and n == 1 { return "cl_values(" + args[0] + ")" }
        if name == "entries" and n == 1 { return "cl_entries(" + args[0] + ")" }
        if name == "bool" and n == 1 { return "cl_bool(cl_truthy(" + args[0] + "))" }
        if name == "pow" and n == 2 { return "cl_pow(" + args[0] + ", " + args[1] + ")" }
        -- Variadic in the interpreter; C takes a count, so the argument list
        -- becomes an array literal. Any arity works, including zero.
        if name == "zip" and n > 0 { return "cl_zip((Value[]){" + join(args, ", ") + "}, " + str(n) + ")" }
        if name == "merge" and n > 0 { return "cl_merge((Value[]){" + join(args, ", ") + "}, " + str(n) + ")" }
        if name == "merge" and n == 0 { return "cl_map_new()" }
        if name == "print" and n > 0 { return "cl_print((Value[]){" + join(args, ", ") + "}, " + str(n) + ")" }
        if name == "print" and n == 0 { return "cl_print(0, 0)" }
        if name == "encode64" and n == 1 { return "cl_encode64(" + args[0] + ")" }
        if name == "decode64" and n == 1 { return "cl_decode64(" + args[0] + ")" }
        if name == "hash" and n == 1 { return "cl_sha256_hex(" + args[0] + ")" }
        if name == "cwd" and n == 0 { return "cl_cwd()" }
        if name == "random" and n == 0 { return "cl_random0()" }
        if name == "random" and n == 1 { return "cl_random1(" + args[0] + ")" }
        if name == "random" and n == 2 { return "cl_random2(" + args[0] + ", " + args[1] + ")" }
        -- strings
        if name == "upper" and n == 1 { return "cl_upper(" + args[0] + ")" }
        if name == "lower" and n == 1 { return "cl_lower(" + args[0] + ")" }
        if name == "trim" and n == 1 { return "cl_trim(" + args[0] + ")" }
        if name == "split" and n == 1 { return "cl_str_split(" + args[0] + ", cl_str(\" \"))" }
        if name == "split" and n == 2 { return "cl_str_split(" + args[0] + ", " + args[1] + ")" }
        if name == "join" and n == 1 { return "cl_str_join(" + args[0] + ", cl_str(\"\"))" }
        if name == "join" and n == 2 { return "cl_str_join(" + args[0] + ", " + args[1] + ")" }
        if name == "replace" and n == 3 { return "cl_replace(" + args[0] + ", " + args[1] + ", " + args[2] + ")" }
        if name == "starts" and n == 2 { return "cl_starts(" + args[0] + ", " + args[1] + ")" }
        if name == "ends" and n == 2 { return "cl_ends(" + args[0] + ", " + args[1] + ")" }
        if name == "substring" and n == 2 { return "cl_substr(" + args[0] + ", (" + args[1] + ").i, (long)strlen((" + args[0] + ").s))" }
        if name == "substring" and n == 3 { return "cl_substr(" + args[0] + ", (" + args[1] + ").i, (" + args[2] + ").i)" }
        if name == "char_at" and n == 2 { return "cl_char_at(" + args[0] + ", (" + args[1] + ").i)" }
        if name == "char_code" and n == 1 { return "cl_char_code(" + args[0] + ")" }
        if name == "from_char_code" and n == 1 { return "cl_from_char_code(" + args[0] + ")" }
        if name == "index_of" and n == 2 { return "cl_index_of(" + args[0] + ", " + args[1] + ")" }
        if name == "pad_left" and n == 2 { return "cl_pad_left(" + args[0] + ", (" + args[1] + ").i)" }
        if name == "pad_right" and n == 2 { return "cl_pad_right(" + args[0] + ", (" + args[1] + ").i)" }
        if name == "chars" and n == 1 { return "cl_chars(" + args[0] + ")" }
        if name == "repeat" and n == 2 { return "cl_str_repeat(" + args[0] + ", (" + args[1] + ").i)" }
        if name == "is_digit" and n == 1 { return "cl_is_digit(" + args[0] + ")" }
        if name == "is_alpha" and n == 1 { return "cl_is_alpha(" + args[0] + ")" }
        if name == "is_alnum" and n == 1 { return "cl_is_alnum(" + args[0] + ")" }
        if name == "is_space" and n == 1 { return "cl_is_space(" + args[0] + ")" }
        -- file I/O
        if name == "read" and n == 1 { return "cl_read_file(" + args[0] + ")" }
        if name == "write" and n == 2 { return "cl_write_file(" + args[0] + ", " + args[1] + ")" }
        if name == "append" and n == 2 { return "cl_append_file(" + args[0] + ", " + args[1] + ")" }
        if name == "exists" and n == 1 { return "cl_exists(" + args[0] + ")" }
        if name == "lines" and n == 1 { return "cl_lines(" + args[0] + ")" }
        if name == "read_bytes" and n == 1 { return "cl_read_bytes(" + args[0] + ")" }
        if name == "write_bytes" and n == 2 { return "cl_write_bytes(" + args[0] + ", " + args[1] + ")" }
        if name == "read_mem" and n == 3 { return "cl_read_mem(" + args[0] + ", " + args[1] + ", " + args[2] + ")" }
        if name == "write_mem" and n == 3 { return "cl_write_mem(" + args[0] + ", " + args[1] + ", " + args[2] + ")" }
        -- process / env
        if name == "env" and n == 1 { return "cl_env(" + args[0] + ", cl_null())" }
        if name == "env" and n == 2 { return "cl_env(" + args[0] + ", " + args[1] + ")" }
        if name == "args" and n == 0 { return "cl_args()" }
        if name == "exit" and n == 0 { return "(exit(0), cl_null())" }
        if name == "exit" and n == 1 { return "(exit((int)(" + args[0] + ").i), cl_null())" }
        if name == "exec" and n == 1 { return "cl_exec(" + args[0] + ")" }
        if name == "exec_full" and n == 1 { return "cl_exec_full(" + args[0] + ")" }
        if name == "type" and n == 1 { return "cl_type_of(" + args[0] + ")" }
        -- sockets
        if name == "tcp_listen" and n == 1 { return "cl_tcp_listen(" + args[0] + ")" }
        if name == "tcp_port" and n == 1 { return "cl_tcp_port(" + args[0] + ")" }
        if name == "tcp_accept" and n == 1 { return "cl_tcp_accept(" + args[0] + ")" }
        if name == "tcp_connect" and n == 2 { return "cl_tcp_connect(" + args[0] + ", " + args[1] + ")" }
        if name == "tcp_send" and n == 2 { return "cl_tcp_send(" + args[0] + ", " + args[1] + ")" }
        if name == "tcp_recv" and n == 2 { return "cl_tcp_recv(" + args[0] + ", " + args[1] + ")" }
        if name == "tcp_close" and n == 1 { return "cl_tcp_close(" + args[0] + ")" }
        if name == "sleep" and n == 1 { return "cl_sleep(" + args[0] + ")" }
        if name == "time" and n == 0 { return "cl_time()" }
        -- math
        if name == "abs" and n == 1 { return "cl_abs(" + args[0] + ")" }
        if name == "floor" and n == 1 { return "cl_floor(" + args[0] + ")" }
        if name == "ceil" and n == 1 { return "cl_ceil(" + args[0] + ")" }
        if name == "round" and n == 1 { return "cl_round1(" + args[0] + ")" }
        if name == "round" and n == 2 { return "cl_round2(" + args[0] + ", " + args[1] + ")" }
        if name == "sqrt" and n == 1 { return "cl_sqrt(" + args[0] + ")" }
        if name == "sin" and n == 1 { return "cl_sin(" + args[0] + ")" }
        if name == "cos" and n == 1 { return "cl_cos(" + args[0] + ")" }
        if name == "tan" and n == 1 { return "cl_tan(" + args[0] + ")" }
        if name == "log" and n == 1 { return "cl_log(" + args[0] + ")" }
        if name == "sum" and n == 1 { return "cl_sum(" + args[0] + ")" }
        if name == "min" and n == 1 { return "cl_min_list(" + args[0] + ")" }
        if name == "min" and n == 2 { return "cl_min2(" + args[0] + ", " + args[1] + ")" }
        if name == "max" and n == 1 { return "cl_max_list(" + args[0] + ")" }
        if name == "max" and n == 2 { return "cl_max2(" + args[0] + ", " + args[1] + ")" }
        -- JSON
        if name == "json_parse" and n == 1 { return "cl_json_parse(" + args[0] + ")" }
        if name == "json_string" and n == 1 { return "cl_json_string(" + args[0] + ")" }
        -- native FFI
        if name == "ffi_open" and n == 1 { return "cl_ffi_open(" + args[0] + ")" }
        if name == "ffi_buffer" and n == 1 { return "cl_ffi_buffer(" + args[0] + ")" }
        if name == "ffi_read" and n == 2 { return "cl_ffi_read(" + args[0] + ", " + args[1] + ")" }
        if name == "ffi_write" and n == 2 { return "cl_ffi_write(" + args[0] + ", " + args[1] + ")" }
        if name == "ffi_free" and n == 1 { return "cl_ffi_free(" + args[0] + ")" }
        if name == "ffi_sym" and n == 1 { return "cl_ffi_sym(" + args[0] + ")" }
        if name == "ffi_call" and n == 3 { return "cl_ffi_call(" + args[0] + ", " + args[1] + ", " + args[2] + ")" }
        return ""
    }

    -- The C expressions for a list of operands, evaluated left to right
    -- whatever order the C compiler would have chosen.
    --
    -- C does not define the order in which a function call's arguments are
    -- evaluated, and the emitter builds every multi-operand construct as one
    -- C expression: `cl_add(a, b)`, `cl_list_add(cl_list_add(l, a), b)`,
    -- `cl_call(f, (Value[]){a, b}, 2)`. GCC evaluates right to left, so
    -- `[bump(), bump()]` was [2, 1] natively against the interpreter's
    -- [1, 2], and `{ "x": bump(), "y": bump() }` and `str(bump()) +
    -- str(bump())` went the same way. Binding each operand to a temporary in
    -- source order settles it, and it settles the other half of the same
    -- question too: if the first operand throws, the second must not have
    -- run.
    --
    -- Returns { seq, decls, names }. When nothing can observe the order, seq
    -- is false, names are the operands emitted in place, and no temporary is
    -- written — so the generated C stays readable for the overwhelming
    -- majority of expressions, which are built from literals and names.
    fn _ordered_parts(nodes) {
        if not _order_matters(nodes) {
            mut plain = []
            for n in nodes { push(plain, this.expr(n)) }
            return { "seq": false, "decls": "", "names": plain }
        }
        mut decls = ""
        mut names = []
        for n in nodes {
            let id = this.tmp_id
            this.tmp_id += 1
            let t = "__o" + str(id)
            -- volatile so the value lives in memory. The conservative
            -- collector finds roots by scanning the C stack, and a Value that
            -- -O2 has split into registers is not on it: under CLARITY_GC=1 a
            -- two-element collection could collect its first element while
            -- the second was still being built. The same reason a function
            -- containing a try gives its locals volatile storage.
            decls = decls + "volatile Value " + t + " = (" + this.expr(n) + "); "
            push(names, t)
        }
        return { "seq": true, "decls": decls, "names": names }
    }

    -- Wrap an expression built from _ordered_parts' names in the statement
    -- expression that declares them, if there were any.
    fn _wrap_seq(parts, body) {
        if not parts["seq"] { return body }
        return "({ " + parts["decls"] + body + "; })"
    }

    -- A string literal, interpolated if it has anything to interpolate.
    -- Native `+` already renders a value exactly as the interpreter's display
    -- does — a list as [1, 2], a map as {a: 1}, an instance through its
    -- to_string() — so the concatenation *is* the interpolation.
    --
    -- Two divergences from `clarity run`, both shared with the bytecode VM
    -- and both inherent to resolving a name while compiling rather than while
    -- running. The interpreter wraps the whole of `{X}` in a try and falls
    -- back to the literal text on *any* failure, so `"a {nope} b"` prints
    -- `a {nope} b` there and is an error here, as it already is under
    -- --fast. And the expressions run when the string is built, so a
    -- compiled program cannot decide at run time that a brace was prose.
    fn _string(node) {
        mut raw = false
        try { raw = node.raw ?? false } catch e_raw { raw = false }
        if raw { return "cl_str(\"" + _c_escape(node.value) + "\")" }
        let parts = _interp_parts(node.value)
        if parts == null { return "cl_str(\"" + _c_escape(node.value) + "\")" }

        -- Two or more interpolated expressions are two or more operands of
        -- one C expression, whose evaluation order C leaves unspecified —
        -- so bind them to temporaries in source order first. The
        -- interpreter evaluates them left to right, and one of them may
        -- have a side effect the next one reads.
        mut exprs = []
        for part in parts {
            if part["kind"] == "expr" { push(exprs, part["node"]) }
        }
        mut names = []
        mut decls = ""
        if len(exprs) > 1 {
            for e in exprs {
                let id = this.tmp_id
                this.tmp_id += 1
                let t = "__ip" + str(id)
                decls = decls + "Value " + t + " = (" + this.expr(e) + "); "
                push(names, t)
            }
        }

        mut out = ""
        mut started = false
        mut k = 0
        for part in parts {
            mut piece = ""
            if part["kind"] == "lit" {
                piece = "cl_str(\"" + _c_escape(part["text"]) + "\")"
            } else {
                piece = if len(names) > 0 { names[k] } else { this.expr(part["node"]) }
                k += 1
            }
            if started { out = "cl_add(" + out + ", " + piece + ")" }
            else { out = piece; started = true }
        }
        if len(names) > 0 { return "({ " + decls + out + "; })" }
        return out
    }

    -- Emit a C expression (of type Value) for an AST expression node.
    fn expr(node) {
        let nt = node.node_type
        if nt == "NumberLiteral" {
            let v = node.value
            if type(v) == "float" or str(v) != str(int(v)) { return "cl_float(" + str(v) + ")" }
            return "cl_int(" + str(int(v)) + ")"
        }
        if nt == "StringLiteral" { return this._string(node) }
        if nt == "BoolLiteral" { return if node.value { "cl_bool(1)" } else { "cl_bool(0)" } }
        if nt == "NullLiteral" { return "cl_null()" }
        if nt == "Identifier" {
            -- A bare mention of a top-level function — `apply(twice, 5)`, not
            -- `twice(5)`, which CallExpression handles directly — is a value.
            -- Emitting `v_twice` would name a variable that does not exist,
            -- and `f_twice` is the C function, not a Value; so wrap it in a
            -- closure. Skipped when something nearer binds the same name,
            -- because then the local is what the program meant.
            if has(this.decorated, node.name) and not contains(this.local_names, node.name) {
                return "v_" + node.name
            }
            if has(this.fn_arity, node.name) and not contains(this.local_names, node.name) {
                this.fn_values[node.name] = true
                -- One closure per function, built once in main, rather than a
                -- fresh one at every mention: `f == f` has to be true, and a
                -- closure compares by identity.
                return "__fnv_" + node.name
            }
            return "v_" + node.name
        }
        if nt == "ThisExpression" { return "v_this" }
        if nt == "FnExpression" { return this._closure(node) }
        if nt == "UnaryOp" {
            if node.operator == "not" { return "cl_not(" + this.expr(node.operand) + ")" }
            if node.operator == "-" { return "cl_neg(" + this.expr(node.operand) + ")" }
            this.unsupported("unary '" + node.operator + "'", node.line)
            return "cl_null()"
        }
        if nt == "BinaryOp" {
            -- `a and b` is b when a is truthy, else a; `a or b` is a when a
            -- is truthy, else b. Both need a twice, and naming it twice in
            -- the ternary *ran* it twice: after `bump() or false` the counter
            -- had gone up two, and the value handed back was the second call's.
            -- So a left operand that can do anything is bound once first.
            if node.operator == "and" or node.operator == "or" {
                let left_first = node.operator == "or"
                if _pure_expr(node.left) {
                    let a = this.expr(node.left)
                    if left_first { return "(cl_truthy(" + a + ") ? " + a + " : " + this.expr(node.right) + ")" }
                    return "(cl_truthy(" + a + ") ? " + this.expr(node.right) + " : " + a + ")"
                }
                let id = this.tmp_id
                this.tmp_id += 1
                let t = "__sc" + str(id)
                let head = "({ Value " + t + " = (" + this.expr(node.left) + "); cl_truthy(" + t + ") ? "
                if left_first { return head + t + " : (" + this.expr(node.right) + "); })" }
                return head + "(" + this.expr(node.right) + ") : " + t + "; })"
            }
            if has(_BINOPS, node.operator) {
                let parts = this._ordered_parts([node.left, node.right])
                let names = parts["names"]
                return this._wrap_seq(parts, _BINOPS[node.operator] + "(" + names[0] + ", " + names[1] + ")")
            }
            this.unsupported("operator '" + node.operator + "'", node.line)
            return "cl_null()"
        }
        if nt == "ListLiteral" {
            mut has_spread = false
            for el in node.elements { if el.node_type == "SpreadExpression" { has_spread = true } }
            if has_spread {
                -- `[1, ...xs, 4]`: the spread elements are opened out, so the
                -- length is not known while compiling and the list is built
                -- one step at a time. The operands are still bound in source
                -- order, for the reason _ordered_parts gives.
                mut inner = []
                for el in node.elements {
                    if el.node_type == "SpreadExpression" { push(inner, el.value) } else { push(inner, el) }
                }
                let sparts = this._ordered_parts(inner)
                let snames = sparts["names"]
                let sid = this.tmp_id
                this.tmp_id += 1
                let sacc = "__ls" + str(sid)
                mut sbody = "volatile Value " + sacc + " = cl_list_new(); "
                mut si = 0
                for el in node.elements {
                    if el.node_type == "SpreadExpression" {
                        sbody = sbody + sacc + " = cl_list_extend(" + sacc + ", " + snames[si] + "); "
                    } else {
                        sbody = sbody + sacc + " = cl_list_add(" + sacc + ", " + snames[si] + "); "
                    }
                    si += 1
                }
                return "({ " + sparts["decls"] + sbody + sacc + "; })"
            }
            let parts = this._ordered_parts(node.elements)
            if not parts["seq"] {
                mut e = "cl_list_new()"
                for nm in parts["names"] { e = "cl_list_add(" + e + ", " + nm + ")" }
                return e
            }
            -- Built through a named local rather than nested calls: each
            -- cl_list_add allocates, and a list held only in a register
            -- between two of them is invisible to a collector that scans the
            -- stack. The same reason `yield` collects into a named local.
            let lid = this.tmp_id
            this.tmp_id += 1
            let acc = "__lb" + str(lid)
            mut body = "volatile Value " + acc + " = cl_list_new(); "
            for nm in parts["names"] { body = body + acc + " = cl_list_add(" + acc + ", " + nm + "); " }
            return "({ " + parts["decls"] + body + acc + "; })"
        }
        if nt == "MapLiteral" {
            mut map_spread = false
            for pair in node.pairs { if pair[0] == null { map_spread = true } }
            if map_spread {
                -- `{...m, "b": 2}` is a pair with no key. Merged in order, so
                -- a later key beats a spread one.
                mut inner = []
                for pair in node.pairs {
                    if pair[0] == null { push(inner, pair[1].value) }
                    else { push(inner, pair[0]); push(inner, pair[1]) }
                }
                let mparts = this._ordered_parts(inner)
                let mnames = mparts["names"]
                let mid2 = this.tmp_id
                this.tmp_id += 1
                let macc = "__ms" + str(mid2)
                mut mbody = "volatile Value " + macc + " = cl_map_new(); "
                mut mi2 = 0
                for pair in node.pairs {
                    if pair[0] == null {
                        mbody = mbody + macc + " = cl_map_merge(" + macc + ", " + mnames[mi2] + "); "
                        mi2 += 1
                    } else {
                        mbody = mbody + macc + " = cl_map_put(" + macc + ", cl_to_cstr(" + mnames[mi2] + "), " + mnames[mi2 + 1] + "); "
                        mi2 += 2
                    }
                }
                return "({ " + mparts["decls"] + mbody + macc + "; })"
            }
            mut flat = []
            for pair in node.pairs {
                push(flat, pair[0])
                push(flat, pair[1])
            }
            let parts = this._ordered_parts(flat)
            let names = parts["names"]
            if not parts["seq"] {
                mut e = "cl_map_new()"
                mut i = 0
                while i < len(names) {
                    e = "cl_map_put(" + e + ", cl_to_cstr(" + names[i] + "), " + names[i + 1] + ")"
                    i += 2
                }
                return e
            }
            let mid = this.tmp_id
            this.tmp_id += 1
            let acc = "__mb" + str(mid)
            mut body = "volatile Value " + acc + " = cl_map_new(); "
            mut j = 0
            while j < len(names) {
                body = body + acc + " = cl_map_put(" + acc + ", cl_to_cstr(" + names[j] + "), " + names[j + 1] + "); "
                j += 2
            }
            return "({ " + parts["decls"] + body + acc + "; })"
        }
        if nt == "IndexExpression" {
            let parts = this._ordered_parts([node.object, node.index])
            let names = parts["names"]
            return this._wrap_seq(parts, "cl_index(" + names[0] + ", " + names[1] + ")")
        }
        if nt == "YieldExpression" {
            -- Clarity's generators are eager: `yield v` is an expression
            -- worth v that also appends v to what this call has collected,
            -- and the call returns the collection if it is not empty. The
            -- scan that set in_generator ignores yields inside a nested fn,
            -- which is its own call with its own collection.
            if not this.in_generator {
                this.reject("yield outside a function", node.line)
                return "cl_null()"
            }
            let id = this.tmp_id
            this.tmp_id += 1
            let t = "__y" + str(id)
            let val = if node.value != null { this.expr(node.value) } else { "cl_null()" }
            return "({ Value " + t + " = (" + val + "); __yields = cl_list_add(__yields, " + t + "); " + t + "; })"
        }
        if nt == "AwaitExpression" {
            -- There is no scheduler here and none in the interpreter either:
            -- `await x` evaluates x. Refusing it kept the last example in
            -- examples/ from compiling for no reason the language has.
            return this.expr(node.value)
        }
        if nt == "OptionalMemberExpression" {
            -- `a?.b`: null when reading the property would have failed, which
            -- is what the interpreter answers and what `?.` is for. It was
            -- refused outright before, so the one way to read a field that
            -- might not be there did not compile.
            return "cl_get_field_opt(" + this.expr(node.object) + ", \"" + node.property + "\")"
        }
        if nt == "MemberExpression" {
            -- `Colour.Red` is not a field read: an enum is a compile-time
            -- table, and its members are C globals initialised once. The
            -- interpreter reports an unknown member as a runtime error; here
            -- the whole table is known while compiling, so it is a compile
            -- error, which is the same program rejected earlier.
            let enum_member = this._enum_member(node)
            if enum_member != null { return enum_member }
            -- Field/property read: `obj.field`. Method *calls* are handled in
            -- CallExpression below; a bare member is always a field lookup.
            return "cl_get_field(" + this.expr(node.object) + ", \"" + node.property + "\")"
        }
        if nt == "CallExpression" {
            -- The receiver of a method call is evaluated before the
            -- arguments, so it goes through the same ordering.
            -- An enum's name is not a value: `Level.names()` is a compile-time
            -- table lookup, so the receiver is not evaluated and must not be
            -- emitted as one.
            mut is_member = node.callee.node_type == "MemberExpression"
            if is_member and node.callee.object.node_type == "Identifier" {
                if has(this.enums, node.callee.object.name) { is_member = false }
            }
            mut operands = []
            if is_member { push(operands, node.callee.object) }
            for a in node.arguments { push(operands, a) }
            mut call_spread = false
            for a in node.arguments { if a.node_type == "SpreadExpression" { call_spread = true } }
            if call_spread { return this._spread_call(node, is_member) }
            let parts = this._ordered_parts(operands)
            let names = parts["names"]
            mut recv = null
            mut cargs = []
            mut i = 0
            if is_member { recv = names[0]; i = 1 }
            while i < len(names) { push(cargs, names[i]); i += 1 }
            return this._wrap_seq(parts, this._emit_call(node.callee, cargs, node.line, recv))
        }
        if nt == "NullCoalesce" {
            -- `a ?? b`: evaluate a once, and b only if a is null. A plain
            -- ternary would have to name `a` twice and would run its side
            -- effects twice, so bind it to a temporary first. This is a
            -- statement expression, a GCC/Clang extension — the backend
            -- already requires cc, gcc or clang.
            let id = this.tmp_id
            this.tmp_id += 1
            let t = "__nc" + str(id)
            return "({ Value " + t + " = (" + this.expr(node.left) + "); " + t +
                ".t == T_NULL ? (" + this.expr(node.right) + ") : " + t + "; })"
        }
        if nt == "IfExpression" {
            -- `if c { a } else { b }` in expression position is a ternary.
            -- Both arms are evaluated lazily by C's ?:, which matches the
            -- interpreter — an arm with a side effect must not run when the
            -- other branch is taken.
            return "(cl_truthy(" + this.expr(node.condition) + ") ? " +
                this.expr(node.true_expr) + " : " + this.expr(node.false_expr) + ")"
        }
        if nt == "RangeExpression" {
            -- `a..b` is exactly range(a, b); an open-ended range is only legal
            -- in a slice, which the interpreter also rejects here.
            if node.end == null {
                this.unsupported("open-ended range outside a slice", node.line)
                return "cl_null()"
            }
            let parts = this._ordered_parts([node.start, node.end])
            let names = parts["names"]
            return this._wrap_seq(parts, "cl_range2(" + names[0] + ", " + names[1] + ")")
        }
        if nt == "PipeExpression" {
            -- `v |> f` is f(v); `v |> f(a, b)` is f(v, a, b). The piped value
            -- becomes the first argument, and the rest of the call is emitted
            -- through the ordinary call path.
            mut operands = [node.value]
            mut target = node.function
            if target.node_type == "CallExpression" {
                for a in target.arguments { push(operands, a) }
                target = target.callee
            }
            let parts = this._ordered_parts(operands)
            mut recv = null
            if target.node_type == "MemberExpression" { recv = this.expr(target.object) }
            return this._wrap_seq(parts, this._emit_call(target, parts["names"], node.line, recv))
        }
        this.unsupported("expression " + nt, node.line)
        return "cl_null()"
    }

    -- `let [a, b] = pair` and `let {x, y} = m`. The value is bound once, the
    -- names are read out of it, and a name past the end of a list binds null
    -- rather than failing — the interpreter's rules. `declare` is false at
    -- module level, where the names are C globals already.
    fn _destructure(node, pad, declare) {
        mut qual = ""
        if declare {
            qual = if this.volatile_locals { "volatile Value " } else { "Value " }
        }
        let id = this.tmp_id
        this.tmp_id += 1
        let t = "__dv" + str(id)
        mut lines = [pad + "volatile Value " + t + " = " + this.expr(node.value) + ";"]
        if node.kind == "map" {
            push(lines, pad + "cl_require_map(" + t + ");")
            for target in node.targets {
                push(lines, pad + qual + "v_" + target + " = cl_index(" + t + ", cl_str(\"" + _c_escape(target) + "\"));")
            }
            return lines
        }
        push(lines, pad + "cl_require_list(" + t + ");")
        mut i = 0
        for target in node.targets {
            if starts(target, "...") {
                let rest_name = substring(target, 3, len(target))
                push(lines, pad + qual + "v_" + rest_name + " = cl_destructure_rest(" + t + ", " + str(i) + ");")
                return lines
            }
            push(lines, pad + qual + "v_" + target + " = cl_destructure_at(" + t + ", " + str(i) + ");")
            i += 1
        }
        return lines
    }

    -- `a, b = b, a`. Every value is evaluated before anything is assigned,
    -- which is what makes the swap a swap.
    fn _multi_assign(node, pad) {
        if len(node.targets) != len(node.values) {
            this.reject("multi-assignment: " + str(len(node.targets)) + " targets but " +
                str(len(node.values)) + " values", node.line)
            return []
        }
        mut lines = []
        mut temps = []
        for v in node.values {
            let id = this.tmp_id
            this.tmp_id += 1
            let t = "__ma" + str(id)
            push(lines, pad + "volatile Value " + t + " = " + this.expr(v) + ";")
            push(temps, t)
        }
        mut i = 0
        for target in node.targets {
            let tn = target.node_type
            if tn == "Identifier" {
                push(lines, pad + "v_" + target.name + " = " + temps[i] + ";")
            } elif tn == "MemberExpression" {
                push(lines, pad + "cl_set_field(" + this.expr(target.object) + ", \"" + target.property + "\", " + temps[i] + ");")
            } elif tn == "IndexExpression" {
                push(lines, pad + "cl_index_set(" + this.expr(target.object) + ", " + this.expr(target.index) + ", " + temps[i] + ");")
            } else {
                this.reject("multi-assignment to " + tn, node.line)
            }
            i += 1
        }
        return lines
    }

    -- Emit C statement lines (a list of strings) for an AST statement.
    fn stmt(node, indent) {
        let pad = repeat("  ", indent)
        let nt = node.node_type
        if nt == "LetStatement" {
            let qual = if this.volatile_locals { "volatile Value v_" } else { "Value v_" }
            return [pad + qual + node.name + " = " + this.expr(node.value) + ";"]
        }
        if nt == "DestructureLetStatement" {
            return this._destructure(node, pad, true)
        }
        if nt == "MultiAssignStatement" {
            return this._multi_assign(node, pad)
        }
        if nt == "AssignStatement" {
            if node.target.node_type == "Identifier" {
                let op = node.operator
                if op == "=" {
                    return [pad + "v_" + node.target.name + " = " + this.expr(node.value) + ";"]
                }
                -- compound assignment (+=, -=, ...): map to the binop
                let base = substring(op, 0, len(op) - 1)
                if has(_BINOPS, base) {
                    return [pad + "v_" + node.target.name + " = " + _BINOPS[base] + "(v_" + node.target.name + ", " + this.expr(node.value) + ");"]
                }
            }
            if node.target.node_type == "IndexExpression" {
                let obj = this.expr(node.target.object)
                let idx = this.expr(node.target.index)
                let op = node.operator
                if op == "=" {
                    return [pad + "cl_index_set(" + obj + ", " + idx + ", " + this.expr(node.value) + ");"]
                }
                let base = substring(op, 0, len(op) - 1)
                if has(_BINOPS, base) {
                    return [pad + "cl_index_set(" + obj + ", " + idx + ", " + _BINOPS[base] + "(cl_index(" + obj + ", " + idx + "), " + this.expr(node.value) + "));"]
                }
            }
            if node.target.node_type == "MemberExpression" {
                let obj = this.expr(node.target.object)
                let prop = node.target.property
                let op = node.operator
                if op == "=" {
                    return [pad + "cl_set_field(" + obj + ", \"" + prop + "\", " + this.expr(node.value) + ");"]
                }
                let base = substring(op, 0, len(op) - 1)
                if has(_BINOPS, base) {
                    return [pad + "cl_set_field(" + obj + ", \"" + prop + "\", " + _BINOPS[base] + "(cl_get_field(" + obj + ", \"" + prop + "\"), " + this.expr(node.value) + "));"]
                }
            }
            this.unsupported("assignment target", node.line)
            return []
        }
        if nt == "ShowStatement" {
            if len(node.values) == 1 {
                return [pad + "cl_show(" + this.expr(node.values[0]) + ");"]
            }
            -- `show a, b` is one line with a space between, as in both other
            -- engines. Emitting one cl_show per value put them on separate
            -- lines, so examples/hello.clarity printed "Colors:" and the list
            -- underneath it rather than beside it.
            let parts = this._ordered_parts(node.values)
            let names = parts["names"]
            mut call = "cl_show_all((Value[]){" + join(names, ", ") + "}, " + str(len(names)) + ")"
            return [pad + this._wrap_seq(parts, call) + ";"]
        }
        if nt == "ExpressionStatement" {
            return [pad + "(void)(" + this.expr(node.expression) + ");"]
        }
        if nt == "ReturnStatement" {
            let val = if node.value != null { this.expr(node.value) } else { "cl_null()" }
            -- In a generator the collection wins over the returned value, but
            -- the value is still evaluated: the interpreter evaluates the
            -- return expression and then discards it, so its side effects
            -- happen either way.
            if this.in_generator and len(this.finally_stack) == 0 {
                let gid = this.tmp_id
                this.tmp_id += 1
                let gt = "__gr" + str(gid)
                return [pad + "{ Value " + gt + " = " + val + ";",
                        pad + "  if (cl_length(__yields) > 0) return __yields;",
                        pad + "  return " + gt + "; }"]
            }
            if len(this.finally_stack) == 0 { return [pad + "return " + val + ";"] }
            -- Returning out of a try has to run the finally blocks it is
            -- leaving, innermost first. The value is computed before they run,
            -- because a finally must not change what is being returned, and
            -- the handlers those blocks belong to are already popped by the
            -- time control reaches here only on the normal path — so pop them
            -- explicitly.
            let id = this.tmp_id
            this.tmp_id += 1
            let t = "__ret" + str(id)
            mut lines = [pad + "{ Value " + t + " = " + val + ";"]
            mut i = len(this.finally_stack) - 1
            -- Emitting the finally bodies here means they run on this path as
            -- well as on the fall-through and throw paths.
            let saved = this.finally_stack
            this.finally_stack = []
            while i >= 0 {
                for st in _block_stmts(saved[i]) { for l in this.stmt(st, indent + 1) { push(lines, l) } }
                i = i - 1
            }
            this.finally_stack = saved
            if this.in_generator {
                push(lines, pad + "  if (cl_length(__yields) > 0) return __yields;")
            }
            push(lines, pad + "  return " + t + "; }")
            return lines
        }
        if nt == "IfStatement" {
            mut lines = [pad + "if(cl_truthy(" + this.expr(node.condition) + ")) {"]
            for s in _block_stmts(node.body) { for l in this.stmt(s, indent + 1) { push(lines, l) } }
            if node.elif_clauses != null {
                for clause in node.elif_clauses {
                    push(lines, pad + "} else if(cl_truthy(" + this.expr(clause[0]) + ")) {")
                    for s in _block_stmts(clause[1]) { for l in this.stmt(s, indent + 1) { push(lines, l) } }
                }
            }
            if node.else_body != null {
                push(lines, pad + "} else {")
                for s in _block_stmts(node.else_body) { for l in this.stmt(s, indent + 1) { push(lines, l) } }
            }
            push(lines, pad + "}")
            return lines
        }
        if nt == "WhileStatement" {
            mut lines = [pad + "while(cl_truthy(" + this.expr(node.condition) + ")) {"]
            for s in _block_stmts(node.body) { for l in this.stmt(s, indent + 1) { push(lines, l) } }
            push(lines, pad + "}")
            return lines
        }
        if nt == "ForStatement" {
            let lid = this.next_loop()
            let it = "__it" + str(lid)
            let ix = "__i" + str(lid)
            mut lines = [pad + "Value " + it + " = cl_iter(" + this.expr(node.iterable) + ");"]
            push(lines, pad + "for(long " + ix + "=0; " + ix + " < cl_length(" + it + "); " + ix + "++) {")
            push(lines, pad + "  Value v_" + node.variable + " = cl_index(" + it + ", cl_int(" + ix + "));")
            for s in _block_stmts(node.body) { for l in this.stmt(s, indent + 1) { push(lines, l) } }
            push(lines, pad + "}")
            return lines
        }
        if nt == "BreakStatement" {
            -- A break that leaves a try would skip its finally. Working out
            -- which of the enclosing finallys lie between here and the loop
            -- needs more bookkeeping than this has; refusing is honest, and
            -- silently skipping a finally would not be.
            if len(this.finally_stack) > 0 { this.unsupported("break inside a try with a finally", node.line) }
            return [pad + "break;"]
        }
        if nt == "ContinueStatement" {
            if len(this.finally_stack) > 0 { this.unsupported("continue inside a try with a finally", node.line) }
            return [pad + "continue;"]
        }
        if nt == "MatchStatement" {
            -- The interpreter matches by `==` against each arm's evaluated
            -- pattern — there is no destructuring — so this is an if/else
            -- chain over cl_equal. The subject is bound to a temporary first
            -- because it must be evaluated exactly once, however many arms
            -- are tested.
            let id = this.tmp_id
            this.tmp_id += 1
            let t = "__match" + str(id)
            mut lines = [pad + "{ Value " + t + " = " + this.expr(node.subject) + ";"]
            mut first = true
            for arm in node.arms {
                let head = if first { pad + "  if(cl_truthy(cl_eq(" } else { pad + "  } else if(cl_truthy(cl_eq(" }
                push(lines, head + t + ", " + this.expr(arm[0]) + "))) {")
                for st in _block_stmts(arm[1]) { for l in this.stmt(st, indent + 2) { push(lines, l) } }
                first = false
            }
            if node.default != null {
                if first { push(lines, pad + "  {") } else { push(lines, pad + "  } else {") }
                for st in _block_stmts(node.default) { for l in this.stmt(st, indent + 2) { push(lines, l) } }
                push(lines, pad + "  }")
            } elif not first {
                push(lines, pad + "  }")
            }
            push(lines, pad + "}")
            return lines
        }
        if nt == "InterfaceStatement" {
            -- An interface is a compile-time contract: the interpreter uses it
            -- to check that a class declaring it defines the right methods,
            -- and it has no effect on what a valid program does at runtime.
            -- So it emits nothing. A program that *violates* an interface is
            -- rejected by the interpreter and accepted here — stated in
            -- ROADMAP, not silently different.
            return []
        }
        if nt == "ThrowStatement" {
            return [pad + "cl_throw(" + this.expr(node.value) + ");"]
        }
        if nt == "TryCatch" {
            let id = this.tmp_id
            this.tmp_id += 1
            let h = "__h" + str(id)
            let h2 = "__hc" + str(id)
            mut lines = [pad + "{ ClHandler " + h + "; " + h + ".prev = cl_handlers; cl_handlers = &" + h + ";"]
            push(lines, pad + "  if(setjmp(" + h + ".buf) == 0) {")
            -- The finally stays on the stack across *both* arms, so a `return`
            -- from either runs it on the way out. Handlers are popped before
            -- their body runs, so a throw from inside a catch reaches the
            -- enclosing handler rather than re-entering the one it is in.
            if node.finally_body != null { push(this.finally_stack, node.finally_body) }
            for st in _block_stmts(node.try_body) { for l in this.stmt(st, indent + 2) { push(lines, l) } }
            push(lines, pad + "    cl_handlers = " + h + ".prev;")
            push(lines, pad + "  } else {")
            push(lines, pad + "    cl_handlers = " + h + ".prev;")
            if node.catch_var != null {
                push(lines, pad + "    Value v_" + node.catch_var + " = cl_thrown;")
            }
            if node.finally_body == null {
                if node.catch_body != null {
                    for st in _block_stmts(node.catch_body) { for l in this.stmt(st, indent + 2) { push(lines, l) } }
                }
            } else {
                -- With a finally, the catch body runs under a handler of its
                -- own. A throw from inside it would otherwise longjmp straight
                -- past the finally to the enclosing handler, and the finally
                -- would never run — which is the whole point of writing one.
                -- Caught here, the finally runs and the value is rethrown.
                push(lines, pad + "    ClHandler " + h2 + "; " + h2 + ".prev = cl_handlers; cl_handlers = &" + h2 + ";")
                push(lines, pad + "    if(setjmp(" + h2 + ".buf) == 0) {")
                if node.catch_body != null {
                    for st in _block_stmts(node.catch_body) { for l in this.stmt(st, indent + 3) { push(lines, l) } }
                }
                push(lines, pad + "      cl_handlers = " + h2 + ".prev;")
                push(lines, pad + "    } else {")
                push(lines, pad + "      cl_handlers = " + h2 + ".prev;")
                push(lines, pad + "      Value " + h2 + "_v = cl_thrown;")
                let saved = this.finally_stack
                this.finally_stack = []
                for st in _block_stmts(node.finally_body) { for l in this.stmt(st, indent + 3) { push(lines, l) } }
                this.finally_stack = saved
                push(lines, pad + "      cl_throw(" + h2 + "_v);")
                push(lines, pad + "    }")
            }
            push(lines, pad + "  }")
            if node.finally_body != null { pop(this.finally_stack) }
            if node.finally_body != null {
                for st in _block_stmts(node.finally_body) { for l in this.stmt(st, indent + 1) { push(lines, l) } }
            }
            push(lines, pad + "}")
            return lines
        }
        if nt == "FnStatement" { return [] }   -- hoisted separately
        this.unsupported("statement " + nt, node.line)
        return []
    }

    fn _fn_signature(node) {
        mut params = []
        for p in node.params { push(params, "Value v_" + _param_name(p)) }
        return "Value f_" + node.name + "(" + join(params, ", ") + ")"
    }

    fn function(node) {
        this.local_names = this._bound_names(node)
        -- C leaves a non-volatile local of the function containing a setjmp
        -- indeterminate if it is modified inside the try. Any function with a
        -- try therefore gets volatile locals; see the exception runtime.
        this.volatile_locals = _has_try(_block_stmts(node.body))
        this.in_generator = _has_yield(_block_stmts(node.body))
        mut lines = [this._fn_signature(node) + " {"]
        for l in this._generator_prologue() { push(lines, l) }
        for s in _block_stmts(node.body) { for l in this.stmt(s, 1) { push(lines, l) } }
        for l in this._generator_epilogue() { push(lines, l) }
        push(lines, "  return cl_null();")
        push(lines, "}")
        this.local_names = []
        this.volatile_locals = false
        this.in_generator = false
        return lines
    }

    -- One list per call, holding what `yield` has collected. A local rather
    -- than anything global, so a recursive or nested generator keeps its own
    -- — which is what the interpreter's save-and-restore buys it.
    fn _generator_prologue() {
        if not this.in_generator { return [] }
        return ["  Value __yields = cl_list_new();"]
    }

    -- Falling off the end of a generator returns what it collected.
    fn _generator_epilogue() {
        if not this.in_generator { return [] }
        return ["  if (cl_length(__yields) > 0) return __yields;"]
    }

    -- Every name this function binds: its parameters, and any `let`/`mut` or
    -- loop variable anywhere inside it. Used only to decide whether a mention
    -- of a top-level function's name actually refers to that function.
    fn _bound_names(node) {
        mut names = []
        for p in node.params {
            let pname = _param_name(p)
            push(names, pname)
        }
        this._collect_bound(_block_stmts(node.body), names)
        return names
    }

    fn _collect_bound(stmts, acc) {
        for s in stmts {
            let nt = s.node_type
            if nt == "LetStatement" { push(acc, s.name) }
            elif nt == "DestructureLetStatement" {
                for target in s.targets {
                    if starts(target, "...") { push(acc, substring(target, 3, len(target))) }
                    else { push(acc, target) }
                }
            }
            elif nt == "ForStatement" {
                if s.variable != null { push(acc, s.variable) }
                this._collect_bound(_block_stmts(s.body), acc)
            }
            elif nt == "WhileStatement" { this._collect_bound(_block_stmts(s.body), acc) }
            elif nt == "IfStatement" {
                this._collect_bound(_block_stmts(s.body), acc)
                if s.elif_clauses != null {
                    for clause in s.elif_clauses { this._collect_bound(_block_stmts(clause[1]), acc) }
                }
                if s.else_body != null { this._collect_bound(_block_stmts(s.else_body), acc) }
            }
            elif nt == "TryCatch" {
                this._collect_bound(_block_stmts(s.try_body), acc)
                if s.catch_var != null { push(acc, s.catch_var) }
                if s.catch_body != null { this._collect_bound(_block_stmts(s.catch_body), acc) }
                if s.finally_body != null { this._collect_bound(_block_stmts(s.finally_body), acc) }
            }
            elif nt == "MatchStatement" {
                for arm in s.arms { this._collect_bound(_block_stmts(arm[1]), acc) }
                if s.default != null { this._collect_bound(_block_stmts(s.default), acc) }
            }
        }
        return null
    }

    -- Resolve a class's callable methods, walking the parent chain so an
    -- own method overrides an inherited one. Returns [methodName, ownerClass]
    -- pairs; ownerClass is where the actual C function lives.
    fn _resolve_methods(class_node) {
        mut seen = {}
        mut result = []
        mut cls = class_node
        while cls != null {
            for m in cls.methods {
                if m.node_type == "FnStatement" and not has(seen, m.name) {
                    seen[m.name] = true
                    push(result, [m.name, cls.name])
                }
            }
            cls = if cls.parent != null and has(this.class_defs, cls.parent) { this.class_defs[cls.parent] } else { null }
        }
        return result
    }

    -- The class that actually defines `mname` (own or inherited), or null.
    fn _method_owner(class_node, mname) {
        mut cls = class_node
        while cls != null {
            for m in cls.methods {
                if m.node_type == "FnStatement" and m.name == mname { return cls.name }
            }
            cls = if cls.parent != null and has(this.class_defs, cls.parent) { this.class_defs[cls.parent] } else { null }
        }
        return null
    }

    -- Emit a class's method functions and its constructor.
    fn class_code(class_node) {
        mut lines = []
        for m in class_node.methods {
            if m.node_type == "FnStatement" {
                this.in_generator = _has_yield(_block_stmts(m.body))
                push(lines, "Value f_" + class_node.name + "_" + m.name + "(Value v_this, Value* __a, long __n) {")
                push(lines, "  (void)__a; (void)__n;")
                for l in this._generator_prologue() { push(lines, l) }
                mut idx = 0
                for p in m.params {
                    push(lines, this._bind_param(_raw_param(p), idx))
                    idx += 1
                }
                for s in _block_stmts(m.body) { for l in this.stmt(s, 1) { push(lines, l) } }
                for l in this._generator_epilogue() { push(lines, l) }
                push(lines, "  return cl_null();")
                push(lines, "}")
                this.in_generator = false
            }
        }
        push(lines, "Value cl_ctor_" + class_node.name + "(Value* __a, long __n) {")
        push(lines, "  Value self = cl_object_new(\"" + class_node.name + "\");")
        let init_owner = this._method_owner(class_node, "init")
        if init_owner != null {
            push(lines, "  f_" + init_owner + "_init(self, __a, __n);")
        }
        push(lines, "  return self;")
        push(lines, "}")
        return lines
    }

    fn compile(tree) {
        mut fns = []
        mut classes = []
        mut enums = []
        mut top = []
        for stmt in tree.body {
            if stmt.node_type == "FnStatement" {
                push(fns, stmt)
                push(this.fn_names, stmt.name)
                this.fn_arity[stmt.name] = len(stmt.params)
                if len(stmt.params) > 0 and _is_rest(stmt.params[len(stmt.params) - 1]) {
                    this.fn_rest[stmt.name] = true
                }
            }
            elif stmt.node_type == "ClassStatement" {
                push(classes, stmt)
                push(this.classes, stmt.name)
                this.class_defs[stmt.name] = stmt
            }
            -- An enum is a compile-time table: registered before any body is
            -- emitted, because a function defined above the enum may still
            -- refer to it (Clarity resolves module scope from anywhere).
            elif stmt.node_type == "EnumStatement" {
                push(enums, stmt)
                mut member_names = []
                for member in stmt.members { push(member_names, member[0]) }
                this.enums[stmt.name] = member_names
            }
            elif stmt.node_type == "DecoratedStatement" and stmt.target.node_type == "FnStatement" {
                -- `@twice fn f() {...}` is a function *and* a rebinding of
                -- its name to whatever the decorator returns. The function is
                -- emitted as usual; the name becomes a global holding the
                -- wrapped value, and calls go through that.
                let target = stmt.target
                push(fns, target)
                push(this.fn_names, target.name)
                this.fn_arity[target.name] = len(target.params)
                if len(target.params) > 0 and _is_rest(target.params[len(target.params) - 1]) {
                    this.fn_rest[target.name] = true
                }
                this.decorated[target.name] = true
                push(top, stmt)
            }
            else { push(top, stmt) }
        }

        -- Emit bodies first: this drives expr()/stmt(), which hoist any
        -- closures into this.closure_defs and bump this.closure_id.
        mut fn_body = []
        for f in fns { for l in this.function(f) { push(fn_body, l) } push(fn_body, "") }
        mut class_body = []
        for c in classes { for l in this.class_code(c) { push(class_body, l) } push(class_body, "") }
        mut main_body = []
        for c in classes {
            for pair in this._resolve_methods(c) {
                push(main_body, "  cl_register(\"" + c.name + "\", \"" + pair[0] + "\", &f_" + pair[1] + "_" + pair[0] + ");")
            }
        }
        -- Enum members are initialised before any module-level binding, so a
        -- `let` may name one. A member with no value of its own is its index,
        -- which is what the interpreter assigns.
        mut enum_globals = []
        for e in enums {
            mut index = 0
            for member in e.members {
                let member_name = member[0]
                let value_node = member[1]
                let global_name = this._enum_global(e.name, member_name)
                push(enum_globals, global_name)
                let init = if value_node != null { this.expr(value_node) } else { "cl_int(" + str(index) + ")" }
                push(main_body, "  " + global_name + " = " + init + ";")
                index += 1
            }
        }
        -- Module-level bindings become C globals rather than locals of main().
        -- A function body compiled above may reference one (Clarity resolves
        -- module scope from anywhere in the file), and a local of main() is
        -- invisible to it. The initialiser stays here, in source order, so
        -- evaluation order matches the interpreter's module load.
        mut globals = []
        mut seen_global = {}
        for s in top {
            if s.node_type == "LetStatement" {
                if not has(seen_global, s.name) {
                    seen_global[s.name] = true
                    push(globals, s.name)
                }
                push(main_body, "  v_" + s.name + " = " + this.expr(s.value) + ";")
            } elif s.node_type == "DecoratedStatement" {
                let dname = s.target.name
                if not has(seen_global, dname) {
                    seen_global[dname] = true
                    push(globals, dname)
                }
                this.fn_values[dname] = true
                -- Innermost decorator first, as in the interpreter.
                mut wrapped = "__fnv_" + dname
                mut di = len(s.decorators) - 1
                while di >= 0 {
                    wrapped = "cl_call(" + this.expr(s.decorators[di]) + ", (Value[]){" + wrapped + "}, 1)"
                    di -= 1
                }
                push(main_body, "  v_" + dname + " = " + wrapped + ";")
            } elif s.node_type == "DestructureLetStatement" {
                -- Every name a module-level pattern binds is a C global, for
                -- the reason the plain `let` above is: a function compiled
                -- anywhere in the file may name one.
                for target in s.targets {
                    let dn = if starts(target, "...") { substring(target, 3, len(target)) } else { target }
                    if not has(seen_global, dn) {
                        seen_global[dn] = true
                        push(globals, dn)
                    }
                }
                for l in this._destructure(s, "  ", false) { push(main_body, l) }
            } else {
                for l in this.stmt(s, 1) { push(main_body, l) }
            }
        }

        -- Assemble: prelude, all forward declarations (so any call order and
        -- mutual recursion is free), closure bodies, function bodies, main.
        mut out = []
        -- Before the prelude, so its #ifndefs see it. A #define rather than a
        -- -D flag so the emitted .c file is self-describing: whoever picks it
        -- up can see which profile produced it.
        if this.freestanding { push(out, "#define CLARITY_FREESTANDING 1") }
        push(out, C_PRELUDE)
        push(out, "")
        -- A top-level function named as a value gets one closure, held in a
        -- global and built once, so `f == f` is true — a closure compares by
        -- identity, and a fresh closure per mention would compare unequal to
        -- itself.
        let fn_value_names = keys(this.fn_values)
        if len(globals) > 0 or len(enum_globals) > 0 or len(fn_value_names) > 0 {
            push(out, "/* module-level bindings */")
            mut roots = []
            for g in globals {
                push(out, "Value v_" + g + ";")
                push(roots, "&v_" + g)
            }
            -- Enum members are roots too: a member whose value is a string or
            -- a list is heap-allocated, and the collector has to see it held.
            for g in enum_globals {
                push(out, "Value " + g + ";")
                push(roots, "&" + g)
            }
            for fname in fn_value_names {
                push(out, "Value __fnv_" + fname + ";")
                push(roots, "&__fnv_" + fname)
            }
            push(out, "static Value* cl_global_roots[] = {" + join(roots, ", ") + "};")
            push(out, "")
        }
        if len(enums) > 0 {
            push(out, "/* enums */")
            for e in enums {
                for l in this._enum_helpers(e.name, this.enums[e.name]) { push(out, l) }
            }
            push(out, "")
        }
        for f in fns { push(out, this._fn_signature(f) + ";") }
        for c in classes {
            for m in c.methods {
                if m.node_type == "FnStatement" {
                    push(out, "Value f_" + c.name + "_" + m.name + "(Value v_this, Value* __a, long __n);")
                }
            }
            push(out, "Value cl_ctor_" + c.name + "(Value* __a, long __n);")
        }
        mut cid = 0
        while cid < this.closure_id {
            push(out, "Value __closure_" + str(cid) + "(Value* __a, Value* __cap, long __n);")
            cid += 1
        }
        -- A top-level function used as a value needs a closure-shaped wrapper:
        -- the closure convention is (args array, captures) but a top-level
        -- function takes its parameters individually, so the thunk unpacks.
        for fname in keys(this.fn_values) {
            push(out, "Value __fnval_" + fname + "(Value* __a, Value* __cap, long __n);")
        }
        push(out, "")
        for cdef in this.closure_defs { for l in cdef { push(out, l) } push(out, "") }
        for l in fn_body { push(out, l) }
        for fname in keys(this.fn_values) {
            mut argv = []
            mut ai = 0
            let fixed = this.fn_arity[fname] - (if has(this.fn_rest, fname) { 1 } else { 0 })
            while ai < fixed { push(argv, "cl_arg(__a, __n, " + str(ai) + ")"); ai += 1 }
            if has(this.fn_rest, fname) { push(argv, "cl_rest(__a, __n, " + str(fixed) + ")") }
            push(out, "Value __fnval_" + fname + "(Value* __a, Value* __cap, long __n) { (void)__cap; (void)__a; (void)__n; return f_" +
                fname + "(" + join(argv, ", ") + "); }")
        }
        push(out, "")
        for l in class_body { push(out, l) }
        push(out, "int main(int argc, char** argv) {")
        push(out, "  cl_argc = argc; cl_argv = argv;")
        push(out, "  GC_CAPTURE_STACK_BASE();")
        push(out, "  if(getenv(\"CLARITY_GC\")) gc_enabled = 1;")
        if len(globals) > 0 or len(enum_globals) > 0 or len(fn_value_names) > 0 {
            push(out, "  cl_globals = cl_global_roots; cl_globals_n = " +
                str(len(globals) + len(enum_globals) + len(fn_value_names)) + ";")
        }
        -- Before anything else in main: a module-level `let` may name a
        -- function as a value, and so may a function it calls.
        for fname in fn_value_names {
            push(out, "  __fnv_" + fname + " = cl_closure_new(&__fnval_" + fname + ", 0, 0);")
        }
        for l in main_body { push(out, l) }
        push(out, "  cl_arena_free();")
        push(out, "  return 0;")
        push(out, "}")
        return join(out, "\n")
    }
}

-- Compile a parsed program to a complete C translation unit. Throws if the
-- program uses a construct stage 1 doesn't support yet.
fn compile_to_c(tree) {
    let cg = CCodegen()
    let src = cg.compile(tree)
    if len(cg.errors) > 0 { throw join(cg.errors, "\n") }
    return src
}

-- The freestanding profile: the same code generator, with the POSIX half of
-- the runtime compiled out and the builtins that needed it refused. What is
-- left is C, not Unix — it is what `clarity cc --freestanding` emits for a
-- target that has no operating system underneath it yet, KyanOS being the
-- one this exists for.
fn compile_to_c_freestanding(tree) {
    let cg = CCodegen()
    cg.freestanding = true
    let src = cg.compile(tree)
    if len(cg.errors) > 0 { throw join(cg.errors, "\n") }
    return src
}
